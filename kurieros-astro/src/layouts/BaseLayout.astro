---
import '../styles/index.css';
import '../styles/themes.css';
import VPNModal from '../components/VPNModal.astro';
import OzonLeadModal from '../components/OzonLeadModal.astro';
import { SUPPORTED_LANGUAGES, translations as allTranslations } from '../data/translations';

const supportedLanguages = SUPPORTED_LANGUAGES;
// M2: shell-UI dictionary is Russian-only (post PR #131), so the 11 non-RU
// slots in `allTranslations` were byte-identical clones of `ru`. Inlining
// all 12 via `define:vars` cost ~147 KB of duplicate JSON literal per HTML
// page (12 × ~13 KB shell dicts). Ship just the RU slot; the runtime falls
// back to it for every non-RU lang. Per-language `.vacancies` slots are
// still created on-demand by `ensureVacancyTranslations` once fragments
// load, so nothing downstream loses data.
const translations = { ru: allTranslations.ru };
// TRANS-1: per-source fragments live at /vacancy-translations/<lang>/<sourceSlug>.json.
// Client scans visible cards for `data-vacancy-source-slug` and loads only
// the fragments it needs (typical detail page: 1 fragment ~80KB-2MB,
// instead of the old combined 20MB <lang>.json).
//
// Cache-busting: every build emits a fresh `?v=<buildTimestamp>` query
// parameter. This ensures the browser refetches the fragment whenever the
// site is redeployed — without it, the prior `cache: 'force-cache'` mode
// would pin users to whatever fragment they saw first, surviving any
// subsequent translation edits (saw this in the wild after #131/#132 ran:
// returning visitors kept seeing pre-revert Armenian titles).
const vacancyTranslationsBase = '/vacancy-translations';
// `__BUILD_TIMESTAMP__` is injected by `vite.define` in astro.config.mjs and
// is the SAME string for every page in a single build. Using `Date.now()`
// here ran per-page (Astro evaluates each page's frontmatter independently),
// stamping a different `?v=` into each of the 5793 HTML files and defeating
// the cross-page `force-cache` strategy. The Vite-injected constant gives
// every page the same compile-time stamp; a redeploy mints a fresh value.
declare const __BUILD_TIMESTAMP__: string;
// Runtime guard: if `vite.define` was misconfigured or omitted (local
// hot-reload edge cases, partial dev server start, etc.), the constant
// may interpolate as the literal string `"undefined"` or be missing
// entirely. Fall back to a per-process stamp so URLs stay valid; log
// loudly because a missing build version means cross-page cache
// invalidation is broken (every page gets a different `?v=`).
const vacancyTranslationsVersion = (typeof __BUILD_TIMESTAMP__ === 'string'
	&& __BUILD_TIMESTAMP__ && __BUILD_TIMESTAMP__ !== 'undefined')
	? __BUILD_TIMESTAMP__
	: (() => { console.error('[BaseLayout] __BUILD_TIMESTAMP__ not injected'); return String(Date.now()); })();
const i18nConfigJson = JSON.stringify({
	translations,
	supportedLanguages,
	vacancyTranslationsBase,
	vacancyTranslationsVersion,
}).replace(/</g, '\\u003c');

interface Props {
	title?: string;
	titleKey?: string;
	description?: string;
	descriptionKey?: string;
	image?: string;
	canonicalURL?: URL | string;
	schemaGraph?: Record<string, any> | Array<Record<string, any>>;
	robots?: string;
	ogType?: string;
	articleSection?: string;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
}

const {
	title = "КурьерОк — Вся работа здесь",
	titleKey,
	description = "Лучшие вакансии для курьеров в России. Работа на авто, мото, вело и пешком. Сравнивайте условия в Яндекс Еда, СДЭК, Ozon и других компаниях.",
	descriptionKey,
	image = "/og-default.png",
	canonicalURL = new URL(Astro.url.pathname, Astro.site),
	schemaGraph = [],
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
	ogType = "website",
	articleSection,
	articlePublishedTime,
	articleModifiedTime,
} = Astro.props;

const resolvedCanonicalUrl = canonicalURL instanceof URL ? canonicalURL : new URL(canonicalURL, Astro.site);
const socialBaseUrl = Astro.site || resolvedCanonicalUrl;
const resolvedImageUrl = new URL(image, socialBaseUrl).toString();

const websiteSchema = {
	"@type": "WebSite",
	name: "КурьерОк",
	url: "https://kurerok.ru/",
};

const normalizedSchemaGraph = Array.isArray(schemaGraph)
	? schemaGraph
	: [schemaGraph];

// `.replace(/</g, …)` escapes `<` so a string containing
// `</script>` (e.g. a job title) cannot break out of the inline
// `<script type="application/ld+json">` block — `JSON.stringify`
// alone does not escape it (audit v3 M16).
const structuredData = JSON.stringify(
	{
		"@context": "https://schema.org",
		"@graph": [websiteSchema, ...normalizedSchemaGraph.filter(Boolean)],
	},
	null,
	2,
).replace(/</g, '\\u003c');

const isProduction = import.meta.env.PROD;
const ga4MeasurementId = String(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '').trim();
const yandexMetrikaId = String(import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? '').trim();
// Verification tokens are set per environment via .env.example vars.
// Hardcoded fallbacks were removed (M19): tokens that drift in source
// outlive their post-rotation usefulness in git history. When a var is
// empty the corresponding <meta> tag is skipped entirely below.
const yandexVerification = String(import.meta.env.PUBLIC_YANDEX_VERIFICATION ?? '').trim();
const googleSiteVerification = String(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim();
---

<!doctype html>
<html lang="ru" prefix="og: http://ogp.me/ns# article: http://ogp.me/ns/article#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="generator" content={Astro.generator} />
		<title data-t-title={titleKey}>{title}</title>
		<meta name="description" content={description} data-t-content={descriptionKey} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={resolvedCanonicalUrl} />
		<!-- Favicon stack: SVG primary (modern browsers) + ICO/PNG fallbacks
		     for legacy browsers and Yandex Webmaster's «favicon not found»
		     check, which expects a real `/favicon.ico` at the site root. -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
			{yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
			{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
		<meta name="format-detection" content="telephone=no" />

		<!-- Manrope (primary UI font, design tokens use it). -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap">

			<!-- Theme Persistence -->
			<script is:inline>
				(function() {
					// Safari Private Browsing and restricted WKWebViews throw a
					// SecurityError on `localStorage.getItem`. If that happens we
					// fall back to the default light theme rather than letting the
					// IIFE crash (which would leave dataset.initialTheme unset and
					// produce a flash of unstyled content / wrong color scheme).
					var savedTheme = null;
					var savedColorMode = null;
					try {
						savedTheme = localStorage.getItem('site-theme');
						savedColorMode = localStorage.getItem('site-color-mode');
					} catch (_) { /* localStorage unavailable — use defaults */ }

					var bodyClass = savedTheme && savedTheme !== 'default'
						? 'theme-' + savedTheme
						: '';
					document.documentElement.dataset.initialTheme = bodyClass;

					var hasSavedMode = savedColorMode === 'dark' || savedColorMode === 'light';
					var systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
					var colorMode = hasSavedMode ? savedColorMode : (systemPrefersDark ? 'dark' : 'light');
					document.documentElement.dataset.initialColorMode = colorMode;
					document.documentElement.style.colorScheme = colorMode;
					// Apply dark-mode class to <html> before first paint to avoid FOUC.
					document.documentElement.classList.toggle('dark-mode', colorMode === 'dark');
					// Mirror the class to <body> as soon as it parses. Dark-mode
					// rules are converged on `:where(html, body).dark-mode .X`
					// (Wave 21e M7), which matches via EITHER ancestor — so the
					// <html> class set above already styles every rule before
					// <body> parses; no rule needs the <body> class to apply.
					// The <body> mirror is kept anyway so the two ancestors stay
					// consistent within the anti-FOUC frame and any future
					// body-scoped logic (Header.astro reads body.dataset, JS that
					// keys off the <body> class) sees the right state without a
					// reload. MutationObserver fires synchronously the moment the
					// parser inserts <body>, so the mirror lands in the same frame.
					(function syncBodyDarkClass() {
						var isDark = colorMode === 'dark';
						if (document.body) {
							document.body.classList.toggle('dark-mode', isDark);
							return;
						}
						new MutationObserver(function (_records, observer) {
							if (document.body) {
								document.body.classList.toggle('dark-mode', isDark);
								observer.disconnect();
							}
						}).observe(document.documentElement, { childList: true });
					})();
				})();
			</script>

			{/* Owner-mute toggle: prevents GA4 + Метрика from firing on
			    dev/owner devices. Persistent localStorage flag; активация
			    через `/?owner-mute=1` (один раз на каждом устройстве),
			    деактивация — `/?owner-unmute=1`. Работает независимо от IP,
			    что надёжнее GA4 internal-traffic фильтров (IP меняется
			    дома/мобильно/в офисе). Должен идти ПЕРЕД analytics-скриптами. */}
			{isProduction && (
				<script is:inline>
					(function() {
						try {
							var qs = window.location.search || '';
							if (qs.indexOf('owner-mute=1') !== -1) {
								localStorage.setItem('kurerok-owner-mute', '1');
								// eslint-disable-next-line no-console
								console.info('[kurerok] Analytics muted on this device. Use ?owner-unmute=1 to restore.');
							} else if (qs.indexOf('owner-unmute=1') !== -1) {
								localStorage.removeItem('kurerok-owner-mute');
								// eslint-disable-next-line no-console
								console.info('[kurerok] Analytics restored.');
							}
							window.__kurerokSkipAnalytics = (localStorage.getItem('kurerok-owner-mute') === '1');
						} catch (_) { /* localStorage unavailable — analytics fire as usual */ }
					})();
				</script>
			)}

			{isProduction && ga4MeasurementId && (
				<>
					<script is:inline define:vars={{ ga4MeasurementId }}>
						(function() {
							if (window.__kurerokSkipAnalytics) {
								// Stub gtag so per-page event handlers don't crash.
								window.gtag = function() {};
								return;
							}
							// Dynamic inject (replaces the previous static <script async src>),
							// so muted devices skip the network request entirely.
							var s = document.createElement('script');
							s.async = true;
							s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4MeasurementId;
							document.head.appendChild(s);

							window.dataLayer = window.dataLayer || [];
							function gtag(){window.dataLayer.push(arguments);}
							gtag('js', new Date());
							gtag('config', ga4MeasurementId, {
								anonymize_ip: true,
							});
							// Expose gtag globally so per-page event handlers can call it.
							window.gtag = gtag;
						})();
					</script>

					<script>
						import '../scripts/analyticsEvents';
					</script>
				</>
			)}

			{isProduction && yandexMetrikaId && (
				<script is:inline define:vars={{ yandexMetrikaId }}>
					(function() {
						if (window.__kurerokSkipAnalytics) return;
						(function(m,e,t,r,i,k,a){
							m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
							m[i].l=1*new Date();
							for (var j = 0; j < document.scripts.length; j++) {
								if (document.scripts[j].src === r) return;
							}
							k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
						})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

						ym(Number(yandexMetrikaId), 'init', {
							clickmap:true,
							trackLinks:true,
							accurateTrackBounce:true,
							webvisor:true
						});
					})();
				</script>
			)}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="КурьерОк" />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={resolvedCanonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedImageUrl} />
		{ogType === "article" && articleSection && (
			<meta property="article:section" content={articleSection} />
		)}
		{ogType === "article" && articlePublishedTime && (
			<meta property="article:published_time" content={articlePublishedTime} />
		)}
		{ogType === "article" && articleModifiedTime && (
			<meta property="article:modified_time" content={articleModifiedTime} />
		)}
		{ogType === "article" && (
			<meta property="article:author" content="КурьерОк" />
		)}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={resolvedCanonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={resolvedImageUrl} />

		<!-- theme-color is HTML attribute (no var() support); kept in sync with --brand-700 from src/styles/themes.css -->
		<meta name="theme-color" content="#1d5634" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<!-- Schema.org Markup -->
			<script is:inline type="application/ld+json" set:html={structuredData}></script>
	</head>
		<body>
			{isProduction && yandexMetrikaId && (
				<noscript>
					<div>
						<img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" />
					</div>
				</noscript>
			)}
			<script is:inline>
				(function() {
					const initialTheme = document.documentElement.dataset.initialTheme;
					const initialColorMode = document.documentElement.dataset.initialColorMode || 'light';

					document.body.className = initialTheme || '';
					document.body.classList.toggle('dark-mode', initialColorMode === 'dark');
					document.body.dataset.colorMode = initialColorMode;
					document.documentElement.style.colorScheme = initialColorMode;
				})();
			</script>
		<slot />

		<VPNModal />
		<OzonLeadModal />

		<script>
			import '../scripts/regionDetector.js';
		</script>
		<script is:inline id="kurieros-i18n-config" type="application/json" set:html={i18nConfigJson}></script>
		<script>
			import '../scripts/i18nRuntime.js';
		</script>
	</body>
</html>
