---
import '../styles/index.css';
import '../styles/themes.css';
import VPNModal from '../components/VPNModal.astro';
import OzonLeadModal from '../components/OzonLeadModal.astro';
import { SUPPORTED_LANGUAGES, translations as allTranslations } from '../data/translations';

const supportedLanguages = SUPPORTED_LANGUAGES;
// M2: shell-UI dictionary is Russian-only (post PR #131), so the 11 non-RU
// slots in `allTranslations` were byte-identical clones of `ru`. Inlining
// all 12 via `define:vars` cost ~147 KB of duplicate JSON literal per HTML
// page (12 × ~13 KB shell dicts). Ship just the RU slot; the runtime falls
// back to it for every non-RU lang. Per-language `.vacancies` slots are
// still created on-demand by `ensureVacancyTranslations` once fragments
// load, so nothing downstream loses data.
const translations = { ru: allTranslations.ru };
// TRANS-1: per-source fragments live at /vacancy-translations/<lang>/<sourceSlug>.json.
// Client scans visible cards for `data-vacancy-source-slug` and loads only
// the fragments it needs (typical detail page: 1 fragment ~80KB-2MB,
// instead of the old combined 20MB <lang>.json).
//
// Cache-busting: every build emits a fresh `?v=<buildTimestamp>` query
// parameter. This ensures the browser refetches the fragment whenever the
// site is redeployed — without it, the prior `cache: 'force-cache'` mode
// would pin users to whatever fragment they saw first, surviving any
// subsequent translation edits (saw this in the wild after #131/#132 ran:
// returning visitors kept seeing pre-revert Armenian titles).
const vacancyTranslationsBase = '/vacancy-translations';
// `__BUILD_TIMESTAMP__` is injected by `vite.define` in astro.config.mjs and
// is the SAME string for every page in a single build. Using `Date.now()`
// here ran per-page (Astro evaluates each page's frontmatter independently),
// stamping a different `?v=` into each of the 5793 HTML files and defeating
// the cross-page `force-cache` strategy. The Vite-injected constant gives
// every page the same compile-time stamp; a redeploy mints a fresh value.
declare const __BUILD_TIMESTAMP__: string;
// Runtime guard: if `vite.define` was misconfigured or omitted (local
// hot-reload edge cases, partial dev server start, etc.), the constant
// may interpolate as the literal string `"undefined"` or be missing
// entirely. Fall back to a per-process stamp so URLs stay valid; log
// loudly because a missing build version means cross-page cache
// invalidation is broken (every page gets a different `?v=`).
const vacancyTranslationsVersion = (typeof __BUILD_TIMESTAMP__ === 'string'
	&& __BUILD_TIMESTAMP__ && __BUILD_TIMESTAMP__ !== 'undefined')
	? __BUILD_TIMESTAMP__
	: (() => { console.error('[BaseLayout] __BUILD_TIMESTAMP__ not injected'); return String(Date.now()); })();

interface Props {
	title?: string;
	titleKey?: string;
	description?: string;
	descriptionKey?: string;
	image?: string;
	canonicalURL?: URL | string;
	schemaGraph?: Record<string, any> | Array<Record<string, any>>;
	robots?: string;
	ogType?: string;
	articleSection?: string;
	articlePublishedTime?: string;
	articleModifiedTime?: string;
}

const {
	title = "КурьерОк — Вся работа здесь",
	titleKey,
	description = "Лучшие вакансии для курьеров в России. Работа на авто, мото, вело и пешком. Сравнивайте условия в Яндекс Еда, СДЭК, Ozon и других компаниях.",
	descriptionKey,
	image = "/og-default.png",
	canonicalURL = new URL(Astro.url.pathname, Astro.site),
	schemaGraph = [],
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
	ogType = "website",
	articleSection,
	articlePublishedTime,
	articleModifiedTime,
} = Astro.props;

const resolvedCanonicalUrl = canonicalURL instanceof URL ? canonicalURL : new URL(canonicalURL, Astro.site);
const socialBaseUrl = Astro.site || resolvedCanonicalUrl;
const resolvedImageUrl = new URL(image, socialBaseUrl).toString();

const websiteSchema = {
	"@type": "WebSite",
	name: "КурьерОк",
	url: "https://kurerok.ru/",
};

const normalizedSchemaGraph = Array.isArray(schemaGraph)
	? schemaGraph
	: [schemaGraph];

// `.replace(/</g, …)` escapes `<` so a string containing
// `</script>` (e.g. a job title) cannot break out of the inline
// `<script type="application/ld+json">` block — `JSON.stringify`
// alone does not escape it (audit v3 M16).
const structuredData = JSON.stringify(
	{
		"@context": "https://schema.org",
		"@graph": [websiteSchema, ...normalizedSchemaGraph.filter(Boolean)],
	},
	null,
	2,
).replace(/</g, '\\u003c');

const isProduction = import.meta.env.PROD;
const ga4MeasurementId = String(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '').trim();
const yandexMetrikaId = String(import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? '').trim();
// Verification tokens are set per environment via .env.example vars.
// Hardcoded fallbacks were removed (M19): tokens that drift in source
// outlive their post-rotation usefulness in git history. When a var is
// empty the corresponding <meta> tag is skipped entirely below.
const yandexVerification = String(import.meta.env.PUBLIC_YANDEX_VERIFICATION ?? '').trim();
const googleSiteVerification = String(import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim();
---

<!doctype html>
<html lang="ru" prefix="og: http://ogp.me/ns# article: http://ogp.me/ns/article#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
		<meta name="generator" content={Astro.generator} />
		<title data-t-title={titleKey}>{title}</title>
		<meta name="description" content={description} data-t-content={descriptionKey} />
		<meta name="robots" content={robots} />
		<link rel="canonical" href={resolvedCanonicalUrl} />
		<!-- Favicon stack: SVG primary (modern browsers) + ICO/PNG fallbacks
		     for legacy browsers and Yandex Webmaster's «favicon not found»
		     check, which expects a real `/favicon.ico` at the site root. -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
			{yandexVerification && <meta name="yandex-verification" content={yandexVerification} />}
			{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
		<meta name="format-detection" content="telephone=no" />

		<!-- Manrope (primary UI font, design tokens use it).
		     Non-blocking preload pattern: a plain `<link rel="stylesheet">`
		     to a third-party CSS endpoint stalls HTML parsing until the
		     stylesheet downloads (~50–150ms RTT to Google's CDN), even
		     with `display=swap` (which only controls the resulting
		     @font-face rules, not the CSS request itself). Fetch as
		     `preload as=style` instead, then promote to `stylesheet`
		     once the asset is in the cache so subsequent paints see it.
		     The `<noscript>` fallback ensures the font still loads on
		     browsers with JS disabled (where the onload handler can't
		     run). -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap"></noscript>

			<!-- Theme Persistence -->
			<script is:inline>
				(function() {
					// Safari Private Browsing and restricted WKWebViews throw a
					// SecurityError on `localStorage.getItem`. If that happens we
					// fall back to the default light theme rather than letting the
					// IIFE crash (which would leave dataset.initialTheme unset and
					// produce a flash of unstyled content / wrong color scheme).
					var savedTheme = null;
					var savedColorMode = null;
					try {
						savedTheme = localStorage.getItem('site-theme');
						savedColorMode = localStorage.getItem('site-color-mode');
					} catch (_) { /* localStorage unavailable — use defaults */ }

					var bodyClass = savedTheme && savedTheme !== 'default'
						? 'theme-' + savedTheme
						: '';
					document.documentElement.dataset.initialTheme = bodyClass;

					var hasSavedMode = savedColorMode === 'dark' || savedColorMode === 'light';
					var systemPrefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
					var colorMode = hasSavedMode ? savedColorMode : (systemPrefersDark ? 'dark' : 'light');
					document.documentElement.dataset.initialColorMode = colorMode;
					document.documentElement.style.colorScheme = colorMode;
					// Apply dark-mode class to <html> before first paint to avoid FOUC.
					document.documentElement.classList.toggle('dark-mode', colorMode === 'dark');
					// Mirror the class to <body> as soon as it parses. ~50 stylesheets
					// in the codebase use `body.dark-mode .X` selectors (vs ~125 using
					// the unprefixed `.dark-mode .X`). Without this sync those rules
					// only attach after Header.astro's DOMContentLoaded handler runs,
					// causing a several-second flash where filters / dropdowns /
					// search-input render with light defaults on a dark hero.
					// MutationObserver fires synchronously the moment the parser
					// inserts <body>, so the body-prefixed rules attach in the same
					// frame as the html-prefixed ones — eliminating the race entirely.
					(function syncBodyDarkClass() {
						var isDark = colorMode === 'dark';
						if (document.body) {
							document.body.classList.toggle('dark-mode', isDark);
							return;
						}
						new MutationObserver(function (_records, observer) {
							if (document.body) {
								document.body.classList.toggle('dark-mode', isDark);
								observer.disconnect();
							}
						}).observe(document.documentElement, { childList: true });
					})();
				})();
			</script>

			{/* Owner-mute toggle: prevents GA4 + Метрика from firing on
			    dev/owner devices. Persistent localStorage flag; активация
			    через `/?owner-mute=1` (один раз на каждом устройстве),
			    деактивация — `/?owner-unmute=1`. Работает независимо от IP,
			    что надёжнее GA4 internal-traffic фильтров (IP меняется
			    дома/мобильно/в офисе). Должен идти ПЕРЕД analytics-скриптами. */}
			{isProduction && (
				<script is:inline>
					(function() {
						try {
							var qs = window.location.search || '';
							if (qs.indexOf('owner-mute=1') !== -1) {
								localStorage.setItem('kurerok-owner-mute', '1');
								// eslint-disable-next-line no-console
								console.info('[kurerok] Analytics muted on this device. Use ?owner-unmute=1 to restore.');
							} else if (qs.indexOf('owner-unmute=1') !== -1) {
								localStorage.removeItem('kurerok-owner-mute');
								// eslint-disable-next-line no-console
								console.info('[kurerok] Analytics restored.');
							}
							window.__kurerokSkipAnalytics = (localStorage.getItem('kurerok-owner-mute') === '1');
						} catch (_) { /* localStorage unavailable — analytics fire as usual */ }
					})();
				</script>
			)}

			{isProduction && ga4MeasurementId && (
				<>
					<script is:inline define:vars={{ ga4MeasurementId }}>
						(function() {
							if (window.__kurerokSkipAnalytics) {
								// Stub gtag so per-page event handlers don't crash.
								window.gtag = function() {};
								return;
							}
							// Dynamic inject (replaces the previous static <script async src>),
							// so muted devices skip the network request entirely.
							var s = document.createElement('script');
							s.async = true;
							s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4MeasurementId;
							document.head.appendChild(s);

							window.dataLayer = window.dataLayer || [];
							function gtag(){window.dataLayer.push(arguments);}
							gtag('js', new Date());
							gtag('config', ga4MeasurementId, {
								anonymize_ip: true,
							});
							// Expose gtag globally so per-page event handlers can call it.
							window.gtag = gtag;
						})();
					</script>

					<!-- Apply-CTA + calculator-submit event delegation.
					     Any `<a data-apply-cta>` click fires `apply_click`;
					     any `[data-calculator-submit]` event-emit fires
					     `calculator_submit`. Both fire only in production
					     (gated by `isProduction && ga4MeasurementId` block). -->
					<script is:inline>
						(function() {
							var safeNum = function(v) {
								var n = Number(v);
								return Number.isFinite(n) ? n : undefined;
							};
							document.addEventListener('click', function(e) {
								var target = e.target instanceof Element ? e.target.closest('[data-apply-cta]') : null;
								if (!target || typeof window.gtag !== 'function') return;
								var partnerDomain = '';
								try {
									var href = target.getAttribute('href') || '';
									if (href && href.indexOf('http') === 0) {
										partnerDomain = new URL(href).hostname;
									}
								} catch (_) { /* same-origin or invalid URL */ }
								window.gtag('event', 'apply_click', {
									company: target.dataset.applyCompany || '',
									city: target.dataset.applyCity || '',
									transport: target.dataset.applyTransport || '',
									salary_max: safeNum(target.dataset.applySalaryMax),
									employment_type: target.dataset.applyEmployment || '',
									partner_domain: partnerDomain,
									cta_position: target.dataset.applyPosition || ''
								});
							}, { passive: true });

							// Custom event channel for calculator_submit — emitters
							// just dispatch `kurieros:calculator-submit` on window.
							window.addEventListener('kurieros:calculator-submit', function(ev) {
								if (typeof window.gtag !== 'function') return;
								var detail = (ev && ev.detail) || {};
								window.gtag('event', 'calculator_submit', {
									city: detail.city || '',
									transport: detail.transport || '',
									hours_per_day: safeNum(detail.hours_per_day),
									days_per_week: safeNum(detail.days_per_week),
									days_per_month: safeNum(detail.days_per_month),
									result_monthly: safeNum(detail.result_monthly),
									source: detail.source || ''
								});
							});
						})();
					</script>
				</>
			)}

			{isProduction && yandexMetrikaId && (
				<script is:inline define:vars={{ yandexMetrikaId }}>
					(function() {
						if (window.__kurerokSkipAnalytics) return;
						(function(m,e,t,r,i,k,a){
							m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
							m[i].l=1*new Date();
							for (var j = 0; j < document.scripts.length; j++) {
								if (document.scripts[j].src === r) return;
							}
							k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a);
						})(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

						ym(Number(yandexMetrikaId), 'init', {
							clickmap:true,
							trackLinks:true,
							accurateTrackBounce:true,
							webvisor:true
						});
					})();
				</script>
			)}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="КурьерОк" />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={resolvedCanonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedImageUrl} />
		{ogType === "article" && articleSection && (
			<meta property="article:section" content={articleSection} />
		)}
		{ogType === "article" && articlePublishedTime && (
			<meta property="article:published_time" content={articlePublishedTime} />
		)}
		{ogType === "article" && articleModifiedTime && (
			<meta property="article:modified_time" content={articleModifiedTime} />
		)}
		{ogType === "article" && (
			<meta property="article:author" content="КурьерОк" />
		)}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={resolvedCanonicalUrl} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={resolvedImageUrl} />

		<!-- theme-color is HTML attribute (no var() support); kept in sync with --brand-700 from src/styles/themes.css -->
		<meta name="theme-color" content="#1d5634" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

		<!-- Schema.org Markup -->
		<script type="application/ld+json" set:html={structuredData}></script>
	</head>
		<body>
			{isProduction && yandexMetrikaId && (
				<noscript>
					<div>
						<img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" />
					</div>
				</noscript>
			)}
			<script is:inline>
				(function() {
					const initialTheme = document.documentElement.dataset.initialTheme;
					const initialColorMode = document.documentElement.dataset.initialColorMode || 'light';

					document.body.className = initialTheme || '';
					document.body.classList.toggle('dark-mode', initialColorMode === 'dark');
					document.body.dataset.colorMode = initialColorMode;
					document.documentElement.style.colorScheme = initialColorMode;
				})();
			</script>
		<slot />

		<VPNModal />
		<OzonLeadModal />

		<script is:inline>
			(async function() {
				if (window.kurieros_user) return;

				if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
					return;
				}
				
				async function fetchWithTimeout(resource, options = {}) {
					const { timeout = 5000 } = options;
					const controller = new AbortController();
					const id = setTimeout(() => controller.abort(), timeout);
					// try/finally: previously `clearTimeout(id)` ran only on the success
					// path. On a fetch throw (e.g. ipapi.co network error → ipwho.is
					// fallback), the dangling 5s timer would fire later and call
					// .abort() on a settled controller — no-op, but the controller
					// stays referenced until the timer fires, leaking memory in the
					// geolocation fallback chain.
					try {
						return await fetch(resource, { ...options, signal: controller.signal });
					} finally {
						clearTimeout(id);
					}
				}

				function normalizeGeoData(raw) {
					if (!raw) return null;

					if (raw.country) {
						return {
							city: raw.city,
							country: raw.country,
							country_name: raw.country_name,
						};
					}

					if (raw.success !== false && raw.country_code) {
						return {
							city: raw.city,
							country: raw.country_code,
							country_name: raw.country,
						};
					}

					return null;
				}

				let data = null;
				try {
					const res = await fetchWithTimeout('https://ipapi.co/json/');
					if (res.ok) {
						data = normalizeGeoData(await res.json());
					}
				} catch {
					try {
						const res = await fetchWithTimeout('https://ipwho.is/');
						if (res.ok) {
							data = normalizeGeoData(await res.json());
						}
					} catch {}
				}

				if (data) {
					window.kurieros_user = data;
					window.dispatchEvent(new CustomEvent('kurieros:region-detected', { detail: data }));
				}
			})();
		</script>
		<script is:inline define:vars={{ translations, supportedLanguages, vacancyTranslationsBase, vacancyTranslationsVersion }}>
			// Global i18n Manager
				(function() {
					const STORAGE_KEY = 'site-lang';
					const DEFAULT_LANG = 'ru';
					const SUPPORTED_LANGS = supportedLanguages;
					const VACANCY_TRANSLATIONS_BASE = vacancyTranslationsBase;
					const VACANCY_TRANSLATIONS_VERSION = vacancyTranslationsVersion;
					// Safari Private Browsing + restricted WKWebViews throw a
					// SecurityError on any localStorage access. Wrap reads/writes
					// so the i18n manager still initializes (falls back to system
					// language detection) instead of crashing the whole IIFE.
					const safeStorage = {
						get(key) { try { return localStorage.getItem(key); } catch (_) { return null; } },
						set(key, value) { try { localStorage.setItem(key, value); } catch (_) { /* ignore */ } },
					};
					// TRANS-1: track loaded (lang, sourceSlug) pairs instead of whole languages.
					// SSG = full-page navigation = `loadedFragments` resets on every page,
					// so each navigation re-pays the JSON.parse + Object.assign merge cost
					// (16-fragment Moscow listing measured ~19MB raw in Phase 2). Persist
					// each parsed fragment in sessionStorage keyed by build version so
					// repeat visits in the same tab skip the parse + the Object.assign.
					const loadedFragments = new Set();
					const SESSION_KEY_PREFIX = 'kurieros_vt_';

					function sessionKey(lang, sourceSlug) {
						return SESSION_KEY_PREFIX + lang + '/' + sourceSlug + '/' + VACANCY_TRANSLATIONS_VERSION;
					}

					function loadFragmentFromSession(lang, sourceSlug) {
						try {
							const raw = sessionStorage.getItem(sessionKey(lang, sourceSlug));
							if (!raw) return null;
							return JSON.parse(raw);
						} catch (_) {
							return null;
						}
					}

					function storeFragmentInSession(lang, sourceSlug, fragment) {
						try {
							sessionStorage.setItem(sessionKey(lang, sourceSlug), JSON.stringify(fragment));
						} catch (_) {
							// QuotaExceededError or SecurityError (Safari Private Browsing,
							// restricted WKWebViews) — skip persistence and let the next
							// page navigation refetch via the HTTP cache. The HTTP layer
							// (force-cache + ?v=<build>) already prevents network hits.
						}
					}

					// One-time per-build cleanup: drop any sessionStorage entries
					// from prior build versions so quota usage doesn't bloat across
					// deploys. The IIFE runs on every full-page navigation (SSG +
					// no SPA shell), but the cleanup loop should only do work once
					// per build version per tab. A sentinel key records the build
					// version we already cleaned for; subsequent navigations within
					// the same build short-circuit the linear scan over every
					// sessionStorage entry.
					const CLEANUP_SENTINEL_KEY = SESSION_KEY_PREFIX + '__cleanup_for__';
					try {
						const lastCleanedVersion = sessionStorage.getItem(CLEANUP_SENTINEL_KEY);
						if (lastCleanedVersion !== VACANCY_TRANSLATIONS_VERSION) {
							const currentSuffix = '/' + VACANCY_TRANSLATIONS_VERSION;
							for (let i = sessionStorage.length - 1; i >= 0; i--) {
								const key = sessionStorage.key(i);
								if (key && key.indexOf(SESSION_KEY_PREFIX) === 0
									&& key !== CLEANUP_SENTINEL_KEY
									&& !key.endsWith(currentSuffix)) {
									sessionStorage.removeItem(key);
								}
							}
							sessionStorage.setItem(CLEANUP_SENTINEL_KEY, VACANCY_TRANSLATIONS_VERSION);
						}
					} catch (_) { /* sessionStorage unavailable — nothing to clean */ }

					window.translations = translations;
					
					function getSafeLang(lang) {
						return SUPPORTED_LANGS.includes(lang) ? lang : DEFAULT_LANG;
					}

					function detectSystemLanguage() {
						const candidates = [];
						if (Array.isArray(navigator.languages)) {
							candidates.push(...navigator.languages);
						}
						if (navigator.language) {
							candidates.push(navigator.language);
						}

						for (const locale of candidates) {
							if (!locale || typeof locale !== 'string') continue;
							const normalizedLocale = locale.trim().toLowerCase();
							if (!normalizedLocale) continue;

							const fullMatch = getSafeLang(normalizedLocale);
							if (fullMatch === normalizedLocale) {
								return fullMatch;
							}

							const baseLang = normalizedLocale.split(/[-_]/)[0];
							const safeBase = getSafeLang(baseLang);
							if (safeBase === baseLang) {
								return safeBase;
							}
						}

						return DEFAULT_LANG;
					}

				function pageHasVacancyTranslationKeys() {
					return Boolean(document.querySelector('[data-t^="vacancies."]'));
				}

				// TRANS-1: collect distinct source slugs from cards/hero on the
				// current page. Each card and the detail-page hero carries
				// `data-vacancy-source-slug` (set in JobCard.astro and v/[slug].astro).
				function getVisibleVacancySourceSlugs() {
					const nodes = document.querySelectorAll('[data-vacancy-source-slug]');
					const slugs = new Set();
					nodes.forEach((node) => {
						const slug = node.dataset.vacancySourceSlug;
						if (slug) slugs.add(slug);
					});
					return Array.from(slugs);
				}

				// M1: fragments are emitted in compact format `{ defaults, entries }`.
				// `defaults` holds fields that are byte-identical across every entry
				// of a source × language (typical: company, requirements, benefits,
				// docs, most details_* — ~35 of 46 fields). `entries[jobId]` only
				// carries the fields that genuinely vary per (city, transport):
				// page_title, title, salary, location, updated_date, details_schedule.
				// Expand back into the flat `{ jobId: {...allFields} }` shape the
				// runtime merger and downstream `applyTranslations` lookups expect.
				function expandFragment(fragment) {
					if (!fragment || typeof fragment !== 'object') return {};
					// Defensive: if the fragment has neither `entries` nor `defaults`
					// but does have other keys, it's an unexpected shape (schema
					// drift, partial deploy, or a stale CDN-cached payload). Warn
					// so the issue surfaces in console rather than silently
					// returning an empty object and skipping all translations.
					if (!('entries' in fragment) && !('defaults' in fragment)
						&& Object.keys(fragment).length > 0) {
						console.warn('[i18n] expandFragment: unexpected fragment shape',
							Object.keys(fragment).slice(0, 3));
					}
					const defaults = fragment.defaults || {};
					const entries = fragment.entries || {};
					const expanded = {};
					for (const id in entries) {
						if (Object.prototype.hasOwnProperty.call(entries, id)) {
							expanded[id] = Object.assign({}, defaults, entries[id]);
						}
					}
					return expanded;
				}

				async function fetchFragment(lang, sourceSlug) {
					const cacheKey = lang + '/' + sourceSlug;
					if (loadedFragments.has(cacheKey)) return null;
					// SessionStorage check first — survives full-page navigation
					// (BFCache miss) within the same tab, so a returning visitor
					// pays neither the network roundtrip nor the JSON.parse cost
					// for already-seen fragments. Versioned key (suffix `/<build>`)
					// means a redeploy invalidates every entry naturally; combined
					// with the one-time cleanup at IIFE start, stale entries do
					// not pile up across deploys.
					const sessionFragment = loadFragmentFromSession(lang, sourceSlug);
					if (sessionFragment) {
						loadedFragments.add(cacheKey);
						return sessionFragment;
					}
					// Immutable-asset cache pattern: each URL carries the build-time
					// `?v=<vacancyTranslationsVersion>` query, and `cache: 'force-cache'`
					// tells the browser to serve the disk cache for any URL it has
					// already seen — zero network roundtrip on subsequent visits within
					// the same build. A redeploy mints a new version, producing fresh
					// URLs → cache miss → re-download once → cached again until the
					// next deploy.
					const url = VACANCY_TRANSLATIONS_BASE + '/' + lang + '/' + sourceSlug + '.json?v=' + VACANCY_TRANSLATIONS_VERSION;
					try {
						const response = await fetch(url, { cache: 'force-cache' });
						if (!response.ok) {
							// 4xx is persistent (missing fragment, bad slug) — mark loaded
							// so we never re-request the same URL from this session and
							// avoid a self-DoS retry storm on every language switch.
							// 5xx may be transient (origin/CDN hiccup) — leave uncached
							// so the next applyTranslations() can retry.
							if (response.status >= 400 && response.status < 500) {
								loadedFragments.add(cacheKey);
							}
							window.dispatchEvent(new CustomEvent('kurieros:fragment-load-failed', {
								detail: { lang, sourceSlug, status: response.status, url },
							}));
							return null;
						}
						const fragment = await response.json();
						loadedFragments.add(cacheKey);
						storeFragmentInSession(lang, sourceSlug, fragment);
						return fragment;
					} catch (error) {
						window.dispatchEvent(new CustomEvent('kurieros:fragment-load-failed', {
							detail: { lang, sourceSlug, error: String(error), url },
						}));
						console.warn('Failed to load vacancy translations fragment', lang, sourceSlug, error);
						return null;
					}
				}

				// Loads every per-source vacancy-translation fragment visible on
				// the current page for `lang`, falls back to the RU shell dict
				// for non-RU slots, expands the compact `{ defaults, entries }`
				// fragment shape, and merges the result into
				// `translations[lang].vacancies`. No-op for RU and for pages
				// with no vacancy keys. Exposed verbatim on the i18n manager as
				// `window.kurieros_i18n.ensureVacancyTranslations` below.
				async function ensureVacancyTranslations(lang) {
					if (lang === DEFAULT_LANG || !pageHasVacancyTranslationKeys()) {
						return;
					}
					const slugs = getVisibleVacancySourceSlugs();
					if (slugs.length === 0) return;

					const fragments = await Promise.all(
						slugs.map((slug) => fetchFragment(lang, slug)),
					);

					// M2: shell-UI dict is RU-only, so non-RU lang slots start
					// empty — fall back to the RU shell dict so translated entries
					// merge atop the same baseline.
					// L6: when falling back to RU, deep-clone so nested objects
					// (e.g. `vacancies.<id>`) are not aliased across `translations.ru`
					// and `translations[lang]`. Without the clone, a later
					// `Object.assign(merged, ...)` could mutate RU entries via a
					// shared reference.
					const langDictionary = translations[lang]
						? translations[lang]
						: structuredClone(translations[DEFAULT_LANG] ?? {});
					const currentVacancies = langDictionary.vacancies || {};
					const merged = { ...currentVacancies };
					for (const fragment of fragments) {
						if (!fragment) continue;
						// M1: compact-format fragments need expansion before merge.
						// `expandFragment` materializes each entry as
						// `{ ...defaults, ...entries[id] }` so the downstream
						// `applyTranslations` lookup (`vacancies.<jobId>.<field>`)
						// works against the same flat shape it always has.
						Object.assign(merged, expandFragment(fragment));
					}
					translations[lang] = {
						...langDictionary,
						vacancies: merged,
					};
				}

				function getNestedValue(obj, path) {
					return path.split('.').reduce((prev, curr) => prev && prev[curr], obj);
				}

				function cacheOriginalTranslations() {
					const elements = document.querySelectorAll('[data-t]');
					const contentElements = document.querySelectorAll('[data-t-content]');
					const titleElement = document.querySelector('[data-t-title]');

					elements.forEach((el) => {
						if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
							if (el.dataset.tOriginalPlaceholder === undefined) {
								el.dataset.tOriginalPlaceholder = el.placeholder || '';
							}
							return;
						}

						if (el.dataset.tOriginalText === undefined) {
							el.dataset.tOriginalText = el.textContent || '';
						}
					});

					contentElements.forEach((el) => {
						if (el.dataset.tOriginalContent === undefined) {
							el.dataset.tOriginalContent = el.getAttribute('content') || '';
						}
					});

					if (titleElement && titleElement.dataset.tOriginalTitle === undefined) {
						titleElement.dataset.tOriginalTitle = titleElement.textContent || document.title || '';
					}
				}

					const savedLang = safeStorage.get(STORAGE_KEY);
					const initialLang = getSafeLang(savedLang || detectSystemLanguage());
					if (savedLang !== initialLang) {
						safeStorage.set(STORAGE_KEY, initialLang);
					}

				window.kurieros_i18n = {
					currentLang: initialLang,
					ensureVacancyTranslations,
					
					async setLanguage(lang) {
						lang = getSafeLang(lang);
						this.currentLang = lang;
						safeStorage.set(STORAGE_KEY, lang);
						await this.ensureVacancyTranslations(lang);
						// Guard against rapid double-clicks: a later setLanguage call may
						// have updated `currentLang` while we awaited fragment loading.
						// Without this check, an earlier-completing fetch (e.g. RU→UZ→TG
						// where UZ resolves first) would call applyTranslations() against
						// the now-current TG dictionary using UZ fragment data → wrong
						// language renders. The later call's own await will handle apply.
						if (this.currentLang !== lang) return;
						this.applyTranslations();
						window.dispatchEvent(new CustomEvent('kurieros:lang-change', { detail: { lang } }));
					},

					applyTranslations() {
						cacheOriginalTranslations();
						const elements = document.querySelectorAll('[data-t]');
						const contentElements = document.querySelectorAll('[data-t-content]');
						const titleElement = document.querySelector('[data-t-title]');
						const lang = getSafeLang(this.currentLang);
						const langData = translations[lang] || translations[DEFAULT_LANG];
						
						elements.forEach((el) => {
							const key = el.getAttribute('data-t');
							if (!key) {
								return;
							}

							const translation = getNestedValue(langData, key);
							const defaultTranslation = getNestedValue(translations[DEFAULT_LANG], key);

							if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
								const fallback = defaultTranslation ?? el.dataset.tOriginalPlaceholder ?? '';
								const nextValue = translation ?? fallback;
								el.placeholder = nextValue;
								return;
							}

							const fallback = defaultTranslation ?? el.dataset.tOriginalText ?? '';
							const nextValue = translation ?? fallback;
							el.textContent = nextValue;
						});

						contentElements.forEach((el) => {
							const key = el.getAttribute('data-t-content');
							if (!key) {
								return;
							}

							const translation = getNestedValue(langData, key);
							const defaultTranslation = getNestedValue(translations[DEFAULT_LANG], key);
							const fallback = defaultTranslation ?? el.dataset.tOriginalContent ?? '';
							const nextValue = translation ?? fallback;
							el.setAttribute('content', nextValue);
						});

						if (titleElement) {
							const key = titleElement.getAttribute('data-t-title');
							const translation = key ? getNestedValue(langData, key) : undefined;
							const defaultTranslation = key ? getNestedValue(translations[DEFAULT_LANG], key) : undefined;
							const fallback = defaultTranslation ?? titleElement.dataset.tOriginalTitle ?? document.title;
							const nextValue = translation ?? fallback;
							titleElement.textContent = nextValue;
							document.title = nextValue;
						}
						
						document.documentElement.setAttribute('lang', lang);
					}
				};

				document.addEventListener('DOMContentLoaded', async () => {
					await window.kurieros_i18n.ensureVacancyTranslations(window.kurieros_i18n.currentLang);
					window.kurieros_i18n.applyTranslations();
				});
				
			})();
		</script>
	</body>
</html>
