---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Logo from '../../components/Logo.astro';

const title = 'Загрузка перехода — КурьерОк';
const description = 'КурьерОк перенаправляет на страницу работодателя.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={new URL('/apply/', Astro.site)}
  robots="noindex, nofollow, noarchive"
  includeRegionModal={false}
  includeOzonLeadModal={false}
>
  <main class="apply-shell" id="apply-page">
    <section class="apply-panel" aria-labelledby="apply-title">
      <Logo size="lg" />
      <h1 class="apply-title" id="apply-title">Загрузка перехода</h1>

      <div class="apply-state" id="apply-loading" role="status" aria-live="polite">
        <span class="apply-spinner" aria-hidden="true"></span>
      </div>

      <div class="apply-state apply-error" id="apply-error" role="alert" hidden>
        <h2 id="apply-error-title">Не нашли переход</h2>
        <p id="apply-error-text">Попробуйте выбрать вакансию ещё раз.</p>
        <a class="apply-submit apply-submit-secondary" href="/">На главную</a>
      </div>

      <div class="apply-state apply-redirect-card" id="apply-job" hidden>
        <span class="apply-spinner" aria-hidden="true"></span>

        <div class="apply-progress" aria-hidden="true">
          <span id="apply-progress-bar"></span>
        </div>

        <p class="sr-only" id="apply-status" role="status" aria-live="polite"></p>
        <a
          class="apply-submit"
          id="apply-direct-link"
          href="#"
          rel="nofollow sponsored"
          hidden
        >
          Перейти сейчас
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import '../../scripts/applyRedirect';
</script>

<style>
  .apply-shell {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(2rem, 8vh, 5rem) 1.25rem;
    background: var(--ink-50);
  }

  .apply-panel {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    width: min(100%, 360px);
    text-align: center;
  }

  .apply-panel :global(.kurerok-logo) {
    letter-spacing: 0;
  }

  .apply-title {
    margin: 0;
    color: var(--ink-900);
    font-size: var(--fs-20);
    font-weight: 900;
    line-height: var(--lh-20);
    letter-spacing: 0;
  }

  .apply-state,
  .apply-redirect-card {
    width: 100%;
    min-width: 0;
  }

  .apply-state[hidden],
  .apply-redirect-card[hidden],
  .apply-submit[hidden] {
    display: none !important;
  }

  .apply-state {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    min-height: 168px;
  }

  .apply-spinner {
    width: 42px;
    height: 42px;
    border: 3px solid var(--ink-200);
    border-top-color: var(--brand-700);
    border-radius: 50%;
    animation: apply-spin 0.85s linear infinite;
  }

  .apply-error h2 {
    margin: 0;
    color: var(--ink-900);
    font-size: var(--fs-18);
    font-weight: 900;
    line-height: var(--lh-18);
    letter-spacing: 0;
  }

  .apply-error {
    display: grid;
    gap: var(--space-3);
  }

  .apply-error p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-14);
    line-height: 1.5;
  }

  .apply-progress {
    overflow: hidden;
    width: min(100%, 260px);
    height: 4px;
    border-radius: var(--radius-pill);
    background: var(--ink-200);
  }

  .apply-progress span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--brand-700);
  }

  .apply-progress span.is-running {
    animation: apply-progress 4s linear forwards;
  }

  .apply-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 176px;
    min-height: 48px;
    padding: 0 1.1rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: var(--brand-700);
    color: var(--ink-0);
    font: inherit;
    font-weight: 900;
    cursor: pointer;
    text-decoration: none;
    letter-spacing: 0;
  }

  .apply-submit:hover,
  .apply-submit:focus-visible {
    background: var(--brand-600);
    outline: none;
  }

  .apply-submit-secondary {
    background: var(--ink-900);
  }

  .apply-submit-secondary:hover,
  .apply-submit-secondary:focus-visible {
    background: var(--ink-700);
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    white-space: nowrap;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
  }

  @keyframes apply-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes apply-progress {
    to {
      width: 100%;
    }
  }

  @media (max-width: 760px) {
    .apply-shell {
      align-items: center;
      padding-inline: 1rem;
    }

    .apply-panel {
      width: min(100%, 320px);
    }
  }
</style>
