	}
	:global(body.dark-mode) .home-navigation-card span {
		color: #94a3b8;
	}
	:global(body.dark-mode) .home-navigation-card p,
	:global(body.dark-mode) .section-heading p {
		color: var(--text-muted);
	}
	:global(body.dark-mode) .home-chip-link {
		background: rgba(67, 77, 90, 0.78);
		border-color: rgba(195, 204, 216, 0.28);
		color: var(--text-main);
	}
	:global(body.dark-mode) .home-chip-link:hover {
		background: rgba(79, 91, 105, 0.94);
		border-color: rgba(52, 211, 153, 0.5);
		box-shadow: 0 10px 24px rgba(15, 23, 42, 0.3);
