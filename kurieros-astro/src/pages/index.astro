		border-color: rgba(195, 204, 216, 0.18);
		color: rgba(231, 234, 240, 0.85);
	}
	:global(:where(html, body).dark-mode) .hero-v2-title {
		color: #e7eaf0;
	}
	:global(:where(html, body).dark-mode) .hero-v2-title-accent {
		color: #4caf80;
	}
	:global(:where(html, body).dark-mode) .hero-v2-title-accent::after {
		background: rgba(76, 175, 128, 0.22);
	}
	:global(:where(html, body).dark-mode) .hero-v2-lead {
		color: rgba(231, 234, 240, 0.78);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature {
		background: rgba(20, 32, 48, 0.7);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature:hover {
		border-color: rgba(76, 175, 128, 0.6);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature-title {
		color: #e7eaf0;
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature-text {
		color: rgba(231, 234, 240, 0.6);
	}
	:global(:where(html, body).dark-mode) .hero-v2-cta-secondary {
		background: rgba(20, 32, 48, 0.7);
		color: #e7eaf0;
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .hero-v2-cta-secondary:hover,
	:global(:where(html, body).dark-mode) .hero-v2-cta-secondary:focus-visible {
		background: rgba(20, 32, 48, 0.9);
		border-color: rgba(76, 175, 128, 0.6);
	}
	:global(:where(html, body).dark-mode) .hero-v2-trust-label {
		color: rgba(231, 234, 240, 0.55);
	}
	:global(:where(html, body).dark-mode) .hero-v2-trust-num {
		color: #e7eaf0;
	}
	:global(:where(html, body).dark-mode) .hero-v2-trust-sep {
		color: rgba(231, 234, 240, 0.3);
	}

	/* === ATF compression for .hero-v2 (≥768px) ==========================
	 * Goal: keep hero from pushing the JobGrid below the fold on a 1080×900
	 * desktop viewport. Header (~72px) + toolbar (~80px sticky) + hero
	 * (~700px before compression) = ~850px → no vacancies visible above
	 * fold. After compression: hero ~450-490px → 1-2 JobCards visible.
	 *
	 * Mobile (<768px) keeps the more spacious layout — vertical real
	 * estate is less precious there and the larger H1 is good for the
	 * "first impression" on a narrow phone screen.
	 *
	 * Trade-offs:
	 *   • Title cap drops 3.5rem → 2.4rem (still feels like a hero,
	 *     not a sentence — passes editorial test).
	 *   • Padding tightened ~33% top/bottom.
	 *   • Features grid forced to 4 columns ≥1024px so the four
	 *     cards land in one row instead of wrapping to two.
	 *   • CTA buttons drop 52px → 44px (still WCAG touch-safe).
	 *   • Inter-block gaps ~30% smaller.
	 */
	@media (min-width: 768px) {
		.hero-v2 {
			padding: clamp(1rem, 2vw, 1.6rem) clamp(1.1rem, 2.4vw, 1.85rem);
			margin-bottom: var(--space-4, 1rem);
		}
		.hero-v2-inner {
			gap: clamp(0.55rem, 1.1vw, 0.85rem);
		}
		.hero-v2-title {
			font-size: clamp(1.65rem, 3.4vw, 2.4rem);
			line-height: 1.08;
		}
		.hero-v2-lead {
			font-size: clamp(0.92rem, 1.1vw, 1.02rem);
			line-height: 1.45;
		}
		.hero-v2-features {
			margin-top: 0;
			gap: 0.5rem;
		}
		.hero-v2-feature {
			padding: 0.6rem 0.8rem;
		}
		.hero-v2-feature-icon {
			font-size: 1.25rem;
		}
		.hero-v2-feature-title {
			font-size: 0.88rem;
		}
		.hero-v2-feature-text {
			font-size: 0.76rem;
			line-height: 1.3;
		}
		.hero-v2-cta-primary,
		.hero-v2-cta-secondary {
			min-height: 44px;
			padding: 0 1.25rem;
			font-size: 0.95rem;
		}
		.hero-v2-trustbar {
			margin-top: 0.2rem;
		}
		.hero-v2-eyebrow {
			padding: 0.3rem 0.75rem;
			font-size: 0.72rem;
		}
	}

	/* Force 4-column features row on wider desktops so they don't wrap. */
	@media (min-width: 1024px) {
		.hero-v2-features {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	/* Mobile for .hero-v2 */
	@media (max-width: 600px) {
		.hero-v2 {
			padding: 1.4rem 1.1rem;
		}
		.hero-v2-features {
			grid-template-columns: 1fr 1fr;
		}
		.hero-v2-cta-primary,
		.hero-v2-cta-secondary {
			width: 100%;
		}
		.hero-v2-trustbar {
			gap: 0.4rem 0.5rem;
		}
	}
	@media (max-width: 400px) {
		.hero-v2-features {
			grid-template-columns: 1fr;
		}
	}

	.home-section {
		padding: 2.25rem;
		margin: 1.5rem auto;
		max-width: 1560px;
		width: 100%;
		background: #ffffff;
		border: 1px solid #dfe7dd;
		border-radius: 8px;
		box-shadow: 0 8px 24px rgba(24, 45, 34, 0.04);
	}
	.home-vacancy-launch {
		margin: 0 auto 0.65rem;
		padding: 0.75rem 1rem;
	}
	.home-filter-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
		align-items: center;
	}
	.home-filter-select {
		width: 100%;
		height: 44px;
		padding: 0 14px;
		border-radius: 12px;
		border: 1px solid #d4dae3;
		/* Pure white so the pill stands out against the cream hero bg
		   instead of blending into it like surface-100 does. */
		background: #ffffff;
		color: var(--ink-900, #0f172a);
		font-size: 15px;
		font-family: inherit;
		font-weight: 500;
		cursor: pointer;
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.home-filter-select:hover {
		border-color: var(--brand-700);
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
	}
	.home-filter-select:focus-visible {
		outline: none;
		border-color: var(--brand-700);
		box-shadow: 0 0 0 3px rgba(22, 115, 76, 0.18);
	}
	.home-discovery-section {
		display: grid;
		gap: 1.5rem;
	}

	/* --- Hero Toolbar --- */
	.hero-toolbar {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0;
		margin-bottom: 0;
		width: 100%;
		/* Match the hero panel & job grid container width — was capped
		   at 1000px / toolbar-top at 640px which left big empty margins. */
		max-width: none;
	}
	.hero-toolbar-only {
		padding: 0;
	}
	.toolbar-top {
		display: flex;
		gap: 12px;
		width: 100%;
		max-width: none;
		margin: 0;
		align-items: flex-end;
	}
	.city-selector-container {
		display: flex;
		align-items: center;
		padding: 0 14px;
		background: #ffffff;
		border: 1px solid #d4dae3;
		font-size: 15px;
		flex: 1;
		height: 44px;
		box-sizing: border-box;
		border-radius: 12px;
		cursor: pointer;
		position: relative;
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.city-selector-container:hover {
		border-color: var(--brand-700);
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
	}
	.city-selector-container:focus-within {
		border-color: var(--brand-700);
		box-shadow: 0 0 0 3px rgba(22, 115, 76, 0.18);
	}
	.city-selector-container::after {
		content: '▼';
		position: absolute;
		right: 14px;
		font-size: 0.7rem;
		color: var(--ink-500, #6c7785);
		pointer-events: none;
	}
	.hero-lang-switcher {
		flex: 0 0 7rem;
		min-width: 0;
	}
	.hero-lang-switcher :global(.lang-toggle) {
		width: 100%;
		min-height: 44px;
		height: 44px;
		background: #ffffff;
		border: 1px solid #d4dae3;
		border-radius: 12px;
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
		font-size: 15px;
		font-weight: 600;
		transition: border-color 0.15s, box-shadow 0.15s;
	}
	.hero-lang-switcher :global(.lang-toggle:hover),
	.hero-lang-switcher :global(.lang-toggle:focus-visible) {
		border-color: var(--brand-700);
		background: #ffffff;
		box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
	}
	/* --- City Select & Icon --- */
	.city-icon {
		position: absolute;
		left: 14px;
		color: var(--ink-500, #6c7785);
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		pointer-events: none;
		z-index: 2;
	}
	.city-select {
		width: 100%;
		border: none;
		background: transparent;
		appearance: none;
		font: inherit;
		font-size: 15px !important;
		font-weight: 500 !important;
		color: var(--ink-900, #0f172a);
		padding: 0 36px;
		outline: none;
		text-align: left;
		text-align-last: left;
		cursor: pointer;
	}

	/* --- Hero CTA Button --- */
	.hero-city-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 0.25rem;
		padding: 0 2.5rem;
		height: 4.8rem;
		box-sizing: border-box;
		border-radius: 8px;
		border: 1px solid #163d2b;
		background: #163d2b;
		color: #fff;
		text-decoration: none;
		font-size: 1.2rem;
		line-height: 1.2;
		transition: var(--transition);
		width: 100%;
	}
	.hero-city-link:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 24px rgba(22, 61, 43, 0.12);
	}

	/* --- Content Sections --- */
	.section-heading {
		margin-bottom: 1.1rem;
	}
	.section-heading h2 {
		margin-bottom: 0.35rem;
		letter-spacing: 0;
	}
	.section-heading p {
		color: #51635c;
	}
	:global(.reviews-section),
	:global(.faq-section) {
		border: none !important;
		background: transparent !important;
		box-shadow: none !important;
		padding: 0 !important;
	}
	:global(.review-card),
	:global(.faq-item) {
		background: var(--surface-color) !important;
		border: 1px solid var(--border-color) !important;
		border-radius: 8px !important;
		box-shadow: 0 4px 12px rgba(24, 45, 34, 0.03) !important;
	}
	.home-navigation-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}
	.home-navigation-card {
		display: grid;
		gap: 0.55rem;
		padding: 1.25rem;
		border-radius: 8px;
		border: 1px solid #dfe7dd;
		background: linear-gradient(180deg, #ffffff 0%, #f7fbf8 100%);
		box-shadow: 0 6px 18px rgba(24, 45, 34, 0.04);
		text-decoration: none;
		color: #1d2b24;
		transition: var(--transition);
	}
	.home-navigation-card-route {
		background: linear-gradient(180deg, #ffffff 0%, #eff8f4 100%);
	}
	.home-navigation-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(24, 45, 34, 0.08);
	}
	.home-navigation-card span,
	.home-navigation-card h3,
	.home-navigation-card p {
		margin: 0;
	}
	.home-navigation-card span {
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: #61746b;
	}
	.home-navigation-card h3 {
		font-size: 1rem;
	}
	.home-navigation-card p {
		color: #51635c;
		line-height: 1.6;
	}
	.home-surface-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.home-surface-card {
		padding: 1.35rem;
		border-radius: 8px;
		border: 1px solid #dfe7dd;
		background: linear-gradient(180deg, #ffffff 0%, #f7fbf8 100%);
		box-shadow: 0 6px 18px rgba(24, 45, 34, 0.04);
	}
	.home-surface-card h3 {
		margin: 0 0 0.8rem;
		font-size: 1rem;
	}
	.home-chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
	}
	.home-chip-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.35rem;
		padding: 0.55rem 0.85rem;
		border-radius: 8px;
		border: 1px solid #c9dccf;
		background: #ffffff;
		color: #1d2b24;
		font-weight: 700;
		text-decoration: none;
		transition: var(--transition);
	}
	.home-chip-link:hover {
		transform: translateY(-1px);
		box-shadow: 0 8px 18px rgba(24, 45, 34, 0.07);
	}

	/* --- Dark Mode --- */
