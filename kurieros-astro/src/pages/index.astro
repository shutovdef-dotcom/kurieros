---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobGrid from '../components/JobGrid.astro';
import IncomeCalculator from '../components/IncomeCalculator.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import PartnerBanner from '../components/PartnerBanner.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import HomeGeoBanner from '../components/home/HomeGeoBanner.astro';
import HomeToolbar from '../components/home/HomeToolbar.astro';
import jobsData from '../data/jobs';
import { getCompaniesFromJobs } from '../utils/companies';
import { sortCityNamesByPopulation } from '../utils/cities';
// City catalogue + names are module-cached in `citiesIndex.ts` (H3
// rationale) instead of re-derived per render (audit ref v4 MEDIUM-1).
import { citiesFromJobs, cityNamesFromJobs } from '../utils/citiesIndex';
import { TOPIC_META, knowledgeBaseData } from '../utils/knowledge';

const cities = citiesFromJobs;
const availableCities = sortCityNamesByPopulation(cityNamesFromJobs);
// `cityRouteMap` used to live here as well and be threaded into the
// inline `define:vars`. After H13 it's served from
// `/api/city-index.json` (see `src/pages/api/city-index.json.ts`) and
// fetched lazily by the home script — no need to inline ~38 KB into
// every render of `dist/index.html`.
const companies = getCompaniesFromJobs(jobsData);
const totalVacancies = jobsData.length;
const FEATURED_KB_IDS = [
	'age-min-courier',
	'income-foot-courier-msk',
	'income-bike-courier-msk',
	'medical-book',
	'self-employed-registration',
	'find-courier-job',
	'training-period',
	'winter-equipment',
];
const featuredKbItems = FEATURED_KB_IDS
	.map((id) => knowledgeBaseData.items.find((entry) => entry.id === id))
	.filter((entry): entry is NonNullable<typeof entry> => Boolean(entry))
	.map((entry) => {
		const topicMeta = TOPIC_META[entry.topic];
		return {
			id: entry.id,
			question: entry.question,
			answer_short: entry.answer_short,
			topicSlug: topicMeta?.slug ?? '',
			topicTitle: topicMeta?.title ?? entry.topic,
		};
	});
const faqItems = featuredKbItems.map((item) => ({
	question: item.question,
	answer: item.answer_short,
}));
const hubLinks = [
	{
		href: '/compare/',
		title: 'Сравнение вакансий',
		text: 'Поставить рядом зарплату, выплаты, транспорт и оформление.',
	},
	{
		href: '/companies/',
		title: 'Компании',
		text: 'Посмотреть, чем отличаются сервисы доставки и банки.',
	},
	{
		href: '/cities/',
		title: 'Города',
		text: 'Найти вакансии в своём городе без лишнего списка.',
	},
	{
		href: '/guide/',
		title: 'Гид для курьера',
		text: 'Возраст, медкнижка, доход, выплаты, штрафы — структурированно.',
	},
	// /blog/ discovery card hidden until first article ships.
];
const homepageTitle = `Работа курьером 2026: ${totalVacancies} вакансий, ${companies.length} компаний | КурьерОк`.slice(0, 70);
const homepageDescription = `Работа курьером в России 2026: ${totalVacancies} активных вакансий, ${companies.length} компаний, ${cities.length} городов. Доход, выплаты, оформление — всё в одном месте.`.slice(0, 170);
const pageSchemaGraph = [
	{
		'@type': 'CollectionPage',
		name: homepageTitle,
		description: homepageDescription,
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: hubLinks.map((link, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: link.title,
				url: new URL(link.href, Astro.site).toString(),
			})),
		},
	},
	{
		'@type': 'Organization',
		name: 'КурьерОк',
		url: Astro.site,
		description: 'Каталог вакансий курьеров, компаний, городов и практических разборов для спокойного выбора работы.',
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<BaseLayout title={homepageTitle} description={homepageDescription} schemaGraph={pageSchemaGraph}>
	<Header />

	<main>
		<div class="home-shell">
			<HomeHero
				totalVacancies={totalVacancies}
				companiesCount={companies.length}
				citiesCount={cities.length}
			/>

			<HomeToolbar availableCities={availableCities} />

			<JobGrid limit={24} moreHref="/cities/" moreLabel="Открыть все города" />

			<IncomeCalculator />

			<ReviewsBlock />

			<HomeFaq items={featuredKbItems} />

			<PartnerBanner />
		</div>
		<HomeGeoBanner />
	</main>

	<Footer />
</BaseLayout>

<script is:inline>
	// Homepage city-selector / geo-banner script.
	//
	// TWIN NOTICE: the city-resolution helpers below (`safeStorage`,
	// `getFallbackCity`, `normalizeDetectedCity`, `getTzCity`,
	// `TZ_TO_CITY`, the `STORAGE_KEY` / `GEO_BANNER_DISMISSED_KEY`
	// literals) are a hand-maintained inline copy of the canonical,
	// test-covered module `src/scripts/homeCity.js`. This `<script>` is
	// `is:inline` and cannot `import`, so the copy is unavoidable. Any
	// edit here MUST be mirrored into `homeCity.js` (and vice versa).
	// `tests/homeCityParity.test.ts` is the drift-guard: it fails CI when
	// the load-bearing constants (TZ map, the two storage keys, Moscow
	// aliases, default city) diverge AND when the resolution-function
	// bodies drift — it pins the load-bearing algorithmic substrings of
	// each twin (audit v5 M11). Still mirror behavioural edits by hand;
	// the guard catches a forgotten mirror, it does not perform one.
	//
	// `availableCities` (972 strings) and `cityRouteMap` (958 entries) used
	// to be inlined via `define:vars`, costing ~49 KB raw / ~6 KB gzip in
	// every render of `dist/index.html`. They're now served as a static
	// JSON fragment under `/api/city-index.json` (see
	// `src/pages/api/city-index.json.ts`) and fetched lazily with
	// `force-cache`.
	//
	// Strategy B (H13): the fetch is fired immediately on script parse
	// (well before DOMContentLoaded) so the data is usually already
	// resolved by the time we need it. Inside the DOMContentLoaded
	// callback we `await` the promise before touching the city flow.
	// The toolbar `<select>` is server-rendered with all options, so
	// manual selection still works even if the fetch is in flight or
	// fails — only the auto-detect / saved-city / city-page-link
	// enhancements are gated on the data being available.
	(function () {
		let availableCities = [];
		let cityRouteMap = {};

		const cityIndexReady = fetch('/api/city-index.json', { cache: 'force-cache' })
			.then((response) => {
				if (!response.ok) throw new Error('city-index fetch failed: ' + response.status);
				return response.json();
			})
			.then((data) => {
				if (data && Array.isArray(data.availableCities)) {
					availableCities = data.availableCities;
				}
				if (data && data.cityRouteMap && typeof data.cityRouteMap === 'object') {
					cityRouteMap = data.cityRouteMap;
				}
			})
			.catch(() => {
				// Network / fetch failure: degrade gracefully. The SSR
				// <select> still works for manual selection, but
				// auto-detect / saved-city / city-page-link enhancements
				// are no-ops because the lookup tables stay empty.
			});

		document.addEventListener('DOMContentLoaded', async () => {
			const STORAGE_KEY = 'kurieros-selected-city';
			const DEFAULT_CITY = 'Москва';
			// Safari Private Browsing + restricted WKWebViews throw a SecurityError
			// on any localStorage access. Wrap reads/writes so the whole
			// DOMContentLoaded callback survives instead of aborting. Pattern
			// matches the `safeStorage` object in `BaseLayout.astro` (audit v2 C1).
			const safeStorage = {
				get(key) { try { return localStorage.getItem(key); } catch (_) { return null; } },
				set(key, value) { try { localStorage.setItem(key, value); } catch (_) { /* ignore */ } },
				remove(key) { try { localStorage.removeItem(key); } catch (_) { /* ignore */ } },
			};
			const citySelect = document.getElementById('city-select');
			const cityPageLink = document.getElementById('city-page-link');

			function getFallbackCity() {
				if (availableCities.includes(DEFAULT_CITY)) {
					return DEFAULT_CITY;
				}
				return availableCities[0] || '';
			}

			function updateCityLink(city) {
				const href = cityRouteMap[city];
				if (!city || !href) {
					cityPageLink.classList.add('hidden');
					cityPageLink.removeAttribute('href');
					return;
				}

				cityPageLink.href = href;
				cityPageLink.classList.remove('hidden');
			}

			function applyCity(city, source = 'manual') {
				const normalizedCity = availableCities.includes(city) ? city : '';
				citySelect.value = normalizedCity;
				updateCityLink(normalizedCity);

				if (normalizedCity) {
					safeStorage.set(STORAGE_KEY, normalizedCity);
				} else {
					safeStorage.remove(STORAGE_KEY);
				}

				window.dispatchEvent(new CustomEvent('kurieros:city-selected', {
					detail: { city: normalizedCity, source, slug: cityRouteMap[normalizedCity]?.replace(/^\/rabota-kurerom-/, '').replace(/\/$/, '') || '' }
				}));
			}

			function normalizeDetectedCity(name) {
				if (!name) return '';
				const directMatch = availableCities.find((city) => city.toLowerCase() === name.toLowerCase());
				if (directMatch) return directMatch;
				const trimmed = name.replace(/^город\s+/i, '').trim();
				const normalizedTrimmed = trimmed.toLowerCase();

				if (['moscow', 'moskva'].includes(normalizedTrimmed) && availableCities.includes(DEFAULT_CITY)) {
					return DEFAULT_CITY;
				}

				return availableCities.find((city) => city.toLowerCase() === normalizedTrimmed) || '';
			}

			async function getIpData() {
				if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
					return null;
				}

				if (window.kurieros_user) {
					return window.kurieros_user;
				}

				return new Promise((resolve) => {
					const timeout = setTimeout(() => resolve(null), 4000);
					window.addEventListener('kurieros:region-detected', (event) => {
						clearTimeout(timeout);
						resolve(event.detail);
					}, { once: true });
				});
			}

			async function detectCityByGeo() {
				const ipData = await getIpData();

				const detectedCity = normalizeDetectedCity(ipData?.city);
				if (detectedCity) {
					applyCity(detectedCity, 'ip');
					return;
				}

				const fallbackCity = getFallbackCity();
				if (fallbackCity) {
					applyCity(fallbackCity, 'default');
				}
			}

			// HV4 — Geo banner for first-time visitors.
			// IANA timezone → primary city of region. VPN typically rewrites IP
			// but не трогает системную таймзону, поэтому работает даже под VPN.
			const TZ_TO_CITY = {
				'Europe/Moscow': 'Москва',
				'Europe/Kaliningrad': 'Калининград',
				'Europe/Samara': 'Самара',
				'Europe/Volgograd': 'Волгоград',
				'Europe/Saratov': 'Саратов',
				'Europe/Astrakhan': 'Астрахань',
				'Europe/Ulyanovsk': 'Ульяновск',
				'Europe/Kirov': 'Киров',
				'Asia/Yekaterinburg': 'Екатеринбург',
				'Asia/Omsk': 'Омск',
				'Asia/Novosibirsk': 'Новосибирск',
				'Asia/Krasnoyarsk': 'Красноярск',
				'Asia/Irkutsk': 'Иркутск',
				'Asia/Yakutsk': 'Якутск',
				'Asia/Vladivostok': 'Владивосток',
				'Asia/Magadan': 'Магадан',
				'Asia/Kamchatka': 'Петропавловск-Камчатский',
				'Asia/Anadyr': 'Анадырь',
				'Asia/Chita': 'Чита'
			};
			const GEO_BANNER_DISMISSED_KEY = 'kurieros:geo-banner-dismissed';

			function getTzCity() {
				try {
					const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
					const city = TZ_TO_CITY[tz];
					return city && availableCities.includes(city) ? city : '';
				} catch (_) {
					return '';
				}
			}

			function showGeoBanner(city) {
				const modal = document.createElement('div');
				modal.id = 'geo-banner';
				modal.className = 'geo-banner-modal';
				modal.setAttribute('role', 'dialog');
				modal.setAttribute('aria-modal', 'true');
				modal.setAttribute('aria-labelledby', 'geo-banner-title');

				// Build modal markup with DOM API (city is dynamic, comes from
				// external geo-IP / window.kurieros_user — never trust as HTML).
				const backdrop = document.createElement('div');
				backdrop.className = 'geo-banner-backdrop';
				backdrop.dataset.action = 'dismiss';

				const card = document.createElement('div');
				card.className = 'geo-banner-card';
				card.setAttribute('role', 'document');

				const icon = document.createElement('div');
				icon.className = 'geo-banner-icon';
				icon.setAttribute('aria-hidden', 'true');
				icon.textContent = '📍';

				const title = document.createElement('h2');
				title.id = 'geo-banner-title';
				title.className = 'geo-banner-title';
				const cityStrong = document.createElement('strong');
				cityStrong.textContent = city; // auto-escaped — XSS-safe
				title.append('Похоже, ваш город — ', cityStrong);

				const body = document.createElement('p');
				body.className = 'geo-banner-body';
				body.textContent = 'Показать только вакансии в этом городе?';

				const actions = document.createElement('div');
				actions.className = 'geo-banner-actions';

				const applyBtn = document.createElement('button');
				applyBtn.type = 'button';
				applyBtn.className = 'geo-banner-btn geo-banner-btn-primary';
				applyBtn.dataset.action = 'apply';
				applyBtn.textContent = 'Да, показать';

				const dismissBtn = document.createElement('button');
				dismissBtn.type = 'button';
				dismissBtn.className = 'geo-banner-btn geo-banner-btn-secondary';
				dismissBtn.dataset.action = 'dismiss';
				dismissBtn.textContent = 'Все города';

				actions.append(applyBtn, dismissBtn);
				card.append(icon, title, body, actions);
				modal.append(backdrop, card);

				document.body.appendChild(modal);
				document.body.classList.add('geo-banner-open');

				const close = (action) => {
					if (action === 'apply') {
						applyCity(city, 'geo-banner');
					} else {
						// Dismiss → silent legacy fallback (Moscow default).
						const fallback = getFallbackCity();
						if (fallback) applyCity(fallback, 'default');
					}
					safeStorage.set(GEO_BANNER_DISMISSED_KEY, '1');
					document.body.classList.remove('geo-banner-open');
					modal.remove();
					if (typeof window.gtag === 'function') {
						window.gtag('event', 'geo_banner_action', { action, city });
					}
				};

				modal.addEventListener('click', (event) => {
					const action = event.target && event.target.dataset && event.target.dataset.action;
					if (action) close(action);
				});
				document.addEventListener('keydown', function escHandler(e) {
					if (e.key === 'Escape') {
						close('dismiss');
						document.removeEventListener('keydown', escHandler);
					}
				});
			}

			async function maybeShowGeoBannerOrAutoApply() {
				// 1. Try IP-geo (existing infrastructure).
				const ipData = await getIpData();
				const ipCity = normalizeDetectedCity(ipData && ipData.city);
				// 2. Fallback to timezone-mapped city.
				const suggested = ipCity || getTzCity();
				if (suggested && availableCities.includes(suggested)) {
					showGeoBanner(suggested);
					return;
				}
				// 3. Final fallback — silent default (Moscow).
				const fallback = getFallbackCity();
				if (fallback) applyCity(fallback, 'default');
			}

			// Wire the manual <select> first — works even if the lazy
			// city-index fetch is still pending. `applyCity` no-ops when
			// `availableCities` is empty (membership check fails) and
			// `updateCityLink` no-ops when `cityRouteMap` is empty.
			citySelect?.addEventListener('change', (event) => {
				applyCity(event.target.value, 'manual');
			});

			// Wait for the lazy city-index fetch before running the
			// saved-city / geo-banner auto-apply flow. Each branch needs
			// `availableCities.includes(...)` for membership and (for the
			// saved-city path) `cityRouteMap` for the city-page-link href.
			// `cityIndexReady` always resolves (catch swallows failures);
			// after it does, `availableCities` is either populated or
			// still `[]` — in the latter case the flow naturally no-ops.
			await cityIndexReady;

			const savedCity = safeStorage.get(STORAGE_KEY);
			const geoBannerDismissed = safeStorage.get(GEO_BANNER_DISMISSED_KEY) === '1';
			if (savedCity && availableCities.includes(savedCity)) {
				applyCity(savedCity, 'saved');
			} else if (geoBannerDismissed) {
				// User already declined the banner once — honor that by
				// using the legacy silent default flow.
				detectCityByGeo();
			} else {
				maybeShowGeoBannerOrAutoApply();
			}

			// FAQ uses native <details>/<summary> — no JS needed.
		});
	})();
</script>

<style>
	/* --- Layout --- */
	main {
		max-width: 1680px;
		padding-top: 0;
	}
	.home-shell {
		max-width: 1560px;
		margin: 0 auto;
		padding: 4mm 1.5rem 3rem;
	}
	/* Hero v2 styles moved to ./components/home/HomeHero.astro (W6-2). */

	/* Toolbar (city select + 4 filters) styles moved to ./components/home/HomeToolbar.astro (W6-2). */

	/* --- Content Sections --- */
	:global(.faq-section) {
		border: none !important;
		background: transparent !important;
		box-shadow: none !important;
		padding: 0 !important;
	}
	:global(.review-card),
	:global(.faq-item) {
		background: var(--surface-color) !important;
		border: 1px solid var(--border-color) !important;
		border-radius: 8px !important;
		box-shadow: 0 4px 12px rgba(24, 45, 34, 0.03) !important;
	}

	/* --- Dark Mode --- */
	/* Old dark-mode .home-hero-* rules removed; .hero-v2 dark-mode lives in ./components/home/HomeHero.astro (W6-2). */
	/* Toolbar dark-mode rules moved to ./components/home/HomeToolbar.astro (W6-2). */
	:global(:where(html, body).dark-mode .review-card),
	:global(:where(html, body).dark-mode .faq-item) {
		background: rgba(67, 77, 90, 0.86) !important;
		border-color: rgba(195, 204, 216, 0.28) !important;
		box-shadow: 0 12px 28px rgba(15, 23, 42, 0.3) !important;
	}
	:global(:where(html, body).dark-mode .faq-question),
	:global(:where(html, body).dark-mode .faq-answer) {
		color: var(--text-main);
	}

	/* --- Utilities (.sr-only / .hidden) moved to HomeToolbar.astro alongside their consumers (W6-2). */

	/* --- Mobile --- */
	@media (max-width: 768px) {
		.home-shell {
			padding-top: 4mm;
			/* `<main>` already supplies 16px (1rem) of horizontal padding;
			   the desktop 1.5rem inline padding from .home-shell on top of
			   that ate ~50px on a 375px screen and pushed the hero off
			   centre. On phones the wrapper just inherits main's padding. */
			padding-inline: 0;
		}
		/* Hero-v2 + toolbar mobile rules moved to their respective components in ./components/home/ (W6-2). */
		/* Old mobile .home-hero-* rules removed. */
	}

	/* Toolbar visual-refresh overrides moved to ./components/home/HomeToolbar.astro (W6-2). */

	/* Geo-banner styles moved to ./components/home/HomeGeoBanner.astro (W6-2). */
	/* Toolbar wrapper, equal-height locks, k-cityrow handoff layout, and
	   late-cascade dark-mode toolbar overrides moved to
	   ./components/home/HomeToolbar.astro (W6-2). */

	/* FAQ — native <details>/<summary> styled to look like the old toggle */
	:global(.faq-question) {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: 16px 20px;
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: var(--fs-16);
		color: var(--ink-900);
		cursor: pointer;
		list-style: none;
		user-select: none;
	}
	:global(.faq-question::-webkit-details-marker) {
		display: none;
	}
	:global(.faq-question::after) {
		content: '+';
		flex: 0 0 auto;
		width: 24px;
		height: 24px;
		display: grid;
		place-items: center;
		font-size: 20px;
		font-weight: 700;
		color: var(--ink-500);
		transition: transform var(--transition), color var(--transition);
	}
	:global(details[open] .faq-question::after) {
		content: '−';
		color: var(--brand-600);
	}
	:global(.faq-question:focus-visible) {
		outline: none;
		box-shadow: var(--shadow-focus);
		border-radius: var(--radius-md);
	}
	:global(.faq-answer) {
		padding: 0 20px 16px;
		color: var(--ink-600);
		line-height: var(--lh-16);
	}
	/* .kb-* rules moved to ./components/home/HomeFaq.astro (W6-2). */

	/* Mobile compaction overrides moved to ./components/home/HomeToolbar.astro and HomeHero.astro (W6-2). */
</style>
