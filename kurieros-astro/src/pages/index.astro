---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobGrid from '../components/JobGrid.astro';
import IncomeCalculator from '../components/IncomeCalculator.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import PartnerBanner from '../components/PartnerBanner.astro';
import jobsData from '../data/jobs';
import { getCompaniesFromJobs } from '../utils/companies';
import { getCitiesFromJobs, getCityNames, sortCityNamesByPopulation } from '../utils/cities';
import { TOPIC_META, knowledgeBaseData } from '../utils/knowledge';

const cities = getCitiesFromJobs(jobsData);
const availableCities = sortCityNamesByPopulation(getCityNames(jobsData));
const cityRouteMap = Object.fromEntries(cities.map((city) => [city.name, `/rabota-kurerom-${city.slug}/`]));
const companies = getCompaniesFromJobs(jobsData);
const totalVacancies = jobsData.length;
const topCities = [...cities]
	.sort((a, b) => b.vacancyCount - a.vacancyCount)
	.slice(0, 6)
	.map((city) => ({
		name: city.name,
		vacancyCount: city.vacancyCount,
		href: `/rabota-kurerom-${city.slug}/`,
	}));
const featuredCompanies = [...companies]
	.sort((a, b) => b.vacancyCount - a.vacancyCount)
	.slice(0, 6)
	.map((company) => ({
		name: company.name,
		href: company.href,
	}));
const featuredFormats = [
	{ name: 'Авто', href: '/rabota-kurerom-na-avto/' },
	{ name: 'Вело', href: '/rabota-kurerom-na-velosipede/' },
	{ name: 'Пешком', href: '/rabota-kurerom-peshkom/' },
	{ name: 'Подработка', href: '/rabota-kurerom-podrabotka/' },
];
const routeCards = [
	{
		title: 'Подработка после дел',
		text: 'Вечерние смены, выходные и варианты без полного графика.',
		href: '/rabota-kurerom-podrabotka/',
	},
	{
		title: 'Можно с 16 лет',
		text: 'Пешие и вело-варианты, где не нужен автомобиль.',
		href: '/rabota-kurerom-16-let/',
	},
	{
		title: 'Есть автомобиль',
		text: 'Посмотреть, где машина правда помогает заработать больше.',
		href: '/rabota-kurerom-na-avto/',
	},
	{
		title: 'Хочу выбрать компанию',
		text: 'Сравнить сервисы по выплатам, требованиям и городам.',
		href: '/companies/',
	},
];
const heroFacts = [
	{ label: 'Вакансии', value: `${totalVacancies}` },
	{ label: 'Компании', value: `${companies.length}` },
	{ label: 'Города', value: `${cities.length}` },
	{ label: 'Форматы', value: 'Авто, вело, пешком, подработка' },
];
const FEATURED_KB_IDS = [
	'age-min-courier',
	'income-foot-courier-msk',
	'income-bike-courier-msk',
	'medical-book',
	'self-employed-registration',
	'find-courier-job',
	'training-period',
	'winter-equipment',
];
const featuredKbItems = FEATURED_KB_IDS
	.map((id) => knowledgeBaseData.items.find((entry) => entry.id === id))
	.filter((entry): entry is NonNullable<typeof entry> => Boolean(entry))
	.map((entry) => {
		const topicMeta = TOPIC_META[entry.topic];
		return {
			id: entry.id,
			question: entry.question,
			answer_short: entry.answer_short,
			topicSlug: topicMeta?.slug ?? '',
			topicTitle: topicMeta?.title ?? entry.topic,
		};
	});
const faqItems = featuredKbItems.map((item) => ({
	question: item.question,
	answer: item.answer_short,
}));
const hubLinks = [
	{
		href: '/compare/',
		title: 'Сравнение вакансий',
		text: 'Поставить рядом зарплату, выплаты, транспорт и оформление.',
	},
	{
		href: '/companies/',
		title: 'Компании',
		text: 'Посмотреть, чем отличаются сервисы доставки и банки.',
	},
	{
		href: '/cities/',
		title: 'Города',
		text: 'Найти вакансии в своём городе без лишнего списка.',
	},
	{
		href: '/guide/',
		title: 'Гид для курьера',
		text: 'Возраст, медкнижка, доход, выплаты, штрафы — структурированно.',
	},
	{
		href: '/blog/',
		title: 'Блог',
		text: 'Разобраться в доходе, расходах и частых ошибках новичков.',
	},
];
const discoveryCards = [
	...routeCards.map((card) => ({
		...card,
		kicker: 'Частый запрос',
		variant: 'route',
	})),
	...hubLinks.map((card) => ({
		...card,
		kicker: 'Раздел сайта',
		variant: 'hub',
	})),
];
const homepageTitle = `Работа курьером 2026: ${totalVacancies} вакансий, ${companies.length} компаний | КурьерОк`.slice(0, 70);
const homepageDescription = `Работа курьером в России 2026: ${totalVacancies} активных вакансий, ${companies.length} компаний, ${cities.length} городов. Доход, выплаты, оформление — всё в одном месте.`.slice(0, 170);
const pageSchemaGraph = [
	{
		'@type': 'CollectionPage',
		name: homepageTitle,
		description: homepageDescription,
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: hubLinks.map((link, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: link.title,
				url: new URL(link.href, Astro.site).toString(),
			})),
		},
	},
	{
		'@type': 'Organization',
		name: 'КурьерОк',
		url: Astro.site,
		description: 'Каталог вакансий курьеров, компаний, городов и практических разборов для спокойного выбора работы.',
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<BaseLayout title={homepageTitle} description={homepageDescription} schemaGraph={pageSchemaGraph}>
	<Header />

	<main>
		<div class="home-shell">
			<section class="hero-v2" aria-labelledby="hero-v2-title">
				<div class="hero-v2-bg" aria-hidden="true"></div>
				<div class="hero-v2-inner">
					<div class="hero-v2-eyebrow">
						<span class="hero-v2-live-dot" aria-hidden="true"></span>
						<span>Агрегатор курьерских вакансий · обновлено сегодня</span>
					</div>
					<h1 id="hero-v2-title" class="hero-v2-title">
						Найди свою смену.
						<span class="hero-v2-title-accent">Получи деньги уже&nbsp;завтра.</span>
					</h1>
					<p class="hero-v2-lead">
						{totalVacancies}&nbsp;проверенных вакансий от&nbsp;{companies.length}&nbsp;крупных компаний
						в&nbsp;{cities.length}&nbsp;городах. Прозрачные выплаты, открытая статистика,
						выход на смену за&nbsp;1&nbsp;день.
					</p>
					<ul class="hero-v2-features">
						<li class="hero-v2-feature">
							<span class="hero-v2-feature-icon" aria-hidden="true">⚡</span>
							<strong class="hero-v2-feature-title">Старт за 1 день</strong>
							<span class="hero-v2-feature-text">Без долгих собеседований</span>
						</li>
						<li class="hero-v2-feature">
							<span class="hero-v2-feature-icon" aria-hidden="true">💸</span>
							<strong class="hero-v2-feature-title">Прозрачные выплаты</strong>
							<span class="hero-v2-feature-text">Тариф за&nbsp;заказ открыт</span>
						</li>
						<li class="hero-v2-feature">
							<span class="hero-v2-feature-icon" aria-hidden="true">🎯</span>
							<strong class="hero-v2-feature-title">Любой формат</strong>
							<span class="hero-v2-feature-text">Авто, вело, пеший, удалённо</span>
						</li>
						<li class="hero-v2-feature">
							<span class="hero-v2-feature-icon" aria-hidden="true">🎓</span>
							<strong class="hero-v2-feature-title">С 16 лет</strong>
							<span class="hero-v2-feature-text">Без опыта и образования</span>
						</li>
					</ul>
					<div class="hero-v2-ctas">
						<a href="#jobs-grid" class="hero-v2-cta-primary" data-t="hero.cta_primary">
							Подобрать вакансию
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
						</a>
						<a href="/calculator/" class="hero-v2-cta-secondary" data-t="hero.cta_secondary">
							Калькулятор дохода
						</a>
					</div>
					<dl class="hero-v2-trustbar">
						<div class="hero-v2-trust-item">
							<dt class="hero-v2-trust-label">Вакансий</dt>
							<dd class="hero-v2-trust-num">{totalVacancies}</dd>
						</div>
						<span class="hero-v2-trust-sep" aria-hidden="true">·</span>
						<div class="hero-v2-trust-item">
							<dt class="hero-v2-trust-label">Компаний</dt>
							<dd class="hero-v2-trust-num">{companies.length}</dd>
						</div>
						<span class="hero-v2-trust-sep" aria-hidden="true">·</span>
						<div class="hero-v2-trust-item">
							<dt class="hero-v2-trust-label">Городов</dt>
							<dd class="hero-v2-trust-num">{cities.length}</dd>
						</div>
					</dl>
				</div>
			</section>

			<section class="home-toolbar-section">
				<div class="hero-toolbar hero-toolbar-only">
					<div class="toolbar-top">
						<div class="city-selector-container" data-region-autoprompt="manual-only">
							<svg class="city-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
							<label class="sr-only" for="city-select">Выберите город</label>
							<select id="city-select" class="city-select">
								<option value="" data-t="location.all_cities">Все города</option>
								{availableCities.map((city) => (
									<option value={city}>{city}</option>
								))}
							</select>
						</div>
						<div class="hero-lang-switcher">
							<LanguageSwitcher />
						</div>
					</div>
					<a id="city-page-link" class="hero-city-link hidden" href="/" data-t="location.view_jobs">Все вакансии в этом городе</a>
					<div class="home-filter-row">
						<select id="vacancy-age-filter" class="home-filter-select" aria-label="Фильтр по возрасту">
							<option value="all">Возраст: любой</option>
							<option value="16plus">Возраст: с 16 лет</option>
							<option value="18plus">Возраст: с 18 лет</option>
						</select>
						<select id="vacancy-transport-filter" class="home-filter-select" aria-label="Фильтр по транспорту">
							<option value="all">Транспорт: любой</option>
							<option value="foot">Транспорт: пешком</option>
							<option value="bicycle">Транспорт: велосипед / самокат</option>
							<option value="auto">Транспорт: авто</option>
							<option value="remote">Транспорт: работа из дома</option>
						</select>
						<select id="vacancy-employment-filter" class="home-filter-select" aria-label="Фильтр по типу трудоустройства">
							<option value="all">Тип трудоустройства: любой</option>
							<option value="gph">Тип трудоустройства: ГПХ</option>
							<option value="self_employed">Тип трудоустройства: самозанятость</option>
							<option value="individual_entrepreneur">Тип трудоустройства: ИП</option>
							<option value="official">Тип трудоустройства: ТК РФ</option>
						</select>
					</div>
				</div>
			</section>

			<JobGrid limit={24} moreHref="/cities/" moreLabel="Все вакансии — выбрать город" />

			<IncomeCalculator />

			<ReviewsBlock />

			<section class="faq-section home-section">
				<div class="section-heading">
					<h2>База знаний для курьера</h2>
					<p>Главные ответы из 23 проверенных источников. Можно открыть любую тему и получить структурированный разбор.</p>
				</div>
				<div class="kb-grid">
					{featuredKbItems.map((item) => (
						<details class="faq-item kb-item">
							<summary class="faq-question">{item.question}</summary>
							<div class="faq-answer">
								<p>{item.answer_short}</p>
								{item.topicSlug && (
									<p class="kb-item-link">
										<a href={`/guide/${item.topicSlug}/#${item.id}`}>
											Подробнее в разделе «{item.topicTitle}» →
										</a>
									</p>
								)}
							</div>
						</details>
					))}
				</div>
				<div class="kb-section-cta">
					<a href="/guide/" class="kb-cta-link">Все вопросы и ответы — Гид для курьера →</a>
				</div>
			</section>

			<PartnerBanner />
		</div>
	</main>

	<Footer />
</BaseLayout>

<script is:inline define:vars={{ availableCities, cityRouteMap }}>
	document.addEventListener('DOMContentLoaded', () => {
		const STORAGE_KEY = 'kurieros-selected-city';
		const DEFAULT_CITY = 'Москва';
		const citySelect = document.getElementById('city-select');
		const cityPageLink = document.getElementById('city-page-link');

		function getFallbackCity() {
			if (availableCities.includes(DEFAULT_CITY)) {
				return DEFAULT_CITY;
			}
			return availableCities[0] || '';
		}

		function updateCityLink(city) {
			const href = cityRouteMap[city];
			if (!city || !href) {
				cityPageLink.classList.add('hidden');
				cityPageLink.removeAttribute('href');
				return;
			}

			cityPageLink.href = href;
			cityPageLink.classList.remove('hidden');
		}

		function applyCity(city, source = 'manual') {
			const normalizedCity = availableCities.includes(city) ? city : '';
			citySelect.value = normalizedCity;
			updateCityLink(normalizedCity);

			if (normalizedCity) {
				localStorage.setItem(STORAGE_KEY, normalizedCity);
			} else {
				localStorage.removeItem(STORAGE_KEY);
			}

			window.dispatchEvent(new CustomEvent('kurieros:city-selected', {
				detail: { city: normalizedCity, source, slug: cityRouteMap[normalizedCity]?.replace(/^\/rabota-kurerom-/, '').replace(/\/$/, '') || '' }
			}));
		}

		function normalizeDetectedCity(name) {
			if (!name) return '';
			const directMatch = availableCities.find((city) => city.toLowerCase() === name.toLowerCase());
			if (directMatch) return directMatch;
			const trimmed = name.replace(/^город\s+/i, '').trim();
			const normalizedTrimmed = trimmed.toLowerCase();

			if (['moscow', 'moskva'].includes(normalizedTrimmed) && availableCities.includes(DEFAULT_CITY)) {
				return DEFAULT_CITY;
			}

			return availableCities.find((city) => city.toLowerCase() === normalizedTrimmed) || '';
		}

		async function getIpData() {
			if (['localhost', '127.0.0.1'].includes(window.location.hostname)) {
				return null;
			}

			if (window.kurieros_user) {
				return window.kurieros_user;
			}

			return new Promise((resolve) => {
				const timeout = setTimeout(() => resolve(null), 4000);
				window.addEventListener('kurieros:region-detected', (event) => {
					clearTimeout(timeout);
					resolve(event.detail);
				}, { once: true });
			});
		}

		async function detectCityByGeo() {
			const ipData = await getIpData();

			const detectedCity = normalizeDetectedCity(ipData?.city);
			if (detectedCity) {
				applyCity(detectedCity, 'ip');
				return;
			}

			const fallbackCity = getFallbackCity();
			if (fallbackCity) {
				applyCity(fallbackCity, 'default');
			}
		}

			const savedCity = localStorage.getItem(STORAGE_KEY);
			if (savedCity && availableCities.includes(savedCity)) {
				applyCity(savedCity, 'saved');
			} else {
				detectCityByGeo();
			}

		citySelect?.addEventListener('change', (event) => {
			applyCity(event.target.value, 'manual');
		});

		// FAQ uses native <details>/<summary> — no JS needed.
	});
</script>

<style>
	/* --- Layout --- */
	main {
		max-width: 1680px;
		padding-top: 0;
	}
	.home-shell {
		max-width: 1560px;
		margin: 0 auto;
		padding: 4mm 1.5rem 3rem;
	}
	/* Old `.hero.hero-home` / `.home-hero-*` rules removed — replaced by .hero-v2 below. */

	/* === Hero v2 — fresh build === */
	.hero-v2 {
		position: relative;
		display: block;
		padding: clamp(1.6rem, 3.5vw, 3rem) clamp(1.25rem, 3vw, 2.25rem);
		margin: 0 0 var(--space-6, 1.5rem);
		border: 1px solid var(--ink-200, #d4dae3);
		border-radius: var(--radius-xl, 20px);
		background: linear-gradient(135deg,
			rgba(232, 246, 230, 0.78) 0%,
			rgba(255, 255, 255, 0.95) 48%,
			rgba(232, 240, 246, 0.7) 100%
		);
		box-shadow: 0 14px 40px rgba(24, 45, 34, 0.06);
		overflow: hidden;
	}
	.hero-v2-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 88% 14%, rgba(46, 139, 87, 0.10) 0%, transparent 55%),
			radial-gradient(circle at 4% 92%, rgba(70, 130, 180, 0.08) 0%, transparent 50%);
	}
	.hero-v2-inner {
		position: relative;
		display: grid;
		gap: clamp(0.85rem, 1.6vw, 1.4rem);
		max-width: 920px;
	}
	.hero-v2-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.9rem;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid var(--ink-200, #d4dae3);
		border-radius: 999px;
		font-family: var(--font-main);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-700, #3a4451);
		width: fit-content;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}
	.hero-v2-live-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #22c55e;
		box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
		animation: hero-v2-pulse 2s ease-out infinite;
	}
	@keyframes hero-v2-pulse {
		0%   { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
		70%  { box-shadow: 0 0 0 9px rgba(34, 197, 94, 0); }
		100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
	}
	.hero-v2-title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(2.1rem, 5vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--ink-900, #0f172a);
		text-wrap: balance;
		max-width: 18ch;
	}
	.hero-v2-title-accent {
		display: inline-block;
		position: relative;
		color: var(--brand-700);
	}
	.hero-v2-title-accent::after {
		content: '';
		position: absolute;
		left: -0.05em;
		right: -0.05em;
		bottom: 0.07em;
		height: 0.22em;
		background: rgba(46, 139, 87, 0.18);
		border-radius: 4px;
		z-index: -1;
	}
	.hero-v2-lead {
		margin: 0;
		font-family: var(--font-main);
		font-size: clamp(0.98rem, 1.3vw, 1.12rem);
		line-height: 1.55;
		color: var(--ink-700, #3a4451);
		max-width: 60ch;
	}
	.hero-v2-features {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 0.7rem;
	}
	.hero-v2-feature {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 0.65rem;
		row-gap: 0.1rem;
		padding: 0.85rem 1rem;
		background: rgba(255, 255, 255, 0.88);
		border: 1px solid var(--ink-200, #d4dae3);
		border-radius: var(--radius-md, 12px);
		transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}
	.hero-v2-feature:hover {
		border-color: var(--brand-500, #2e8b57);
		transform: translateY(-2px);
		box-shadow: 0 10px 22px rgba(24, 45, 34, 0.07);
	}
	.hero-v2-feature-icon {
		grid-row: 1 / 3;
		align-self: center;
		font-size: 1.55rem;
		line-height: 1;
	}
	.hero-v2-feature-title {
		font-family: var(--font-heading);
