		background: var(--surface-100, #0e1622);
		border-color: var(--ink-200, #2a3441);
		box-shadow: none;
	}
	:global(body.dark-mode) .city-selector-container:hover {
		border-color: var(--brand-500, #2eb37a);
		background: var(--surface-100, #0e1622);
	}
	:global(body.dark-mode) .city-selector-container:focus-within {
		border-color: var(--brand-500, #2eb37a);
		box-shadow: 0 0 0 3px rgba(46, 179, 122, 0.22);
	}
	:global(body.dark-mode) .city-selector-container::after,
	:global(body.dark-mode) .city-icon {
