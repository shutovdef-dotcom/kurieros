		border-color: var(--ink-200, #2a3441);
		box-shadow: none;
		color: #e7eaf0;
	}
	:global(body.dark-mode) .hero-lang-switcher :global(.lang-toggle:hover),
	:global(body.dark-mode) .hero-lang-switcher :global(.lang-toggle:focus-visible) {
		background: var(--surface-100, #0e1622);
