	.vacancy-list li {
		margin-bottom: 0.5rem;
	}
	.vacancy-guidance-section {
		border: 1px solid var(--vacancy-border);
		background: var(--vacancy-card-gradient);
	}
	.answer-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.answer-card {
		padding: 1rem;
		border-radius: 8px;
		border: 1px solid var(--vacancy-border);
		background: var(--vacancy-soft);
		color: var(--vacancy-ink);
		line-height: 1.6;
	}
	.answer-grid-two {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.answer-card-warning {
		border-color: #efd7bd;
		background: #fff8ef;
	}
	.numbered-list li::marker {
		color: var(--vacancy-action);
		font-weight: 900;
	}
	.faq-stack {
		display: grid;
		gap: 1rem;
	}
	.faq-item {
		padding: 1.1rem;
		border: 1px solid var(--vacancy-border);
		border-radius: 8px;
		background: var(--vacancy-card);
	}
	.faq-item h3 {
		margin: 0 0 0.45rem;
		font-size: 1rem;
	}
	.faq-item p {
		margin: 0;
		color: var(--vacancy-muted);
		line-height: 1.7;
	}
	.trust-stack {
		display: grid;
		gap: 0.9rem;
		margin-bottom: 1rem;
	}
	.trust-item {
		padding: 1rem;
		border: 1px solid var(--vacancy-border);
		border-radius: 8px;
		background: var(--vacancy-card);
		line-height: 1.7;
		color: var(--vacancy-ink);
	}
	.trust-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.vacancy-route-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
		gap: 1rem;
	}
	.route-card {
		padding: 1rem;
		border: 1px solid var(--vacancy-border);
		border-radius: 8px;
		background: var(--vacancy-card);
	}
	.route-card h3 {
		margin: 0 0 0.9rem;
		font-size: 1rem;
	}
	.route-chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.related-jobs-grid {
		display: grid;
		gap: 0.75rem;
	}
	.related-job-card {
		display: grid;
		gap: 0.4rem;
		padding: 0.95rem 1rem;
		border-radius: 8px;
		border: 1px solid var(--vacancy-border);
		background: var(--vacancy-route-gradient);
		text-decoration: none;
		color: var(--vacancy-ink);
	}
	.related-job-card span {
		color: var(--vacancy-muted);
	}
	.related-job-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		font-size: 0.85rem;
	}
	.vacancy-card-sidebar {
		background: var(--vacancy-card);
		padding: 2rem;
		border-radius: 8px;
		border: 1px solid var(--vacancy-border);
		box-shadow: var(--vacancy-shadow);
		position: sticky;
		top: 2rem;
	}
	.detail-item {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--vacancy-border);
		color: var(--vacancy-muted);
		gap: 1rem;
	}
	.detail-item strong,
	.detail-item span {
		color: var(--vacancy-ink);
	}
	.apply-btn-large {
		display: block;
		width: 100%;
		background: var(--vacancy-action);
		color: var(--ink-0);
		text-align: center;
		padding: 1.15rem 1.1rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--vacancy-action);
		font-weight: 900;
		margin-top: 2rem;
		text-decoration: none;
		box-shadow: var(--shadow-md);
		transition: transform 0.2s, box-shadow 0.2s, background 0.2s, border-color 0.2s;
	}
	.apply-btn-large:hover {
		transform: translateY(-1px);
		background: var(--vacancy-action-hover);
		border-color: var(--vacancy-action-hover);
		box-shadow: var(--shadow-lg);
	}
	.apply-btn-large:focus-visible {
		outline: none;
		box-shadow: var(--shadow-focus);
	}
	.apply-btn-hero {
		margin-top: 1rem;
	}
	.apply-btn-disabled {
		background: var(--vacancy-soft);
		color: var(--vacancy-ink);
		border: 1px solid var(--vacancy-border);
		box-shadow: none;
	}
	.apply-btn-disabled:hover {
		transform: none;
		background: var(--vacancy-soft);
		border-color: var(--vacancy-border);
		color: var(--vacancy-ink);
	}
	.apply-note {
		text-align: center;
		font-size: 0.75rem;
		color: var(--vacancy-muted);
		margin-top: 0.5rem;
	}
	.vacancy-income-calculator {
		display: grid;
		gap: 0.8rem;
		margin-top: 1rem;
		padding: 0.95rem;
		border-radius: 8px;
		border: 1px solid var(--vacancy-border-strong);
		background: var(--vacancy-soft);
	}
	.vacancy-income-eyebrow {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0;
		color: var(--vacancy-eyebrow);
	}
	.vacancy-income-rate {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--vacancy-ink);
	}
	.vacancy-income-rate strong {
		font-size: 0.94rem;
	}
	.vacancy-income-rate-muted {
		color: var(--vacancy-muted);
	}
	.vacancy-income-controls {
		display: grid;
		gap: 0.45rem;
	}
	.vacancy-income-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		font-size: 0.79rem;
		color: var(--vacancy-muted);
	}
	.vacancy-income-label strong {
		min-width: 2.4rem;
		text-align: center;
		padding: 0.2rem 0.45rem;
		border-radius: 999px;
		background: var(--vacancy-soft-strong);
		color: var(--vacancy-ink);
		font-size: 0.78rem;
	}
	.vacancy-income-range {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 0.42rem;
		border-radius: 999px;
		background: #d7e4dc;
		outline: none;
	}
	.vacancy-income-range::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--vacancy-action);
		border: 2px solid #ffffff;
		box-shadow: 0 3px 10px rgba(22, 61, 43, 0.24);
		cursor: pointer;
	}
	.vacancy-income-range::-moz-range-thumb {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--vacancy-action);
		border: 2px solid #ffffff;
		box-shadow: 0 3px 10px rgba(22, 61, 43, 0.24);
		cursor: pointer;
	}
	.vacancy-income-range:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.vacancy-income-output {
		display: grid;
		gap: 0.18rem;
		padding: 0.68rem;
		border-radius: 8px;
		background: var(--vacancy-card);
		border: 1px solid var(--vacancy-border);
	}
	.vacancy-income-output span {
		font-size: 0.72rem;
		text-transform: uppercase;
		font-weight: 800;
		color: var(--vacancy-muted);
	}
	.vacancy-income-output strong {
		font-size: 1.2rem;
		line-height: 1.2;
		color: var(--vacancy-ink);
	}
	.vacancy-income-output small {
		font-size: 0.72rem;
		line-height: 1.35;
		color: var(--vacancy-muted);
	}
	.apply-note-hero {
		margin: 0;
		color: var(--vacancy-muted);
		line-height: 1.45;
	}
	:global(body.dark-mode) .vacancy-page {
		/* All values derived from global --ink-*/--brand-* tokens
		   so /v/[slug] dark mode stays in lock-step with the rest of
		   the site (warm coal palette, not cool slate). */
		--vacancy-ink: var(--ink-800);
		--vacancy-muted: var(--ink-500);
		--vacancy-eyebrow: var(--ink-600);
		--vacancy-border: var(--ink-200);
		--vacancy-border-strong: var(--ink-300);
		--vacancy-chip-border: var(--ink-200);
		--vacancy-card: var(--ink-100);
		--vacancy-soft: var(--ink-150);
		--vacancy-soft-strong: var(--ink-200);
		--vacancy-action: var(--dm-green-surface);
		--vacancy-action-hover: var(--dm-green-surface-hover);
		--vacancy-focus: var(--dm-green-focus);
		--vacancy-panel-gradient: linear-gradient(
			135deg,
			var(--ink-150) 0%,
			var(--ink-100) 52%,
			var(--ink-150) 100%
		);
		--vacancy-card-gradient: linear-gradient(180deg, var(--ink-100) 0%, var(--ink-150) 100%);
		--vacancy-route-gradient: linear-gradient(180deg, var(--ink-100) 0%, var(--ink-150) 100%);
		--vacancy-shadow: var(--shadow-md);
		--vacancy-shadow-strong: var(--shadow-lg);
		background: var(--ink-50);
	}
	:global(body.dark-mode) .vacancy-logo,
	:global(body.dark-mode) .fact-card,
	:global(body.dark-mode) .meta-pill,
	:global(body.dark-mode) .hero-link,
	:global(body.dark-mode) .faq-item,
	:global(body.dark-mode) .trust-item,
	:global(body.dark-mode) .route-card,
	:global(body.dark-mode) .vacancy-income-output {
		background: rgba(67, 77, 90, 0.86);
	}
	:global(body.dark-mode) .answer-card-warning {
		background: rgba(96, 74, 53, 0.72);
		border-color: rgba(239, 215, 189, 0.34);
	}
	:global(body.dark-mode) .vacancy-income-range {
		background: rgba(148, 163, 184, 0.34);
	}
	@media (max-width: 1100px) {
		.vacancy-facts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.answer-grid,
		.answer-grid-two,
		.vacancy-route-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 768px) {
		.vacancy-header,
		.vacancy-answer-panel {
			grid-template-columns: 1fr;
		}
		.vacancy-salary-card {
			order: -1;
		}
		.vacancy-facts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 520px) {
		.vacancy-header {
			padding: 1.25rem;
		}

		.vacancy-header h1 {
			font-size: 1.55rem;
			line-height: 1.2;
			max-width: none;
		}

		/* Mobile hero — keep logo + title in a row so the title sits in
		   the empty space to the right of the logo (instead of dropping
		   below it). Logo shrinks 80→56 so titles like «Автокурьер в
		   Яндекс Еда в Москве» fit in the remaining ~250px on a 375px
		   viewport without overflow. */
		.vacancy-company-info {
			flex-direction: row;
			gap: 0.85rem;
			align-items: flex-start;
		}
		.vacancy-logo {
			width: 56px;
			height: 56px;
			padding: 0.3rem;
			flex-shrink: 0;
		}
		.vacancy-kicker {
			margin-bottom: 0.3rem;
			font-size: 0.65rem;
		}
		.vacancy-company-info > div {
			min-width: 0;
			flex: 1;
		}
		/* Keep .vacancy-facts at 2 columns even on the narrowest phones —
		   user feedback: "Их надо сделать более компактными для мобильной
		   версии, чтобы они были по два блока на одной строке". The
		   inherited rule from @media (max-width: 768px) above sets
		   grid-template-columns: repeat(2, minmax(0, 1fr)) and we no
		   longer override it down to a single column at 520px. */
	}

	/* === Visual refresh overrides (Apply CTAs, sidebar, mobile sticky) === */
	.apply-btn-large {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--accent-500);
		color: var(--ink-0);
		border: none;
		border-radius: var(--radius-md);
		padding: 14px 28px;
		font-family: var(--font-main);
		font-weight: 700;
		font-size: var(--fs-16);
		text-decoration: none;
		transition: background var(--transition);
	}
	.apply-btn-large:hover {
		background: var(--accent-400);
	}
	.apply-btn-large:focus-visible {
		outline: none;
		box-shadow: var(--shadow-focus);
	}
	.apply-btn-hero {
		min-height: 52px;
		padding: 16px 32px;
		font-size: var(--fs-18);
	}
	.apply-btn-disabled {
		background: var(--ink-100);
		color: var(--ink-700);
		pointer-events: none;
		cursor: not-allowed;
	}

	.vacancy-sidebar {
		align-self: start;
	}
	@media (min-width: 1024px) {
		.vacancy-sidebar {
			position: sticky;
			top: 80px;
		}
	}
	.side-card,
	.vacancy-sidebar > * {
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xs);
	}

	/* Mobile sticky CTA — superseded by VacancyStickyApply.astro
	   component (the existing rule below would render at z-index 90,
	   while .bottom-nav (Header.astro) is z-index 1000 — so on mobile
	   the apply button silently went *under* the bottom nav and
	   "disappeared" from the income block. The component now drives
	   the sticky bottom CTA on both mobile + desktop, and is offset
	   above .bottom-nav on mobile via its own @media block. */

	/* === KB-driven section (replaces old fit/anti/check/FAQ/transparency blocks) === */
	.vacancy-kb-section {
		display: grid;
		gap: 1rem;
		padding: 1.75rem 1.85rem;
		background: var(--vacancy-card);
		border: 1px solid var(--vacancy-border);
		border-radius: 16px;
		box-shadow: var(--vacancy-shadow);
	}
	.vacancy-kb-section .section-eyebrow {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--vacancy-eyebrow);
	}
	.vacancy-kb-section h2 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		line-height: 1.18;
		color: var(--vacancy-ink);
		letter-spacing: -0.01em;
	}
	.vacancy-kb-lead {
		margin: 0;
		max-width: 70ch;
		color: var(--vacancy-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.vacancy-kb-grid {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.25rem;
	}
	.vacancy-kb-item {
		border: 1px solid var(--vacancy-border);
		border-radius: 12px;
		background: var(--vacancy-soft);
		transition: border-color 0.18s ease, background 0.18s ease;
		overflow: hidden;
	}
	.vacancy-kb-item[open] {
		border-color: var(--vacancy-chip-border);
		background: var(--vacancy-soft-strong);
	}
	.vacancy-kb-question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.95rem 1.1rem;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-weight: 700;
		font-size: 1rem;
		color: var(--vacancy-ink);
		cursor: pointer;
		list-style: none;
		user-select: none;
		line-height: 1.35;
	}
	.vacancy-kb-question::-webkit-details-marker {
		display: none;
	}
	.vacancy-kb-toggle {
		flex: 0 0 auto;
		position: relative;
		width: 22px;
		height: 22px;
		display: inline-block;
	}
	.vacancy-kb-toggle::before,
	.vacancy-kb-toggle::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 12px;
		height: 2px;
		background: var(--vacancy-action);
		border-radius: 2px;
		transform: translate(-50%, -50%);
		transition: transform 0.18s ease, opacity 0.18s ease;
	}
	.vacancy-kb-toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}
	.vacancy-kb-item[open] .vacancy-kb-toggle::after {
		transform: translate(-50%, -50%) rotate(0deg);
		opacity: 0;
	}
	.vacancy-kb-answer {
		display: grid;
		gap: 0.75rem;
		padding: 0 1.1rem 1.05rem;
		color: var(--vacancy-muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.vacancy-kb-answer p {
		margin: 0;
	}
	.vacancy-kb-deeplink {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		background: rgba(22, 61, 43, 0.07);
		color: var(--vacancy-action);
		font-weight: 700;
		font-size: 0.85rem;
		text-decoration: none;
		width: fit-content;
		transition: background 0.18s ease, transform 0.18s ease;
	}
	.vacancy-kb-deeplink:hover,
	.vacancy-kb-deeplink:focus-visible {
		background: rgba(22, 61, 43, 0.13);
		transform: translateX(2px);
		outline: none;
	}
	.vacancy-kb-meta {
		margin: 0.5rem 0 0;
		font-size: 0.82rem;
		color: var(--vacancy-eyebrow);
	}

	/* Dark mode */
	:global(:where(html, body).dark-mode) .vacancy-kb-section {
		background: rgba(20, 32, 48, 0.7);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-section .section-eyebrow,
	:global(:where(html, body).dark-mode) .vacancy-kb-meta {
		color: rgba(231, 234, 240, 0.55);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-section h2 {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-lead,
	:global(:where(html, body).dark-mode) .vacancy-kb-answer {
		color: rgba(231, 234, 240, 0.75);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-item {
		background: rgba(15, 23, 36, 0.65);
		border-color: rgba(195, 204, 216, 0.16);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-item[open] {
		background: rgba(20, 32, 48, 0.85);
		border-color: rgba(76, 175, 128, 0.4);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-question {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-toggle::before,
	:global(:where(html, body).dark-mode) .vacancy-kb-toggle::after {
		background: var(--brand-500);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-deeplink {
		background: rgba(76, 175, 128, 0.15);
		color: var(--brand-500);
	}
	:global(:where(html, body).dark-mode) .vacancy-kb-deeplink:hover,
	:global(:where(html, body).dark-mode) .vacancy-kb-deeplink:focus-visible {
		background: rgba(76, 175, 128, 0.25);
	}

	@media (max-width: 600px) {
		.vacancy-kb-section {
			padding: 1.2rem 1rem;
		}
	}

	/* === SEO+AI replacement blocks === */

	/* Block A: Quick fact summary (Speakable) */
	.vacancy-quick-summary {
		padding: 1.6rem 1.85rem;
		background: var(--vacancy-soft-strong);
		border: 1px solid var(--vacancy-chip-border);
		border-radius: 16px;
		box-shadow: var(--vacancy-shadow);
		display: grid;
		gap: 0.55rem;
	}
	.vacancy-quick-summary .section-eyebrow {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--vacancy-eyebrow);
	}
	.vacancy-quick-summary h2 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		line-height: 1.18;
		color: var(--vacancy-ink);
		letter-spacing: -0.01em;
	}
	.vacancy-quick-summary-text {
		margin: 0;
		font-size: 1.02rem;
		line-height: 1.6;
		color: var(--vacancy-ink);
		max-width: 78ch;
	}

	/* Block B: HowTo steps */
	.vacancy-howto {
		padding: 1.75rem 1.85rem;
		background: var(--vacancy-card);
		border: 1px solid var(--vacancy-border);
		border-radius: 16px;
		box-shadow: var(--vacancy-shadow);
		display: grid;
		gap: 0.85rem;
	}
	.vacancy-howto h2 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		line-height: 1.18;
		letter-spacing: -0.01em;
		color: var(--vacancy-ink);
	}
	.vacancy-howto-lead {
		margin: 0;
