		background: rgba(96, 74, 53, 0.72);
		border-color: rgba(239, 215, 189, 0.34);
	}
	:global(body.dark-mode) .vacancy-income-range {
		background: rgba(148, 163, 184, 0.34);
	}
	@media (max-width: 1100px) {
		.vacancy-facts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.answer-grid,
		.answer-grid-two,
		.vacancy-route-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 768px) {
		.vacancy-header,
		.vacancy-answer-panel {
			grid-template-columns: 1fr;
		}
		.vacancy-salary-card {
			order: -1;
		}
		.vacancy-facts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 520px) {
		.vacancy-header {
			padding: 1.25rem;
		}

		.vacancy-header h1 {
			font-size: 2.35rem;
