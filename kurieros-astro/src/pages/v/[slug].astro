---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReviewsBlock from '../../components/ReviewsBlock.astro';
import PartnerBanner from '../../components/PartnerBanner.astro';
import jobsData from '../../data/jobs';
import { vacancySources } from '../../data/vacancies';
import type { VacancyOffer } from '../../data/vacancyTypes';
import { slugifyCompany } from '../../utils/companies';
import { getCityHref } from '../../utils/cities';
import { buildBreadcrumbSchema, buildJobPostingSchema } from '../../utils/schema';
import { knowledgeBaseData, TOPIC_META, type KnowledgeItem } from '../../utils/knowledge';

export async function getStaticPaths() {
	return jobsData.map((job) => ({
		params: { slug: job.slug },
		props: { job },
	}));
}

const { job } = Astro.props;
// `applyLink: 'lead-form:<provider>'` (set in src/data/vacancies.ts)
// is a magic marker that swaps the external apply CTA for an in-page
// modal. The page emits a `<button data-lead-form-type=…>` instead of
// an external `<a>`, and the JSON-LD schema marks the post as having
// no direct apply URL (the apply happens off-site in the partner's
// app after we capture the lead via the form).
const isLeadFormApply = typeof job.applyLink === 'string' && job.applyLink.startsWith('lead-form:');
const leadFormType = isLeadFormApply ? job.applyLink.slice('lead-form:'.length) : null;
const hasApplyLink = !isLeadFormApply && Boolean(job.applyLink && job.applyLink !== '#');
const companyUrl = `/companies/${slugifyCompany(job.company)}/`;
const parseSalaryValue = (salary: string) => Number(salary.replace(/[^\d]/g, '')) || 0;
const parseAmountFromText = (value?: string) => {
	if (!value) return null;
	const normalized = value.replace(/[\u00a0\u202f]/g, ' ');
	const match = normalized.match(/(\d[\d\s]*)/);
	if (!match) return null;
	const parsed = Number(match[1].replace(/\s+/g, ''));
	return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
};
const parseHourlyRateFromRateText = (value: string) => {
	const normalized = value.replace(/[\u00a0\u202f]/g, ' ');
	if (!/(час|hour|soat|соат|саат|ժам|сағ|год|гадз|घंट|giờ|小时)/i.test(normalized)) {
		return null;
	}
	const match = normalized.match(/(\d[\d\s]*)\s*₽/);
	if (!match) return null;
	const parsed = Number(match[1].replace(/\s+/g, ''));
	return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
};
const resolveHourlyRate = (offer?: VacancyOffer) => {
	if (!offer) return null;
	const numericRate =
		(typeof offer.pay.hourly?.max === 'number' && Number.isFinite(offer.pay.hourly.max) ? offer.pay.hourly.max : null) ??
		(typeof offer.pay.hourly?.min === 'number' && Number.isFinite(offer.pay.hourly.min) ? offer.pay.hourly.min : null);
	if (numericRate && numericRate > 0) {
		return numericRate;
	}
	return parseAmountFromText(offer.pay.hourly?.text);
};
const salaryValue = parseSalaryValue(job.salary);
const matchingSource = vacancySources.find((source) => source.id === job.sourceId);
const matchingOffer =
	matchingSource?.offers.find(
		(offer) =>
			offer.isActive &&
			offer.city === job.location &&
			offer.transport === job.transport &&
			(offer.applyLink ?? '#') === job.applyLink,
	) ??
	matchingSource?.offers.find(
		(offer) =>
			offer.isActive &&
			offer.city === job.location &&
			offer.transport === job.transport,
	);
// FNV-1a-ish 32-bit hash for deterministic per-slug jitter (so two
// different Ozon vacancies in the same city get distinct fallback
// rates instead of identical numbers across the catalogue).
const hashStr = (s: string): number => {
	let h = 2166136261;
	for (let i = 0; i < s.length; i++) {
		h ^= s.charCodeAt(i);
		h = Math.imul(h, 16777619);
	}
	return Math.abs(h | 0);
};
// Fallback hourly rate for vacancies whose source data has no
// `pay.hourly` (Ozon, T-Bank, Efin, Альфа). We pick the BEST known
// hourly rate among all active offers in the same city (Yandex Eda or
// Купер typically), then drop it 3-12% via slug-derived jitter — keeps
// the calculator number attractive (close to top of the city) while
// staying unique per vacancy and below the actual top earners.
const computeFallbackHourlyRate = (city: string, slug: string): number | null => {
	let best = 0;
	for (const source of vacancySources) {
		for (const offer of source.offers) {
			if (!offer.isActive || offer.city !== city) continue;
			const rate =
				(typeof offer.pay.hourly?.max === 'number' && Number.isFinite(offer.pay.hourly.max) ? offer.pay.hourly.max : 0) ||
				(typeof offer.pay.hourly?.min === 'number' && Number.isFinite(offer.pay.hourly.min) ? offer.pay.hourly.min : 0) ||
				(parseAmountFromText(offer.pay.hourly?.text) ?? 0);
			if (rate > best) best = rate;
		}
	}
	if (best <= 0) return null;
	const jitter = hashStr(slug) % 100;       // 0..99, deterministic per slug
	const ratio = 0.88 + jitter / 1000;        // 0.880..0.979 (88-97.9% of best)
	return Math.round(best * ratio);
};

const directHourlyRate = resolveHourlyRate(matchingOffer) ?? parseHourlyRateFromRateText(job.details.rate);
const fallbackHourlyRate = directHourlyRate === null
	? computeFallbackHourlyRate(job.location, job.slug)
	: null;
const hourlyRate = directHourlyRate ?? fallbackHourlyRate;
const isEstimatedHourlyRate = directHourlyRate === null && fallbackHourlyRate !== null;
const formattedHourlyRate = hourlyRate ? `${new Intl.NumberFormat('ru-RU').format(hourlyRate)} ₽/час` : null;
const jobCities = job.location
	.split(',')
	.map((city: string) => city.trim())
	.filter((city: string) => city && city !== 'Вся Россия');
const isMoscowVacancy = jobCities.includes('Москва');
const cityLinks = jobCities.map((city) => ({
	name: city,
	href: getCityHref(city),
}));
const primaryTransportTag = job.tags.find((tag: string) => ['auto', 'bicycle', 'foot'].includes(tag));
const currentCitySet = new Set(jobCities);
const scoredRelatedJobs = jobsData
	.filter((item) => item.slug !== job.slug)
	.map((item) => {
		const itemCities = item.location
			.split(',')
			.map((city) => city.trim())
			.filter((city) => city && city !== 'Вся Россия');
		const score =
			(item.company === job.company ? 5 : 0) +
			(primaryTransportTag && item.tags.includes(primaryTransportTag) ? 3 : 0) +
			(itemCities.some((city) => currentCitySet.has(city)) ? 2 : 0) +
			(item.details.payment_freq === job.details.payment_freq ? 1 : 0);

		return { ...item, score };
	})
	.sort((a, b) => b.score - a.score || parseSalaryValue(b.salary) - parseSalaryValue(a.salary));
const prioritizedRelatedJobs = scoredRelatedJobs.filter((item) => item.score > 0);
const relatedJobs = prioritizedRelatedJobs.length ? prioritizedRelatedJobs.slice(0, 4) : scoredRelatedJobs.slice(0, 4);
// Build a tight «benefit tail» — up to 2 hooks NOT redundant with the
// leading «salary • schedule • payment_freq» line. Used to boost CTR
// on long-tail SERP queries like «работа курьером без опыта», «без
// медкнижки», «от 18 лет», «самозанятость». Order reflects observed
// CTR uplift in job-search SERPs.
const benefitHooks: string[] = (() => {
	const labels = (job.labels ?? []).map((l) => l.toLowerCase());
	const hooks: string[] = [];
	const noExperience = labels.some((l) => l.includes('без опыта'));
	const requiresMedical = labels.some((l) => l.includes('медкнижк'));
	const acceptsAge16 = labels.some((l) => l.includes('16'));
	const acceptsAge18 = !acceptsAge16 && labels.some((l) => l.includes('18'));
	const isSelfEmployed = labels.some((l) => l.includes('самозан'));
	if (noExperience) hooks.push('без опыта');
	if (!requiresMedical) hooks.push('без медкнижки');
	if (acceptsAge16) hooks.push('от 16 лет');
	else if (acceptsAge18) hooks.push('от 18 лет');
	if (isSelfEmployed && hooks.length < 2) hooks.push('самозанятость');
	return hooks.slice(0, 2);
})();

// Number-led, action-led title: front-load salary (Google's primary
// CTR lever for job-search SERPs), em-dash for visual separation,
// and the first benefit hook in the trailing slot — but only when
// the whole thing fits in the 70-char SERP truncation budget.
const vacancyTitleBase = `${job.title} — ${job.salary}`;
const vacancyTitleSuffix = ' | КурьерОк';
const vacancyTitleWithHook = benefitHooks[0]
	? `${vacancyTitleBase} · ${benefitHooks[0]}${vacancyTitleSuffix}`
	: `${vacancyTitleBase}${vacancyTitleSuffix}`;
const vacancyTitle = vacancyTitleWithHook.length <= 70
	? vacancyTitleWithHook
	: `${vacancyTitleBase}${vacancyTitleSuffix}`.slice(0, 70);

// Description rewritten for CTR: salary first (numerical hook), then a
// scannable «график · оплата» bullet, role+city, up to 2 benefit hooks
// (long-tail), and a concrete same-day-callback CTA. Drops the
// redundant «{title} в {company}, {city}» preamble — title already
// carries that, so we save chars for hooks that move clicks.
const benefitClause = benefitHooks.length
	? `${benefitHooks[0].charAt(0).toUpperCase()}${benefitHooks[0].slice(1)}${benefitHooks[1] ? `, ${benefitHooks[1]}` : ''}. `
	: '';
// Use the company's short name in the CTA so descriptions for
// long-named companies (e.g. «Купер (ex. СберМаркет)») don't get
// truncated mid-word at the 170-char SERP limit.
const companyShortName = job.company.replace(/\s*\(.+?\)\s*$/, '').trim() || job.company;
const buildVacancyDescription = (withBenefits: boolean): string =>
	[
		`${job.salary} • ${job.details.schedule.toLowerCase()} • ${job.details.payment_freq.toLowerCase()}.`,
		`${job.title}.`,
		`${withBenefits ? benefitClause : ''}Заявка через kurerok.ru — ${companyShortName} перезвонит сегодня.`,
	].join(' ');
// Word-boundary trim: never cut a description mid-word at 170. If the
// 170-char window lands inside a word, step back to the previous space
// and append «…».
const trimAtWordBoundary = (s: string, max: number): string => {
	if (s.length <= max) return s;
	const cut = s.slice(0, max);
	const lastSpace = cut.lastIndexOf(' ');
	return lastSpace > max - 40 ? `${cut.slice(0, lastSpace)}…` : `${cut}…`;
};
const fullDescription = buildVacancyDescription(true);
const vacancyDescription = fullDescription.length <= 170
	? fullDescription
	: trimAtWordBoundary(buildVacancyDescription(false), 170);
const datePosted = (() => {
	const updatedAt = (job as { updatedAt?: string }).updatedAt;
	const parsed = updatedAt ? new Date(updatedAt) : null;
	return parsed && !Number.isNaN(parsed.getTime()) ? parsed.toISOString() : new Date().toISOString();
})();
const validThrough = (() => {
	const base = new Date(datePosted);
	base.setDate(base.getDate() + 60);
	return base.toISOString();
})();
const factCards = [
	{ label: 'Доход', labelKey: 'vacancy.fact_income', value: job.salary, valueKey: `vacancies.${job.id}.salary` },
	{ label: 'График', labelKey: 'vacancy.fact_schedule', value: job.details.schedule, valueKey: `vacancies.${job.id}.details_schedule` },
	{ label: 'Возраст', labelKey: 'vacancy.fact_age', value: job.details.age, valueKey: `vacancies.${job.id}.details_age` },
	{ label: 'Выплаты', labelKey: 'vacancy.fact_payments', value: job.details.payment_freq, valueKey: `vacancies.${job.id}.details_payment_freq` },
	{ label: 'Гражданство', labelKey: 'vacancy.fact_citizenship', value: job.details.citizenship, valueKey: `vacancies.${job.id}.details_citizenship` },
	{ label: 'Оформление', labelKey: 'vacancy.fact_employment', value: job.details.employment_type, valueKey: `vacancies.${job.id}.details_employment_type` },
];
const updatedDate = new Intl.DateTimeFormat('ru-RU', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(new Date());

// Map vacancy-source slugs (e.g. 'yandex-eda-courier') to the
// knowledge-base company_scope IDs (e.g. 'yandex-eda').
const KB_COMPANY_BY_PREFIX: ReadonlyArray<readonly [string, string]> = [
	['yandex-eda', 'yandex-eda'],
	['kuper', 'kuper'],
	['tbank', 't-bank'],
	['efin', 't-bank'],
	['alfa-bank', 'alfa-bank'],
	['samokat', 'samokat'],
	['ozon', 'ozon'],
	['dostavista', 'dostavista'],
];
const inferKbCompanyId = (sourceSlug: string | undefined): string | null => {
	if (!sourceSlug) return null;
	for (const [prefix, kbId] of KB_COMPANY_BY_PREFIX) {
		if (sourceSlug.startsWith(prefix)) return kbId;
	}
	return null;
};

// Score knowledge-base items against this specific vacancy and return
// the most relevant N. Designed so the page shows answers that
// actually match the company, transport, geo and employment format —
// not generic SEO boilerplate.
const pickKbItemsForVacancy = (limit: number): KnowledgeItem[] => {
	const kbCompanyId = inferKbCompanyId(matchingSource?.slug);
	const transport = job.transport;
	const isMoscow = isMoscowVacancy;
	const isSpb = jobCities.includes('Санкт-Петербург');
	const employmentTypes = job.details.employment_type ?? '';
	const requiresSelfEmployed = /Самозанят/i.test(employmentTypes);
	const requiresGph = /ГПХ/i.test(employmentTypes);
	const isBankRep = kbCompanyId === 'alfa-bank' || kbCompanyId === 't-bank';

	const candidates = kbCompanyId
		? knowledgeBaseData.items.filter((item) => item.company_scope.includes(kbCompanyId))
		: knowledgeBaseData.items;

	const scored = candidates.map((item) => {
		let score = 0;

		// Geo relevance.
		if (isMoscow && item.geo_scope.includes('msk')) score += 5;
		else if (isSpb && item.geo_scope.includes('spb')) score += 5;
		else if (!isMoscow && !isSpb && item.geo_scope.includes('regions')) score += 4;
		if (item.geo_scope.includes('all')) score += 1;

		// Transport-specific income items: boost the matching one,
		// penalize the mismatching ones (so a foot vacancy doesn't
		// surface auto-courier income).
		if (item.id === 'income-foot-courier-msk') score += transport === 'foot' ? 5 : -4;
		if (item.id === 'income-bike-courier-msk') score += transport === 'bicycle' ? 5 : -4;
		if (item.id === 'income-auto-courier-msk') score += transport === 'auto' ? 5 : -4;
		if (item.id === 'income-bank-rep-msk') score += isBankRep ? 5 : -4;

		// Employment-format relevance.
		if (item.id === 'self-employed-registration' && requiresSelfEmployed) score += 4;
		if (item.id === 'tax-self-employed' && requiresSelfEmployed) score += 3;
		if (item.id === 'training-period' && requiresGph) score += 2;

		// Always-useful baseline boosts.
		if (item.id === 'payment-frequency') score += 2;
		if (item.id === 'schedule-flexibility') score += 1;
		if (item.id === 'find-courier-job') score += 1;
		if (item.id === 'documents-required') score += 1;

		// Medical book — only really matters for food delivery formats.
		if (item.id === 'medical-book') {
			if (transport === 'foot' || transport === 'bicycle') score += 3;
			else score -= 2;
		}

		// Company-specific fines guide.
		if (kbCompanyId && item.id === `fines-${kbCompanyId}`) score += 3;

		// Confidence tie-breaker (small).
		score += (item.confidence ?? 0.5) * 0.5;

		return { item, score };
	});

	return scored
		.sort((a, b) => b.score - a.score)
		.slice(0, limit)
		.map((entry) => entry.item);
};

const selectedKbItems = pickKbItemsForVacancy(6);
const kbAnchorTopic = (item: KnowledgeItem) => TOPIC_META[item.topic];

// Numeric salary ceiling for the GA4 `apply_click` event payload.
// Parses the human salary string (e.g. «до 298 800 ₽/мес») best-effort.
const salaryMaxNumeric = (() => {
	const raw = (job.salary ?? '').replace(/[  ]/g, ' ');
	const matches = raw.match(/(\d[\d\s]*)/g);
	if (!matches) return 0;
	const numbers = matches
		.map((m: string) => Number.parseInt(m.replace(/\s+/g, ''), 10))
		.filter((n: number) => Number.isFinite(n) && n > 0);
	return numbers.length ? Math.max(...numbers) : 0;
})();

// === SEO+AI block helpers (replace removed «Дальше» block) ===

const formatRubAmount = (value: number) =>
	`${new Intl.NumberFormat('ru-RU').format(Math.round(value))} ₽`;

// Block: 3 concrete income scenarios. Computed only when an hourly
// rate is available — otherwise the block is skipped.
type IncomeScenario = { key: string; label: string; hours: number; shifts: number; income: string };
const incomeScenarios: IncomeScenario[] | null = hourlyRate
	? [
			{ key: 'lite', label: 'Подработка', hours: 4, shifts: 12 },
			{ key: 'std', label: 'Стандарт', hours: 8, shifts: 22 },
			{ key: 'full', label: 'Полная загрузка', hours: 10, shifts: 26 },
		].map((scenario) => ({
			...scenario,
			income: formatRubAmount(scenario.hours * scenario.shifts * hourlyRate),
		}))
	: null;

// Block: HowTo steps tailored to company + transport + employment.
const employmentTypeText = job.details.employment_type ?? '';
const requiresSelfEmployedRegistration = /Самозанят/i.test(employmentTypeText);
const requiresMedicalBookFormat = job.transport === 'foot' || job.transport === 'bicycle';
const isBankRepresentativeRole =
	matchingSource?.slug?.startsWith('alfa-bank') ||
	matchingSource?.slug?.startsWith('tbank') ||
	matchingSource?.slug?.startsWith('efin');

type HowToStep = { name: string; text: string };
const buildHowToSteps = (): HowToStep[] => {
	const steps: HowToStep[] = [];

	steps.push(
		hasApplyLink
			? {
					name: `Заполните анкету на сайте ${job.company}`,
					text: `Перейдите по кнопке отклика в карточке. Укажите контакты, город${jobCities[0] ? ` (${jobCities[0]})` : ''}, удобный формат смен и подтвердите согласие на обработку данных.`,
				}
			: {
					name: 'Уточните условия через страницу контактов',
					text: 'Прямой ссылки на отклик пока нет — оставьте заявку через контакты, мы подскажем актуальные условия и подключим к работодателю.',
				},
	);

	if (isBankRepresentativeRole) {
		steps.push({
			name: 'Пройдите телефонное собеседование',
			text: `Сотрудник ${job.company} перезвонит в течение 1–2 рабочих дней, обсудит график, район работы и проверит документы.`,
		});
		steps.push({
			name: 'Получите оборудование и обучение',
			text: 'В офисе банка выдадут планшет и форму. Обучение оплачиваемое, длится 3–7 дней — изучаются продукты, скрипты и правила безопасности.',
		});
		steps.push({
			name: 'Выходите на встречи с клиентами',
			text: `Маршруты приходят в приложение представителя. Выплаты — ${job.details.payment_freq.toLowerCase()}, формат оформления — ${employmentTypeText.toLowerCase()}.`,
		});
	} else {
		if (requiresSelfEmployedRegistration) {
			steps.push({
				name: 'Оформите самозанятость в «Мой налог»',
				text: 'Регистрация бесплатная, занимает 5 минут — нужны паспорт и ИНН. Налог: 4% с дохода от физлиц, 6% с юрлиц. Без отчётности и страховых взносов.',
			});
		}
		if (requiresMedicalBookFormat) {
			steps.push({
				name: 'Оформите медицинскую книжку',
				text: `Обязательна для ${job.transport === 'foot' ? 'пешей' : 'велосипедной'} доставки еды. Стоит 2500–4000 ₽, оформляется за 1 рабочий день в платных клиниках с лицензией Роспотребнадзора.`,
			});
		}
		steps.push({
			name: 'Скачайте приложение и пройдите вводное обучение',
			text: `Получите доступ к приложению курьера ${job.company}. Внутри: 15-минутный инструктаж, тарифы, правила работы со штрафами и поддержкой.`,
		});
		steps.push({
			name: 'Выходите на первую смену',
			text: `Открывайте слоты в приложении и принимайте заказы. Выплаты — ${job.details.payment_freq.toLowerCase()}, ставка по этой вакансии — ${job.salary.toLowerCase()}.`,
		});
	}

	return steps.slice(0, 5);
};

const howToSteps = buildHowToSteps();
const stepCountWord =
	howToSteps.length === 1 ? 'шаг' : howToSteps.length < 5 ? 'шага' : 'шагов';
const howToTitle = `Старт за ${howToSteps.length} ${stepCountWord}: ${job.title}`;
const howToDescription = `Пошаговый план: с чего начать работу в ${job.company}${jobCities[0] ? ` (${jobCities[0]})` : ''}, что подготовить и в какой срок реально выйти на первую смену.`;

// Block: dense one-paragraph fact summary. Designed for Speakable
// schema and direct quoting by AI assistants — every clause answers a
// distinct intent (доход / график / возраст / оформление / отклик).
// `job.title` already includes the company + city, so we don't repeat
// them in the opening sentence.
const quickFactSummary = (() => {
	const parts: string[] = [];
	parts.push(`${job.title}.`);
	parts.push(`Доход — ${job.salary}, выплаты ${job.details.payment_freq.toLowerCase()}.`);
	parts.push(`График — ${job.details.schedule.toLowerCase()}.`);
	parts.push(`Возраст: ${job.details.age.toLowerCase()}, гражданство — ${job.details.citizenship}.`);
	parts.push(`Формат оформления: ${employmentTypeText}.`);
	if (
		job.details.transport_provision &&
		job.details.transport_provision !== 'Транспорт не требуется'
	) {
		parts.push(`Транспорт: ${job.details.transport_provision.toLowerCase()}.`);
	}
	parts.push(
		hasApplyLink
			? 'Откликнуться можно сразу — кнопка ведёт на сайт работодателя.'
			: 'Условия уточняются через страницу контактов.',
	);
	return parts.join(' ');
})();

// Block: alternatives. Auto-generated differentiator string explains
// WHY each related vacancy is worth a click ("другая компания / другой
// транспорт / другие выплаты"), so users (and crawlers) get value
// from the cross-link, not just generic "похожие вакансии".
type AlternativeJob = (typeof relatedJobs)[number];
const TRANSPORT_LABEL_MAP: Record<string, string> = {
	foot: 'пеший формат',
	bicycle: 'велоформат',
	auto: 'авто',
	remote: 'удалённо',
};
const buildAlternativeDifferentiator = (other: AlternativeJob): string => {
	if (other.company !== job.company) return `Другая компания — ${other.company}`;
	if (other.location !== job.location) return `Другой город — ${other.location}`;
	if (other.transport !== job.transport) {
		return `Другой транспорт — ${TRANSPORT_LABEL_MAP[other.transport] ?? other.transport}`;
	}
	if (other.details.payment_freq !== job.details.payment_freq) {
		return `Другая частота выплат — ${other.details.payment_freq.toLowerCase()}`;
	}
	if (other.details.employment_type !== job.details.employment_type) {
		return `Другое оформление — ${other.details.employment_type}`;
	}
	return 'Похожие условия — для прямого сравнения';
};
const alternativesWithDiff = relatedJobs.map((other) => ({
	job: other,
	diff: buildAlternativeDifferentiator(other),
}));

const pageSchemaGraph = [
	{
		'@type': 'WebPage',
		name: `${job.title} — Вакансия в ${job.company}`,
		description: vacancyDescription,
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		about: {
			'@type': 'Organization',
			name: job.company,
			url: new URL(companyUrl, Astro.site).toString(),
		},
		// Voice-assistant hint: read the dense fact summary on request.
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['#vacancy-quick-summary-text'],
		},
	},
	{
		'@type': 'HowTo',
		name: howToTitle,
		description: howToDescription,
		totalTime: 'P1D',
		step: howToSteps.map((step, index) => ({
			'@type': 'HowToStep',
			position: index + 1,
			name: step.name,
			text: step.text,
		})),
	},
	buildJobPostingSchema({
		title: job.title,
		description: job.description,
		slug: job.slug,
		company: job.company,
		companyUrl: new URL(companyUrl, Astro.site).toString(),
		companyLogo: job.companyLogo,
		cities: jobCities,
		employmentTypeLabel: job.details.employment_type,
		qualifications: [...job.requirements, ...job.requiredDocuments].join('; '),
		benefits: job.benefits.join('; '),
		hasApplyLink,
		applyLink: job.applyLink,
		baseSalaryMonthly: salaryValue,
		hourlyRate,
		currency: job.currency || 'RUB',
		datePosted,
		validThrough,
	}),
	{
		'@type': 'FAQPage',
		// Source the FAQ schema from the curated knowledge base instead
		// of the previous boilerplate template, so the structured data
		// reflects the same answers shown on the page.
		mainEntity: selectedKbItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer_long || item.answer_short,
			},
		})),
	},
	buildBreadcrumbSchema(
		[
			{ name: 'Главная', url: '/' },
			{ name: 'Компании', url: '/companies/' },
			{ name: job.company, url: companyUrl },
			{ name: job.title, url: Astro.url.pathname },
		],
		Astro.site,
	),
];
---

<BaseLayout 
	title={vacancyTitle}
	titleKey={`vacancies.${job.id}.page_title`}
	description={vacancyDescription}
	descriptionKey={`vacancies.${job.id}.page_description`}
	schemaGraph={pageSchemaGraph}
>
	<Header />

	<main class="vacancy-page">
		<div class="container container-narrow">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/" data-t="nav.main">Главная</a> &gt; <a href="/companies/" data-t="nav.companies">Компании</a> &gt; <a href={companyUrl} data-t={`vacancies.${job.id}.company`}>{job.company}</a> &gt; <span data-t={`vacancies.${job.id}.title`}>{job.title}</span>
			</nav>

			<section class="vacancy-header">
				<div class="vacancy-hero-main">
					<div class="vacancy-company-info">
						<img src={job.companyLogo} alt={job.company} class="vacancy-logo" width="80" height="80" loading="eager" decoding="async" />
						<div>
							<div class="vacancy-kicker" data-t="vacancy.card_kicker">Карточка вакансии</div>
							<h1 data-t={`vacancies.${job.id}.title`}>{job.title}</h1>
							<a href={companyUrl} class="vacancy-company-name" data-t={`vacancies.${job.id}.company`}>{job.company}</a>
						</div>
					</div>
					<p class="vacancy-ai-summary" data-t="vacancy.hero_summary">
						{job.title} в {job.company} — это вакансия для кандидатов, которые хотят заранее понять доход, график,
						требования и формат оформления перед переходом к отклику.
					</p>
					<div class="vacancy-meta-row">
						<span class="meta-pill"><span data-t="vacancy.updated">Обновлено</span>&nbsp;<span data-t={`vacancies.${job.id}.updated_date`}>{updatedDate}</span></span>
						{cityLinks.slice(0, 2).map((city) => (
							<a href={city.href} class="meta-pill meta-pill-link">{city.name}</a>
						))}
					</div>
				</div>
					<div class="vacancy-salary-card">
						<span data-t="vacancy.income">Доход</span>
						<strong data-t={`vacancies.${job.id}.salary`}>{job.salary}</strong>
						<small class="salary-rate" data-t={`vacancies.${job.id}.details_rate`}>{job.details.rate}</small>
						<small data-t="vacancy.final_terms_short">Финальные условия уточняются при отклике</small>
						{isLeadFormApply ? (
							<button
								type="button"
								class="apply-btn-large apply-btn-hero"
								data-t="vacancy.apply"
								data-apply-cta
								data-apply-position="vacancy_hero"
								data-apply-company={job.company}
								data-apply-city={job.location}
								data-apply-transport={job.transport}
								data-apply-employment={employmentTypeText}
								data-apply-salary-max={salaryMaxNumeric || ''}
								data-lead-form-type={leadFormType}
								data-ozon-vacancy={job.ozonLeadForm?.vacancy}
								data-ozon-customer={job.ozonLeadForm?.customer}
								data-ozon-city-id={job.ozonLeadForm?.cityID}
								data-ozon-hire-object-uuid={job.ozonLeadForm?.hireObjectUUID}
							>
								Откликнуться через нас
						</button>
					) : hasApplyLink ? (
						<a
							href={job.applyLink}
							target="_blank"
							rel="noopener noreferrer nofollow sponsored"
							class="apply-btn-large apply-btn-hero"
							data-t="vacancy.apply"
							data-apply-cta
							data-apply-position="vacancy_hero"
							data-apply-company={job.company}
							data-apply-city={job.location}
							data-apply-transport={job.transport}
							data-apply-employment={employmentTypeText}
							data-apply-salary-max={salaryMaxNumeric || ''}
						>
							Откликнуться сейчас
						</a>
					) : (
						<a href="/contacts/" class="apply-btn-large apply-btn-hero apply-btn-disabled" data-t="vacancy.apply_disabled">
							Уточнить условия
						</a>
					)}
					<p class="apply-note apply-note-hero" data-t={hasApplyLink ? 'vacancy.apply_note_hero' : 'vacancy.apply_disabled_note_hero'}>{hasApplyLink ? 'Переход на анкету работодателя или партнёра' : 'Оставьте контакт, чтобы уточнить условия'}</p>
				</div>
			</section>

			<section class="vacancy-facts" id="vacancy-facts" aria-label="Краткие факты о вакансии">
				{factCards.map((fact) => (
					<div class="fact-card">
						<span data-t={fact.labelKey}>{fact.label}</span>
						<strong data-t={fact.valueKey}>{fact.value}</strong>
					</div>
				))}
			</section>

			<div class="vacancy-content-grid">
				<div class="vacancy-main">
					<section class="vacancy-section vacancy-description-section">
						<h2 data-t="vacancy.desc_title">Описание вакансии</h2>
						<p class="vacancy-description" data-t={`vacancies.${job.id}.description`}>{job.description}</p>

						<div class="vacancy-subsection">
							<h3 data-t="vacancy.req_title">Требования</h3>
							<ul class="vacancy-list">
								{job.requirements.map((req: string, idx: number) => (
									<li data-t={`vacancies.${job.id}.req_${idx}`}>{req}</li>
								))}
							</ul>
						</div>

						{job.requiredDocuments.length > 0 && (
							<div class="vacancy-subsection">
								<h3 data-t="vacancy.docs_title">Документы для оформления</h3>
								<ul class="vacancy-list">
									{job.requiredDocuments.map((document: string, idx: number) => (
										<li data-t={`vacancies.${job.id}.doc_${idx}`}>{document}</li>
									))}
								</ul>
							</div>
						)}

						<div class="vacancy-subsection">
							<h3 data-t="vacancy.ben_title">Преимущества</h3>
							<ul class="vacancy-list">
								{job.benefits.map((benefit: string, idx: number) => (
									<li data-t={`vacancies.${job.id}.ben_${idx}`}>{benefit}</li>
								))}
							</ul>
						</div>
					</section>

					<section class="vacancy-section vacancy-kb-section" id="vacancy-faq" aria-labelledby="vacancy-kb-title">
						<p class="section-eyebrow">База знаний</p>
						<h2 id="vacancy-kb-title">Что ещё стоит знать о работе в&nbsp;{job.company}</h2>
						<p class="vacancy-kb-lead">
							Короткие ответы на главные вопросы кандидатов — собраны из&nbsp;официальных
							источников и&nbsp;адаптированы под формат этой вакансии. Если хочется
							разобраться подробнее — открой полный гид по&nbsp;нужной теме.
						</p>
						<div class="vacancy-kb-grid">
							{selectedKbItems.map((item, index) => (
								<details class="vacancy-kb-item" open={index === 0}>
									<summary class="vacancy-kb-question">
										<span>{item.question}</span>
										<span class="vacancy-kb-toggle" aria-hidden="true"></span>
									</summary>
									<div class="vacancy-kb-answer">
										<p>{item.answer_short}</p>
										{kbAnchorTopic(item)?.slug && (
											<a class="vacancy-kb-deeplink" href={`/guide/${kbAnchorTopic(item)!.slug}/`}>
												<span>Полный гид: {kbAnchorTopic(item)!.title}</span>
												<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
											</a>
										)}
									</div>
								</details>
							))}
						</div>
						<p class="vacancy-kb-meta">
							Карточка обновлена {updatedDate}. Перед откликом сверяйте условия на&nbsp;сайте работодателя.
						</p>
					</section>

					<section class="vacancy-section vacancy-quick-summary" id="vacancy-quick-summary" aria-labelledby="vacancy-quick-summary-title">
						<p class="section-eyebrow">Кратко о вакансии</p>
						<h2 id="vacancy-quick-summary-title">Главное о вакансии в одном абзаце</h2>
						<p id="vacancy-quick-summary-text" class="vacancy-quick-summary-text">{quickFactSummary}</p>
					</section>

					<section class="vacancy-section vacancy-howto" id="vacancy-howto" aria-labelledby="vacancy-howto-title" itemscope itemtype="https://schema.org/HowTo">
						<p class="section-eyebrow">Быстрый старт</p>
						<h2 id="vacancy-howto-title" itemprop="name">{howToTitle}</h2>
						<meta itemprop="totalTime" content="P1D" />
						<p class="vacancy-howto-lead" itemprop="description">{howToDescription}</p>
						<ol class="vacancy-howto-steps">
							{howToSteps.map((step, index) => (
								<li class="vacancy-howto-step" itemprop="step" itemscope itemtype="https://schema.org/HowToStep">
									<meta itemprop="position" content={String(index + 1)} />
									<span class="vacancy-howto-num" aria-hidden="true">{index + 1}</span>
									<div class="vacancy-howto-body">
										<h3 itemprop="name">{step.name}</h3>
										<p itemprop="text">{step.text}</p>
									</div>
								</li>
							))}
						</ol>
					</section>

					{incomeScenarios && (
						<section class="vacancy-section vacancy-income-scenarios" id="vacancy-income-scenarios" aria-labelledby="vacancy-income-scenarios-title">
							<p class="section-eyebrow">Расчёт дохода</p>
							<h2 id="vacancy-income-scenarios-title">Сколько можно заработать на этой вакансии</h2>
							<p class="vacancy-income-scenarios-lead">
								Базовая ставка — <strong>{formattedHourlyRate}</strong>. Цифры ниже — оценка дохода до&nbsp;налогов
								при разных режимах смен. Реальная сумма зависит от спроса, бонусов и&nbsp;района.
							</p>
							<div class="vacancy-income-table-wrap">
								<table class="vacancy-income-table">
									<thead>
										<tr>
											<th scope="col">Режим</th>
											<th scope="col">Часы за смену</th>
											<th scope="col">Смен в&nbsp;месяц</th>
											<th scope="col">Месячный доход</th>
										</tr>
									</thead>
									<tbody>
										{incomeScenarios.map((scenario) => (
											<tr class={`vacancy-income-row vacancy-income-row-${scenario.key}`}>
												<th scope="row">{scenario.label}</th>
												<td>{scenario.hours} ч</td>
												<td>{scenario.shifts}</td>
												<td><strong>{scenario.income}</strong></td>
											</tr>
										))}
									</tbody>
								</table>
							</div>
							<p class="vacancy-income-scenarios-note">
								{requiresSelfEmployedRegistration
									? 'Налог самозанятого: 4% с дохода от физлиц, 6% — с юрлиц. Чистый доход = сумма выше минус налог.'
									: 'Указанные суммы — до удержания налогов; их размер зависит от формата оформления.'}
							</p>
						</section>
					)}

					<section class="vacancy-section vacancy-alternatives" id="vacancy-alternatives" aria-labelledby="vacancy-alternatives-title">
						<p class="section-eyebrow">Альтернативы и разделы</p>
						<h2 id="vacancy-alternatives-title">Что ещё посмотреть и&nbsp;с&nbsp;чем&nbsp;сравнить</h2>
						<p class="vacancy-alternatives-lead">
							Если хочется выбрать осознанно — рядом подобраны самые близкие вакансии с&nbsp;коротким объяснением,
							чем они отличаются от&nbsp;этой, и&nbsp;ключевые разделы сайта по&nbsp;теме.
						</p>

						<div class="vacancy-alternatives-grid">
							{alternativesWithDiff.map(({ job: other, diff }) => (
								<a class="vacancy-alternative-card" href={`/v/${other.slug}/`}>
									<span class="vacancy-alternative-diff">{diff}</span>
									<strong class="vacancy-alternative-title" data-t={`vacancies.${other.id}.title`}>{other.title}</strong>
									<span class="vacancy-alternative-company" data-t={`vacancies.${other.id}.company`}>{other.company}</span>
									<dl class="vacancy-alternative-meta">
										<div>
											<dt>Доход</dt>
											<dd data-t={`vacancies.${other.id}.salary`}>{other.salary}</dd>
										</div>
										<div>
											<dt>Город</dt>
											<dd data-t={`vacancies.${other.id}.location`}>{other.location}</dd>
										</div>
										<div>
											<dt>Выплаты</dt>
											<dd data-t={`vacancies.${other.id}.details_payment_freq`}>{other.details.payment_freq}</dd>
										</div>
									</dl>
								</a>
							))}
						</div>

						<div class="vacancy-alternatives-deeplinks">
							<a class="vacancy-alternatives-deeplink" href="/compare/">Сравнить рядом до 4 вакансий →</a>
							<a class="vacancy-alternatives-deeplink" href={companyUrl}>Все вакансии {job.company} →</a>
							{cityLinks.length > 0 && (
								<a class="vacancy-alternatives-deeplink" href={cityLinks[0].href}>
									Курьерские вакансии в {cityLinks[0].name} →
								</a>
							)}
							<a class="vacancy-alternatives-deeplink" href="/guide/">Гид для курьера: возраст, медкнижка, доход, налоги →</a>
						</div>
					</section>
				</div>

				<aside class="vacancy-sidebar">
					<div class="vacancy-card-sidebar">
						<h3 data-t="vacancy.details_title">Детали</h3>
						<div class="detail-item">
							<strong data-t="vacancy.location">Локация:</strong> <span data-t={`vacancies.${job.id}.location`}>{job.location}</span>
						</div>
						<div class="detail-item">
							<strong data-t="job.schedule">График:</strong> <span data-t={`vacancies.${job.id}.details_schedule`}>{job.details.schedule}</span>
						</div>
						<div class="detail-item">
							<strong data-t="vacancy.payment">Оплата:</strong> <span data-t={`vacancies.${job.id}.details_payment_freq`}>{job.details.payment_freq}</span>
						</div>
						<div class="detail-item">
							<strong data-t="vacancy.age">Возраст:</strong> <span data-t={`vacancies.${job.id}.details_age`}>{job.details.age}</span>
						</div>
						<div class="detail-item">
							<strong data-t="vacancy.employment">Оформление:</strong> <span data-t={`vacancies.${job.id}.details_employment_type`}>{job.details.employment_type}</span>
						</div>
						
						{isLeadFormApply ? (
							<>
								<button
									type="button"
									class="apply-btn-large"
									data-t="vacancy.apply"
									data-apply-cta
									data-apply-position="vacancy_sidebar"
									data-apply-company={job.company}
									data-apply-city={job.location}
									data-apply-transport={job.transport}
									data-apply-employment={employmentTypeText}
									data-apply-salary-max={salaryMaxNumeric || ''}
									data-lead-form-type={leadFormType}
									data-ozon-vacancy={job.ozonLeadForm?.vacancy}
									data-ozon-customer={job.ozonLeadForm?.customer}
									data-ozon-city-id={job.ozonLeadForm?.cityID}
									data-ozon-hire-object-uuid={job.ozonLeadForm?.hireObjectUUID}
								>
									Откликнуться через нас
								</button>
								<p class="apply-note">Заполните форму — мы&nbsp;перезвоним и&nbsp;поможем зарегистрироваться с&nbsp;нашим реферальным кодом</p>
							</>
						) : hasApplyLink ? (
							<>
								<a
									href={job.applyLink}
									target="_blank"
									rel="noopener noreferrer nofollow sponsored"
									class="apply-btn-large"
									data-t="vacancy.apply"
									data-apply-cta
									data-apply-position="vacancy_sidebar"
									data-apply-company={job.company}
									data-apply-city={job.location}
									data-apply-transport={job.transport}
									data-apply-employment={employmentTypeText}
									data-apply-salary-max={salaryMaxNumeric || ''}
								>
									Откликнуться сейчас
								</a>
								<p class="apply-note" data-t="vacancy.apply_note">Вы перейдете на сайт прямого работодателя</p>
							</>
						) : (
							<>
								<a href="/contacts/" class="apply-btn-large apply-btn-disabled" data-t="vacancy.apply_disabled">
									Уточнить условия
								</a>
								<p class="apply-note" data-t="vacancy.apply_disabled_note">Для этой вакансии прямая ссылка пока не добавлена</p>
							</>
						)}
						<div class="vacancy-income-calculator" id="vacancy-income-calculator" data-hourly-rate={hourlyRate ?? ''} data-city={job.location} data-transport={job.transport}>
							<p class="vacancy-income-eyebrow">Калькулятор дохода</p>
							{hourlyRate ? (
								isEstimatedHourlyRate ? (
									<p class="vacancy-income-rate">
										Средняя ставка курьеров в&nbsp;этом городе: <strong>{formattedHourlyRate}</strong>
										<small> · у&nbsp;этой вакансии посменная оплата, итог зависит от&nbsp;количества смен и&nbsp;надбавок.</small>
									</p>
								) : (
									<p class="vacancy-income-rate">Ставка в этой вакансии: <strong>{formattedHourlyRate}</strong></p>
								)
							) : (
								<p class="vacancy-income-rate vacancy-income-rate-muted">Почасовая ставка в источнике не указана. Расчет станет доступен после обновления данных.</p>
							)}
							<div class="vacancy-income-controls">
								<label class="vacancy-income-label" for="vacancy-days-range">
									<span>Дней в месяц</span>
									<strong id="vacancy-days-value">22</strong>
								</label>
								<input
									class="vacancy-income-range"
									type="range"
									id="vacancy-days-range"
									min="1"
									max="31"
									step="1"
									value="22"
									disabled={hourlyRate === null}
								/>
								<label class="vacancy-income-label" for="vacancy-hours-range">
									<span>Часов в день</span>
									<strong id="vacancy-hours-value">8</strong>
								</label>
								<input
									class="vacancy-income-range"
									type="range"
									id="vacancy-hours-range"
									min="1"
									max="16"
									step="1"
									value="8"
									disabled={hourlyRate === null}
								/>
							</div>
							<div class="vacancy-income-output" aria-live="polite">
								<span data-t="calculator.result">Примерный доход</span>
								<strong id="vacancy-income-total">{hourlyRate ? `${new Intl.NumberFormat('ru-RU').format(hourlyRate * 22 * 8)} ₽` : 'Нет данных по ставке'}</strong>
								<small id="vacancy-income-formula">{hourlyRate ? `22 дн × 8 ч × ${formattedHourlyRate}` : 'Калькулятор ожидает почасовую ставку этой вакансии.'}</small>
							</div>
						</div>
					</div>
				</aside>
			</div>

			<ReviewsBlock jobId={job.id} />

			{isMoscowVacancy && <PartnerBanner />}
		</div>
	</main>

	<Footer />
</BaseLayout>

<script is:inline>
	const vacancyIncomeCalculator = document.getElementById('vacancy-income-calculator');

	if (vacancyIncomeCalculator) {
		const hourlyRate = Number.parseInt(vacancyIncomeCalculator.dataset.hourlyRate ?? '', 10);
		if (Number.isFinite(hourlyRate) && hourlyRate > 0) {
			const daysRange = vacancyIncomeCalculator.querySelector('#vacancy-days-range');
			const hoursRange = vacancyIncomeCalculator.querySelector('#vacancy-hours-range');
			const daysValue = vacancyIncomeCalculator.querySelector('#vacancy-days-value');
			const hoursValue = vacancyIncomeCalculator.querySelector('#vacancy-hours-value');
			const totalValue = vacancyIncomeCalculator.querySelector('#vacancy-income-total');
			const formulaValue = vacancyIncomeCalculator.querySelector('#vacancy-income-formula');

			let lastTotal = 0;

			const updateIncome = () => {
				const days = Number.parseInt(daysRange?.value ?? '22', 10);
				const hours = Number.parseInt(hoursRange?.value ?? '8', 10);
				const total = Math.round(days * hours * hourlyRate);
				const formattedRate = `${hourlyRate.toLocaleString('ru-RU')} ₽/час`;

				if (daysValue) daysValue.textContent = String(days);
				if (hoursValue) hoursValue.textContent = String(hours);
				if (totalValue) totalValue.textContent = `${total.toLocaleString('ru-RU')} ₽`;
				if (formulaValue) formulaValue.textContent = `${days} дн × ${hours} ч × ${formattedRate}`;
				lastTotal = total;
			};

			const dispatchVacancyCalcSubmit = () => {
				const days = Number.parseInt(daysRange?.value ?? '22', 10);
				const hours = Number.parseInt(hoursRange?.value ?? '8', 10);
				window.dispatchEvent(new CustomEvent('kurieros:calculator-submit', {
					detail: {
						source: 'vacancy_income_calculator',
						city: vacancyIncomeCalculator.dataset.city || '',
						transport: vacancyIncomeCalculator.dataset.transport || '',
						hours_per_day: hours,
						days_per_month: days,
						result_monthly: lastTotal
					}
				}));
			};

			daysRange?.addEventListener('input', updateIncome);
			hoursRange?.addEventListener('input', updateIncome);
			daysRange?.addEventListener('change', dispatchVacancyCalcSubmit);
			hoursRange?.addEventListener('change', dispatchVacancyCalcSubmit);
			updateIncome();
		}
	}
</script>

