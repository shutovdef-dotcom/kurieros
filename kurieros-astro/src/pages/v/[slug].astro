---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VacancyStickyApply from '../../components/VacancyStickyApply.astro';
import ReviewsBlock from '../../components/ReviewsBlock.astro';
import PartnerBanner from '../../components/PartnerBanner.astro';
import VacancyBreadcrumb from '../../components/vacancy/VacancyBreadcrumb.astro';
import VacancyHero from '../../components/vacancy/VacancyHero.astro';
import VacancyFactsTable from '../../components/vacancy/VacancyFactsTable.astro';
import VacancyContentSections from '../../components/vacancy/VacancyContentSections.astro';
import VacancyKnowledgeBase from '../../components/vacancy/VacancyKnowledgeBase.astro';
import VacancyQuickSummary from '../../components/vacancy/VacancyQuickSummary.astro';
import VacancyHowTo from '../../components/vacancy/VacancyHowTo.astro';
import VacancyIncomeScenarios from '../../components/vacancy/VacancyIncomeScenarios.astro';
import VacancySimilar from '../../components/vacancy/VacancySimilar.astro';
import VacancyOtherCities from '../../components/vacancy/VacancyOtherCities.astro';
import VacancySidebar from '../../components/vacancy/VacancySidebar.astro';
import jobsData from '../../data/jobs';
import { vacancySources } from '../../data/vacancies';
import type { VacancyOffer } from '../../data/vacancyTypes';
import { slugifyCompany } from '../../utils/companies';
import { getCityHref } from '../../utils/cities';
import { applyHourlyJitter } from '../../utils/fnv1a';
import { getApplyCta } from '../../utils/applyCta';
import { buildBreadcrumbSchema, buildJobPostingSchema } from '../../utils/schema';
import { knowledgeBaseData, type KnowledgeItem } from '../../utils/knowledge';

export async function getStaticPaths() {
	return jobsData.map((job) => ({
		params: { slug: job.slug },
		props: { job },
	}));
}

const { job } = Astro.props;
// `applyLink: 'lead-form:<provider>'` (the constant `OZON_LEAD_APPLY`
// defined in src/data/partnerLinks.ts, wired onto offers in
// src/data/ozonOffers.ts) is a magic marker that swaps the external
// apply CTA for an in-page modal. The page emits a `<button
// data-lead-form-type=…>` instead of an external `<a>`, and the JSON-LD
// schema marks the post as having no direct apply URL (the apply
// happens off-site in the partner's app after we capture the lead via
// the form).
const isLeadFormApply = typeof job.applyLink === 'string' && job.applyLink.startsWith('lead-form:');
const leadFormType = isLeadFormApply ? job.applyLink.slice('lead-form:'.length) : null;
const hasApplyLink = !isLeadFormApply && Boolean(job.applyLink && job.applyLink !== '#');
const companyUrl = `/companies/${slugifyCompany(job.company)}/`;
const parseSalaryValue = (salary: string) => Number(salary.replace(/[^\d]/g, '')) || 0;
const parseAmountFromText = (value?: string) => {
	if (!value) return null;
	const normalized = value.replace(/[\u00a0\u202f]/g, ' ');
	const match = normalized.match(/(\d[\d\s]*)/);
	if (!match) return null;
	const parsed = Number(match[1].replace(/\s+/g, ''));
	return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
};
const parseHourlyRateFromRateText = (value: string) => {
	const normalized = value.replace(/[\u00a0\u202f]/g, ' ');
	if (!/(час|hour|soat|соат|саат|ժам|сағ|год|гадз|घंट|giờ|小时)/i.test(normalized)) {
		return null;
	}
	const match = normalized.match(/(\d[\d\s]*)\s*₽/);
	if (!match) return null;
	const parsed = Number(match[1].replace(/\s+/g, ''));
	return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
};
const resolveHourlyRate = (offer?: VacancyOffer) => {
	if (!offer) return null;
	const numericRate =
		(typeof offer.pay.hourly?.max === 'number' && Number.isFinite(offer.pay.hourly.max) ? offer.pay.hourly.max : null) ??
		(typeof offer.pay.hourly?.min === 'number' && Number.isFinite(offer.pay.hourly.min) ? offer.pay.hourly.min : null);
	if (numericRate && numericRate > 0) {
		return numericRate;
	}
	return parseAmountFromText(offer.pay.hourly?.text);
};
const salaryValue = parseSalaryValue(job.salary);
const matchingSource = vacancySources.find((source) => source.id === job.sourceId);
const matchingOffer =
	matchingSource?.offers.find(
		(offer) =>
			offer.isActive &&
			offer.city === job.location &&
			offer.transport === job.transport &&
			(offer.applyLink ?? '#') === job.applyLink,
	) ??
	matchingSource?.offers.find(
		(offer) =>
			offer.isActive &&
			offer.city === job.location &&
			offer.transport === job.transport,
	);
// Fallback hourly rate for vacancies whose source data has no
// `pay.hourly` (Ozon, T-Bank, Efin, Альфа). We pick the BEST known
// hourly rate among all active offers in the same city (Yandex Eda or
// Купер typically), then drop it 3-12% via slug-derived jitter — keeps
// the calculator number attractive (close to top of the city) while
// staying unique per vacancy and below the actual top earners.
const computeFallbackHourlyRate = (city: string, slug: string): number | null => {
	let best = 0;
	for (const source of vacancySources) {
		for (const offer of source.offers) {
			if (!offer.isActive || offer.city !== city) continue;
			const rate =
				(typeof offer.pay.hourly?.max === 'number' && Number.isFinite(offer.pay.hourly.max) ? offer.pay.hourly.max : 0) ||
				(typeof offer.pay.hourly?.min === 'number' && Number.isFinite(offer.pay.hourly.min) ? offer.pay.hourly.min : 0) ||
				(parseAmountFromText(offer.pay.hourly?.text) ?? 0);
			if (rate > best) best = rate;
		}
	}
	if (best <= 0) return null;
	// Render-side jitter key — bare slug (one rate per vacancy page).
	// Formula owned by `applyHourlyJitter` (audit ref v3 M4).
	return applyHourlyJitter(best, slug);
};

const directHourlyRate = resolveHourlyRate(matchingOffer) ?? parseHourlyRateFromRateText(job.details.rate);
const fallbackHourlyRate = directHourlyRate === null
	? computeFallbackHourlyRate(job.location, job.slug)
	: null;
const hourlyRate = directHourlyRate ?? fallbackHourlyRate;
const isEstimatedHourlyRate = directHourlyRate === null && fallbackHourlyRate !== null;
const formattedHourlyRate = hourlyRate ? `${new Intl.NumberFormat('ru-RU').format(hourlyRate)} ₽/час` : null;
const jobCities = job.location
	.split(',')
	.map((city: string) => city.trim())
	.filter((city: string) => city && city !== 'Вся Россия');
const isMoscowVacancy = jobCities.includes('Москва');
const cityLinks = jobCities.map((city) => ({
	name: city,
	href: getCityHref(city),
}));
const currentCitySet = new Set(jobCities);
// HV20 — «Похожие на эту вакансию» с трёхуровневой сортировкой:
//   Tier 1 (top): другая компания + тот же транспорт + тот же город
//                 — самые релевантные «прямые альтернативы».
//   Tier 2:       любая вакансия из того же города (включая ту же
//                 компанию на другом транспорте, или другие компании).
//   Tier 3:       вакансии из других городов — fill, если предыдущих
//                 не хватило для top-6.
// Внутри каждого tier сортировка по убыванию зарплаты.
type SimilarTier = 1 | 2 | 3;
function getSimilarityTier(item: typeof job): SimilarTier {
	const itemCities = item.location
		.split(',')
		.map((city: string) => city.trim())
		.filter((city: string) => city && city !== 'Вся Россия');
	const isSameCity =
		itemCities.some((city: string) => currentCitySet.has(city)) ||
		item.location === 'Вся Россия';
	const isSameTransport = item.transport === job.transport;
	const isDifferentCompany = item.company !== job.company;
	if (isDifferentCompany && isSameTransport && isSameCity) return 1;
	if (isSameCity) return 2;
	return 3;
}
// Bounded top-N selection (audit ref v3 H2 / NEW-1). The previous
// implementation sorted the ENTIRE ~4,800-job list — allocating a
// ~4,785-element wrapper array and running an O(n log n) sort — on
// every one of the 4,786 `/v/` pages, just to keep the leading 6.
//
// `selectTopN` does a single O(n) pass keeping only the `n` best.
// `project` is run ONCE per item (it computes the sort key — here a
// `{ tier, salaryValue }` pair; `getSimilarityTier` does string
// splitting, so it must not re-run inside the comparator), and the
// raw item + its key are kept together. `compare` orders by the key.
//
// It reproduces `items.map(...).sort(compare).slice(0, n)` EXACTLY,
// including the stable tie-break: a candidate is inserted at the first
// position where it is *strictly* better than the element already
// there, so items equal under `compare` keep their original input
// order (`Array.prototype.sort` is stable). Output is byte-identical
// to the old full-sort — but at most `n` wrapper objects ever exist,
// not ~4,785, and there is no array-wide sort.
function selectTopN<T, K>(
	items: readonly T[],
	n: number,
	project: (item: T) => K,
	compare: (a: K, b: K) => number,
): T[] {
	if (n <= 0) return [];
	const kept: Array<{ item: T; key: K }> = [];
	for (const item of items) {
		const key = project(item);
		let index = 0;
		while (index < kept.length && compare(key, kept[index].key) >= 0) {
			index++;
		}
		if (index >= n) continue; // not better than any of the n kept
		kept.splice(index, 0, { item, key });
		if (kept.length > n) kept.length = n;
	}
	return kept.map((entry) => entry.item);
}

const SIMILAR_JOBS_LIMIT = 6;
const similarJobs = selectTopN(
	jobsData.filter((item) => item.slug !== job.slug),
	SIMILAR_JOBS_LIMIT,
	(item) => ({ tier: getSimilarityTier(item), salaryValue: parseSalaryValue(item.salary) }),
	(a, b) => a.tier - b.tier || b.salaryValue - a.salaryValue,
);
// Build a tight «benefit tail» — up to 2 hooks NOT redundant with the
// leading «salary • schedule • payment_freq» line. Used to boost CTR
// on long-tail SERP queries like «работа курьером без опыта», «без
// медкнижки», «от 18 лет», «самозанятость». Order reflects observed
// CTR uplift in job-search SERPs.
const benefitHooks: string[] = (() => {
	const labels = (job.labels ?? []).map((l) => l.toLowerCase());
	const hooks: string[] = [];
	const noExperience = labels.some((l) => l.includes('без опыта'));
	const requiresMedical = labels.some((l) => l.includes('медкнижк'));
	const acceptsAge16 = labels.some((l) => l.includes('16'));
	const acceptsAge18 = !acceptsAge16 && labels.some((l) => l.includes('18'));
	const isSelfEmployed = labels.some((l) => l.includes('самозан'));
	if (noExperience) hooks.push('без опыта');
	if (!requiresMedical) hooks.push('без медкнижки');
	if (acceptsAge16) hooks.push('от 16 лет');
	else if (acceptsAge18) hooks.push('от 18 лет');
	if (isSelfEmployed && hooks.length < 2) hooks.push('самозанятость');
	return hooks.slice(0, 2);
})();

// Number-led, action-led title: front-load salary (Google's primary
// CTR lever for job-search SERPs), em-dash for visual separation,
// and the first benefit hook in the trailing slot — but only when
// the whole thing fits in the 70-char SERP truncation budget.
const vacancyTitleBase = `${job.title} — ${job.salary}`;
const vacancyTitleSuffix = ' | КурьерОк';
const vacancyTitleWithHook = benefitHooks[0]
	? `${vacancyTitleBase} · ${benefitHooks[0]}${vacancyTitleSuffix}`
	: `${vacancyTitleBase}${vacancyTitleSuffix}`;
const vacancyTitle = vacancyTitleWithHook.length <= 70
	? vacancyTitleWithHook
	: `${vacancyTitleBase}${vacancyTitleSuffix}`.slice(0, 70);

// Description rewritten for CTR: salary first (numerical hook), then a
// scannable «график · оплата» bullet, role+city, up to 2 benefit hooks
// (long-tail), and a concrete same-day-callback CTA. Drops the
// redundant «{title} в {company}, {city}» preamble — title already
// carries that, so we save chars for hooks that move clicks.
const benefitClause = benefitHooks.length
	? `${benefitHooks[0].charAt(0).toUpperCase()}${benefitHooks[0].slice(1)}${benefitHooks[1] ? `, ${benefitHooks[1]}` : ''}. `
	: '';
// Use the company's short name in the CTA so descriptions for
// long-named companies (e.g. «Купер (ex. СберМаркет)») don't get
// truncated mid-word at the 170-char SERP limit.
const companyShortName = job.company.replace(/\s*\(.+?\)\s*$/, '').trim() || job.company;

// «Сравните с X, Y» — single phrase that differentiates kurerok.ru from
// official company sites for brand-query traffic. GSC показывает 59
// показов / 0 кликов на «яндекс курьер работа» — пользователь идёт
// напрямую на yandex.ru/eda и пропускает агрегатор. Эта фраза в
// description-сниппете говорит SERP-юзеру что у нас он получит
// СРАВНЕНИЕ нескольких компаний — то, чего нет на официальном сайте.
//
// Filter: skip the brand whose alias appears in `job.company`. Need
// alias matching because actual `job.company` strings вперемешку:
// «Яндекс Еда» (Cyrillic), «Купер (ex. СберМаркет)», «Ozon» (Latin).
const COMPARISON_BRANDS: Array<{ display: string; aliases: string[] }> = [
	{ display: 'Яндекс.Еда', aliases: ['яндекс еда', 'yandex eda', 'я.еда', 'яндекс.еда'] },
	{ display: 'Купер',      aliases: ['купер', 'kuper', 'сбермаркет'] },
	{ display: 'Ozon',       aliases: ['ozon', 'озон'] },
	{ display: 'Самокат',    aliases: ['самокат', 'samokat'] },
];
const comparisonAlternatives = COMPARISON_BRANDS.filter((brand) => {
	const lowerCompany = job.company.toLowerCase();
	return !brand.aliases.some((alias) => lowerCompany.includes(alias));
})
	.slice(0, 2)
	.map((brand) => brand.display);
const comparisonClause = comparisonAlternatives.length
	? `На kurerok.ru сравните с ${comparisonAlternatives.join(', ')}. `
	: '';

const buildVacancyDescription = (withBenefits: boolean): string =>
	[
		`${job.salary} • ${job.details.schedule.toLowerCase()} • ${job.details.payment_freq.toLowerCase()}.`,
		`${job.title}.`,
		`${withBenefits ? benefitClause : ''}${comparisonClause}${companyShortName} перезвонит сегодня.`,
	].join(' ');
// Word-boundary trim: never cut a description mid-word at 170. If the
// 170-char window lands inside a word, step back to the previous space
// and append «…».
const trimAtWordBoundary = (s: string, max: number): string => {
	if (s.length <= max) return s;
	const cut = s.slice(0, max);
	const lastSpace = cut.lastIndexOf(' ');
	return lastSpace > max - 40 ? `${cut.slice(0, lastSpace)}…` : `${cut}…`;
};
const fullDescription = buildVacancyDescription(true);
const vacancyDescription = fullDescription.length <= 170
	? fullDescription
	: trimAtWordBoundary(buildVacancyDescription(false), 170);
const datePosted = (() => {
	const parsed = job.updatedAt ? new Date(job.updatedAt) : null;
	return parsed && !Number.isNaN(parsed.getTime()) ? parsed.toISOString() : new Date().toISOString();
})();
const validThrough = (() => {
	const base = new Date(datePosted);
	base.setDate(base.getDate() + 60);
	return base.toISOString();
})();
const factCards = [
	{ label: 'Доход', labelKey: 'vacancy.fact_income', value: job.salary, valueKey: `vacancies.${job.id}.salary` },
	{ label: 'График', labelKey: 'vacancy.fact_schedule', value: job.details.schedule, valueKey: `vacancies.${job.id}.details_schedule` },
	{ label: 'Возраст', labelKey: 'vacancy.fact_age', value: job.details.age, valueKey: `vacancies.${job.id}.details_age` },
	{ label: 'Выплаты', labelKey: 'vacancy.fact_payments', value: job.details.payment_freq, valueKey: `vacancies.${job.id}.details_payment_freq` },
	{ label: 'Гражданство', labelKey: 'vacancy.fact_citizenship', value: job.details.citizenship, valueKey: `vacancies.${job.id}.details_citizenship` },
	{ label: 'Оформление', labelKey: 'vacancy.fact_employment', value: job.details.employment_type, valueKey: `vacancies.${job.id}.details_employment_type` },
];
const updatedDate = new Intl.DateTimeFormat('ru-RU', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(new Date());

// Map vacancy-source slugs (e.g. 'yandex-eda-courier') to the
// knowledge-base company_scope IDs (e.g. 'yandex-eda').
const KB_COMPANY_BY_PREFIX: ReadonlyArray<readonly [string, string]> = [
	['yandex-eda', 'yandex-eda'],
	['kuper', 'kuper'],
	['tbank', 't-bank'],
	['efin', 't-bank'],
	['alfa-bank', 'alfa-bank'],
	['samokat', 'samokat'],
	['ozon', 'ozon'],
	['dostavista', 'dostavista'],
];
const inferKbCompanyId = (sourceSlug: string | undefined): string | null => {
	if (!sourceSlug) return null;
	for (const [prefix, kbId] of KB_COMPANY_BY_PREFIX) {
		if (sourceSlug.startsWith(prefix)) return kbId;
	}
	return null;
};

// Score knowledge-base items against this specific vacancy and return
// the most relevant N. Designed so the page shows answers that
// actually match the company, transport, geo and employment format —
// not generic SEO boilerplate.
const pickKbItemsForVacancy = (limit: number): KnowledgeItem[] => {
	const kbCompanyId = inferKbCompanyId(matchingSource?.slug);
	const transport = job.transport;
	const isMoscow = isMoscowVacancy;
	const isSpb = jobCities.includes('Санкт-Петербург');
	const employmentTypes = job.details.employment_type ?? '';
	const requiresSelfEmployed = /Самозанят/i.test(employmentTypes);
	const requiresGph = /ГПХ/i.test(employmentTypes);
	const isBankRep = kbCompanyId === 'alfa-bank' || kbCompanyId === 't-bank';

	const candidates = kbCompanyId
		? knowledgeBaseData.items.filter((item) => item.company_scope.includes(kbCompanyId))
		: knowledgeBaseData.items;

	const scored = candidates.map((item) => {
		let score = 0;

		// Geo relevance.
		if (isMoscow && item.geo_scope.includes('msk')) score += 5;
		else if (isSpb && item.geo_scope.includes('spb')) score += 5;
		else if (!isMoscow && !isSpb && item.geo_scope.includes('regions')) score += 4;
		if (item.geo_scope.includes('all')) score += 1;

		// Transport-specific income items: boost the matching one,
		// penalize the mismatching ones (so a foot vacancy doesn't
		// surface auto-courier income).
		if (item.id === 'income-foot-courier-msk') score += transport === 'foot' ? 5 : -4;
		if (item.id === 'income-bike-courier-msk') score += transport === 'bicycle' ? 5 : -4;
		if (item.id === 'income-auto-courier-msk') score += transport === 'auto' ? 5 : -4;
		if (item.id === 'income-bank-rep-msk') score += isBankRep ? 5 : -4;

		// Employment-format relevance.
		if (item.id === 'self-employed-registration' && requiresSelfEmployed) score += 4;
		if (item.id === 'tax-self-employed' && requiresSelfEmployed) score += 3;
		if (item.id === 'training-period' && requiresGph) score += 2;

		// Always-useful baseline boosts.
		if (item.id === 'payment-frequency') score += 2;
		if (item.id === 'schedule-flexibility') score += 1;
		if (item.id === 'find-courier-job') score += 1;
		if (item.id === 'documents-required') score += 1;

		// Medical book — only really matters for food delivery formats.
		if (item.id === 'medical-book') {
			if (transport === 'foot' || transport === 'bicycle') score += 3;
			else score -= 2;
		}

		// Company-specific fines guide.
		if (kbCompanyId && item.id === `fines-${kbCompanyId}`) score += 3;

		// Confidence tie-breaker (small).
		score += (item.confidence ?? 0.5) * 0.5;

		return { item, score };
	});

	return scored
		.sort((a, b) => b.score - a.score)
		.slice(0, limit)
		.map((entry) => entry.item);
};

const selectedKbItems = pickKbItemsForVacancy(6);

// Apply CTA — single source of truth in src/utils/applyCta.ts.
// Drift between this and the JobCard copy of the computation directly
// hits GA4 `apply_click` value and visible button text, so the helper
// is the only place this lives. Audit ref: v2 H4.
const { salaryMaxNumeric, applyLabel } = getApplyCta(job);

// === SEO+AI block helpers (replace removed «Дальше» block) ===

const formatRubAmount = (value: number) =>
	`${new Intl.NumberFormat('ru-RU').format(Math.round(value))} ₽`;

// Block: 3 concrete income scenarios. Computed only when an hourly
// rate is available — otherwise the block is skipped.
type IncomeScenario = { key: string; label: string; hours: number; shifts: number; income: string };
const incomeScenarios: IncomeScenario[] | null = hourlyRate
	? [
			{ key: 'lite', label: 'Подработка', hours: 4, shifts: 12 },
			{ key: 'std', label: 'Стандарт', hours: 8, shifts: 22 },
			{ key: 'full', label: 'Полная загрузка', hours: 10, shifts: 26 },
		].map((scenario) => ({
			...scenario,
			income: formatRubAmount(scenario.hours * scenario.shifts * hourlyRate),
		}))
	: null;

// Block: HowTo steps tailored to company + transport + employment.
const employmentTypeText = job.details.employment_type ?? '';
const requiresSelfEmployedRegistration = /Самозанят/i.test(employmentTypeText);
const requiresMedicalBookFormat = job.transport === 'foot' || job.transport === 'bicycle';
const isBankRepresentativeRole =
	matchingSource?.slug?.startsWith('alfa-bank') ||
	matchingSource?.slug?.startsWith('tbank') ||
	matchingSource?.slug?.startsWith('efin');

type HowToStep = { name: string; text: string };
const buildHowToSteps = (): HowToStep[] => {
	const steps: HowToStep[] = [];

	// Disabled-vacancy HowTo branch removed per C3 — every vacancy has a
	// real applyLink so we always render the «Fill in the partner form»
	// step.
	steps.push({
		name: `Заполните анкету на сайте ${job.company}`,
		text: `Перейдите по кнопке отклика в карточке. Укажите контакты, город${jobCities[0] ? ` (${jobCities[0]})` : ''}, удобный формат смен и подтвердите согласие на обработку данных.`,
	});

	if (isBankRepresentativeRole) {
		steps.push({
			name: 'Пройдите телефонное собеседование',
			text: `Сотрудник ${job.company} перезвонит в течение 1–2 рабочих дней, обсудит график, район работы и проверит документы.`,
		});
		steps.push({
			name: 'Получите оборудование и обучение',
			text: 'В офисе банка выдадут планшет и форму. Обучение оплачиваемое, длится 3–7 дней — изучаются продукты, скрипты и правила безопасности.',
		});
		steps.push({
			name: 'Выходите на встречи с клиентами',
			text: `Маршруты приходят в приложение представителя. Выплаты — ${job.details.payment_freq.toLowerCase()}, формат оформления — ${employmentTypeText.toLowerCase()}.`,
		});
	} else {
		if (requiresSelfEmployedRegistration) {
			steps.push({
				name: 'Оформите самозанятость в «Мой налог»',
				text: 'Регистрация бесплатная, занимает 5 минут — нужны паспорт и ИНН. Налог: 4% с дохода от физлиц, 6% с юрлиц. Без отчётности и страховых взносов.',
			});
		}
		if (requiresMedicalBookFormat) {
			steps.push({
				name: 'Оформите медицинскую книжку',
				text: `Обязательна для ${job.transport === 'foot' ? 'пешей' : 'велосипедной'} доставки еды. Стоит 2500–4000 ₽, оформляется за 1 рабочий день в платных клиниках с лицензией Роспотребнадзора.`,
			});
		}
		steps.push({
			name: 'Скачайте приложение и пройдите вводное обучение',
			text: `Получите доступ к приложению курьера ${job.company}. Внутри: 15-минутный инструктаж, тарифы, правила работы со штрафами и поддержкой.`,
		});
		steps.push({
			name: 'Выходите на первую смену',
			text: `Открывайте слоты в приложении и принимайте заказы. Выплаты — ${job.details.payment_freq.toLowerCase()}, ставка по этой вакансии — ${job.salary.toLowerCase()}.`,
		});
	}

	return steps.slice(0, 5);
};

const howToSteps = buildHowToSteps();
const stepCountWord =
	howToSteps.length === 1 ? 'шаг' : howToSteps.length < 5 ? 'шага' : 'шагов';
const howToTitle = `Старт за ${howToSteps.length} ${stepCountWord}: ${job.title}`;
const howToDescription = `Пошаговый план: с чего начать работу в ${job.company}${jobCities[0] ? ` (${jobCities[0]})` : ''}, что подготовить и в какой срок реально выйти на первую смену.`;

// Block: dense one-paragraph fact summary. Designed for Speakable
// schema and direct quoting by AI assistants — every clause answers a
// distinct intent (доход / график / возраст / оформление / отклик).
// `job.title` already includes the company + city, so we don't repeat
// them in the opening sentence.
const quickFactSummary = (() => {
	const parts: string[] = [];
	parts.push(`${job.title}.`);
	parts.push(`Доход — ${job.salary}, выплаты ${job.details.payment_freq.toLowerCase()}.`);
	parts.push(`График — ${job.details.schedule.toLowerCase()}.`);
	parts.push(`Возраст: ${job.details.age.toLowerCase()}, гражданство — ${job.details.citizenship}.`);
	parts.push(`Формат оформления: ${employmentTypeText}.`);
	if (
		job.details.transport_provision &&
		job.details.transport_provision !== 'Транспорт не требуется'
	) {
		parts.push(`Транспорт: ${job.details.transport_provision.toLowerCase()}.`);
	}
	// Disabled-vacancy summary branch removed per C3 — every vacancy
	// has a real applyLink, so the message is unconditional.
	parts.push('Откликнуться можно сразу — кнопка ведёт на сайт работодателя.');
	return parts.join(' ');
})();

// «Эта роль в других городах» — дешёвый внутренний linkback для
// пользователей без жёсткой привязки к городу (приехали по запросу
// «работа курьером Озон» без указания города, или готовы к релокации).
// Сейчас они часто отскакивают, увидев один город — добавляем
// 4-12 кнопок «та же вакансия, другие города», отсортированных по
// зарплате. sourceId — стабильный ключ роли (общий для всех city/transport
// вариантов одного `VacancySource`), см. `src/data/vacancyTypes.ts:142`.
// `selectTopN` keeps only the leading 12 in a single O(n) pass and
// runs `parseSalaryValue` ONCE per item (via `project`) instead of
// twice per comparison — same full-`.sort()` anti-pattern that
// `selectTopN` already eliminated for `similarJobs`. Audit ref v5 M5.
const SAME_ROLE_OTHER_CITIES_LIMIT = 12;
const sameRoleOtherCities = selectTopN(
	jobsData.filter((item) => item.sourceId === job.sourceId && item.slug !== job.slug),
	SAME_ROLE_OTHER_CITIES_LIMIT,
	(item) => parseSalaryValue(item.salary),
	(a, b) => b - a,
);

const pageSchemaGraph = [
	{
		'@type': 'WebPage',
		name: `${job.title} — Вакансия в ${job.company}`,
		description: vacancyDescription,
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		about: {
			'@type': 'Organization',
			name: job.company,
			url: new URL(companyUrl, Astro.site).toString(),
		},
		// Voice-assistant hint: read the dense fact summary on request.
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['#vacancy-quick-summary-text'],
		},
	},
	{
		'@type': 'HowTo',
		name: howToTitle,
		description: howToDescription,
		totalTime: 'P1D',
		step: howToSteps.map((step, index) => ({
			'@type': 'HowToStep',
			position: index + 1,
			name: step.name,
			text: step.text,
		})),
	},
	buildJobPostingSchema({
		title: job.title,
		description: job.description,
		slug: job.slug,
		company: job.company,
		companyUrl: new URL(companyUrl, Astro.site).toString(),
		companyLogo: job.companyLogo,
		cities: jobCities,
		employmentTypeLabel: job.details.employment_type,
		qualifications: [...job.requirements, ...job.requiredDocuments].join('; '),
		benefits: job.benefits.join('; '),
		hasApplyLink,
		applyLink: job.applyLink,
		baseSalaryMonthly: salaryValue,
		hourlyRate,
		currency: job.currency || 'RUB',
		datePosted,
		validThrough,
	}),
	{
		'@type': 'FAQPage',
		// Source the FAQ schema from the curated knowledge base instead
		// of the previous boilerplate template, so the structured data
		// reflects the same answers shown on the page.
		mainEntity: selectedKbItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer_long || item.answer_short,
			},
		})),
	},
	buildBreadcrumbSchema(
		[
			{ name: 'Главная', url: '/' },
			{ name: 'Компании', url: '/companies/' },
			{ name: job.company, url: companyUrl },
			{ name: job.title, url: Astro.url.pathname },
		],
		Astro.site,
	),
];
---

<BaseLayout
	title={vacancyTitle}
	titleKey={`vacancies.${job.id}.page_title`}
	description={vacancyDescription}
	descriptionKey={`vacancies.${job.id}.page_description`}
	schemaGraph={pageSchemaGraph}
>
	<Header />

	<main class="vacancy-page" data-vacancy-source-slug={job.sourceSlug}>
		<div class="container container-narrow">
			<VacancyBreadcrumb job={job} companyUrl={companyUrl} />

			<VacancyHero
				job={job}
				companyUrl={companyUrl}
				cityLinks={cityLinks}
				updatedDate={updatedDate}
				isLeadFormApply={isLeadFormApply}
				leadFormType={leadFormType}
				salaryMaxNumeric={salaryMaxNumeric}
				applyLabel={applyLabel}
				employmentTypeText={employmentTypeText}
			/>

			<VacancyFactsTable factCards={factCards} />

			<div class="vacancy-content-grid">
				<div class="vacancy-main">
					<VacancyContentSections job={job} />

					<VacancyKnowledgeBase
						companyName={job.company}
						updatedDate={updatedDate}
						items={selectedKbItems}
					/>

					<VacancyQuickSummary summary={quickFactSummary} />

					<VacancyHowTo
						title={howToTitle}
						description={howToDescription}
						steps={howToSteps}
					/>

					{incomeScenarios && (
						<VacancyIncomeScenarios
							formattedHourlyRate={formattedHourlyRate ?? ''}
							scenarios={incomeScenarios}
							requiresSelfEmployedRegistration={requiresSelfEmployedRegistration}
						/>
					)}

					<VacancySimilar jobs={similarJobs} />

					<VacancyOtherCities jobs={sameRoleOtherCities} currentCity={jobCities[0] ?? 'здесь'} />
				</div>

				<VacancySidebar
					job={job}
					isLeadFormApply={isLeadFormApply}
					leadFormType={leadFormType}
					salaryMaxNumeric={salaryMaxNumeric}
					applyLabel={applyLabel}
					employmentTypeText={employmentTypeText}
					hourlyRate={hourlyRate}
					formattedHourlyRate={formattedHourlyRate}
					isEstimatedHourlyRate={isEstimatedHourlyRate}
				/>
			</div>

			<ReviewsBlock jobId={job.id} />

			{isMoscowVacancy && <PartnerBanner />}
		</div>
		<VacancyStickyApply />
	</main>

	<Footer />
</BaseLayout>

<style>
	.vacancy-page {
		/* All --vacancy-* tokens route through global design tokens
		   (themes.css). Dark-mode values are overridden below in
		   :global(body.dark-mode) .vacancy-page. */
		--vacancy-ink: var(--ink-800);
		--vacancy-muted: var(--ink-500);
		--vacancy-eyebrow: var(--ink-500);
		--vacancy-border: var(--ink-200);
		--vacancy-border-strong: var(--ink-200);
		--vacancy-chip-border: var(--ink-200);
		--vacancy-card: var(--ink-0);
		--vacancy-soft: var(--ink-50);
		--vacancy-soft-strong: var(--ink-100);
		--vacancy-action: var(--brand-800);
		--vacancy-action-hover: var(--brand-700);
		--vacancy-focus: var(--brand-500);
		--vacancy-panel-gradient: linear-gradient(135deg, var(--ink-50) 0%, var(--ink-0) 54%, var(--ink-50) 100%);
		--vacancy-card-gradient: linear-gradient(180deg, var(--ink-0) 0%, var(--ink-50) 100%);
		--vacancy-route-gradient: linear-gradient(180deg, var(--ink-0) 0%, var(--ink-50) 100%);
		--vacancy-shadow: var(--shadow-sm);
		--vacancy-shadow-strong: var(--shadow-md);
		padding: 2rem 0 4rem;
		background: linear-gradient(180deg, var(--ink-0) 0%, var(--ink-50) 100%);
		color: var(--vacancy-ink);
	}
	.container-narrow {
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	.vacancy-content-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 2rem;
	}
	@media (max-width: 768px) {
		.vacancy-content-grid {
			grid-template-columns: 1fr;
		}
	}
	:global(body.dark-mode) .vacancy-page {
		/* All values derived from global --ink-* and --brand-* tokens
		   so /v/[slug] dark mode stays in lock-step with the rest of
		   the site (warm coal palette, not cool slate). */
		--vacancy-ink: var(--ink-800);
		--vacancy-muted: var(--ink-500);
		--vacancy-eyebrow: var(--ink-600);
		--vacancy-border: var(--ink-200);
		--vacancy-border-strong: var(--ink-300);
		--vacancy-chip-border: var(--ink-200);
		--vacancy-card: var(--ink-100);
		--vacancy-soft: var(--ink-150);
		--vacancy-soft-strong: var(--ink-200);
		--vacancy-action: var(--dm-green-surface);
		--vacancy-action-hover: var(--dm-green-surface-hover);
		--vacancy-focus: var(--dm-green-focus);
		--vacancy-panel-gradient: linear-gradient(
			135deg,
			var(--ink-150) 0%,
			var(--ink-100) 52%,
			var(--ink-150) 100%
		);
		--vacancy-card-gradient: linear-gradient(180deg, var(--ink-100) 0%, var(--ink-150) 100%);
		--vacancy-route-gradient: linear-gradient(180deg, var(--ink-100) 0%, var(--ink-150) 100%);
		--vacancy-shadow: var(--shadow-md);
		--vacancy-shadow-strong: var(--shadow-lg);
		background: var(--ink-50);
	}
</style>
