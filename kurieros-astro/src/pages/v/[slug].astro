		border-spacing: 0;
		font-size: 0.95rem;
		min-width: 360px;
	}
	.vacancy-income-table thead th {
		text-align: left;
		padding: 0.7rem 0.9rem;
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
