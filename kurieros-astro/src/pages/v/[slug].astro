<script is:inline>
	const vacancyIncomeCalculator = document.getElementById('vacancy-income-calculator');

	if (vacancyIncomeCalculator) {
		const hourlyRate = Number.parseInt(vacancyIncomeCalculator.dataset.hourlyRate ?? '', 10);
		if (Number.isFinite(hourlyRate) && hourlyRate > 0) {
			const daysRange = vacancyIncomeCalculator.querySelector('#vacancy-days-range');
			const hoursRange = vacancyIncomeCalculator.querySelector('#vacancy-hours-range');
			const daysValue = vacancyIncomeCalculator.querySelector('#vacancy-days-value');
			const hoursValue = vacancyIncomeCalculator.querySelector('#vacancy-hours-value');
			const totalValue = vacancyIncomeCalculator.querySelector('#vacancy-income-total');
			const formulaValue = vacancyIncomeCalculator.querySelector('#vacancy-income-formula');

			let lastTotal = 0;

			const updateIncome = () => {
				const days = Number.parseInt(daysRange?.value ?? '22', 10);
				const hours = Number.parseInt(hoursRange?.value ?? '8', 10);
				const total = Math.round(days * hours * hourlyRate);
				const formattedRate = `${hourlyRate.toLocaleString('ru-RU')} ₽/час`;

				if (daysValue) daysValue.textContent = String(days);
				if (hoursValue) hoursValue.textContent = String(hours);
				if (totalValue) totalValue.textContent = `${total.toLocaleString('ru-RU')} ₽`;
				if (formulaValue) formulaValue.textContent = `${days} дн × ${hours} ч × ${formattedRate}`;
				lastTotal = total;
			};

			const dispatchVacancyCalcSubmit = () => {
				const days = Number.parseInt(daysRange?.value ?? '22', 10);
				const hours = Number.parseInt(hoursRange?.value ?? '8', 10);
				window.dispatchEvent(new CustomEvent('kurieros:calculator-submit', {
					detail: {
						source: 'vacancy_income_calculator',
						city: vacancyIncomeCalculator.dataset.city || '',
						transport: vacancyIncomeCalculator.dataset.transport || '',
						hours_per_day: hours,
						days_per_month: days,
						result_monthly: lastTotal
					}
				}));
			};

			daysRange?.addEventListener('input', updateIncome);
			hoursRange?.addEventListener('input', updateIncome);
			daysRange?.addEventListener('change', dispatchVacancyCalcSubmit);
			hoursRange?.addEventListener('change', dispatchVacancyCalcSubmit);
			updateIncome();
		}
	}
</script>

<script is:inline>
	// HV19 (rev) — Share button on detail page with RU-market options.
	// Always shows custom dropdown (Telegram / WhatsApp / VK / МАХ /
	// Copy / Ещё). «Ещё» calls `navigator.share()` and is shown only
	// when the API is supported (mobile mainly).
	(function () {
		if (typeof navigator.share === 'function') {
			document.querySelectorAll('.share-option-native').forEach((b) => b.removeAttribute('hidden'));
		}

		function closeAllDropdowns() {
			document.querySelectorAll('.share-dropdown:not([hidden])').forEach((d) => {
				d.setAttribute('hidden', '');
				const trigger = d.parentElement && d.parentElement.querySelector('[data-share-vacancy]');
				if (trigger) trigger.setAttribute('aria-expanded', 'false');
			});
		}

		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;

			const shareBtn = target.closest('[data-share-vacancy]');
			if (shareBtn) {
				event.preventDefault();
				event.stopPropagation();
				const wrap = shareBtn.closest('.share-wrap');
				const dropdown = wrap && wrap.querySelector('.share-dropdown');
				if (!dropdown) return;
				document.querySelectorAll('.share-dropdown:not([hidden])').forEach((d) => {
					if (d !== dropdown) d.setAttribute('hidden', '');
				});
				const willOpen = dropdown.hasAttribute('hidden');
				if (willOpen) {
					dropdown.removeAttribute('hidden');
					shareBtn.setAttribute('aria-expanded', 'true');
				} else {
					dropdown.setAttribute('hidden', '');
					shareBtn.setAttribute('aria-expanded', 'false');
				}
				return;
			}

			const shareOption = target.closest('[data-share-target]');
			if (shareOption) {
				event.preventDefault();
				const wrap = shareOption.closest('.share-wrap');
				const trigger = wrap && wrap.querySelector('[data-share-vacancy]');
				if (!trigger) return;
				const slug = trigger.dataset.shareSlug || '';
				const title = trigger.dataset.shareTitle || 'Вакансия курьера';
				const salary = trigger.dataset.shareSalary || '';
				const url = 'https://kurerok.ru/v/' + slug + '/?utm_source=share&utm_medium=user';
				const text = title + (salary ? ' · ' + salary : '');
				const action = shareOption.dataset.shareTarget;

				if (action === 'telegram') {
					window.open('https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(text), '_blank', 'noopener,noreferrer');
				} else if (action === 'whatsapp') {
					window.open('https://wa.me/?text=' + encodeURIComponent(text + '\n' + url), '_blank', 'noopener,noreferrer');
				} else if (action === 'vk') {
					window.open('https://vk.com/share.php?url=' + encodeURIComponent(url) + '&title=' + encodeURIComponent(title) + '&description=' + encodeURIComponent(salary), '_blank', 'noopener,noreferrer');
				} else if (action === 'max') {
					// МАХ — российский мессенджер от VK / Ростелекома.
					// Web-share URL: https://max.ru/share?url=...&text=...
					// Если глубокая ссылка не сработает — пользователь увидит
					// web-страницу МАХ'а и сможет поделиться там.
					window.open('https://max.ru/share?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(text), '_blank', 'noopener,noreferrer');
				} else if (action === 'copy') {
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(url).then(() => {
							const orig = shareOption.innerHTML;
							shareOption.innerHTML = '<span class="share-option-icon" aria-hidden="true">✓</span> Ссылка скопирована';
							setTimeout(() => { shareOption.innerHTML = orig; }, 1500);
						}).catch(() => {});
					}
				} else if (action === 'native') {
					if (typeof navigator.share === 'function') {
						navigator.share({ title, text, url }).catch(() => {});
					}
				}

				if (action !== 'copy') closeAllDropdowns();

				if (typeof window.gtag === 'function') {
					window.gtag('event', 'share_vacancy', { vacancy_slug: slug, method: action });
				}
				return;
			}

			if (!target.closest('.share-wrap')) {
				closeAllDropdowns();
			}
		}, true);

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeAllDropdowns();
		});
	})();
</script>

