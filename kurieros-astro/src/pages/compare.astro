---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompareFilters from '../components/compare/CompareFilters.astro';
import CompareGrid from '../components/compare/CompareGrid.astro';
import CompareHelpGrid from '../components/compare/CompareHelpGrid.astro';
import CompareHero from '../components/compare/CompareHero.astro';
import jobsData from '../data/jobs';
import { sortCityNamesByPopulation } from '../utils/cities';
// City names are module-cached in `citiesIndex.ts` (H3 rationale)
// instead of re-derived per render (audit ref v4 MEDIUM-1).
import { cityNamesFromJobs } from '../utils/citiesIndex';
import { buildBreadcrumbSchema } from '../utils/schema';
import { mapCompareJob } from '../utils/compareJob';
import type { CompareData, Feature } from '../scripts/compare/types';

// Compare-page browser-side logic lives in a single typed ES module
// (`src/scripts/compare/compareInit.ts`) that Astro bundles and tree-shakes.
// It used to be four `.js` fragments imported via Vite `?raw` and
// string-concatenated into an inline `set:html` script — the fragments
// shared variables through implicit closure with no compile-time check
// (audit v2 M1). Server data is now handed to the bundled module via a
// `<script type="application/json">` tag (see the markup below) instead of
// `define:vars`, which would force `is:inline` and block `import`.

// The slim job → `CompareJob` projection (`mapCompareJob`) and its 3
// label helpers live in `src/utils/compareJob.ts` — the SAME module the
// `/api/v1/compare-jobs.json` endpoint imports, so the 4 preselected jobs
// rendered here and the full catalogue the client lazy-loads can never
// drift in shape (audit v3 M19).

// Only render preselected jobs in HTML (was: all ~4.8k → 3.9 MB page).
// Full job catalog is served from /api/v1/compare-jobs.json and fetched
// lazily by the client only if user has saved compareList in localStorage.
// The preselect count is `MAX_COMPARE_IDS` — the compare-list cap defined
// in src/scripts/compare/compareList.ts (a user can compare at most that
// many jobs, so we inline exactly that many). This frontmatter runs at
// build time but compareList.ts exports the value only as a module-private
// const, so the literal is mirrored here and pinned by
// tests/compareListParity.test.ts.
const MAX_COMPARE_IDS = 4;
const compareJobs = jobsData.slice(0, MAX_COMPARE_IDS).map(mapCompareJob);
const totalCompareJobs = jobsData.length;
const availableCities = sortCityNamesByPopulation(cityNamesFromJobs);

// Typed as `Feature[]` so each `key` is checked against `CompareFeatureKey`
// (the string-valued keys of `CompareJob`) — a typo here is now a compile
// error, not a blank feature row at runtime.
const features: Feature[] = [
  { key: 'salary', name: 'Доход' },
  { key: 'location', name: 'Район работы' },
  { key: 'transport', name: 'Транспорт' },
  { key: 'transport_provision', name: 'Транспортное средство' },
  { key: 'age', name: 'Возраст' },
  { key: 'os', name: 'Операционная система' },
  { key: 'contract', name: 'Оформление' },
  { key: 'citizenship', name: 'Гражданство' },
  { key: 'payout', name: 'Выплаты' },
  { key: 'bonus', name: 'Особенности' },
];

const compareTitle = 'Сравнение вакансий курьеров: что лучше выбрать | КурьерОк';
const compareDescription = 'Сравнение вакансий курьеров по зарплате, выплатам, транспорту и оформлению. Смотрите, что лучше для дохода, старта и стабильности.';

const pageSchemaGraph = [
  {
    '@type': 'CollectionPage',
    name: 'Сравнение вакансий курьеров',
    description: compareDescription,
    url: Astro.url.href,
    dateModified: new Date().toISOString(),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: compareJobs.map((job, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: job.title,
        url: new URL(job.link, Astro.site).toString(),
      })),
    },
  },
  buildBreadcrumbSchema(
    [
      { name: 'Главная', url: '/' },
      { name: 'Сравнение вакансий', url: '/compare/' },
    ],
    Astro.site,
  ),
];

// Server data handed to the bundled `compareInit` module. Serialized into
// a `<script type="application/json">` tag below and parsed by the module
// on `DOMContentLoaded`. We only inline the 4 preselected jobs (the full
// ~4.8k-job catalog is fetched lazily from /api/v1/compare-jobs.json) plus the
// feature-row definitions and total count for the empty-state copy.
const compareData: CompareData = { compareJobs, features, totalCompareJobs };
---

<BaseLayout title={compareTitle} description={compareDescription} schemaGraph={pageSchemaGraph}>
  <Header />

  <main class="compare-page">
    <div class="compare-container">
      <CompareHero />

      <CompareFilters availableCities={availableCities} />

      <CompareGrid compareJobs={compareJobs} features={features} />

      <CompareHelpGrid />

    </div>
  </main>

  <Footer />
</BaseLayout>

{/*
  Server data for the bundled compare module. A `<script type="application/json">`
  tag is inert (the browser never executes it) and `JSON.stringify` here is the
  same XSS-safe emission pattern BaseLayout uses for JSON-LD structured data.
  The bundled module below reads it back via `getElementById(...).textContent`.
*/}
<script type="application/json" id="compare-data" set:html={JSON.stringify(compareData).replace(/</g, '\\u003c')} is:inline></script>

<script>
  // Bundled + tree-shaken by Astro (no `is:inline`, no `define:vars`), so it
  // can `import`. Boots the /compare/ page logic from the typed ES module.
  import { initComparePage } from '../scripts/compare/compareInit';
  import type { CompareData } from '../scripts/compare/types';

  document.addEventListener('DOMContentLoaded', () => {
    const dataTag = document.getElementById('compare-data');
    if (!dataTag?.textContent) return;

    // Guard the embedded-JSON parse: a malformed payload (serialization
    // edge, CDN mangle, stale half-written HTML) would otherwise throw a
    // SyntaxError, abort this handler, and silently kill the entire
    // /compare/ client layer while the SSR grid still renders (v3 H5).
    let data: CompareData;
    try {
      data = JSON.parse(dataTag.textContent) as CompareData;
    } catch (err) {
      console.error('[compare] failed to parse compare-data', err);
      return;
    }
    if (!data || !Array.isArray(data.compareJobs) || !Array.isArray(data.features)) {
      console.error('[compare] compare-data has unexpected shape');
      return;
    }
    initComparePage(data);
  });
</script>


<style>
  /*
    compare.astro renders only 4 self-styled sub-components inside
    `<main class="compare-page"><div class="compare-container">`, so its
    scoped <style> needs rules for exactly those two classes. The old
    GEO/answer-panel/route-grid families were removed as dead (audit v3 H7).
  */
  .compare-page {
    padding: 2.5rem 1.5rem;
    max-width: var(--content-max-width);
    margin: 0 auto;
    width: 100%;
    flex: 1;
  }

  .compare-container {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .compare-page {
      padding: 1rem 0.5rem;
    }

    .compare-container {
      padding: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .compare-page {
      padding: 0.75rem 0.35rem;
    }

    .compare-container {
      padding: 0.5rem;
      border-radius: 8px;
    }
  }

  /* === Visual refresh overrides (Compare page) === */
  .compare-page {
    background: var(--ink-0);
    border: 1px solid var(--ink-200);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
  }
</style>
