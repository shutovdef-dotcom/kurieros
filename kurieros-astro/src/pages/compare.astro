---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import jobsData from '../data/jobs';
import { getCityNames, sortCityNamesByPopulation } from '../utils/cities';
import { slugifyCompany } from '../utils/companies';
import { buildBreadcrumbSchema } from '../utils/schema';

const transportLabelMap: Record<string, string> = {
  auto: 'Авто',
  bicycle: 'Велосипед / самокат',
  foot: 'Пешком',
  remote: 'Удалённо / офис',
};

const getTransportLabel = (tags: string[]) =>
  tags.find((tag) => tag in transportLabelMap)
    ? transportLabelMap[tags.find((tag) => tag in transportLabelMap) as string]
    : 'Смешанный формат';

const getTransportProvisionLabel = (provision: 'own' | 'company' | 'not_required') => {
  if (provision === 'company') return 'Компания выдает транспортное средство';
  if (provision === 'not_required') return 'Транспорт не требуется';
  return 'Нужно своё транспортное средство';
};

const normalizeOsRequirement = (value?: string) => {
  const normalized = String(value ?? '').trim().toLowerCase();
  const hasAndroid = /android|андроид/.test(normalized);
  const hasIos = /(?:^|[^a-z])ios(?:[^a-z]|$)|iphone|ipad|айос|айфон/.test(normalized);

  if (hasAndroid && hasIos) return 'Android или iOS';
  if (hasIos) return 'iOS';
  if (hasAndroid) return 'Android';
  return 'Android или iOS';
};

const mapCompareJob = (job: typeof jobsData[number]) => ({
  id: job.id,
  slug: job.slug,
  title: job.title,
  company: job.company,
  companyLogo: job.companyLogo,
  companySlug: slugifyCompany(job.company),
  companyHref: `/companies/${slugifyCompany(job.company)}/`,
  salary: job.salary,
  location: job.location,
  transport: getTransportLabel(job.tags),
  transport_provision: getTransportProvisionLabel(job.transportProvision),
  contract: job.details.employment_type,
  citizenship: job.details.citizenship,
  payout: job.details.payment_freq,
  bonus: job.benefits[0] || 'Условия уточняются при отклике',
  age: job.details.age,
  os: normalizeOsRequirement(job.details.os),
  link: `/v/${job.slug}/`,
});

// Only render preselected 4 jobs in HTML (was: all 4399 → 3.9 MB page).
// Full job catalog is served from /api/compare-jobs.json and fetched
// lazily by the client only if user has saved compareList in localStorage.
const compareJobs = jobsData.slice(0, 4).map(mapCompareJob);
const totalCompareJobs = jobsData.length;
const availableCities = sortCityNamesByPopulation(getCityNames(jobsData));

const features = [
  { key: 'salary', name: 'Зарплата' },
  { key: 'location', name: 'Район работы' },
  { key: 'transport', name: 'Транспорт' },
  { key: 'transport_provision', name: 'Транспортное средство' },
  { key: 'age', name: 'Возраст' },
  { key: 'os', name: 'Операционная система' },
  { key: 'contract', name: 'Оформление' },
  { key: 'citizenship', name: 'Гражданство' },
  { key: 'payout', name: 'Выплаты' },
  { key: 'bonus', name: 'Особенности' },
];

const compareTitle = 'Сравнение вакансий курьеров: что лучше выбрать | КурьерОк';
const compareDescription = 'Сравнение вакансий курьеров по зарплате, выплатам, транспорту и оформлению. Смотрите, что лучше для дохода, старта и стабильности.';

const pageSchemaGraph = [
  {
    '@type': 'CollectionPage',
    name: 'Сравнение вакансий курьеров',
    description: compareDescription,
    url: Astro.url.href,
    dateModified: new Date().toISOString(),
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: compareJobs.map((job, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: job.title,
        url: new URL(job.link, Astro.site).toString(),
      })),
    },
  },
  buildBreadcrumbSchema(
    [
      { name: 'Главная', url: '/' },
      { name: 'Сравнение вакансий', url: '/compare/' },
    ],
    Astro.site,
  ),
];
---

<BaseLayout title={compareTitle} description={compareDescription} schemaGraph={pageSchemaGraph}>
  <Header />

  <main class="compare-page">
    <div class="compare-container">
      <div class="compare-header">
        <div class="compare-header-copy">
          <nav class="compare-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Главная</a>
            <span>/</span>
            <span>Сравнение вакансий</span>
          </nav>
          <h1>Сравнение вакансий</h1>
          <p class="compare-subtitle">Сравните базовые условия, а потом открывайте только те карточки, которые действительно подходят.</p>
        </div>
        <div class="compare-header-actions">
          <a href="#compare-table" class="compare-table-link">К таблице</a>
          <a href="/" class="back-link">← К вакансиям</a>
        </div>
      </div>

      <section class="compare-filters" aria-label="Фильтры сравнения">
        <p class="compare-filters-hint">
          Можно сравнить добавленные вакансии вручную, либо выбрать город и транспорт — и страница покажет все подходящие варианты.
        </p>
        <div class="compare-filters-row">
          <label class="compare-filter">
            <span>Город</span>
            <select id="compare-city-filter">
              <option value="">Все города</option>
              {availableCities.map((city) => (
                <option value={city}>{city}</option>
              ))}
            </select>
          </label>
          <label class="compare-filter">
            <span>Транспорт</span>
            <select id="compare-transport-filter">
              <option value="">Любой формат</option>
              <option value="foot">Пешком</option>
              <option value="bicycle">Велосипед / самокат</option>
              <option value="auto">Авто</option>
              <option value="remote">Удалённо / из дома</option>
            </select>
          </label>
          <button type="button" id="compare-filter-reset" class="compare-filter-reset">Сбросить</button>
        </div>
        <p class="compare-filters-status" id="compare-filters-status" aria-live="polite"></p>
      </section>

      <div class="compare-table-wrapper" id="compare-table">
        <div class="compare-grid" style={`--cols: ${compareJobs.length};`}>
          {compareJobs.length > 0 ? (
            <>
              <div class="compare-row compare-head">
                <div class="compare-cell feature-col empty-cell">
                  Параметры
                </div>
                {compareJobs.map((job, index) => (
                  <div class="compare-cell job-col" data-col={index}>
                    <div class="job-card-mini">
                      <button class="remove-col-btn" aria-label="Удалить" title="Удалить из сравнения" data-col-target={index} type="button">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                      </button>
                      <div class={`company-logo company-logo-${job.companySlug}`}>
                        {job.companyLogo ? (
                          <img
                            src={job.companyLogo}
                            alt={`${job.company} logo`}
                            width="56"
                            height="56"
                            loading="lazy"
                            decoding="async"
                          />
                        ) : (
                          <span class="company-logo-letter">
                            {job.company.charAt(0)}
                          </span>
                        )}
                      </div>
                      <h3>{job.title}</h3>
                      <span class="company-name">{job.company}</span>
                    </div>
                  </div>
                ))}
              </div>

              {features.map((feature) => (
                <div class="compare-row">
                  <div class="compare-cell feature-col">
                    {feature.name}
                  </div>
                  {compareJobs.map((job, index) => (
                    <div class="compare-cell job-col" data-col={index}>
                      {job[feature.key as keyof typeof job]}
                    </div>
                  ))}
                </div>
              ))}

              <div class="compare-row compare-actions">
                <div class="compare-cell feature-col"></div>
                {compareJobs.map((job, index) => (
                  <div class="compare-cell job-col" data-col={index}>
                    <a href={job.link} class="btn-primary">Открыть карточку</a>
                  </div>
                ))}
              </div>
            </>
          ) : (
            <div class="compare-empty-state">
              <h3>Нет вакансий для сравнения</h3>
              <p>Список активных вакансий очищен. Новые варианты появятся здесь после публикации карточек.</p>
              <a href="/" class="btn-primary compare-empty-state-link">Вернуться на главную</a>
            </div>
          )}
        </div>
      </div>

      <section class="compare-help-grid" aria-label="Частые вопросы перед откликом">
        <div class="compare-help-heading">
          <p class="section-eyebrow">Помощь в выборе</p>
          <h2>Что обычно спрашивают перед откликом</h2>
        </div>
        <div class="compare-help-cards">
          <a class="compare-help-card" href="/guide/dohod/">
            <span class="compare-help-kicker">Доход</span>
            <h3>Сколько реально зарабатывает курьер?</h3>
            <p>Вилки по форматам в Москве, СПб и регионах — пеший, вело, авто, банк-представитель.</p>
            <span class="compare-help-link">Открыть гид →</span>
          </a>
          <a class="compare-help-card" href="/guide/vyplaty/">
            <span class="compare-help-kicker">Выплаты</span>
            <h3>Где платят чаще — еженедельно или раз в месяц?</h3>
            <p>Яндекс.Еда, Купер, Самокат — еженедельно. Альфа-Банк по ТК РФ — 2 раза в месяц.</p>
            <span class="compare-help-link">Открыть гид →</span>
          </a>
          <a class="compare-help-card" href="/guide/oformlenie/">
            <span class="compare-help-kicker">Оформление</span>
            <h3>Где проще трудоустроиться?</h3>
            <p>Самозанятость, ГПХ, ИП или ТК РФ — какой режим подходит и как зарегистрироваться.</p>
            <span class="compare-help-link">Открыть гид →</span>
          </a>
          <a class="compare-help-card" href="/guide/dokumenty/">
            <span class="compare-help-kicker">Документы</span>
            <h3>Какие документы нужны для отклика?</h3>
            <p>Паспорт, ИНН, СНИЛС — базовый набор. Для авто — права и СТС, для иностранцев — патент.</p>
            <span class="compare-help-link">Открыть гид →</span>
          </a>
          <a class="compare-help-card" href="/guide/vozrast/">
            <span class="compare-help-kicker">Возраст</span>
            <h3>Со скольки лет берут курьером?</h3>
            <p>С 16 лет — пешком и на велосипеде в Yandex Еде и Купере. С 18 — автокурьеры и банк.</p>
            <span class="compare-help-link">Открыть гид →</span>
          </a>
          <a class="compare-help-card" href="/guide/shtrafy/">
            <span class="compare-help-kicker">Штрафы</span>
            <h3>За что штрафуют курьеров?</h3>
            <p>Опоздания, отмены слотов, отсутствие формы — суммы и условия по сервисам.</p>
            <span class="compare-help-link">Открыть гид →</span>
          </a>
        </div>
        <a class="compare-help-all" href="/guide/">Все гиды для курьера →</a>
      </section>

    </div>
  </main>

  <Footer />
</BaseLayout>

<script is:inline define:vars={{ compareJobs, features, totalCompareJobs }}>
  document.addEventListener('DOMContentLoaded', () => {
    const grid = document.querySelector('.compare-grid');
    if (!grid) return;

    const companyLinks = document.querySelector('[data-compare-companies]');
    // Bootstrap with the 4 preselected jobs already in HTML.
    // Full catalog is fetched lazily from /api/compare-jobs.json on demand.
    const jobsById = new Map(compareJobs.map((job) => [job.id, job]));
    const hasAvailableJobs = totalCompareJobs > 0;
    let fullCatalogPromise = null;

    function ensureFullCatalog() {
      if (fullCatalogPromise) return fullCatalogPromise;
      fullCatalogPromise = fetch('/api/compare-jobs.json', { cache: 'force-cache' })
        .then((response) => (response.ok ? response.json() : []))
        .then((jobs) => {
          if (Array.isArray(jobs)) {
            for (const job of jobs) {
              jobsById.set(job.id, job);
            }
          }
          return jobs;
        })
        .catch(() => []);
      return fullCatalogPromise;
    }
    const scopeAttribute = Array.from(grid.getAttributeNames()).find((name) => name.startsWith('data-astro-cid'));

    function applyScopedStyles(root) {
      if (!scopeAttribute) return;
      root.querySelectorAll('*').forEach((element) => {
        element.setAttribute(scopeAttribute, '');
      });
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function parseSalaryValue(salary) {
      return Number(String(salary).replace(/[^\d]/g, '')) || 0;
    }

    function renderCompanyLogo(job) {
      const firstLetter = String(job.company ?? '').trim().charAt(0) || '•';
      if (!job.companyLogo) {
        return `<span class="company-logo-letter">${escapeHtml(firstLetter)}</span>`;
      }

      return `
        <img
          src="${escapeHtml(job.companyLogo)}"
          alt="${escapeHtml(job.company)} logo"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
      `;
    }

    function readStoredCompareIds() {
      try {
        const rawList = JSON.parse(localStorage.getItem('compareList') || '[]');
        if (!Array.isArray(rawList)) return [];

        return rawList
          .map((id) => Number.parseInt(String(id), 10))
          .filter((id, index, ids) => Number.isFinite(id) && ids.indexOf(id) === index)
          .slice(0, 4);
      } catch {
        return [];
      }
    }

    function readCompareIds() {
      return readStoredCompareIds().filter((id) => jobsById.has(id));
    }

    function writeCompareIds(ids) {
      localStorage.setItem('compareList', JSON.stringify(ids));
      window.dispatchEvent(new CustomEvent('compareUpdate'));
    }

    function getSelectedJobs() {
      const storedIds = readStoredCompareIds();
      const validIds = storedIds.filter((id) => jobsById.has(id));

      if (JSON.stringify(storedIds) !== JSON.stringify(validIds)) {
        writeCompareIds(validIds);
      }

      return validIds.map((id) => jobsById.get(id)).filter(Boolean);
    }

    function renderEmptyState() {
      const emptyCopy = hasAvailableJobs
        ? {
          heading: 'Нет вакансий для сравнения',
          text: 'Добавьте 2-4 вакансии из списка, чтобы увидеть разницу по выплатам, транспорту и оформлению.',
          href: '/#vacancies',
          link: 'Вернуться к вакансиям',
        }
        : {
          heading: 'Нет вакансий для сравнения',
          text: 'Список активных вакансий очищен. Новые варианты появятся здесь после публикации карточек.',
          href: '/',
          link: 'Вернуться на главную',
        };

      grid.style.setProperty('--cols', '0');
      grid.innerHTML = `
        <div class="compare-empty-state">
          <h3>${emptyCopy.heading}</h3>
          <p>${emptyCopy.text}</p>
          <a href="${emptyCopy.href}" class="btn-primary compare-empty-state-link">${emptyCopy.link}</a>
        </div>
      `;
      applyScopedStyles(grid);

      if (companyLinks) {
        companyLinks.innerHTML = '<a href="/companies/" class="compare-chip-link">Все компании</a>';
        applyScopedStyles(companyLinks);
      }
    }

    function renderComparisonTable(jobs) {
      if (jobs.length === 0) {
        renderEmptyState();
        return;
      }

      grid.style.setProperty('--cols', jobs.length.toString());

      const headerCells = jobs.map((job, index) => `
        <div class="compare-cell job-col" data-col="${index}">
          <div class="job-card-mini">
            <button class="remove-col-btn" aria-label="Удалить" title="Удалить из сравнения" data-job-id="${job.id}" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
            <div class="company-logo company-logo-${escapeHtml(job.companySlug)}">
              ${renderCompanyLogo(job)}
            </div>
            <h3>${escapeHtml(job.title)}</h3>
            <span class="company-name">${escapeHtml(job.company)}</span>
          </div>
        </div>
      `).join('');

      const featureRows = features.map((feature) => `
        <div class="compare-row">
          <div class="compare-cell feature-col">${escapeHtml(feature.name)}</div>
          ${jobs.map((job, index) => `
            <div class="compare-cell job-col" data-col="${index}">
              ${escapeHtml(job[feature.key])}
            </div>
          `).join('')}
        </div>
      `).join('');

      const actionCells = jobs.map((job, index) => `
        <div class="compare-cell job-col" data-col="${index}">
          <a href="${escapeHtml(job.link)}" class="btn-primary">Открыть карточку</a>
        </div>
      `).join('');

      grid.innerHTML = `
        <div class="compare-row compare-head">
          <div class="compare-cell feature-col empty-cell">Параметры</div>
          ${headerCells}
        </div>
        ${featureRows}
        <div class="compare-row compare-actions">
          <div class="compare-cell feature-col"></div>
          ${actionCells}
        </div>
      `;
      applyScopedStyles(grid);
    }

    function renderCompanyLinks(jobs) {
      if (!companyLinks) return;

      const companies = Array.from(new Map(jobs.map((job) => [job.company, {
        name: job.company,
        href: job.companyHref,
      }])).values());

      companyLinks.innerHTML = companies.length
        ? companies.map((company) => `<a href="${escapeHtml(company.href)}" class="compare-chip-link">${escapeHtml(company.name)}</a>`).join('')
        : '<a href="/companies/" class="compare-chip-link">Все компании</a>';
      applyScopedStyles(companyLinks);
    }

    function renderSelectedComparison() {
      const storedIds = readStoredCompareIds();
      const needsCatalog = storedIds.some((id) => !jobsById.has(id));
      if (needsCatalog) {
        // User saved IDs we don't have in preselected — load full catalog.
        ensureFullCatalog().then(() => {
          const jobs = getSelectedJobs();
          renderComparisonTable(jobs);
          renderCompanyLinks(jobs);
        });
        return;
      }
      const jobs = getSelectedJobs();
      renderComparisonTable(jobs);
      renderCompanyLinks(jobs);
    }

    renderSelectedComparison();

    grid.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('.remove-col-btn') : null;
      if (!btn) return;

      const jobId = Number.parseInt(btn.getAttribute('data-job-id') || '', 10);
      if (!Number.isFinite(jobId)) return;

      writeCompareIds(readCompareIds().filter((id) => id !== jobId));
      renderSelectedComparison();
    });

    window.addEventListener('storage', (event) => {
      if (event.key === 'compareList') {
        renderSelectedComparison();
      }
    });

    // ====== City + transport filter mode ======
    // When user picks city/transport, fetch full catalog and render
    // matching jobs (overrides the localStorage-driven manual mode).
    const cityFilter = document.getElementById('compare-city-filter');
    const transportFilter = document.getElementById('compare-transport-filter');
    const filterReset = document.getElementById('compare-filter-reset');
    const filterStatus = document.getElementById('compare-filters-status');

    const TRANSPORT_LABEL_TO_TAG = {
      'Авто': 'auto',
      'Велосипед / самокат': 'bicycle',
      'Пешком': 'foot',
      'Удалённо / офис': 'remote',
    };

    function jobMatchesTransport(job, tagValue) {
      if (!tagValue) return true;
      const label = String(job.transport || '');
      if (TRANSPORT_LABEL_TO_TAG[label] === tagValue) return true;
      return false;
    }

    function jobMatchesCity(job, cityName) {
      if (!cityName) return true;
      const loc = String(job.location || '').toLowerCase();
      return loc.includes(cityName.toLowerCase()) || loc === 'вся россия';
    }

    function setStatus(text) {
      if (filterStatus) filterStatus.textContent = text || '';
    }

    async function applyServerFilters() {
      const city = cityFilter?.value || '';
      const transport = transportFilter?.value || '';
      if (!city && !transport) {
        // No filter — fall back to manual selection from localStorage.
        renderSelectedComparison();
        setStatus('');
        return;
      }
      setStatus('Загружаем подходящие вакансии…');
      const all = await ensureFullCatalog();
      const list = Array.isArray(all) ? all : [];
      const matched = list.filter((job) => jobMatchesCity(job, city) && jobMatchesTransport(job, transport));
      // Cap to 12 columns (UI limit) but show count of total matches.
      const display = matched.slice(0, 12);
      if (display.length === 0) {
        setStatus(`Нет вакансий по фильтру «${city || 'любой город'} / ${transport ? Object.keys(TRANSPORT_LABEL_TO_TAG).find(k => TRANSPORT_LABEL_TO_TAG[k] === transport) : 'любой транспорт'}»`);
        renderComparisonTable([]);
        renderCompanyLinks([]);
        return;
      }
      renderComparisonTable(display);
      renderCompanyLinks(display);
      setStatus(matched.length > display.length
        ? `Показано ${display.length} из ${matched.length} вакансий по фильтру`
        : `Показано ${display.length} вакансий по фильтру`);
    }

    cityFilter?.addEventListener('change', applyServerFilters);
    transportFilter?.addEventListener('change', applyServerFilters);
    filterReset?.addEventListener('click', () => {
      if (cityFilter) cityFilter.value = '';
      if (transportFilter) transportFilter.value = '';
      applyServerFilters();
    });
  });
</script>

<style>
  .compare-page {
    padding: 2.5rem 1.5rem;
    max-width: 1560px;
    margin: 0 auto;
    width: 100%;
    flex: 1;
  }

  .compare-container {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .compare-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .compare-header-copy {
    display: grid;
    gap: 0.35rem;
  }

  .compare-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
  }

  .compare-subtitle {
    margin: 0;
