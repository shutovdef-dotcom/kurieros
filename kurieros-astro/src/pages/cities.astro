---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCityRegion } from '../data/cityRegions';
import { slugifyCity } from '../utils/cities';
import { formatRussianPlural } from '../utils/format';
import { buildBreadcrumbSchema } from '../utils/schema';
// City catalogue is module-cached in `citiesIndex.ts` (H3 rationale)
// instead of re-derived per render (audit ref v4 MEDIUM-1).
import { citiesFromJobs } from '../utils/citiesIndex';

// Match the city-selector dropdown ordering (utils/cities.ts:
// `sortCityNamesByPopulation`) — Moscow / Petersburg / large cities
// first, alphabetical only as a tiebreak. The previous default
// alphabetical order from `getCitiesFromJobs()` buried major cities
// behind small ones (Абаза, Абакан, Агидель…).
const cities = citiesFromJobs
	.map((city) => ({
		...city,
		href: `/rabota-kurerom-${city.slug}/`,
	}))
	.sort(
		(a, b) =>
			b.population - a.population ||
			a.name.localeCompare(b.name, 'ru'),
	);

const totalVacancies = cities.reduce((sum, city) => sum + city.vacancyCount, 0);
type CityLink = (typeof cities)[number];

const OTHER_REGION_NAME = 'СНГ и другие направления';
const compareCitiesByPopulation = (a: CityLink, b: CityLink) =>
	b.population - a.population ||
	a.name.localeCompare(b.name, 'ru');

const citiesByRegion = cities.reduce<Record<string, CityLink[]>>((groups, city) => {
	const regionName = getCityRegion(city.name) ?? OTHER_REGION_NAME;
	return {
		...groups,
		[regionName]: [...(groups[regionName] ?? []), city],
	};
}, {});

const regionGroups = Object.entries(citiesByRegion)
	.map(([name, groupCities]) => {
		const sortedCities = [...groupCities].sort(compareCitiesByPopulation);
		const vacancyCount = sortedCities.reduce((sum, city) => sum + city.vacancyCount, 0);
		return {
			id: `region-${slugifyCity(name) || 'other'}`,
			name,
			cityCount: sortedCities.length,
			vacancyCount,
			cities: sortedCities,
		};
	})
	.sort((a, b) => {
		if (a.name === OTHER_REGION_NAME) return 1;
		if (b.name === OTHER_REGION_NAME) return -1;
		return a.name.localeCompare(b.name, 'ru');
	});
const totalRegionCount = regionGroups.filter((region) => region.name !== OTHER_REGION_NAME).length;

// JSON-LD ItemList cap (audit v3 M21). A 958-entry ItemList was ~118 KB
// of inline JSON-LD that merely duplicated the crawlable city links already
// in the markup — near-zero
// rich-result benefit. Cap the structured-data list to the top cities
// by vacancy count; the full set stays discoverable via regional blocks.
const SCHEMA_ITEM_LIST_LIMIT = 30;
const schemaItemListCities = [...cities]
	.sort((a, b) => b.vacancyCount - a.vacancyCount || a.name.localeCompare(b.name, 'ru'))
	.slice(0, SCHEMA_ITEM_LIST_LIMIT);

// Both helpers now delegate to the shared `formatRussianPlural` from
// src/utils/format.ts. The vacancy variant additionally returns an
// i18n key so the city-tile template can data-t the count for non-RU
// locales — that key shape is preserved.
const getVacancyPlural = (count: number) => {
	const text = formatRussianPlural(count, ['вакансия', 'вакансии', 'вакансий']);
	const key =
		text === 'вакансия' ? 'cities.vacancies_1'
		: text === 'вакансии' ? 'cities.vacancies_2'
		: 'cities.vacancies_5';
	return { text, key };
};

const getCityPlural = (count: number) =>
	formatRussianPlural(count, ['город', 'города', 'городов']);

const getRegionPlural = (count: number) =>
	formatRussianPlural(count, ['регион', 'региона', 'регионов']);

const faqItems = [
	{
		question: 'Что есть на странице городов?',
		answer: `На странице собраны ${cities.length} ${getCityPlural(cities.length)} по ${totalRegionCount} ${getRegionPlural(totalRegionCount)}, где уже есть ${totalVacancies} ${getVacancyPlural(totalVacancies).text} курьеров. Это стартовая навигационная точка для перехода в локальные подборки.`,
	},
	{
		question: 'Какой следующий шаг после выбора города?',
		answer: 'Откройте страницу нужного города, посмотрите активные вакансии, сравните компании и только потом переходите к карточкам конкретных работодателей.',
	},
	{
		question: 'Зачем выбирать город перед откликом?',
		answer: 'Условия курьерской работы зависят от города: отличаются компании, районы, транспорт и график. Поэтому лучше сначала открыть локальную подборку, а уже потом выбирать вакансию.',
	},
];
const pageSchemaGraph = [
	{
		'@type': 'CollectionPage',
		name: 'Города — работа курьером',
		description: 'Каталог городов с локальными подборками вакансий курьеров и быстрым переходом в нужный город.',
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: schemaItemListCities.map((city, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: city.name,
				url: new URL(city.href, Astro.site).toString(),
			})),
		},
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
	buildBreadcrumbSchema(
		[
			{ name: 'Главная', url: '/' },
			{ name: 'Города', url: '/cities/' },
		],
		Astro.site,
	),
];
---

<BaseLayout
	title="Работа курьером по городам России: вакансии и компании | КурьерОк"
	description="Выберите город и откройте локальную подборку вакансий курьеров: компании, форматы работы, выплаты и быстрые переходы по городам России."
	schemaGraph={pageSchemaGraph}
>
	<Header />

	<main class="cities-page">
		<section class="cities-hero">
			<p class="section-eyebrow">Города</p>
			<h1 data-t="cities.title">Работа курьером по городам России</h1>
			<p data-t="cities.subtitle">
				Выберите город, посмотрите активные бренды, затем откройте локальную подборку вакансий и подходящий формат работы.
			</p>
		</section>

		<section class="regions-overview" aria-labelledby="regions-overview-title">
			<div>
				<p class="section-eyebrow">Регионы</p>
				<h2 id="regions-overview-title">
					{cities.length} {getCityPlural(cities.length)} в {totalRegionCount} {getRegionPlural(totalRegionCount)}
				</h2>
			</div>
			<nav class="region-index" aria-label="Быстрый переход по регионам">
				{regionGroups.map((region) => (
					<a href={`#${region.id}`}>
						<span>{region.name}</span>
						<small>{region.cityCount}</small>
					</a>
				))}
			</nav>
		</section>

		<section class="region-list" aria-label="Города по регионам">
			{regionGroups.map((region) => {
				const regionVacancyPlural = getVacancyPlural(region.vacancyCount);
				return (
					<section class="region-block" id={region.id}>
						<header class="region-heading">
							<div>
								<p class="region-meta">{region.cityCount} {getCityPlural(region.cityCount)}</p>
								<h2>{region.name}</h2>
							</div>
							<span class="region-vacancies">
								<span class="count-num">{region.vacancyCount}</span> <span data-t={regionVacancyPlural.key}>{regionVacancyPlural.text}</span>
							</span>
						</header>
						<div class="city-link-list">
							{region.cities.map((city) => {
								const plural = getVacancyPlural(city.vacancyCount);
								return (
									<a class="city-tile" href={city.href}>
										<strong>{city.name}</strong>
										<span><span class="count-num">{city.vacancyCount}</span> <span data-t={plural.key}>{plural.text}</span></span>
									</a>
								);
							})}
						</div>
					</section>
				);
			})}
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	.cities-page {
		max-width: var(--content-max-width);
		margin: 0 auto;
		padding: 2rem 1rem 4rem;
	}
	.cities-hero {
		margin-bottom: 1.5rem;
	}
	.section-eyebrow {
		margin: 0 0 0.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--accent-color);
	}
	.cities-hero h1 {
		font-size: 3rem;
		line-height: 1.05;
		letter-spacing: 0;
		margin-bottom: 0.45rem;
	}
	.cities-hero p,
	.city-tile span,
	.region-meta,
	.region-vacancies,
	.region-index small {
		color: var(--text-muted);
	}
	.regions-overview,
	.region-block,
	.city-tile {
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}
	.regions-overview {
		display: grid;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 1rem;
	}
	.regions-overview h2 {
		margin: 0;
		font-size: 1.35rem;
		line-height: 1.2;
	}
	.region-index {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.5rem;
		max-height: 16rem;
		overflow: auto;
		padding-right: 0.15rem;
	}
	.region-index a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 3.35rem;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		color: var(--text-main);
		background: var(--ink-0);
		text-decoration: none;
		transition: border-color var(--transition), box-shadow var(--transition);
	}
	.region-index a:hover,
	.region-index a:focus-visible {
		border-color: var(--brand-500);
		box-shadow: var(--shadow-sm);
		outline: none;
	}
	.region-index span {
		overflow-wrap: anywhere;
		font-weight: 800;
		line-height: 1.18;
	}
	.region-index small {
		font-size: 0.78rem;
		font-weight: 900;
		align-self: center;
	}
	.region-list {
		display: grid;
		gap: 1rem;
	}
	.region-block {
		padding: 1rem;
		scroll-margin-top: 5.5rem;
	}
	.region-heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.85rem;
	}
	.region-meta {
		margin: 0 0 0.25rem;
		font-size: 0.8rem;
		font-weight: 800;
	}
	.region-heading h2 {
		margin: 0;
		font-size: 1.3rem;
		line-height: 1.2;
		letter-spacing: 0;
	}
	.region-vacancies {
		flex: 0 0 auto;
		font-size: 0.9rem;
		font-weight: 800;
		white-space: nowrap;
	}
	.city-link-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
		gap: 0.65rem;
	}
	.city-tile {
		display: grid;
		align-content: start;
		gap: 0.3rem;
		min-height: 4.6rem;
		padding: 0.85rem;
		color: var(--text-main);
		text-decoration: none;
		transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
	}
	.city-tile:hover {
		transform: translateY(-2px);
		border-color: var(--text-main);
		box-shadow: var(--shadow-md);
	}
	.city-tile:focus-visible {
		border-color: var(--brand-500);
		box-shadow: var(--shadow-sm);
		outline: none;
	}
	.city-tile strong {
		font-size: 1rem;
		overflow-wrap: anywhere;
	}
	@media (max-width: 560px) {
		.cities-hero h1 {
			font-size: 2.2rem;
		}
		.regions-overview h2 {
			font-size: 1.15rem;
		}
		.region-index,
		.city-link-list {
			grid-template-columns: 1fr;
		}
		.region-heading {
			display: grid;
		}
		.region-vacancies {
			white-space: normal;
		}
	}

	/* === Visual refresh overrides (Cities page) === */
	.regions-overview,
	.region-block,
	.city-tile {
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-md);
	}
	.city-tile:hover,
	.city-tile:focus-visible {
		border-color: var(--brand-500);
		box-shadow: var(--shadow-sm);
	}
</style>
