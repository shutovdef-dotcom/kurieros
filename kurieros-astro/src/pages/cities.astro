---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import jobsData from '../data/jobs';
import { getCitiesFromJobs } from '../utils/cities';
import { formatRussianPlural } from '../utils/format';
import { buildBreadcrumbSchema } from '../utils/schema';

// Match the city-selector dropdown ordering (utils/cities.ts:
// `sortCityNamesByPopulation`) — Moscow / Petersburg / large cities
// first, alphabetical only as a tiebreak. The previous default
// alphabetical order from `getCitiesFromJobs()` buried major cities
// behind small ones (Абаза, Абакан, Агидель…).
const cities = getCitiesFromJobs(jobsData)
	.map((city) => ({
		...city,
		href: `/rabota-kurerom-${city.slug}/`,
	}))
	.sort(
		(a, b) =>
			b.population - a.population ||
			a.name.localeCompare(b.name, 'ru'),
	);

const totalVacancies = cities.reduce((sum, city) => sum + city.vacancyCount, 0);

// Both helpers now delegate to the shared `formatRussianPlural` from
// src/utils/format.ts. The vacancy variant additionally returns an
// i18n key so the city-tile template can data-t the count for non-RU
// locales — that key shape is preserved.
const getVacancyPlural = (count: number) => {
	const text = formatRussianPlural(count, ['вакансия', 'вакансии', 'вакансий']);
	const key =
		text === 'вакансия' ? 'cities.vacancies_1'
		: text === 'вакансии' ? 'cities.vacancies_2'
		: 'cities.vacancies_5';
	return { text, key };
};

const getCityPlural = (count: number) =>
	formatRussianPlural(count, ['город', 'города', 'городов']);

const faqItems = [
	{
		question: 'Что есть на странице городов?',
		answer: `На странице собраны ${cities.length} ${getCityPlural(cities.length)}, где уже есть ${totalVacancies} ${getVacancyPlural(totalVacancies).text} курьеров. Это стартовая навигационная точка для перехода в локальные подборки.`,
	},
	{
		question: 'Какой следующий шаг после выбора города?',
		answer: 'Откройте страницу нужного города, посмотрите активные вакансии, сравните компании и только потом переходите к карточкам конкретных работодателей.',
	},
	{
		question: 'Зачем выбирать город перед откликом?',
		answer: 'Условия курьерской работы зависят от города: отличаются компании, районы, транспорт и график. Поэтому лучше сначала открыть локальную подборку, а уже потом выбирать вакансию.',
	},
];
const pageSchemaGraph = [
	{
		'@type': 'CollectionPage',
		name: 'Города — работа курьером',
		description: 'Каталог городов с локальными подборками вакансий курьеров и быстрым переходом в нужный город.',
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: cities.map((city, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: city.name,
				url: new URL(city.href, Astro.site).toString(),
			})),
		},
	},
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
	buildBreadcrumbSchema(
		[
			{ name: 'Главная', url: '/' },
			{ name: 'Города', url: '/cities/' },
		],
		Astro.site,
	),
];
---

<BaseLayout
	title="Работа курьером по городам России: вакансии и компании | КурьерОк"
	description="Выберите город и откройте локальную подборку вакансий курьеров: компании, форматы работы, выплаты и быстрые переходы по городам России."
	schemaGraph={pageSchemaGraph}
>
	<Header />

	<main class="cities-page">
		<section class="cities-hero">
			<p class="section-eyebrow">Города</p>
			<h1 data-t="cities.title">Работа курьером по городам России</h1>
			<p data-t="cities.subtitle">
				Выберите город, посмотрите активные бренды, затем откройте локальную подборку вакансий и подходящий формат работы.
			</p>
		</section>

		<section class="cities-grid">
			{cities.map((city) => {
				const plural = getVacancyPlural(city.vacancyCount);
				return (
					<a class="city-tile" href={city.href}>
						<strong>{city.name}</strong>
						<span><span class="count-num">{city.vacancyCount}</span> <span data-t={plural.key}>{plural.text}</span></span>
					</a>
				);
			})}
		</section>

	</main>

	<Footer />
</BaseLayout>

<style>
	/*
		cities.astro markup uses 6 classes only: cities-page, cities-hero,
		section-eyebrow, cities-grid, city-tile, count-num. The old
		spotlight/answer-panel/route-grid GEO families were removed as dead
		scoped CSS (audit v3 H8).
	*/
	.cities-page {
		max-width: 1240px;
		margin: 0 auto;
		padding: 2rem 1rem 4rem;
	}
	.cities-hero {
		margin-bottom: 1.5rem;
	}
	.section-eyebrow {
		margin: 0 0 0.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--accent-color);
	}
	.cities-hero h1 {
		font-size: 3rem;
		line-height: 1.05;
		letter-spacing: 0;
		margin-bottom: 0.45rem;
	}
	.cities-hero p,
	.city-tile span {
		color: var(--text-muted);
	}
	.city-tile {
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}
	.cities-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.8rem;
		margin-bottom: 1.5rem;
	}
	.city-tile {
		display: grid;
		gap: 0.35rem;
		padding: 1rem;
		color: var(--text-main);
		text-decoration: none;
		transition: var(--transition);
	}
	.city-tile:hover {
		transform: translateY(-2px);
		border-color: var(--text-main);
		box-shadow: var(--shadow-md);
	}
	.city-tile strong {
		font-size: 1rem;
	}
	@media (max-width: 560px) {
		.cities-hero h1 {
			font-size: 2.2rem;
		}
		.cities-grid {
			grid-template-columns: 1fr;
		}
	}

	/* === Visual refresh overrides (Cities page) === */
	.cities-grid > a {
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-md);
		transition: border-color var(--transition), box-shadow var(--transition);
	}
	.cities-grid > a:hover,
	.cities-grid > a:focus-visible {
		border-color: var(--brand-500);
		box-shadow: var(--shadow-sm);
		outline: none;
	}
</style>
