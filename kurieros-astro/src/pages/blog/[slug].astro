---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {
  BLOG_RELEASE_MANIFEST,
  blogReleaseBySlug,
  type BlogReleaseRecord,
} from '../../utils/blogManifest';
import { getBlogPrimarySources } from '../../utils/blogSourceRegistry';
import { buildBreadcrumbSchema } from '../../utils/schema';

type Props = {
  entry: CollectionEntry<'blog'>;
  release: BlogReleaseRecord;
};

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const entriesBySlug = new Map(entries.map((entry) => [entry.id, entry]));

  return BLOG_RELEASE_MANIFEST.releases.map((release) => {
    const entry = entriesBySlug.get(release.slug);
    if (!entry) {
      throw new Error(
        `Published blog release ${release.slug} has no matching markdown entry. Refusing to generate it.`,
      );
    }
    return {
      params: { slug: release.slug },
      props: { entry, release },
    };
  });
}

const { entry, release } = Astro.props;
const { Content } = await render(entry);
const primarySources = getBlogPrimarySources(entry.id);
const allBlogEntries = await getCollection('blog');
const allBlogEntriesBySlug = new Map(allBlogEntries.map((item) => [item.id, item]));
const relatedPosts = entry.data.relatedSlugs
  .map((slug) => {
    const relatedRelease = blogReleaseBySlug.get(slug);
    const relatedEntry = allBlogEntriesBySlug.get(slug);
    return relatedRelease && relatedEntry
      ? { slug, title: relatedEntry.data.title }
      : undefined;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('ru-RU', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'Europe/Moscow',
  }).format(new Date(value));

const canonicalURL = new URL(`/blog/${entry.id}/`, Astro.site);
const pageSchemaGraph = [
  {
    '@type': 'BlogPosting',
    headline: entry.data.title,
    description: entry.data.description,
    url: canonicalURL.toString(),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalURL.toString(),
    },
    author: {
      '@type': 'Organization',
      name: entry.data.author,
      url: new URL('/', Astro.site).toString(),
    },
    publisher: {
      '@type': 'Organization',
      name: 'КурьерОк',
      url: new URL('/', Astro.site).toString(),
    },
    image: new URL('/og-default.png', Astro.site).toString(),
    datePublished: release.firstPublishedAt,
    ...(release.modifiedAt ? { dateModified: release.modifiedAt } : {}),
    citation: primarySources.map((source) => ({
      '@type': 'WebPage',
      name: source.publisher,
      url: source.url,
    })),
  },
  buildBreadcrumbSchema(
    [
      { name: 'Главная', url: '/' },
      { name: 'Блог', url: '/blog/' },
      { name: entry.data.title, url: `/blog/${entry.id}/` },
    ],
    Astro.site,
  ),
];
---

<BaseLayout
  title={`${entry.data.title} | КурьерОк`}
  description={entry.data.description}
  canonicalURL={canonicalURL}
  schemaGraph={pageSchemaGraph}
  ogType="article"
  articleSection="Работа курьером"
  articlePublishedTime={release.firstPublishedAt}
  articleModifiedTime={release.modifiedAt}
>
  <Header />

  <main class="article-shell">
    <nav class="breadcrumbs" aria-label="Хлебные крошки">
      <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/blog/">Блог</a><span aria-hidden="true">/</span><span>{entry.data.title}</span>
    </nav>

    <article class="article">
      <header class="article-header">
        <p class="eyebrow">Материал КурьерОк</p>
        <h1>{entry.data.title}</h1>
        <p class="article-lead">{entry.data.description}</p>
        <dl class="article-facts">
          <div>
            <dt>Опубликовано</dt>
            <dd><time datetime={release.firstPublishedAt}>{formatDate(release.firstPublishedAt)}</time></dd>
          </div>
          {release.modifiedAt && (
            <div>
              <dt>Обновлено</dt>
              <dd><time datetime={release.modifiedAt}>{formatDate(release.modifiedAt)}</time></dd>
            </div>
          )}
          <div>
            <dt>Источники проверены</dt>
            <dd><time datetime={release.sourceCheckedAt}>{formatDate(release.sourceCheckedAt)}</time></dd>
          </div>
          <div>
            <dt>Автор</dt>
            <dd>{entry.data.author}</dd>
          </div>
        </dl>
      </header>

      <div class="article-layout">
        <div class="article-body prose"><Content /></div>
        <aside class="article-aside" aria-label="Навигация по материалу">
          <a class="aside-link" href={entry.data.pillarHref}>Открыть справочник по теме</a>
          {entry.data.commercialHref && (
            <a class="aside-link" href={entry.data.commercialHref}>Посмотреть актуальные вакансии</a>
          )}
          <p>Условия в вакансиях меняются. Перед откликом сверяйте исходный оффер и договор.</p>
        </aside>
      </div>

      <section class="article-sources" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title">Источники и границы материала</h2>
        <p>
          Ссылки ниже показывают, на каких первичных или официальных страницах основан
          материал. Они не заменяют проверку конкретной вакансии, договора или условий в вашем городе.
        </p>
        <ul>
          {primarySources.map((source) => (
            <li>
              <a href={source.url} rel="noopener noreferrer" target="_blank">{source.publisher}</a>
              <span> — {source.scope}</span>
            </li>
          ))}
        </ul>
      </section>

      {relatedPosts.length > 0 && (
        <section class="related-posts" aria-labelledby="related-posts-title">
          <h2 id="related-posts-title">Читайте также</h2>
          <ul>
            {relatedPosts.map(({ slug, title }) => (
              <li><a href={`/blog/${slug}/`}>{title}</a></li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .article-shell { max-width: var(--content-max-width); margin: 0 auto 4rem; padding: 1rem; }
  .breadcrumbs { color: var(--text-muted); font-size: 0.88rem; display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.75rem 0 2rem; }
  .breadcrumbs a { color: inherit; }
  .article { max-width: 74rem; }
  .article-header { max-width: 54rem; margin-bottom: 2.5rem; }
  .eyebrow { color: var(--brand-700); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.9rem; }
  .article-header h1 { font-size: clamp(2.1rem, 5vw, 4rem); letter-spacing: -0.035em; line-height: 1.03; margin: 0 0 1.1rem; }
  .article-lead { color: var(--text-muted); font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.65; margin: 0; }
  .article-facts { border-top: 1px solid var(--ink-200); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.5rem; margin: 1.5rem 0 0; padding-top: 1rem; }
  .article-facts div { min-width: 0; }
  .article-facts dt { color: var(--text-muted); font-size: 0.78rem; margin: 0 0 0.2rem; }
  .article-facts dd { font-weight: 700; margin: 0; }
  .article-layout { align-items: start; display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: minmax(0, 1fr) minmax(13rem, 17rem); }
  .prose { color: var(--text); font-size: 1.06rem; line-height: 1.78; min-width: 0; }
  .prose :global(h2) { font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.15; margin: 2.5rem 0 0.85rem; }
  .prose :global(h3) { font-size: 1.2rem; line-height: 1.25; margin: 1.7rem 0 0.6rem; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1rem; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.35rem; }
  .prose :global(li + li) { margin-top: 0.4rem; }
  .prose :global(a) { color: var(--brand-700); }
  .article-aside { background: var(--brand-50); border: 1px solid var(--brand-200); border-radius: var(--radius-xl); display: grid; gap: 0.75rem; padding: 1rem; position: sticky; top: 1rem; }
  .article-aside p { color: var(--ink-700); font-size: 0.88rem; line-height: 1.55; margin: 0.25rem 0 0; }
  .aside-link { color: var(--brand-700); font-weight: 800; line-height: 1.35; text-decoration: none; }
  .aside-link:hover, .aside-link:focus-visible { text-decoration: underline; }
  .article-sources, .related-posts { border-top: 1px solid var(--ink-200); margin-top: 2.5rem; max-width: 54rem; padding-top: 1.5rem; }
  .article-sources h2, .related-posts h2 { font-size: 1.35rem; margin: 0 0 0.75rem; }
  .article-sources p { color: var(--text-muted); line-height: 1.65; }
  .article-sources ul, .related-posts ul { padding-left: 1.25rem; }
  .article-sources li + li, .related-posts li + li { margin-top: 0.55rem; }
  .article-sources a, .related-posts a { color: var(--brand-700); }
  @media (max-width: 820px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-aside { position: static; }
  }
  @media (max-width: 520px) {
    .article-facts { grid-template-columns: 1fr; }
    .breadcrumbs { margin-bottom: 1.35rem; }
  }
</style>
