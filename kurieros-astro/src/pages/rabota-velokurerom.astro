---
/**
 * /rabota-velokurerom/ — bicycle/scooter-courier hub page.
 * Demand: ~17 483 searches/mo.
 *
 * Thin wrapper: picks the 'bicycle' entry from HUB_CONFIGS, filters jobs,
 * builds schema, and renders BaseLayout + TransportHub.
 * All template logic lives in TransportHub.astro (bead B5).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TransportHub from '../components/TransportHub.astro';
import jobsData from '../data/jobs';
import {
	HUB_CONFIGS,
	buildHubTitle,
	buildHubDescription,
	buildHubFaqItems,
	buildHubSchemaGraph,
	extractHubCities,
} from '../utils/transportHubs';
import { filterJobsByCriteria } from '../utils/jobFilters';
import { parseSalary } from '../utils/format';

const cfg = HUB_CONFIGS['bicycle'];

const filteredJobs = filterJobsByCriteria(jobsData, cfg.filter);
const isEmpty = filteredJobs.length === 0;

const companyNames = Array.from(new Set(filteredJobs.map((j) => j.company))).slice(0, 5);
const maxSalary = filteredJobs.reduce((acc, j) => {
	const v = parseSalary(j.salary);
	return v > acc ? v : acc;
}, 0);

const dateModifiedIso = new Date().toISOString();
const title = buildHubTitle(cfg, filteredJobs.length, maxSalary, isEmpty);
const description = buildHubDescription(cfg, filteredJobs.length, companyNames, isEmpty);
const faqItems = buildHubFaqItems(cfg, filteredJobs.length, companyNames);
const schemaGraph = buildHubSchemaGraph({
	cfg,
	jobs: filteredJobs,
	faqItems,
	title,
	description,
	pageUrlHref: new URL(Astro.url.pathname, Astro.site).toString(),
	pageUrlPathname: Astro.url.pathname,
	siteUrl: Astro.site,
	dateModifiedIso,
});
---

<BaseLayout
	title={title}
	description={description}
	schemaGraph={schemaGraph}
	robots={isEmpty ? 'noindex, follow' : undefined}
>
	<Header />
	<TransportHub
		config={cfg}
		filteredJobs={filteredJobs}
		isEmpty={isEmpty}
		faqItems={faqItems}
		companyNames={companyNames}
		cities={extractHubCities(filteredJobs)}
	/>
	<Footer />
</BaseLayout>
