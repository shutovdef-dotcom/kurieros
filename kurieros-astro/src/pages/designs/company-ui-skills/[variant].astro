---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCityHref } from '../../../utils/cities';
import {
  UI_SKILL_VARIANTS,
  getCompanyDesignPreview,
  type UiSkillVariant,
} from '../../../utils/companyDesignPreview';

export function getStaticPaths() {
  return UI_SKILL_VARIANTS.map((variant) => ({
    params: { variant: variant.slug },
    props: { variant },
  }));
}

const { variant } = Astro.props as { variant: UiSkillVariant };
const preview = getCompanyDesignPreview();
const {
  company,
  guide,
  updatedDate,
  cities,
  hiddenCityCount,
  vacancyExamples,
  reviews,
  salaryLabel,
  vacancyCountText,
  cityCountText,
  primaryPayment,
  primaryFormat,
} = preview;
const title = `${variant.name}: ${company.name} | UI Skills`;
const description = `${variant.repo}: экспериментальная версия страницы компании ${company.name}.`;
const pageClass = `system-design-page system-${variant.slug}`;
const stats = [
  ['Вакансии', vacancyCountText],
  ['Города', cityCountText],
  ['Доход', salaryLabel],
  ['Формат', primaryFormat],
];
const checks = [
  guide.cautionPoints[0],
  guide.cautionPoints[1],
  guide.verdictPoints[2],
];
---

<BaseLayout title={title} description={description} robots="noindex, nofollow">
  <main class={pageClass}>
    <nav class="variant-nav" aria-label="Навигация по дизайн-вариантам">
      <div class="variant-nav-links">
        <a href="/designs/company-ui-skills/">Все варианты</a>
        <a href="/companies/kuper-ex-sbermarket/">Оригинал</a>
        {UI_SKILL_VARIANTS.map((item) => (
          <a
            href={item.href}
            data-theme-link
            aria-current={item.slug === variant.slug ? 'page' : undefined}
          >
            {item.navLabel}
          </a>
        ))}
      </div>
      <div class="theme-switcher" aria-label="Цветовая тема">
        <button type="button" data-theme-option="light" aria-pressed="true">Светлая</button>
        <button type="button" data-theme-option="dark" aria-pressed="false">Тёмная</button>
      </div>
    </nav>

    {variant.slug === 'shadcn-ui' && (
      <div class="sh-shell">
        <section class="sh-hero">
          <div class="sh-copy">
            <p class="sh-kicker">{variant.systemType}</p>
            <h1>{guide.h1}</h1>
            <p>{guide.subtitle}</p>
            <div class="sh-actions">
              <a class="sh-button sh-button-primary" href="#sh-vacancies">Смотреть карточки</a>
              <a class="sh-button sh-button-secondary" href="#sh-faq">FAQ</a>
            </div>
          </div>
          <aside class="sh-card sh-summary">
            <div class="sh-card-header">
              <img src={company.logo} alt={company.name} width="56" height="56" />
              <div>
                <h2>{company.name}</h2>
                <p>Обновлено {updatedDate}</p>
              </div>
            </div>
            <div class="sh-separator"></div>
            <dl>
              {stats.map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        </section>

        <section class="sh-card sh-section">
          <div class="sh-card-header">
            <div>
              <p class="sh-kicker">Verdict</p>
              <h2>{guide.verdictTitle}</h2>
            </div>
            <span class="sh-badge">{primaryPayment}</span>
          </div>
          <div class="sh-separator"></div>
          <div class="sh-verdict-grid">
            {guide.verdictPoints.map((point) => (
              <article>
                <p>{point}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="sh-card sh-section" id="sh-vacancies">
          <div class="sh-card-header">
            <div>
              <p class="sh-kicker">Cards</p>
              <h2>Вакансии для первого сравнения</h2>
            </div>
            <a class="sh-button sh-button-secondary" href={guide.primaryHubHref}>Все вакансии</a>
          </div>
          <div class="sh-list">
            {vacancyExamples.map((job) => (
              <article>
                <div>
                  <h3><a href={job.href}>{job.title}</a></h3>
                  <p>{job.location}</p>
                </div>
                <strong>{job.salary}</strong>
                <span class="sh-badge">{job.payment}</span>
              </article>
            ))}
          </div>
        </section>

        <section class="sh-two">
          <div class="sh-card sh-section">
            <p class="sh-kicker">Before apply</p>
            <h2>Что проверить</h2>
            <div class="sh-accordion">
              {checks.map((check, index) => (
                <details open={index === 0}>
                  <summary>Пункт {index + 1}</summary>
                  <p>{check}</p>
                </details>
              ))}
            </div>
          </div>
          <div class="sh-card sh-section" id="sh-faq">
            <p class="sh-kicker">Cities</p>
            <h2>Где есть предложения</h2>
            <div class="sh-city-grid">
              {cities.map((city) => <a href={getCityHref(city)}>{city}</a>)}
              {hiddenCityCount > 0 && <a href={guide.primaryHubHref}>ещё {hiddenCityCount}</a>}
            </div>
          </div>
        </section>
      </div>
    )}

    {variant.slug === 'swiss-design' && (
      <>
        <section class="swiss-hero">
          <div class="swiss-index">KUPER<br />2026</div>
          <div>
            <p class="swiss-caption">{variant.systemType}</p>
            <h1>{guide.h1}</h1>
            <p>{guide.summary}</p>
          </div>
          <aside>
            <img src={company.logo} alt={company.name} width="56" height="56" />
            <span>{updatedDate}</span>
          </aside>
        </section>

        <section class="swiss-grid swiss-stats" aria-label="Факты">
          {stats.map(([label, value]) => (
            <article>
              <span>{label}</span>
              <strong>{value}</strong>
            </article>
          ))}
        </section>

        <section class="swiss-grid swiss-analysis">
          <div>
            <p class="swiss-caption">Verdict</p>
            <h2>{guide.verdictTitle}</h2>
          </div>
          <div>
            {guide.verdictPoints.map((point) => <p>{point}</p>)}
          </div>
        </section>

        <section class="swiss-table" aria-labelledby="swiss-vacancies">
          <div class="swiss-table-head">
            <p class="swiss-caption">Vacancies</p>
            <h2 id="swiss-vacancies">Примеры вакансий</h2>
          </div>
          {vacancyExamples.map((job) => (
            <article>
              <a href={job.href}>{job.title}</a>
              <span>{job.location}</span>
              <strong>{job.salary}</strong>
              <span>{job.payment}</span>
            </article>
          ))}
        </section>

        <section class="swiss-grid swiss-lists">
          <div>
            <p class="swiss-caption">Checks</p>
            <h2>Что проверить</h2>
            <ul>
              {checks.map((point) => <li>{point}</li>)}
            </ul>
          </div>
          <div>
            <p class="swiss-caption">Cities</p>
            <h2>Города</h2>
            <div class="swiss-city-list">
              {cities.map((city) => <a href={getCityHref(city)}>{city}</a>)}
            </div>
          </div>
        </section>
      </>
    )}

    {variant.slug === 'oklch-system' && (
      <div class="ok-shell">
        <section class="ok-hero">
          <div>
            <p class="ok-system-label">{variant.systemType}</p>
            <h1>{guide.h1}</h1>
            <p>{guide.summary}</p>
          </div>
          <aside class="ok-token-card">
            <span>Primary</span>
            <strong>oklch(0.45 0.09 155)</strong>
            <span>Surface</span>
            <strong>oklch(0.98 0.012 155)</strong>
            <span>Warning</span>
            <strong>oklch(0.62 0.13 78)</strong>
          </aside>
        </section>

        <section class="ok-tones" aria-label="Цветовые роли">
          {stats.map(([label, value], index) => (
            <article class={`ok-tone ok-tone-${index + 1}`}>
              <span>{label}</span>
              <strong>{value}</strong>
            </article>
          ))}
        </section>

        <section class="ok-flow">
          <div class="ok-panel ok-panel-primary">
            <h2>{guide.verdictTitle}</h2>
            {guide.verdictPoints.map((point) => <p>{point}</p>)}
          </div>
          <div class="ok-panel ok-panel-warning">
            <h2>Перед откликом</h2>
            <ul>{checks.map((point) => <li>{point}</li>)}</ul>
          </div>
        </section>

        <section class="ok-vacancies">
          <div class="ok-section-head">
            <h2>Карточки с тональными статусами</h2>
            <a href={guide.primaryHubHref}>Все вакансии Купер</a>
          </div>
          <div class="ok-job-grid">
            {vacancyExamples.map((job) => (
              <article>
                <span>{job.payment}</span>
                <h3><a href={job.href}>{job.title}</a></h3>
                <p>{job.location}</p>
                <strong>{job.salary}</strong>
              </article>
            ))}
          </div>
        </section>

        <section class="ok-cities">
          <h2>Города в той же палитре</h2>
          <div>
            {cities.map((city) => <a href={getCityHref(city)}>{city}</a>)}
          </div>
        </section>
      </div>
    )}

    {variant.slug === 'impeccable-system' && (
      <div class="imp-shell">
        <section class="imp-hero">
          <div class="imp-map" aria-hidden="true">
            <span>Маршрут</span>
            <span>Документы</span>
            <span>Слоты</span>
            <span>Выплаты</span>
          </div>
          <div>
            <p>{variant.systemType}</p>
            <h1>{guide.h1}</h1>
            <p>{guide.subtitle}</p>
            <a href="#imp-vacancies">Выбрать первую карточку</a>
          </div>
          <aside>
            <img src={company.logo} alt={company.name} width="64" height="64" />
            <strong>{salaryLabel}</strong>
            <span>{primaryPayment}</span>
          </aside>
        </section>

        <section class="imp-route">
          <div>
            <h2>Один маршрут вместо одинаковых карточек</h2>
            <p>{guide.summary}</p>
          </div>
          <ol>
            {guide.steps.slice(0, 4).map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <section class="imp-split">
          <article>
            <h2>{guide.verdictTitle}</h2>
            {guide.verdictPoints.map((point) => <p>{point}</p>)}
          </article>
          <article>
            <h2>Что не решать по бренду</h2>
            <ul>{checks.map((point) => <li>{point}</li>)}</ul>
          </article>
        </section>

        <section class="imp-vacancies" id="imp-vacancies">
          <div>
            <h2>Разные города, разные роли</h2>
            <p>Здесь важна не сетка ради сетки, а быстрый выбор первого сравнения.</p>
          </div>
          <div class="imp-job-stack">
            {vacancyExamples.map((job, index) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3><a href={job.href}>{job.title}</a></h3>
                <p>{job.location}</p>
                <strong>{job.salary}</strong>
              </article>
            ))}
          </div>
        </section>
      </div>
    )}

    <section class="variant-scorecard" aria-label="Оценка подхода">
      <div>
        <h2>Почему это дизайн-система</h2>
        <p><strong>{variant.systemType}.</strong> Источник: <a href={variant.sourceUrl}>{variant.repo}</a>.</p>
        <p>{variant.nameExplanation}</p>
      </div>
      <div>
        <h2>Что может понравиться</h2>
        <ul>{variant.strengths.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div>
        <h2>Что может не понравиться</h2>
        <ul>{variant.risks.map((item) => <li>{item}</li>)}</ul>
      </div>
      {reviews.length > 0 && (
        <div>
          <h2>Проверка на живом тексте</h2>
          <p>{reviews[0].comment}</p>
        </div>
      )}
    </section>
  </main>
  <script is:inline>
    (() => {
      const allowedThemes = new Set(['light', 'dark']);
      const readThemeFromUrl = () => new URL(window.location.href).searchParams.get('theme');
      const initialTheme = allowedThemes.has(readThemeFromUrl())
        ? readThemeFromUrl()
        : allowedThemes.has(window.localStorage.getItem('ui-skills-theme'))
          ? window.localStorage.getItem('ui-skills-theme')
          : 'light';

      const syncControls = (theme) => {
        document.querySelectorAll('[data-theme-option]').forEach((control) => {
          control.setAttribute('aria-pressed', String(control.dataset.themeOption === theme));
        });
        document.querySelectorAll('[data-theme-link]').forEach((link) => {
          const nextUrl = new URL(link.getAttribute('href'), window.location.href);
          if (theme === 'dark') {
            nextUrl.searchParams.set('theme', 'dark');
          } else {
            nextUrl.searchParams.delete('theme');
          }
          link.setAttribute('href', `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`);
        });
      };

      const syncTheme = (theme, updateUrl = false) => {
        document.documentElement.dataset.uiSkillsTheme = theme;
        window.localStorage.setItem('ui-skills-theme', theme);
        syncControls(theme);

        if (updateUrl) {
          const nextCurrentUrl = new URL(window.location.href);
          if (theme === 'dark') {
            nextCurrentUrl.searchParams.set('theme', 'dark');
          } else {
            nextCurrentUrl.searchParams.delete('theme');
          }
          window.history.replaceState({}, '', `${nextCurrentUrl.pathname}${nextCurrentUrl.search}${nextCurrentUrl.hash}`);
        }
      };

      syncTheme(initialTheme);
      document.addEventListener('click', (event) => {
        const control = event.target instanceof Element
          ? event.target.closest('[data-theme-option]')
          : null;
        if (!control) return;
        event.preventDefault();
        syncTheme(control.dataset.themeOption, true);
      });
    })();
  </script>
</BaseLayout>

<style>
  .system-design-page {
    --nav-bg: rgba(255, 255, 255, 0.94);
    --nav-border: rgba(0, 0, 0, 0.12);
    --nav-active-bg: #18181b;
    --nav-active-fg: #fff;
    --nav-control-bg: rgba(255, 255, 255, 0.72);
    --scorecard-bg: rgba(255, 255, 255, 0.82);
    --scorecard-border: rgba(0, 0, 0, 0.14);
    min-height: 100vh;
  }

  .variant-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem;
    border-bottom: 1px solid var(--nav-border);
    background: var(--nav-bg);
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px);
  }

  .variant-nav-links,
  .theme-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .variant-nav a,
  .theme-switcher button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 0.9rem;
    border: 1px solid var(--nav-border);
    border-radius: 8px;
    background: var(--nav-control-bg);
    color: inherit;
    font-size: 0.88rem;
    font-weight: 800;
    font-family: inherit;
    text-decoration: none;
  }

  .theme-switcher button {
    cursor: pointer;
  }

  .variant-nav a[aria-current="page"],
  .theme-switcher button[aria-pressed="true"] {
    background: var(--nav-active-bg);
    color: var(--nav-active-fg);
  }

  .variant-nav a:focus-visible,
  .theme-switcher button:focus-visible,
  .system-design-page a:focus-visible,
  .system-design-page summary:focus-visible {
    outline: 3px solid #facc15;
    outline-offset: 3px;
  }

  .variant-scorecard {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    max-width: 1180px;
  }

  .variant-scorecard > div {
    padding: 1rem;
    border: 1px solid var(--scorecard-border);
    background: var(--scorecard-bg);
  }

  .variant-scorecard h2 {
    margin: 0 0 0.7rem;
    font-size: 1rem;
  }

  .variant-scorecard ul,
  .variant-scorecard p {
    margin: 0;
    padding-left: 1rem;
    line-height: 1.6;
  }

  .variant-scorecard p {
    padding-left: 0;
  }

  .variant-scorecard p + p {
    margin-top: 0.75rem;
  }

  .variant-scorecard a {
    color: inherit;
    font-weight: 850;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  :global(html[data-ui-skills-theme="dark"]) .system-design-page {
    --nav-bg: rgba(12, 14, 12, 0.88);
    --nav-border: rgba(255, 255, 255, 0.16);
    --nav-active-bg: #f4f4f5;
    --nav-active-fg: #111113;
    --nav-control-bg: rgba(255, 255, 255, 0.06);
    --scorecard-bg: rgba(255, 255, 255, 0.06);
    --scorecard-border: rgba(255, 255, 255, 0.14);
    color-scheme: dark;
  }

  .system-shadcn-ui {
    --background: #fafafa;
    --foreground: #18181b;
    --muted: #f4f4f5;
    --muted-foreground: #71717a;
    --card: #ffffff;
    --border: #e4e4e7;
    --primary: #18181b;
    --primary-foreground: #fafafa;
    --radius: 0.75rem;
    background: var(--background);
    color: var(--foreground);
  }

  :global(html[data-ui-skills-theme="dark"]) .system-shadcn-ui {
    --background: #09090b;
    --foreground: #fafafa;
    --muted: #18181b;
    --muted-foreground: #a1a1aa;
    --card: #111113;
    --border: #27272a;
    --primary: #fafafa;
    --primary-foreground: #18181b;
    --scorecard-bg: rgba(17, 17, 19, 0.92);
    --scorecard-border: #27272a;
  }

  .sh-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .sh-hero,
  .sh-two {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(320px, 0.8fr);
    gap: 1rem;
  }

  .sh-hero {
    align-items: stretch;
    padding: 2rem 0 1rem;
  }

  .sh-copy {
    display: grid;
    align-content: center;
    gap: 1rem;
    min-height: 520px;
  }

  .sh-kicker {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .sh-copy h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.35rem, 7vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .sh-copy > p:not(.sh-kicker) {
    max-width: 62ch;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1.05rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .sh-actions,
  .sh-card-header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }

  .sh-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: calc(var(--radius) - 2px);
    padding: 0 1rem;
    font-weight: 650;
    text-decoration: none;
  }

  .sh-button-primary {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  .sh-button-secondary {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
  }

  .sh-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .sh-summary,
  .sh-section {
    padding: 1.25rem;
  }

  .sh-summary img {
    object-fit: contain;
  }

  .sh-summary h2,
  .sh-section h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .sh-summary p {
    margin: 0.25rem 0 0;
    color: var(--muted-foreground);
  }

  .sh-separator {
    height: 1px;
    margin: 1rem 0;
    background: var(--border);
  }

  .sh-summary dl {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .sh-summary dt {
    color: var(--muted-foreground);
    font-size: 0.85rem;
  }

  .sh-summary dd {
    margin: 0.15rem 0 0;
    font-size: 1.2rem;
    font-weight: 750;
  }

  .sh-section {
    margin-top: 1rem;
  }

  .sh-badge {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 0.65rem;
    background: var(--muted);
    color: var(--foreground);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .sh-verdict-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .sh-verdict-grid article,
  .sh-list article {
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) - 2px);
    background: var(--background);
  }

  .sh-verdict-grid article {
    padding: 1rem;
  }

  .sh-verdict-grid p {
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.6;
  }

  .sh-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .sh-list article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem;
  }

  .sh-list h3,
  .sh-list p {
    margin: 0;
  }

  .sh-list h3 a {
    color: var(--foreground);
    text-decoration: none;
  }

  .sh-list p {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
  }

  .sh-list strong {
    font-variant-numeric: tabular-nums;
  }

  .sh-accordion {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
