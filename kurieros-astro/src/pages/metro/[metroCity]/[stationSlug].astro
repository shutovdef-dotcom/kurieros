---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import JobGrid from '../../../components/JobGrid.astro';
import { getCityJobsFromMap } from '../../../utils/jobFilters';
import { jobsByCity } from '../../../utils/jobsByCityIndex';
import {
  getRelatedMetroStations,
  metroStations,
  partitionMetroOffersForStation,
  type MetroStation,
} from '../../../utils/metroStations';
import { buildBreadcrumbSchema } from '../../../utils/schema';
import { getVacancyPluralText } from '../../../utils/format';
import { getVacancyCanonicalUrl } from '../../../utils/vacancyUrl';
import { parseSalaryValue } from '../../../utils/vacancyPage';

export async function getStaticPaths() {
  return metroStations.map((station) => ({
    params: {
      metroCity: station.citySlug,
      stationSlug: station.stationSlug,
    },
    props: { station },
  }));
}

const { station } = Astro.props as { station: MetroStation };
const jobs = getCityJobsFromMap(jobsByCity, station.jobsCityName);
const {
  verifiedLocalOffers: verifiedLocalJobs,
  cityFallbackOffers: cityFallbackJobs,
} = partitionMetroOffersForStation(station, jobs);
const visibleJobsLimit = 12;
const vacancyCountText = `${jobs.length} ${getVacancyPluralText(jobs.length)}`;
const verifiedLocalCountText = `${verifiedLocalJobs.length} ${getVacancyPluralText(verifiedLocalJobs.length)}`;
const maxSalary = Math.max(0, ...jobs.map((job) => parseSalaryValue(job.salary)));
const formattedMaxSalary = maxSalary > 0
  ? new Intl.NumberFormat('ru-RU').format(maxSalary)
  : null;
const companyNames = Array.from(new Set(jobs.map((job) => job.company))).slice(0, 4);
const relatedStations = getRelatedMetroStations(station);
const title = verifiedLocalJobs.length > 0
  ? `Работа у метро ${station.stationName} — ${verifiedLocalCountText} | КурьерОк`
  : `Работа: метро ${station.stationName} как ориентир — ${vacancyCountText} | КурьерОк`;
const description = (verifiedLocalJobs.length > 0
  ? `${verifiedLocalCountText} с подтверждённой привязкой к станции ${station.stationName}; отдельно показан городской резерв ${station.cityName}.`
  : `Метро ${station.stationName} как ориентир: ${vacancyCountText} по городу ${station.cityName} без подтверждённой привязки к станции.`
).slice(0, 170);
const faqItems = [
  {
    question: `Какие вакансии показаны для станции ${station.stationName}?`,
    answer: verifiedLocalJobs.length > 0
      ? `Сначала показаны ${verifiedLocalCountText} с проверенной привязкой к станции. Остальные предложения явно отделены как городской резерв ${station.cityName}.`
      : `Пока здесь показан только городской резерв: ${vacancyCountText} в ${station.cityPrepositional}. Для этих карточек не подтверждена привязка к станции ${station.stationName}.`,
  },
  {
    question: `Это отдельные вакансии у станции ${station.stationName}?`,
    answer: verifiedLocalJobs.length > 0
      ? `Только блок с пометкой «Подтверждено источником». У таких предложений проверены адрес и измеренная связь со станцией.`
      : `Нет. Мы не выдаём станцию за адрес работодателя: без источника и измеренной связи предложение остаётся в городском резерве.`,
  },
  {
    question: 'Почему условия могут отличаться?',
    answer: 'Доход, график, оформление и требования задаёт работодатель. Перед откликом откройте карточку вакансии и проверьте детали.',
  },
];
const pageSchemaGraph = [
  {
    '@type': 'CollectionPage',
    name: title,
    description,
    url: Astro.url.href,
    isPartOf: {
      '@type': 'WebSite',
      name: 'КурьерОк',
      url: new URL('/', Astro.site).toString(),
    },
    about: {
      '@type': 'SubwayStation',
      name: station.stationName,
      address: {
        '@type': 'PostalAddress',
        addressLocality: station.cityName,
        ...(station.qualityMetadata?.districtName
          ? { addressRegion: station.qualityMetadata.districtName }
          : {}),
        addressCountry: 'RU',
      },
      ...(station.qualityMetadata?.coordinates
        ? {
            geo: {
              '@type': 'GeoCoordinates',
              latitude: station.qualityMetadata.coordinates.latitude,
              longitude: station.qualityMetadata.coordinates.longitude,
            },
          }
        : {}),
    },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: jobs.length,
      itemListElement: jobs.slice(0, 10).map((job, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: job.title,
        url: getVacancyCanonicalUrl(job, Astro.site),
      })),
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  buildBreadcrumbSchema(
    [
      { name: 'Главная', url: '/' },
      { name: `Работа курьером в ${station.cityName}`, url: station.cityHref },
      { name: `Метро ${station.stationName}`, url: Astro.url.pathname },
    ],
    Astro.site,
  ),
];
---

<BaseLayout title={title} description={description} schemaGraph={pageSchemaGraph}>
  <Header />

  <main class="metro-page">
    <section class="metro-hero">
      <div class="container metro-hero-inner">
        <nav class="breadcrumbs" aria-label="Хлебные крошки">
          <a href="/">Главная</a>
          <span aria-hidden="true">›</span>
          <a href={station.cityHref}>Работа курьером в {station.cityName}</a>
          <span aria-hidden="true">›</span>
          <span>Метро {station.stationName}</span>
        </nav>

        <div class="metro-hero-content">
          <p class="eyebrow">Метро как ориентир</p>
          <h1>Вакансии: метро {station.stationName}</h1>
          <p class="lead">
            {verifiedLocalJobs.length > 0
              ? `${verifiedLocalCountText} имеют проверенную привязку к станции. Городские предложения показаны отдельно.`
              : `${vacancyCountText} в ${station.cityPrepositional}. Это городской резерв без подтверждённой привязки к станции.`}
          </p>
          <div class="metro-facts">
            <span>{vacancyCountText} по городу</span>
            {verifiedLocalJobs.length > 0 && <span>{verifiedLocalCountText} подтверждено</span>}
            <span>{companyNames.length} компаний</span>
            {formattedMaxSalary && <span>до {formattedMaxSalary} ₽/мес</span>}
            {station.lineNames.length > 0 && <span>{station.lineNames.slice(0, 2).join(', ')}</span>}
          </div>
        </div>
      </div>
    </section>

    {verifiedLocalJobs.length > 0 && (
      <section class="container metro-section" aria-labelledby="verified-metro-vacancies-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Подтверждено источником</p>
            <h2 id="verified-metro-vacancies-title">Вакансии с проверенной привязкой к станции</h2>
          </div>
          <a href={station.cityHref}>Все вакансии в {station.cityPrepositional}</a>
        </div>
        <p class="section-note">
          Для этих карточек в журнале проверки есть адрес источника и измеренная
          пешая или транспортная связь со станцией {station.stationName}.
        </p>
        <JobGrid
          jobs={verifiedLocalJobs}
          limit={visibleJobsLimit}
          revealable={false}
          moreHref={station.cityHref}
          moreLabel={`Все вакансии в ${station.cityPrepositional}`}
          initialCity={station.jobsCityName}
        />
      </section>
    )}

    {cityFallbackJobs.length > 0 && (
      <section class="container metro-section" aria-labelledby="metro-vacancies-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Городской резерв</p>
            <h2 id="metro-vacancies-title">Городские вакансии без привязки к станции</h2>
          </div>
          <a href={station.cityHref}>Все вакансии в {station.cityPrepositional}</a>
        </div>
        <p class="section-note">
          Эти предложения относятся к городу {station.cityName}. Точный адрес или
          транспортная связь со станцией {station.stationName} источником не подтверждены.
        </p>
        <JobGrid
          jobs={cityFallbackJobs}
          limit={visibleJobsLimit}
          revealable={false}
          moreHref={station.cityHref}
          moreLabel={`Все вакансии в ${station.cityPrepositional}`}
          initialCity={station.jobsCityName}
        />
      </section>
    )}

    <section class="container metro-section metro-info-grid">
      <div>
        <p class="eyebrow">Как читать страницу</p>
        <h2>Станция не заменяет городскую страницу</h2>
        <p>
          Главная страница по городу остаётся <a href={station.cityHref}>работа курьером в {station.cityName}</a>.
          Эта страница использует станцию как навигационный ориентир и не создаёт разметку вакансии
          с фиктивным адресом.
        </p>
      </div>
      <div>
        <p class="eyebrow">FAQ</p>
        <div class="faq-list">
          {faqItems.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    {relatedStations.length > 0 && (
      <section class="container metro-section" aria-labelledby="nearby-metro-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Топология метро</p>
            <h2 id="nearby-metro-title">Соседние станции по линии</h2>
          </div>
        </div>
        <div class="station-links">
          {relatedStations.map((item) => (
            <a href={item.href}>{item.stationName}</a>
          ))}
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

<style>
  .metro-page {
    background: var(--surface-color);
    color: var(--ink-900);
  }

  .metro-hero {
    background: linear-gradient(180deg, var(--brand-50), var(--surface-color));
    border-bottom: 1px solid var(--ink-100);
  }

  .metro-hero-inner {
    padding: var(--space-6) var(--space-4) var(--space-10);
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-8);
    color: var(--ink-600);
    font-size: var(--fs-14);
  }

  .breadcrumbs a {
    color: var(--brand-700);
    font-weight: 700;
  }

  .metro-hero-content {
    max-width: 860px;
  }

  .eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--brand-700);
    font-size: var(--fs-13);
    font-weight: 800;
    text-transform: uppercase;
  }

  h1,
  h2 {
    margin: 0;
    letter-spacing: 0;
    line-height: 1.08;
  }

  h1 {
    max-width: 760px;
    font-size: clamp(2.2rem, 7vw, 4.8rem);
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  .lead {
    max-width: 720px;
    margin: var(--space-4) 0 0;
    color: var(--ink-700);
    font-size: var(--fs-18);
    line-height: 1.55;
  }

  .metro-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .metro-facts span,
  .station-links a {
    border: 1px solid var(--ink-200);
    border-radius: var(--radius-md);
    background: var(--surface-100);
    color: var(--ink-800);
    font-size: var(--fs-14);
    font-weight: 800;
  }

  .metro-facts span {
    padding: var(--space-2) var(--space-3);
  }

  .metro-section {
    padding: var(--space-10) var(--space-4);
  }

  .section-note {
    max-width: 780px;
    margin: calc(var(--space-4) * -1) 0 var(--space-6);
    color: var(--ink-700);
    line-height: 1.6;
  }

  .section-heading {
    display: flex;
    gap: var(--space-4);
    align-items: end;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .section-heading a,
  .metro-info-grid a {
    color: var(--brand-700);
    font-weight: 800;
  }

  .metro-info-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  .metro-info-grid p {
    margin: var(--space-3) 0 0;
    color: var(--ink-700);
    line-height: 1.6;
  }

  .faq-list {
    display: grid;
    gap: var(--space-3);
  }

  details {
    border: 1px solid var(--ink-200);
    border-radius: var(--radius-md);
    background: var(--surface-100);
    padding: var(--space-4);
  }

  summary {
    cursor: pointer;
    color: var(--ink-900);
    font-weight: 800;
  }

  details p {
    margin-bottom: 0;
  }

  .station-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .station-links a {
    padding: var(--space-2) var(--space-3);
  }

  @media (min-width: 900px) {
    .metro-info-grid {
      grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    }
  }

  @media (max-width: 680px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }
  }
</style>
