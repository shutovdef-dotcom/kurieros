---
import JobCard from '../../../../components/JobCard.astro';
import {
	LISTING_BATCH_SIZE,
	getJobsForListingSlug,
	getListingBatchUrl,
	getListingBatchStaticPaths,
} from '../../../../utils/listingBatches';
import { toJobCardViewModel } from '../../../../utils/jobCardViewModel';

export const prerender = true;

export function getStaticPaths() {
	return getListingBatchStaticPaths();
}

const listingSlug = Astro.params.listingSlug || '';
const rawPageNumber = Number.parseInt(Astro.params.page || '2', 10);
const pageNumber = Number.isFinite(rawPageNumber) && rawPageNumber > 1
	? rawPageNumber
	: 2;

const matchedJobs = getJobsForListingSlug(listingSlug);
const start = (pageNumber - 1) * LISTING_BATCH_SIZE;
const batchJobs = matchedJobs.slice(start, start + LISTING_BATCH_SIZE);
const remainingCount = Math.max(0, matchedJobs.length - (start + LISTING_BATCH_SIZE));
const nextBatchUrl = remainingCount > 0
	? getListingBatchUrl(listingSlug, pageNumber + 1)
	: undefined;
---
{/*
  Listing-card batch endpoint.

  Heavy listing pages render only the first 24 cards in the main HTML.
  The bottom-nav «Вакансии» action and explicit filters fetch these static
  fragments to append the next cards without duplicating JobCard markup in JS.
*/}
<div
	class="jobs-grid-batch"
	data-overflow-count={remainingCount}
	data-next-batch-url={nextBatchUrl}
>
	{batchJobs.map((job) => <JobCard job={toJobCardViewModel(job)} />)}
</div>
