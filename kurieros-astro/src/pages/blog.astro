---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import articlesData from '../data/articles.json';
import { buildBreadcrumbSchema } from '../utils/schema';

// Shape of a `src/data/articles.json` entry. The file is intentionally
// `[]` today (the /blog/ feature is shelved — see the empty-state note
// below), so this interface documents the contract a future entry must
// satisfy and lets `posts` infer instead of leaking `: any`.
interface Article {
	slug: string;
	title: string;
	description: string;
	date: string;
}

const formatDate = (value: string) =>
	new Intl.DateTimeFormat('ru-RU', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	}).format(new Date(value));

const posts = (articlesData as Article[]).map((article) => ({
	...article,
	excerpt: article.description,
	formattedDate: formatDate(article.date),
}));

const blogTitle = 'Блог о работе курьером | КурьерОк';
const blogDescription = 'Блог КурьерОк готовится к запуску. Скоро здесь появятся материалы про работу курьером.';

const pageSchemaGraph = [
	{
		'@type': 'CollectionPage',
		name: 'Блог КурьерОк',
		description: blogDescription,
		url: Astro.url.href,
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: posts.map((post, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: post.title,
				url: new URL(`/blog/${post.slug}/`, Astro.site).toString(),
			})),
		},
	},
	buildBreadcrumbSchema(
		[
			{ name: 'Главная', url: '/' },
			{ name: 'Блог', url: '/blog/' },
		],
		Astro.site,
	),
];
---

<BaseLayout
	title={blogTitle}
	description={blogDescription}
	schemaGraph={pageSchemaGraph}
>
	<Header />

	<main>
		<section class="blog-hero">
			<div class="blog-hero-copy">
				<span class="eyebrow">Редакция КурьерОк</span>
				<h1>Журнал о работе курьером</h1>
				<p>Практические разборы дохода, компаний и форматов доставки без рекламного шума и пустых обещаний.</p>
			</div>
			<div class="blog-hero-note">
				<span>{posts.length === 0 ? 'Готовим материалы' : `${posts.length} материалов`}</span>
			</div>
		</section>

		{/*
			Empty-state placeholder. `articles.json` is intentionally `[]`, so
			`posts` is always empty and the old `posts.length > 0` listing
			branch was permanently unreachable — it was removed (audit v3 M5).
			The `/blog/` feature stays shelved pending a product decision.
		*/}
		<section class="blog-empty">
			<h2>Скоро здесь будут материалы</h2>
			<p>Команда готовит новые статьи о работе курьером — про доход, форматы доставки и реальные условия. Загляните позже.</p>
		</section>

		<section class="newsletter">
			<div class="newsletter-content">
				<h2>Подпишитесь на новые статьи</h2>
				<p>Получайте новые материалы о вакансиях, выплатах и выборе формата работы прямо в Telegram.</p>
				<a href="/contacts/" class="btn-primary newsletter-link">Подписаться в Telegram</a>
			</div>
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	/*
		blog.astro is an empty-state placeholder (articles.json is []). Its
		reachable markup uses only the hero, blog-empty and newsletter blocks;
		the topic-grid / featured-story / blog-card families styled the
		removed `posts.length > 0` listing branch and were deleted as dead
		scoped CSS (audit v3 M5).
	*/
	.blog-hero {
		max-width: 1360px;
		margin: 0 auto 2rem;
		padding: 3rem 1rem 1.5rem;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
	}
	.blog-hero-copy h1 {
		font-size: 4.4rem;
		line-height: 0.95;
		letter-spacing: 0;
		max-width: 10ch;
		margin-bottom: 1rem;
	}
	.blog-hero-copy p {
		color: var(--text-muted);
		max-width: 60ch;
		font-size: 1.05rem;
		line-height: 1.8;
	}
	.eyebrow {
		display: inline-flex;
		margin-bottom: 1rem;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0;
		color: var(--text-muted);
	}
	.blog-hero-note {
		display: grid;
		gap: 0.5rem;
		justify-items: end;
		color: var(--text-muted);
		font-size: 0.95rem;
	}
	.newsletter-link {
		max-width: 300px;
		margin: 0 auto;
		display: block;
	}
	.newsletter {
		max-width: 1360px;
		margin: 0 auto 4rem;
		background: linear-gradient(135deg, var(--brand-800), var(--brand-700));
		padding: 4rem 2rem;
		border-radius: 8px;
		text-align: center;
	}
	.newsletter h2 { color: var(--ink-900); margin-bottom: 1rem; }
	.newsletter p { color: var(--ink-700); margin-bottom: 2rem; }
	@media (max-width: 960px) {
		.blog-hero {
			grid-template-columns: 1fr;
		}
		.blog-hero-note {
			justify-items: start;
		}
	}
	@media (max-width: 720px) {
		.blog-hero-copy h1 {
			font-size: 2.8rem;
			max-width: 12ch;
		}
		.newsletter {
			margin-left: 1rem;
			margin-right: 1rem;
			padding: 3rem 1.25rem;
			border-radius: 8px;
		}
	}

	/* === Visual refresh overrides (Blog listing) === */
	.newsletter {
		background: var(--brand-50);
		border: 1px solid var(--brand-200);
		border-radius: var(--radius-xl);
	}

	:global(:where(html, body).dark-mode) .newsletter h2 { color: var(--ink-900); }
	:global(:where(html, body).dark-mode) .newsletter p { color: var(--ink-700); }
</style>
