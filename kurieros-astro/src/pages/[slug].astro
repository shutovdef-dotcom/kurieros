---
/* eslint-disable max-lines -- TODO(H14): decompose [slug].astro (~1149 LOC after skip-blank/comments) into focused per-concern components, then remove this disable. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobGrid from '../components/JobGrid.astro';
import JobFilters from '../components/JobFilters.astro';
import PartnerBanner from '../components/PartnerBanner.astro';
import articlesDataRaw from '../data/articles.json';
import jobsData from '../data/jobs';
import { CATEGORIES } from '../data/constants';
import { getCitiesFromJobs } from '../utils/cities';
import { formatMoney, getVacancyPluralText, parseSalary } from '../utils/format';
import {
	type Article,
	buildFactCards,
	buildFaqItems,
	buildHeroIntro,
	buildNearbyCityLinks,
	buildPageSchemaGraph,
	buildSeoDescription,
	buildSeoTitle,
	buildTransportTypes,
	buildVacancyCountText,
	cleanCategoryName,
} from '../utils/cityListingPage';

// `articles.json` ships empty (`[]`); TS narrows the default JSON
// import to `never[]`, which fouls every `article.title`/`.description`
// access downstream. Once articles ship we'll get richer fields, but
// the contract is fixed: title + description (used for keyword
// matching) + slug/date (consumed by blog.astro).
const articlesData = articlesDataRaw as Article[];

export async function getStaticPaths() {
	type CityProps = {
		type: 'city';
		data: ReturnType<typeof getCitiesFromJobs>[number];
		title: string;
		description: string;
	};
	type CategoryProps = {
		type: 'category';
		data: (typeof CATEGORIES)[number];
		title: string;
		description: string;
	};
	type StaticPath = {
		params: { slug: string };
		props: CityProps | CategoryProps;
	};
	const paths: StaticPath[] = [];

	getCitiesFromJobs(jobsData).forEach((city) => {
		paths.push({
			params: { slug: `rabota-kurerom-${city.slug}` },
			props: {
				type: 'city',
				data: city,
				title: `Работа курьером ${city.prep} — Вакансии 2026`,
				description: `Свежие вакансии для курьеров ${city.prep}. Сравнивайте условия, компании и выплаты до отклика.`,
			},
		});
	});

	CATEGORIES.forEach((cat) => {
		// Special-case H1/description for the daily-payout landing —
		// honest positioning instead of the generic «Работа курьером:
		// {Name} — Вакансии 2026» template (see [slug].astro for the
		// matching seoTitle/seoDescription/heroIntro/FAQ overrides).
		const isEzhednev = cat.slug === 'ezhednevnaya-oplata';
		// AUDIT-OK (A1): the title says «ежедневной» while the description
		// mentions «1–7 дней» — by design. The slug captures the SEO query
		// «ежедневная оплата», but the honest description reflects the
		// bank-transfer cadence; the wallet-instant cadence is covered
		// separately on the page body. Owner-confirmed; do not re-flag.
		paths.push({
			params: { slug: `rabota-kurerom-${cat.slug}` },
			props: {
				type: 'category',
				data: cat,
				title: isEzhednev
					? 'Работа курьером с ежедневной оплатой 2026'
					: `Работа курьером: ${cat.name} — Вакансии 2026`,
				description: isEzhednev
					? 'Курьерские вакансии с самой быстрой банковской выплатой (раз в 1–7 дней) и долей наличных заказов в день смены. Яндекс.Еда, Купер и другие партнёры — реальные условия без обмана.'
					: `Вакансии курьеров в формате "${cat.name}": выплаты, компании, требования и быстрый переход к подходящим вариантам.`,
			},
		});
	});

	return paths;
}

const { type, data, title } = Astro.props;
const isMoscowCityPage = type === 'city' && data.slug === 'moskva';
// Старый override `searchTerm = 'еженед'` для ezhednevnaya-oplata
// удалён: теперь Y.Eda+Купер действительно помечены как «Ежедневно»
// (см. buildPay() в src/data/vacancies.ts) — мгновенные выплаты через
// встроенный кошелёк = ежедневный UX. Запрос «Ежеднев» по
// payment_freq теперь честно матчит ~3000+ реальных вакансий.
//
// Флаг `isEzhednevLanding` оставлен — используется ниже для кастомных
// title/description/FAQ, которые объясняют механику быстрых выплат
// (это полезный контент для SEO и доверия пользователя).
const isEzhednevLanding = type === 'category' && data.slug === 'ezhednevnaya-oplata';
const searchTerm = type === 'category' ? (data.query || '').toLowerCase() : '';
const tagFilter = type === 'category' ? data.tag || 'all' : 'all';

const filteredJobs = jobsData.filter((job) => {
	const matchesCity =
		type !== 'city' ||
		job.location.toLowerCase().includes(data.name.toLowerCase()) ||
		job.location === 'Вся Россия';
	const matchesTag = tagFilter === 'all' || job.tags.includes(tagFilter);
	const matchesSearch =
		!searchTerm ||
		job.title.toLowerCase().includes(searchTerm) ||
		job.company.toLowerCase().includes(searchTerm) ||
		job.location.toLowerCase().includes(searchTerm) ||
		job.salary.toLowerCase().includes(searchTerm) ||
		// Match payment_freq so a category page with `query: 'Еженед'`
		// или `query: 'Ежеднев'` populates from `details.payment_freq` —
		// слова «Еженедельно» / «Ежедневно» живут только там.
		job.details.payment_freq.toLowerCase().includes(searchTerm);

	return matchesCity && matchesTag && matchesSearch;
});

const companyNames = Array.from(new Set(filteredJobs.map((job) => job.company)));
const paymentTypes = Array.from(new Set(filteredJobs.map((job) => job.details.payment_freq)));
const transportTypes = buildTransportTypes(filteredJobs);
// P0: empty listings need noindex so Google/Yandex don't penalise us for thin
// content. We also drop them from the sitemap (see astro.config.mjs).
const isEmptyListing = filteredJobs.length === 0;

// «Соседние города» — exit-ramp для search-визитёров. GSC report
// (2026-05-03) показал: page_depth Метрики 2.49 → 1.62, avg session
// 5:04 → 2:32. Юзер приходит на small-city из long-tail, видит
// JobGrid и УХОДИТ — нет «куда ещё кликнуть». Этот блок даёт топ-12
// городов с наибольшим числом вакансий как явный «следующий шаг»
// сразу под JobGrid. Только для type='city' — на категории не нужен.
const nearbyCityLinks = type === 'city' ? buildNearbyCityLinks(jobsData, data.slug) : [];

// P1: max salary across the matched listings — used in title/description to
// make the snippet more clickable in search results (cheaper-than-rewrite
// because the number lives directly in the SERP and beats a generic count).
const maxSalary = filteredJobs.reduce((acc, job) => {
	const value = parseSalary(job.salary);
	return value > acc ? value : acc;
}, 0);
const formattedMaxSalary = maxSalary > 0 ? formatMoney(maxSalary) : null;
const vacancyCountText = buildVacancyCountText(filteredJobs.length);

const cityPrep = type === 'city' ? data.prep : undefined;
const categoryName = type === 'category' ? data.name : undefined;
const categoryNameClean = type === 'category' ? cleanCategoryName(data.name) : undefined;

const seoTitle = buildSeoTitle({
	type,
	cityPrep,
	categoryNameClean,
	formattedMaxSalary,
	vacancyCountText,
	isEmptyListing,
	isEzhednevLanding,
});
const seoDescription = buildSeoDescription({
	type,
	cityPrep,
	categoryName,
	categoryNameClean,
	formattedMaxSalary,
	vacancyCountText,
	isEmptyListing,
	isEzhednevLanding,
	companyNames,
	paymentTypes,
	transportTypes,
});
const heroIntro = buildHeroIntro(type, isEzhednevLanding, vacancyCountText, cityPrep);
const factCards = buildFactCards({
	filteredJobsCount: filteredJobs.length,
	companyCount: companyNames.length,
	transportTypes,
	paymentTypes,
});

// articlesData currently ships empty, but the import wiring is kept
// so the page can light up the «related articles» surface as soon as
// content lands without another refactor. Touching the import alone
// would silently regress that path.
void articlesData;

const faqItems = buildFaqItems({
	type,
	isEzhednevLanding,
	dataName: data.name,
	cityPrep,
	filteredJobsCount: filteredJobs.length,
	companyNames,
	transportTypes,
	vacancyCountText,
});

const pageSchemaGraph = buildPageSchemaGraph({
	type,
	dataName: data.name,
	title,
	seoDescription,
	pageUrlHref: Astro.url.href,
	pageUrlPathname: Astro.url.pathname,
	siteUrl: Astro.site,
	dateModifiedIso: new Date().toISOString(),
	filteredJobs,
	faqItems,
});
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	schemaGraph={pageSchemaGraph}
	robots={isEmptyListing ? 'noindex, follow' : undefined}
>
	<Header />

	<main>
		<section class="hero listing-hero">
			<div class="listing-hero-panel">
				<nav class="listing-breadcrumb" aria-label="Хлебные крошки">
					<a href="/">Главная</a>
					{type === 'city' && (
						<>
							<span>&gt;</span>
							<a href="/cities/">Города</a>
						</>
					)}
					<span>&gt;</span>
					<span>{type === 'city' ? `Работа курьером ${data.prep}` : data.name}</span>
				</nav>
				<p class="section-eyebrow">{type === 'city' ? 'Вакансии в городе' : 'Готовый фильтр'}</p>
				<h1>{title}</h1>
				<p>{heroIntro}</p>
				<div class="listing-hero-actions">
					<a href="#vacancies" class="listing-primary-link">Смотреть вакансии</a>
					<a href="/compare/" class="listing-secondary-link">Сравнить</a>
				</div>
				<div class="listing-fact-grid listing-fact-grid-hero">
					{factCards.map((fact) => (
						<article class="listing-fact-card">
							<span>{fact.label}</span>
							<strong>{fact.value}</strong>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="listing-filters" aria-label="Фильтры вакансий">
			<JobFilters />
		</section>

		<JobGrid
			initialCity={type === 'city' ? data.name : undefined}
			initialTag={type === 'category' ? data.tag : undefined}
			initialSearch={type === 'category' ? data.query : undefined}
			limit={24}
			revealable
		/>

		{nearbyCityLinks.length > 0 && (
			<section class="nearby-cities" aria-labelledby="nearby-cities-title">
				<h2 id="nearby-cities-title" class="nearby-cities-title">Не нашли подходящее? Соседние города</h2>
				<p class="nearby-cities-lead">
					Те же компании (Яндекс.Еда, Купер, Озон, Самокат) работают в&nbsp;{nearbyCityLinks.length} крупнейших городах России. Перейдите в&nbsp;любой и&nbsp;посмотрите тарифы, выплаты и&nbsp;условия — вакансии одинаково «свежие, от&nbsp;прямых работодателей».
				</p>
				<ul class="nearby-cities-list">
					{nearbyCityLinks.map((city) => (
						<li class="nearby-cities-item">
							<a class="nearby-cities-link" href={`/rabota-kurerom-${city.slug}/`}>
								<span class="nearby-cities-name">{city.name}</span>
								<span class="nearby-cities-count">{city.vacancyCount}&nbsp;{getVacancyPluralText(city.vacancyCount)}</span>
							</a>
						</li>
					))}
				</ul>
				<p class="nearby-cities-footer">
					<a href="/cities/" class="nearby-cities-all-link">Все&nbsp;города&nbsp;→</a>
				</p>
			</section>
		)}

		{isMoscowCityPage && <PartnerBanner />}
	</main>

	<Footer />
</BaseLayout>

<style>
	.listing-hero,
	.listing-vacancy-launch,
	.listing-fact-grid,
	.listing-geo-grid,
	.listing-local-grid,
	.listing-faq-section,
	.listing-filters,
	.listing-trust-panel {
		max-width: 1180px;
		margin-inline: auto;
	}
	.listing-filters {
		padding: 0 1rem;
		margin-bottom: var(--space-3);
	}

	.listing-hero {
		padding: 1.25rem 1rem 0.5rem;
		margin-bottom: 1rem;
	}

	.listing-hero-panel {
		padding: 1.65rem;
		text-align: left;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		background: linear-gradient(135deg, rgba(245, 249, 242, 0.96) 0%, rgba(255, 255, 255, 0.98) 58%, rgba(242, 250, 253, 0.96) 100%);
		box-shadow: 0 14px 36px rgba(24, 45, 34, 0.07);
	}

	.listing-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		align-items: center;
		margin-bottom: 0.85rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.listing-breadcrumb a {
		color: var(--accent-color);
		text-decoration: none;
	}

	.listing-hero h1 {
		max-width: 14ch;
		margin: 0 0 0.7rem;
		font-size: 3.8rem;
		line-height: 0.97;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.listing-hero-panel > p:not(.section-eyebrow) {
		max-width: 720px;
		margin: 0;
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.section-eyebrow {
		margin: 0 0 0.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--accent-color);
	}

	.listing-trust-panel {
		display: grid;
		grid-template-columns: minmax(220px, 0.32fr) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
		margin-bottom: 1rem;
		padding: 1.5rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.74);
		box-shadow: var(--shadow-sm);
	}

	.listing-trust-panel h2,
	.listing-trust-panel p {
		margin: 0;
	}

	.listing-trust-panel p {
		color: var(--text-muted);
		line-height: 1.8;
	}

	.listing-hero-actions,
	.listing-vacancy-launch-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		align-items: center;
		margin-top: 1rem;
	}

	.listing-primary-link,
	.listing-secondary-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.8rem 1.15rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 800;
		transition: var(--transition);
	}

	.listing-primary-link {
		background: var(--brand-800);
		border: 1px solid var(--brand-800);
		color: var(--ink-0);
	}

	.listing-secondary-link {
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid #a8c8b5;
		color: var(--brand-800);
	}

	.listing-primary-link:hover,
	.listing-secondary-link:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 24px rgba(22, 61, 43, 0.12);
	}

	.listing-vacancy-launch {
		display: grid;
		grid-template-columns: minmax(260px, 0.42fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		margin-bottom: 1rem;
		padding: 1.35rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-vacancy-launch h2,
	.listing-vacancy-launch p {
		margin: 0;
	}

	.listing-vacancy-launch-copy {
		display: grid;
		gap: 0.55rem;
	}

	.listing-vacancy-launch-copy p:not(.section-eyebrow) {
		color: var(--text-muted);
		line-height: 1.65;
	}

	.listing-vacancy-launch-actions {
		margin-top: 0;
	}

	.listing-fact-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1rem 0 0;
	}

	.listing-fact-card {
		display: grid;
		gap: 0.25rem;
		min-height: auto;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-fact-card span {
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.listing-fact-card strong {
		align-self: start;
		font-size: 1rem;
		line-height: 1.32;
	}

	.listing-geo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding: 0 1rem;
	}

	.listing-local-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding: 0 1rem;
	}

	.listing-geo-card,
	.listing-local-card,
	.listing-faq-section {
		padding: 1.5rem;
		border-radius: 8px;
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
	}

	.listing-geo-card {
		border: 1px solid rgba(var(--brand-700-rgb), 0.16);
		background:
			linear-gradient(180deg, var(--scrim-light-strong), rgba(247, 251, 248, 0.96)),
			var(--bg-card);
	}

	.listing-local-card {
		border: 1px solid var(--scrim-border-mid);
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-geo-card-caution {
		border-color: rgba(249, 115, 22, 0.16);
	}

	.listing-geo-card h2,
	.listing-local-card h2,
	.listing-faq-section h2 {
		margin-top: 0;
		margin-bottom: 1rem;
		font-size: 1.55rem;
	}

	.listing-bullet-list {
		margin: 0;
		padding-left: 1.35rem;
		color: var(--text-main);
	}

	.listing-bullet-list li {
		margin-bottom: 0.7rem;
		line-height: 1.7;
	}

	.numbered-list li::marker {
		color: var(--accent-color);
		font-weight: 900;
	}

	.listing-faq-section {
		margin: 0 1rem 1.5rem;
	}

	.listing-company-section {
		max-width: 1180px;
		margin: 0 auto 1.5rem;
		padding: 0 1rem;
	}

	.listing-company-section h2 {
		margin: 0 0 1rem;
		font-size: 1.55rem;
	}

	.listing-company-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.listing-company-card {
		display: grid;
		gap: 0.45rem;
		padding: 1.2rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
		color: var(--text-main);
		text-decoration: none;
		transition: var(--transition);
	}

	.listing-company-card:hover {
		transform: translateY(-2px);
		border-color: var(--text-main);
		box-shadow: var(--shadow-md);
	}

	.listing-company-card span,
	.listing-company-card small {
		color: var(--text-muted);
		line-height: 1.6;
	}

	.listing-faq-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.listing-faq-item {
		padding: 1.1rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.72);
	}

	.listing-faq-item h3 {
		margin: 0 0 0.45rem;
		font-size: 1rem;
	}

	.listing-faq-item p {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.7;
	}

	.listing-trust-panel {
		margin: 0 1rem 2rem;
	}

	.listing-link-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1180px;
		margin: 0 auto 2rem;
		padding: 0 1rem;
	}

	.listing-link-card {
		padding: 1.5rem;
		border-radius: 8px;
		border: 1px solid var(--scrim-border-mid);
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.link-chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.link-chip,
	.related-article-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.4rem;
		padding: 0.65rem 0.9rem;
		border-radius: 8px;
		border: 1px solid rgba(var(--brand-700-rgb), 0.18);
		background: rgba(var(--brand-700-rgb), 0.08);
		color: var(--text-main);
		text-decoration: none;
		font-weight: 800;
	}

	.related-article-stack {
		display: grid;
		gap: 0.7rem;
	}

	.listing-empty-note {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.7;
	}

	@media (min-width: 768px) {
		.listing-hero {
			padding: 2rem 1rem 0.75rem;
			margin-bottom: 1rem;
		}
	}

	@media (max-width: 960px) {
		.listing-fact-grid,
		.listing-faq-grid,
		.listing-company-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.listing-geo-grid,
		.listing-link-grid,
		.listing-local-grid {
			grid-template-columns: 1fr;
		}
	}

