---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobGrid from '../components/JobGrid.astro';
import JobFilters from '../components/JobFilters.astro';
import PartnerBanner from '../components/PartnerBanner.astro';
import CityInsights from '../components/CityInsights.astro';
import jobsData from '../data/jobs';
import { CATEGORIES } from '../data/constants';
import { getCitiesFromJobs } from '../utils/cities';
import { formatMoney, parseSalary } from '../utils/format';
import {
	buildFactCards,
	buildFaqItems,
	buildHeroIntro,
	buildPageSchemaGraph,
	buildSeoDescription,
	buildSeoTitle,
	buildTransportTypes,
	buildVacancyCountText,
	cleanCategoryName,
} from '../utils/cityListingPage';
import {
	filterJobsByCriteria,
	getCityJobsFromMap,
} from '../utils/jobFilters';
import { HUB_CONFIGS, isHubEmpty } from '../utils/transportHubs';
import { CATEGORY_CANONICAL_HUB } from '../utils/categoryCanonicalHub';
// `jobsByCity` is built ONCE at module load inside jobsByCityIndex.ts
// (imports are module-cached). It is NOT rebuilt per page — a local
// `const jobsByCity = buildJobsByCityMap(jobsData)` in this frontmatter
// would re-run once per generated city/category listing page (audit
// ref v3 NEW-2); the shared module binding avoids that. (audit ref v2
// H12)
import { jobsByCity } from '../utils/jobsByCityIndex';
// `citiesFromJobs` is the module-cached city catalogue — same H3
// rationale as `jobsByCity` above (audit ref v4 MEDIUM-1).
import { citiesFromJobs } from '../utils/citiesIndex';
// Z1.1 — unique per-city insights (Kuper shift rates + region + live counts).
import { buildCitySalaryRows, buildCitySummary } from '../utils/cityInsights';
import { getCityShiftRates, NATIONAL_AVG_SHIFT, KUPER_RATES_UPDATED_AT } from '../utils/kuperCityRates';
import { getCityGeo, getNearbyCities } from '../utils/cityGeoIndex';

// Build a lookup from hub path → HubConfig for the isHubEmpty guard.
const _hubPathToConfig = Object.fromEntries(
	Object.values(HUB_CONFIGS).map((cfg) => [`/${cfg.slug}/`, cfg]),
);

export async function getStaticPaths() {
	type CityProps = {
		type: 'city';
		data: ReturnType<typeof getCitiesFromJobs>[number];
		title: string;
		description: string;
	};
	type CategoryProps = {
		type: 'category';
		data: (typeof CATEGORIES)[number];
		title: string;
		description: string;
	};
	type StaticPath = {
		params: { slug: string };
		props: CityProps | CategoryProps;
	};
	const paths: StaticPath[] = [];

	citiesFromJobs.forEach((city) => {
		paths.push({
			params: { slug: `rabota-kurerom-${city.slug}` },
			props: {
				type: 'city',
				data: city,
				title: `Работа курьером ${city.prep} — Вакансии 2026`,
				description: `Свежие вакансии для курьеров ${city.prep}. Сравнивайте условия, компании и выплаты до отклика.`,
			},
		});
	});

	CATEGORIES.forEach((cat) => {
		// Special-case H1/description for the daily-payout landing —
		// honest positioning instead of the generic «Работа курьером:
		// {Name} — Вакансии 2026» template (see [slug].astro for the
		// matching seoTitle/seoDescription/heroIntro/FAQ overrides).
		const isEzhednev = cat.slug === 'ezhednevnaya-oplata';
		// AUDIT-OK (A1): the title says «ежедневной» while the description
		// mentions «1–7 дней» — by design. The slug captures the SEO query
		// «ежедневная оплата», but the honest description reflects the
		// bank-transfer cadence; the wallet-instant cadence is covered
		// separately on the page body. Owner-confirmed; do not re-flag.
		paths.push({
			params: { slug: `rabota-kurerom-${cat.slug}` },
			props: {
				type: 'category',
				data: cat,
				title: isEzhednev
					? 'Работа курьером с ежедневной оплатой 2026'
					: `Работа курьером: ${cat.name} — Вакансии 2026`,
				description: isEzhednev
					? 'Курьерские вакансии с самой быстрой банковской выплатой (раз в 1–7 дней) и долей наличных заказов в день смены. Яндекс.Еда, Купер и другие партнёры — реальные условия без обмана.'
					: `Вакансии курьеров в формате "${cat.name}": выплаты, компании, требования и быстрый переход к подходящим вариантам.`,
			},
		});
	});

	return paths;
}

const { type, data, title } = Astro.props;
const isMoscowCityPage = type === 'city' && data.slug === 'moskva';
// Старый override `searchTerm = 'еженед'` для ezhednevnaya-oplata
// удалён: теперь Y.Eda+Купер действительно помечены как «Ежедневно»
// (см. buildPay() в src/data/sources/shared.ts) — мгновенные выплаты
// через встроенный кошелёк = ежедневный UX. Запрос «Ежеднев» по
// payment_freq теперь честно матчит ~3000+ реальных вакансий.
//
// Флаг `isEzhednevLanding` оставлен — используется ниже для кастомных
// title/description/FAQ, которые объясняют механику быстрых выплат
// (это полезный контент для SEO и доверия пользователя).
const isEzhednevLanding = type === 'category' && data.slug === 'ezhednevnaya-oplata';
const searchTerm = type === 'category' ? (data.query || '').toLowerCase() : '';
const tagFilter = type === 'category' ? data.tag || 'all' : 'all';

// Single source of truth for the city/tag/search predicate lives in
// `src/utils/jobFilters.ts` — sitemap emitter + JobGrid + this page
// MUST agree on which jobs land where, so any drift would noindex
// listings while still emitting them in the sitemap (or vice versa).
//
// For city pages we look up the per-city bucket from the module-level
// `jobsByCity` Map (O(1)) and only run the tag/search filter on that
// subset. For category pages there's no city criterion, so we filter
// the full job list directly. Both branches converge on
// `filterJobsByCriteria`, keeping the predicate semantics identical
// to the sitemap emitter. (audit ref v2 H12)
const filteredJobs =
	type === 'city'
		? filterJobsByCriteria(getCityJobsFromMap(jobsByCity, data.name), {
			tag: tagFilter,
			search: searchTerm,
		})
		: filterJobsByCriteria(jobsData, {
			tag: tagFilter,
			search: searchTerm,
		});

const companyNames = Array.from(new Set(filteredJobs.map((job) => job.company)));
const paymentTypes = Array.from(new Set(filteredJobs.map((job) => job.details.payment_freq)));
const transportTypes = buildTransportTypes(filteredJobs);
// P0: thin listings (0 or 1 vacancy) need noindex so Google/Yandex don't
// penalise us for thin content. We also drop them from the sitemap (see
// astro.config.mjs). Threshold mirrors getEmptyListingPaths() in listingSlugs.ts.
const isEmptyListing = filteredJobs.length <= 1;

// Decision A: emit cross-canonical to hub page for the 4 canonicaled category
// facets — but only when the hub itself is non-empty (a noindexed hub as
// canonical target would be an indexing bug). All other pages → undefined
// (BaseLayout falls back to self-canonical via Astro.url.pathname).
const _hubPath = type === 'category' ? CATEGORY_CANONICAL_HUB[data.slug] : undefined;
const _hubCfg = _hubPath !== undefined ? _hubPathToConfig[_hubPath] : undefined;
const canonicalURL =
	_hubPath !== undefined && _hubCfg !== undefined && !isHubEmpty(jobsData, _hubCfg)
		? _hubPath
		: undefined;

// «Соседние города» — exit-ramp для search-визитёров (GSC 2026-05-03:
// page_depth 2.49 → 1.62 без «куда ещё кликнуть»). Z1.1: вместо топ-12
// по числу вакансий (одинаковый на всех страницах) — географически
// ближайшие города с вакансиями, уникальный набор на каждый город.
const cityGeo = type === 'city' ? getCityGeo(data.slug) : null;
const cityNeighbours = type === 'city' ? getNearbyCities(data.slug) : [];

// P1: max salary across the matched listings — used in title/description to
// make the snippet more clickable in search results (cheaper-than-rewrite
// because the number lives directly in the SERP and beats a generic count).
const maxSalary = filteredJobs.reduce((acc, job) => {
	const value = parseSalary(job.salary);
	return value > acc ? value : acc;
}, 0);
const formattedMaxSalary = maxSalary > 0 ? formatMoney(maxSalary) : null;
const vacancyCountText = buildVacancyCountText(filteredJobs.length);

// Z1.1 — unique per-city content block (city pages only, rendered below
// the JobGrid). Kuper ships shift rates for ~412/958 cities; the summary
// degrades gracefully (vacancy-derived salary, no rate table) otherwise.
const cityRates = type === 'city' ? getCityShiftRates(data.name) : null;
const citySalaryRows = buildCitySalaryRows(cityRates, maxSalary);
const citySummary =
	type === 'city' && filteredJobs.length > 0
		? buildCitySummary({
			prep: data.prep,
			population: data.population,
			region: cityGeo?.region,
			district: cityGeo?.district,
			vacancyCount: filteredJobs.length,
			companyNames,
			rates: cityRates,
			nationalAutoAvg: NATIONAL_AVG_SHIFT.auto,
		})
		: '';

const cityPrep = type === 'city' ? data.prep : undefined;
const categoryName = type === 'category' ? data.name : undefined;
const categoryNameClean = type === 'category' ? cleanCategoryName(data.name) : undefined;

const seoTitle = buildSeoTitle({
	type,
	cityPrep,
	categoryNameClean,
	formattedMaxSalary,
	vacancyCountText,
	isEmptyListing,
	isEzhednevLanding,
});
const seoDescription = buildSeoDescription({
	type,
	cityPrep,
	categoryName,
	categoryNameClean,
	formattedMaxSalary,
	vacancyCountText,
	isEmptyListing,
	isEzhednevLanding,
	companyNames,
	paymentTypes,
	transportTypes,
});
const heroIntro = buildHeroIntro(type, isEzhednevLanding, vacancyCountText, cityPrep);
const factCards = buildFactCards({
	filteredJobsCount: filteredJobs.length,
	companyCount: companyNames.length,
	transportTypes,
	paymentTypes,
});

const faqItems = buildFaqItems({
	type,
	isEzhednevLanding,
	dataName: data.name,
	cityPrep,
	filteredJobsCount: filteredJobs.length,
	companyNames,
	transportTypes,
	vacancyCountText,
});

const pageSchemaGraph = buildPageSchemaGraph({
	type,
	dataName: data.name,
	title,
	seoDescription,
	pageUrlHref: Astro.url.href,
	pageUrlPathname: Astro.url.pathname,
	siteUrl: Astro.site,
	dateModifiedIso: new Date().toISOString(),
	filteredJobs,
	faqItems,
});
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	schemaGraph={pageSchemaGraph}
	robots={isEmptyListing ? 'noindex, follow' : undefined}
	canonicalURL={canonicalURL}
>
	<Header />

	<main>
		<section class="hero listing-hero">
			<div class="listing-hero-panel">
				<nav class="listing-breadcrumb" aria-label="Хлебные крошки">
					<a href="/">Главная</a>
					{type === 'city' && (
						<>
							<span>&gt;</span>
							<a href="/cities/">Города</a>
						</>
					)}
					<span>&gt;</span>
					<span>{type === 'city' ? `Работа курьером ${data.prep}` : data.name}</span>
				</nav>
				<p class="section-eyebrow">{type === 'city' ? 'Вакансии в городе' : 'Готовый фильтр'}</p>
				<h1>{title}</h1>
				<p>{type === 'city' && citySummary ? citySummary : heroIntro}</p>
				<div class="listing-hero-actions">
					<a href="#vacancies" class="listing-primary-link">Смотреть вакансии</a>
					<a href="/compare/" class="listing-secondary-link">Сравнить</a>
				</div>
				<div class="listing-fact-grid listing-fact-grid-hero">
					{factCards.map((fact) => (
						<article class="listing-fact-card">
							<span>{fact.label}</span>
							<strong>{fact.value}</strong>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="listing-filters" aria-label="Фильтры вакансий">
			<JobFilters />
		</section>

		<JobGrid
			initialCity={type === 'city' ? data.name : undefined}
			initialTag={type === 'category' ? data.tag : undefined}
			initialSearch={type === 'category' ? data.query : undefined}
			jobs={filteredJobs}
			limit={24}
			revealable
		/>

		{type === 'city' && citySummary && (
			<CityInsights
				prep={data.prep}
				salaryRows={citySalaryRows}
				maxSalary={maxSalary}
				updatedAt={KUPER_RATES_UPDATED_AT}
				salaryFromVacancies={cityRates === null}
				neighbours={cityNeighbours}
			/>
		)}

		{isMoscowCityPage && <PartnerBanner />}
	</main>

	<Footer />
</BaseLayout>

<style>
	.listing-hero,
	.listing-fact-grid,
	.listing-filters {
		max-width: var(--content-max-width);
		margin-inline: auto;
	}
	.listing-filters {
		padding: 0 1rem;
		margin-bottom: var(--space-3);
	}

	.listing-hero {
		padding: 1.25rem 1rem 0.5rem;
		margin-bottom: 1rem;
	}

	.listing-hero-panel {
		position: relative;
		overflow: hidden;
		padding: clamp(1.6rem, 3.5vw, 3rem) clamp(1.25rem, 3vw, 2.25rem);
		text-align: left;
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-xl, 20px);
		background: linear-gradient(135deg,
			rgba(232, 246, 230, 0.78) 0%,
			rgba(255, 255, 255, 0.95) 48%,
			rgba(232, 240, 246, 0.7) 100%);
		box-shadow: 0 14px 40px rgba(24, 45, 34, 0.06);
	}
	.listing-hero-panel::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 88% 14%, rgba(46, 139, 87, 0.1) 0%, transparent 55%),
			radial-gradient(circle at 4% 92%, rgba(70, 130, 180, 0.08) 0%, transparent 50%);
	}
	.listing-hero-panel > * {
		position: relative;
		z-index: 1;
	}

	.listing-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		align-items: center;
		margin-bottom: 0.85rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.listing-breadcrumb a {
		color: var(--accent-color);
		text-decoration: none;
	}

	.listing-hero h1 {
		max-width: 18ch;
		margin: 0 0 0.5rem;
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: clamp(1.55rem, 5vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--ink-900);
		text-wrap: balance;
	}

	.listing-hero-panel > p:not(.section-eyebrow) {
		max-width: 60ch;
		margin: 0;
		font-family: var(--font-main);
		font-size: clamp(0.98rem, 1.3vw, 1.12rem);
		line-height: 1.55;
		color: var(--ink-700);
	}

	.section-eyebrow {
		display: inline-flex;
		align-items: center;
		width: fit-content;
		margin: 0 0 0.2rem;
		padding: 0.35rem 0.85rem;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid var(--ink-200);
		border-radius: 999px;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-700);
	}

	.listing-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		align-items: center;
		margin-top: 1rem;
	}

	.listing-primary-link,
	.listing-secondary-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 52px;
		padding: 0 1.6rem;
		border-radius: 12px;
		text-decoration: none;
		font-weight: 700;
		font-size: 1rem;
		transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
	}

	.listing-primary-link {
		background: var(--brand-700);
		border: 1px solid var(--brand-700);
		color: var(--ink-0);
		box-shadow: 0 8px 20px rgba(var(--brand-700-rgb), 0.22);
	}

	.listing-secondary-link {
		background: rgba(255, 255, 255, 0.9);
		border: 1px solid var(--ink-200);
		color: var(--ink-900);
	}

	.listing-primary-link:hover,
	.listing-primary-link:focus-visible {
		background: var(--brand-600);
		transform: translateY(-1px);
		box-shadow: 0 12px 26px rgba(var(--brand-700-rgb), 0.32);
		outline: none;
	}

	.listing-secondary-link:hover,
	.listing-secondary-link:focus-visible {
		border-color: var(--brand-500);
		transform: translateY(-1px);
		outline: none;
	}

	.listing-fact-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1rem 0 0;
	}

	.listing-fact-card {
		display: grid;
		gap: 0.15rem;
		min-height: auto;
		padding: 0.85rem 1rem;
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-md, 12px);
		background: rgba(255, 255, 255, 0.88);
		transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}

	.listing-fact-card:hover {
		border-color: var(--brand-500);
		transform: translateY(-2px);
		box-shadow: 0 10px 22px rgba(24, 45, 34, 0.07);
	}

	.listing-fact-card span {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--ink-500);
	}

	.listing-fact-card strong {
		align-self: start;
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1.32;
		color: var(--ink-900);
	}

	@media (min-width: 768px) {
		.listing-hero {
			padding: 2rem 1rem 0.75rem;
			margin-bottom: 1rem;
		}
		.listing-hero-panel {
			padding: clamp(1rem, 2vw, 1.6rem) clamp(1.1rem, 2.4vw, 1.85rem);
		}
		.listing-hero h1 {
			font-size: clamp(1.65rem, 3.4vw, 2.4rem);
			line-height: 1.08;
		}
		.listing-hero-panel > p:not(.section-eyebrow) {
			font-size: clamp(0.92rem, 1.1vw, 1.02rem);
			line-height: 1.45;
		}
		.listing-primary-link,
		.listing-secondary-link {
			min-height: 44px;
			padding: 0 1.25rem;
			font-size: 0.95rem;
		}
	}

	@media (max-width: 960px) {
		.listing-fact-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.listing-breadcrumb {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.listing-hero-panel {
			padding: 1.1rem;
		}

		.listing-fact-grid {
			display: none;
		}

		.listing-hero {
			padding-inline: 1rem;
		}
	}

	/* Dark mode — mirror hero-v2 (HomeHero.astro). */
	:global(:where(html, body).dark-mode) .listing-hero-panel {
		background: linear-gradient(135deg,
			rgba(20, 32, 48, 0.85) 0%,
			rgba(12, 22, 36, 0.95) 50%,
			rgba(18, 28, 44, 0.8) 100%);
		border-color: rgba(195, 204, 216, 0.18);
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.32);
	}
	:global(:where(html, body).dark-mode) .listing-hero-panel::before {
		background:
			radial-gradient(circle at 88% 14%, rgba(76, 175, 128, 0.1) 0%, transparent 55%),
			radial-gradient(circle at 4% 92%, rgba(96, 165, 250, 0.08) 0%, transparent 50%);
	}
	:global(:where(html, body).dark-mode) .section-eyebrow {
		background: rgba(20, 32, 48, 0.6);
		border-color: rgba(195, 204, 216, 0.18);
		color: rgba(231, 234, 240, 0.85);
	}
	:global(:where(html, body).dark-mode) .listing-hero-panel h1 {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .listing-hero-panel > p:not(.section-eyebrow) {
		color: rgba(231, 234, 240, 0.78);
	}
	:global(:where(html, body).dark-mode) .listing-fact-card {
		background: rgba(20, 32, 48, 0.7);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .listing-fact-card strong {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .listing-fact-card span {
		color: rgba(231, 234, 240, 0.6);
	}
	:global(:where(html, body).dark-mode) .listing-secondary-link {
		background: rgba(20, 32, 48, 0.7);
		color: var(--ink-800);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .listing-secondary-link:hover,
	:global(:where(html, body).dark-mode) .listing-secondary-link:focus-visible {
		background: rgba(20, 32, 48, 0.9);
		border-color: rgba(76, 175, 128, 0.6);
	}
	:global(:where(html, body).dark-mode) .listing-primary-link {
		background: var(--brand-600);
		border-color: var(--brand-600);
		color: var(--ink-0);
	}

</style>
