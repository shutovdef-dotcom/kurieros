---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobGrid from '../components/JobGrid.astro';
import JobFilters from '../components/JobFilters.astro';
import PartnerBanner from '../components/PartnerBanner.astro';
import jobsData from '../data/jobs';
import { CATEGORIES } from '../data/constants';
import { getCitiesFromJobs } from '../utils/cities';
import { formatMoney, getVacancyPluralText, parseSalary } from '../utils/format';
import {
	buildFactCards,
	buildFaqItems,
	buildHeroIntro,
	buildNearbyCityLinks,
	buildPageSchemaGraph,
	buildSeoDescription,
	buildSeoTitle,
	buildTransportTypes,
	buildVacancyCountText,
	cleanCategoryName,
} from '../utils/cityListingPage';
import {
	filterJobsByCriteria,
	getCityJobsFromMap,
} from '../utils/jobFilters';
import { HUB_CONFIGS, isHubEmpty } from '../utils/transportHubs';
import { CATEGORY_CANONICAL_HUB } from '../utils/categoryCanonicalHub';
// `jobsByCity` is built ONCE at module load inside jobsByCityIndex.ts
// (imports are module-cached). It is NOT rebuilt per page — a local
// `const jobsByCity = buildJobsByCityMap(jobsData)` in this frontmatter
// would re-run once per generated city/category listing page (audit
// ref v3 NEW-2); the shared module binding avoids that. (audit ref v2
// H12)
import { jobsByCity } from '../utils/jobsByCityIndex';
// `citiesFromJobs` is the module-cached city catalogue — same H3
// rationale as `jobsByCity` above (audit ref v4 MEDIUM-1).
import { citiesFromJobs } from '../utils/citiesIndex';

// Build a lookup from hub path → HubConfig for the isHubEmpty guard.
const _hubPathToConfig = Object.fromEntries(
	Object.values(HUB_CONFIGS).map((cfg) => [`/${cfg.slug}/`, cfg]),
);

export async function getStaticPaths() {
	type CityProps = {
		type: 'city';
		data: ReturnType<typeof getCitiesFromJobs>[number];
		title: string;
		description: string;
	};
	type CategoryProps = {
		type: 'category';
		data: (typeof CATEGORIES)[number];
		title: string;
		description: string;
	};
	type StaticPath = {
		params: { slug: string };
		props: CityProps | CategoryProps;
	};
	const paths: StaticPath[] = [];

	citiesFromJobs.forEach((city) => {
		paths.push({
			params: { slug: `rabota-kurerom-${city.slug}` },
			props: {
				type: 'city',
				data: city,
				title: `Работа курьером ${city.prep} — Вакансии 2026`,
				description: `Свежие вакансии для курьеров ${city.prep}. Сравнивайте условия, компании и выплаты до отклика.`,
			},
		});
	});

	CATEGORIES.forEach((cat) => {
		// Special-case H1/description for the daily-payout landing —
		// honest positioning instead of the generic «Работа курьером:
		// {Name} — Вакансии 2026» template (see [slug].astro for the
		// matching seoTitle/seoDescription/heroIntro/FAQ overrides).
		const isEzhednev = cat.slug === 'ezhednevnaya-oplata';
		// AUDIT-OK (A1): the title says «ежедневной» while the description
		// mentions «1–7 дней» — by design. The slug captures the SEO query
		// «ежедневная оплата», but the honest description reflects the
		// bank-transfer cadence; the wallet-instant cadence is covered
		// separately on the page body. Owner-confirmed; do not re-flag.
		paths.push({
			params: { slug: `rabota-kurerom-${cat.slug}` },
			props: {
				type: 'category',
				data: cat,
				title: isEzhednev
					? 'Работа курьером с ежедневной оплатой 2026'
					: `Работа курьером: ${cat.name} — Вакансии 2026`,
				description: isEzhednev
					? 'Курьерские вакансии с самой быстрой банковской выплатой (раз в 1–7 дней) и долей наличных заказов в день смены. Яндекс.Еда, Купер и другие партнёры — реальные условия без обмана.'
					: `Вакансии курьеров в формате "${cat.name}": выплаты, компании, требования и быстрый переход к подходящим вариантам.`,
			},
		});
	});

	return paths;
}

const { type, data, title } = Astro.props;
const isMoscowCityPage = type === 'city' && data.slug === 'moskva';
// Старый override `searchTerm = 'еженед'` для ezhednevnaya-oplata
// удалён: теперь Y.Eda+Купер действительно помечены как «Ежедневно»
// (см. buildPay() в src/data/sources/shared.ts) — мгновенные выплаты
// через встроенный кошелёк = ежедневный UX. Запрос «Ежеднев» по
// payment_freq теперь честно матчит ~3000+ реальных вакансий.
//
// Флаг `isEzhednevLanding` оставлен — используется ниже для кастомных
// title/description/FAQ, которые объясняют механику быстрых выплат
// (это полезный контент для SEO и доверия пользователя).
const isEzhednevLanding = type === 'category' && data.slug === 'ezhednevnaya-oplata';
const searchTerm = type === 'category' ? (data.query || '').toLowerCase() : '';
const tagFilter = type === 'category' ? data.tag || 'all' : 'all';

// Single source of truth for the city/tag/search predicate lives in
// `src/utils/jobFilters.ts` — sitemap emitter + JobGrid + this page
// MUST agree on which jobs land where, so any drift would noindex
// listings while still emitting them in the sitemap (or vice versa).
//
// For city pages we look up the per-city bucket from the module-level
// `jobsByCity` Map (O(1)) and only run the tag/search filter on that
// subset. For category pages there's no city criterion, so we filter
// the full job list directly. Both branches converge on
// `filterJobsByCriteria`, keeping the predicate semantics identical
// to the sitemap emitter. (audit ref v2 H12)
const filteredJobs =
	type === 'city'
		? filterJobsByCriteria(getCityJobsFromMap(jobsByCity, data.name), {
			tag: tagFilter,
			search: searchTerm,
		})
		: filterJobsByCriteria(jobsData, {
			tag: tagFilter,
			search: searchTerm,
		});

const companyNames = Array.from(new Set(filteredJobs.map((job) => job.company)));
const paymentTypes = Array.from(new Set(filteredJobs.map((job) => job.details.payment_freq)));
const transportTypes = buildTransportTypes(filteredJobs);
// P0: empty listings need noindex so Google/Yandex don't penalise us for thin
// content. We also drop them from the sitemap (see astro.config.mjs).
const isEmptyListing = filteredJobs.length === 0;

// Decision A: emit cross-canonical to hub page for the 4 canonicaled category
// facets — but only when the hub itself is non-empty (a noindexed hub as
// canonical target would be an indexing bug). All other pages → undefined
// (BaseLayout falls back to self-canonical via Astro.url.pathname).
const _hubPath = type === 'category' ? CATEGORY_CANONICAL_HUB[data.slug] : undefined;
const _hubCfg = _hubPath !== undefined ? _hubPathToConfig[_hubPath] : undefined;
const canonicalURL =
	_hubPath !== undefined && _hubCfg !== undefined && !isHubEmpty(jobsData, _hubCfg)
		? _hubPath
		: undefined;

// «Соседние города» — exit-ramp для search-визитёров. GSC report
// (2026-05-03) показал: page_depth Метрики 2.49 → 1.62, avg session
// 5:04 → 2:32. Юзер приходит на small-city из long-tail, видит
// JobGrid и УХОДИТ — нет «куда ещё кликнуть». Этот блок даёт топ-12
// городов с наибольшим числом вакансий как явный «следующий шаг»
// сразу под JobGrid. Только для type='city' — на категории не нужен.
const nearbyCityLinks = type === 'city' ? buildNearbyCityLinks(data.slug) : [];

// P1: max salary across the matched listings — used in title/description to
// make the snippet more clickable in search results (cheaper-than-rewrite
// because the number lives directly in the SERP and beats a generic count).
const maxSalary = filteredJobs.reduce((acc, job) => {
	const value = parseSalary(job.salary);
	return value > acc ? value : acc;
}, 0);
const formattedMaxSalary = maxSalary > 0 ? formatMoney(maxSalary) : null;
const vacancyCountText = buildVacancyCountText(filteredJobs.length);

const cityPrep = type === 'city' ? data.prep : undefined;
const categoryName = type === 'category' ? data.name : undefined;
const categoryNameClean = type === 'category' ? cleanCategoryName(data.name) : undefined;

const seoTitle = buildSeoTitle({
	type,
	cityPrep,
	categoryNameClean,
	formattedMaxSalary,
	vacancyCountText,
	isEmptyListing,
	isEzhednevLanding,
});
const seoDescription = buildSeoDescription({
	type,
	cityPrep,
	categoryName,
	categoryNameClean,
	formattedMaxSalary,
	vacancyCountText,
	isEmptyListing,
	isEzhednevLanding,
	companyNames,
	paymentTypes,
	transportTypes,
});
const heroIntro = buildHeroIntro(type, isEzhednevLanding, vacancyCountText, cityPrep);
const factCards = buildFactCards({
	filteredJobsCount: filteredJobs.length,
	companyCount: companyNames.length,
	transportTypes,
	paymentTypes,
});

const faqItems = buildFaqItems({
	type,
	isEzhednevLanding,
	dataName: data.name,
	cityPrep,
	filteredJobsCount: filteredJobs.length,
	companyNames,
	transportTypes,
	vacancyCountText,
});

const pageSchemaGraph = buildPageSchemaGraph({
	type,
	dataName: data.name,
	title,
	seoDescription,
	pageUrlHref: Astro.url.href,
	pageUrlPathname: Astro.url.pathname,
	siteUrl: Astro.site,
	dateModifiedIso: new Date().toISOString(),
	filteredJobs,
	faqItems,
});
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	schemaGraph={pageSchemaGraph}
	robots={isEmptyListing ? 'noindex, follow' : undefined}
	canonicalURL={canonicalURL}
>
	<Header />

	<main>
		<section class="hero listing-hero">
			<div class="listing-hero-panel">
				<nav class="listing-breadcrumb" aria-label="Хлебные крошки">
					<a href="/">Главная</a>
					{type === 'city' && (
						<>
							<span>&gt;</span>
							<a href="/cities/">Города</a>
						</>
					)}
					<span>&gt;</span>
					<span>{type === 'city' ? `Работа курьером ${data.prep}` : data.name}</span>
				</nav>
				<p class="section-eyebrow">{type === 'city' ? 'Вакансии в городе' : 'Готовый фильтр'}</p>
				<h1>{title}</h1>
				<p>{heroIntro}</p>
				<div class="listing-hero-actions">
					<a href="#vacancies" class="listing-primary-link">Смотреть вакансии</a>
					<a href="/compare/" class="listing-secondary-link">Сравнить</a>
				</div>
				<div class="listing-fact-grid listing-fact-grid-hero">
					{factCards.map((fact) => (
						<article class="listing-fact-card">
							<span>{fact.label}</span>
							<strong>{fact.value}</strong>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="listing-filters" aria-label="Фильтры вакансий">
			<JobFilters />
		</section>

		<JobGrid
			initialCity={type === 'city' ? data.name : undefined}
			initialTag={type === 'category' ? data.tag : undefined}
			initialSearch={type === 'category' ? data.query : undefined}
			jobs={filteredJobs}
			limit={24}
			revealable
		/>

		{nearbyCityLinks.length > 0 && (
			<section class="nearby-cities" aria-labelledby="nearby-cities-title">
				<h2 id="nearby-cities-title" class="nearby-cities-title">Не нашли подходящее? Соседние города</h2>
				<p class="nearby-cities-lead">
					Те же компании (Яндекс.Еда, Купер, Озон, Самокат) работают в&nbsp;{nearbyCityLinks.length} крупнейших городах России. Перейдите в&nbsp;любой и&nbsp;посмотрите тарифы, выплаты и&nbsp;условия — вакансии одинаково «свежие, от&nbsp;прямых работодателей».
				</p>
				<ul class="nearby-cities-list">
					{nearbyCityLinks.map((city) => (
						<li class="nearby-cities-item">
							<a class="nearby-cities-link" href={`/rabota-kurerom-${city.slug}/`}>
								<span class="nearby-cities-name">{city.name}</span>
								<span class="nearby-cities-count">{city.vacancyCount}&nbsp;{getVacancyPluralText(city.vacancyCount)}</span>
							</a>
						</li>
					))}
				</ul>
				<p class="nearby-cities-footer">
					<a href="/cities/" class="nearby-cities-all-link">Все&nbsp;города&nbsp;→</a>
				</p>
			</section>
		)}

		{isMoscowCityPage && <PartnerBanner />}
	</main>

	<Footer />
</BaseLayout>

<style>
	.listing-hero,
	.listing-fact-grid,
	.listing-filters {
		max-width: 1180px;
		margin-inline: auto;
	}
	.listing-filters {
		padding: 0 1rem;
		margin-bottom: var(--space-3);
	}

	.listing-hero {
		padding: 1.25rem 1rem 0.5rem;
		margin-bottom: 1rem;
	}

	.listing-hero-panel {
		padding: 1.65rem;
		text-align: left;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		background: linear-gradient(135deg, rgba(245, 249, 242, 0.96) 0%, rgba(255, 255, 255, 0.98) 58%, rgba(242, 250, 253, 0.96) 100%);
		box-shadow: 0 14px 36px rgba(24, 45, 34, 0.07);
	}

	.listing-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		align-items: center;
		margin-bottom: 0.85rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.listing-breadcrumb a {
		color: var(--accent-color);
		text-decoration: none;
	}

	.listing-hero h1 {
		max-width: 14ch;
		margin: 0 0 0.7rem;
		font-size: 3.8rem;
		line-height: 0.97;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.listing-hero-panel > p:not(.section-eyebrow) {
		max-width: 720px;
		margin: 0;
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.section-eyebrow {
		margin: 0 0 0.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--accent-color);
	}

	.listing-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		align-items: center;
		margin-top: 1rem;
	}

	.listing-primary-link,
	.listing-secondary-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.8rem 1.15rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 800;
		transition: var(--transition);
	}

	.listing-primary-link {
		background: var(--brand-800);
		border: 1px solid var(--brand-800);
		color: var(--ink-0);
	}

	.listing-secondary-link {
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid #a8c8b5;
		color: var(--brand-800);
	}

	.listing-primary-link:hover,
	.listing-secondary-link:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 24px rgba(22, 61, 43, 0.12);
	}

	.listing-fact-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1rem 0 0;
	}

	.listing-fact-card {
		display: grid;
		gap: 0.25rem;
		min-height: auto;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-fact-card span {
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.listing-fact-card strong {
		align-self: start;
		font-size: 1rem;
		line-height: 1.32;
	}

	@media (min-width: 768px) {
		.listing-hero {
			padding: 2rem 1rem 0.75rem;
			margin-bottom: 1rem;
		}
	}

	@media (max-width: 960px) {
		.listing-fact-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.listing-breadcrumb {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.listing-hero-panel {
			padding: 1rem;
			border-radius: 8px;
		}

		.listing-fact-grid {
			display: none;
		}

		.listing-hero h1 {
			font-size: 2.4rem;
		}

		.listing-hero {
			padding-inline: 1rem;
		}
	}

	/* === Visual refresh overrides (City/Category listing pages) === */
	.listing-hero {
		background: var(--ink-50);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-xs);
	}
	.listing-hero h1 {
		font-family: var(--font-heading);
		color: var(--ink-900);
		letter-spacing: -0.02em;
		font-weight: 800;
		line-height: 1.15;
	}
	.listing-hero p {
		color: var(--ink-600);
	}

	/* Color contrast fixes — make headings/text readable in light theme */
	.listing-hero-panel h1 {
		color: var(--ink-900);
	}
	.listing-fact-card strong {
		color: var(--ink-700);
	}
	.listing-fact-card span {
		color: var(--ink-500);
	}

	/* Dark-mode overrides for hardcoded light backgrounds in legacy rules */
	:global(:where(html, body).dark-mode) .listing-hero-panel,
	:global(:where(html, body).dark-mode) .listing-fact-card,
	:global(:where(html, body).dark-mode) .listing-secondary-link {
		background-color: var(--ink-100);
		background-image: none;
		border-color: var(--ink-200);
		color: var(--ink-700);
		box-shadow: var(--shadow-xs);
	}
	/* Primary CTA keeps `background: var(--brand-800)` + `color: var(--ink-0)`.
	   In dark mode --brand-800 has no override (stays dark green) while
	   --ink-0 flips to near-black → ~1.6:1 contrast. Re-pair with the
	   dark-mode green-surface tokens, same treatment as IncomeCalculator's
	   .calc-cta-btn. */
	:global(:where(html, body).dark-mode) .listing-primary-link {
		background: var(--dm-green-surface-strong);
		border-color: var(--dm-green-border);
		color: var(--dm-green-text);
	}
	:global(:where(html, body).dark-mode) .listing-hero-panel h1,
	:global(:where(html, body).dark-mode) .listing-fact-card strong {
		color: var(--ink-900);
	}
	:global(:where(html, body).dark-mode) .listing-hero-panel > p:not(.section-eyebrow),
	:global(:where(html, body).dark-mode) .listing-fact-card span {
		color: var(--ink-600);
	}

	/* === Nearby cities — exit-ramp ===================================
	 * P2 fix (analytics report 2026-05-03): page_depth dropped 2.49 →
	 * 1.62 because search visitors landed on city pages and bounced.
	 * This block — rendered ONLY for type='city' below the JobGrid —
	 * gives a clear «next step» to other large cities. Visual style
	 * matches the existing «alternatives» block on /v/<slug>/ pages
	 * for consistency.
	 */
	.nearby-cities {
		max-width: 1180px;
		margin: 2rem auto 1.5rem;
		padding: 1.75rem 1.85rem;
		background: var(--surface-color);
		border: 1px solid var(--ink-200);
		border-radius: 16px;
		box-shadow: var(--shadow-sm);
		display: grid;
		gap: 0.85rem;
	}
	.nearby-cities-title {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		line-height: 1.18;
		letter-spacing: -0.01em;
		color: var(--ink-900);
	}
	.nearby-cities-lead {
		margin: 0;
		max-width: 70ch;
		color: var(--ink-600);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.nearby-cities-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.45rem;
	}
	.nearby-cities-item {
		margin: 0;
	}
	.nearby-cities-link {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6rem;
		padding: 0.7rem 0.95rem;
		border-radius: 10px;
		background: rgba(232, 246, 230, 0.55);
		border: 1px solid rgba(var(--brand-700-rgb), 0.16);
		text-decoration: none;
		color: var(--ink-900);
		font-size: 0.92rem;
		transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
	}
	.nearby-cities-link:hover,
	.nearby-cities-link:focus-visible {
		border-color: var(--brand-700);
		background: rgba(232, 246, 230, 0.9);
		transform: translateX(2px);
		outline: none;
	}
	.nearby-cities-name {
		font-weight: 600;
	}
	.nearby-cities-count {
		color: var(--brand-700);
		font-weight: 700;
		white-space: nowrap;
		font-size: 0.85rem;
	}
	.nearby-cities-footer {
		margin: 0.5rem 0 0;
	}
	.nearby-cities-all-link {
		color: var(--brand-700);
		font-weight: 700;
		text-decoration: none;
		font-size: 0.92rem;
	}
	.nearby-cities-all-link:hover,
	.nearby-cities-all-link:focus-visible {
		text-decoration: underline;
		outline: none;
	}

	:global(:where(html, body).dark-mode) .nearby-cities {
		background: var(--ink-100);
		border-color: var(--ink-200);
	}
	:global(:where(html, body).dark-mode) .nearby-cities-link {
		background: rgba(20, 32, 48, 0.65);
		border-color: rgba(195, 204, 216, 0.18);
