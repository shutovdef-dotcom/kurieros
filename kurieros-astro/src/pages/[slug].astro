---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JobGrid from '../components/JobGrid.astro';
import JobFilters from '../components/JobFilters.astro';
import PartnerBanner from '../components/PartnerBanner.astro';
import articlesData from '../data/articles.json';
import jobsData from '../data/jobs';
import { CATEGORIES } from '../data/constants';
import { getCitiesFromJobs } from '../utils/cities';
import { slugifyCompany } from '../utils/companies';
import { formatMoney, getVacancyPluralText, humanJoin, parseSalary } from '../utils/format';
import { buildBreadcrumbSchema, buildPlaceSchema } from '../utils/schema';

export async function getStaticPaths() {
	const paths = [];

	getCitiesFromJobs(jobsData).forEach((city) => {
		paths.push({
			params: { slug: `rabota-kurerom-${city.slug}` },
			props: {
				type: 'city',
				data: city,
				title: `Работа курьером ${city.prep} — Вакансии 2026`,
				description: `Свежие вакансии для курьеров ${city.prep}. Сравнивайте условия, компании и выплаты до отклика.`,
			},
		});
	});

	CATEGORIES.forEach((cat) => {
		// Special-case H1/description for the daily-payout landing —
		// honest positioning instead of the generic «Работа курьером:
		// {Name} — Вакансии 2026» template (see [slug].astro for the
		// matching seoTitle/seoDescription/heroIntro/FAQ overrides).
		const isEzhednev = cat.slug === 'ezhednevnaya-oplata';
		// AUDIT-OK (A1): the title says «ежедневной» while the description
		// mentions «1–7 дней» — by design. The slug captures the SEO query
		// «ежедневная оплата», but the honest description reflects the
		// bank-transfer cadence; the wallet-instant cadence is covered
		// separately on the page body. Owner-confirmed; do not re-flag.
		paths.push({
			params: { slug: `rabota-kurerom-${cat.slug}` },
			props: {
				type: 'category',
				data: cat,
				title: isEzhednev
					? 'Работа курьером с ежедневной оплатой 2026'
					: `Работа курьером: ${cat.name} — Вакансии 2026`,
				description: isEzhednev
					? 'Курьерские вакансии с самой быстрой банковской выплатой (раз в 1–7 дней) и долей наличных заказов в день смены. Яндекс.Еда, Купер и другие партнёры — реальные условия без обмана.'
					: `Вакансии курьеров в формате "${cat.name}": выплаты, компании, требования и быстрый переход к подходящим вариантам.`,
			},
		});
	});

	return paths;
}

const { type, data, title, description } = Astro.props;
const isMoscowCityPage = type === 'city' && data.slug === 'moskva';
// Старый override `searchTerm = 'еженед'` для ezhednevnaya-oplata
// удалён: теперь Y.Eda+Купер действительно помечены как «Ежедневно»
// (см. buildPay() в src/data/vacancies.ts) — мгновенные выплаты через
// встроенный кошелёк = ежедневный UX. Запрос «Ежеднев» по
// payment_freq теперь честно матчит ~3000+ реальных вакансий.
//
// Флаг `isEzhednevLanding` оставлен — используется ниже для кастомных
// title/description/FAQ, которые объясняют механику быстрых выплат
// (это полезный контент для SEO и доверия пользователя).
const isEzhednevLanding = type === 'category' && data.slug === 'ezhednevnaya-oplata';
const searchTerm = type === 'category' ? (data.query || '').toLowerCase() : '';
const tagFilter = type === 'category' ? data.tag || 'all' : 'all';

const filteredJobs = jobsData.filter((job) => {
	const matchesCity =
		type !== 'city' ||
		job.location.toLowerCase().includes(data.name.toLowerCase()) ||
		job.location === 'Вся Россия';
	const matchesTag = tagFilter === 'all' || job.tags.includes(tagFilter);
	const matchesSearch =
		!searchTerm ||
		job.title.toLowerCase().includes(searchTerm) ||
		job.company.toLowerCase().includes(searchTerm) ||
		job.location.toLowerCase().includes(searchTerm) ||
		job.salary.toLowerCase().includes(searchTerm) ||
		// Match payment_freq so a category page with `query: 'Еженед'`
		// или `query: 'Ежеднев'` populates from `details.payment_freq` —
		// слова «Еженедельно» / «Ежедневно» живут только там.
		job.details.payment_freq.toLowerCase().includes(searchTerm);

	return matchesCity && matchesTag && matchesSearch;
});

const companyNames = Array.from(new Set(filteredJobs.map((job) => job.company)));
const relatedCompanies = companyNames.slice(0, 6).map((company) => ({
	name: company,
	href: `/companies/${slugifyCompany(company)}/`,
}));
const paymentTypes = Array.from(new Set(filteredJobs.map((job) => job.details.payment_freq)));
const transportLabelMap: Record<string, string> = {
	auto: 'На авто',
	bicycle: 'На велосипеде или самокате',
	foot: 'Пеший формат',
};
const transportTypes = Array.from(
	new Set(
		filteredJobs.flatMap((job) =>
			job.tags
				.filter((tag) => tag in transportLabelMap)
				.map((tag) => transportLabelMap[tag]),
		),
	),
);
const availableTags = new Set(filteredJobs.flatMap((job) => job.tags));
const hasDailyPayments = paymentTypes.some((payment) => payment.toLowerCase().includes('ежеднев'));
const hasWeeklyPayments = paymentTypes.some((payment) => payment.toLowerCase().includes('еженед'));
const cityScenarioRoutes =
	type === 'city'
		? ['na-avto', 'peshkom', 'na-velosipede', 'dlya-studentov', 'podrabotka', 'ezhednevnaya-oplata', 'ezhenedelnaya-oplata']
			.filter((slug) => {
				if (slug === 'na-avto') return availableTags.has('auto');
				if (slug === 'peshkom') return availableTags.has('foot');
				if (slug === 'na-velosipede') return availableTags.has('bicycle');
				if (slug === 'dlya-studentov') return availableTags.has('16plus');
				if (slug === 'podrabotka') return availableTags.has('flexible');
				if (slug === 'ezhednevnaya-oplata') return hasDailyPayments;
				if (slug === 'ezhenedelnaya-oplata') return hasWeeklyPayments;
				return false;
			})
			.map((slug) => CATEGORIES.find((category) => category.slug === slug))
			.filter(Boolean)
			.slice(0, 5)
			.map((category) => ({
				name: category!.name,
				href: `/rabota-kurerom-${category!.slug}/`,
			}))
		: [];
const cityCompanyCards =
	type === 'city'
		? Array.from(
			filteredJobs.reduce(
				(map, job) => {
					const existing = map.get(job.company) ?? {
						name: job.company,
						href: `/companies/${slugifyCompany(job.company)}/`,
						vacancyCount: 0,
						maxSalary: 0,
						payments: new Set<string>(),
						transports: new Set<string>(),
					};

					existing.vacancyCount += 1;
					existing.maxSalary = Math.max(existing.maxSalary, parseSalary(job.salary));
					existing.payments.add(job.details.payment_freq);
					job.tags
						.filter((tag) => tag in transportLabelMap)
						.forEach((tag) => existing.transports.add(transportLabelMap[tag]));

					map.set(job.company, existing);
					return map;
				},
				new Map<
					string,
					{
						name: string;
						href: string;
						vacancyCount: number;
						maxSalary: number;
						payments: Set<string>;
						transports: Set<string>;
					}
				>(),
			).values(),
		)
			.map((company) => ({
				name: company.name,
				href: company.href,
				vacancyCount: company.vacancyCount,
				maxSalary: company.maxSalary,
				paymentPreview: Array.from(company.payments).slice(0, 2),
				transportPreview: Array.from(company.transports).slice(0, 2),
			}))
			.sort((a, b) => b.vacancyCount - a.vacancyCount || b.maxSalary - a.maxSalary)
			.slice(0, 4)
		: [];
const salaryLeader =
	type === 'city' ? [...cityCompanyCards].sort((a, b) => b.maxSalary - a.maxSalary)[0] : null;
const localStartPoints =
	type === 'city'
		? [
			cityCompanyCards[0]
				? `Больше всего вариантов сейчас у ${cityCompanyCards[0].name}. Начните с этой компании, если хотите быстро понять рынок ${data.prep}.`
				: `В подборке ${data.prep} уже есть несколько вакансий. Сначала посмотрите компании, где больше открытых позиций.`,
			salaryLeader
				? `Самая высокая заявленная сумма сейчас у ${salaryLeader.name}: до ${formatMoney(salaryLeader.maxSalary)} ₽. Проверьте, из чего складывается эта цифра.`
				: 'Доход зависит от смен, района и транспорта, поэтому лучше сравнить несколько вакансий перед откликом.',
			transportTypes.length
				? `В городе есть варианты: ${humanJoin(transportTypes).toLowerCase()}. Можно сразу сузить список по транспорту и графику.`
				: 'Формат работы зависит от работодателя, поэтому после выбора города полезно открыть страницы по типу доставки.',
		]
		: [];
const updatedDate = new Intl.DateTimeFormat('ru-RU', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(new Date());
// P0: empty listings need noindex so Google/Yandex don't penalise us for thin
// content. We also drop them from the sitemap (see astro.config.mjs).
const isEmptyListing = filteredJobs.length === 0;

// «Соседние города» — exit-ramp для search-визитёров. GSC report
// (2026-05-03) показал: page_depth Метрики 2.49 → 1.62, avg session
// 5:04 → 2:32. Юзер приходит на small-city из long-tail, видит
// JobGrid и УХОДИТ — нет «куда ещё кликнуть». Этот блок даёт топ-12
// городов с наибольшим числом вакансий как явный «следующий шаг»
// сразу под JobGrid. Только для type='city' — на категории не нужен.
const nearbyCityLinks =
	type === 'city'
		? getCitiesFromJobs(jobsData)
				.filter((city) => city.slug !== data.slug)
				.sort((a, b) => b.vacancyCount - a.vacancyCount)
				.slice(0, 12)
				.map((city) => ({
					name: city.name,
					slug: city.slug,
					vacancyCount: city.vacancyCount,
				}))
		: [];

// P1: max salary across the matched listings — used in title/description to
// make the snippet more clickable in search results (cheaper-than-rewrite
// because the number lives directly in the SERP and beats a generic count).
const maxSalary = filteredJobs.reduce((acc, job) => {
	const value = parseSalary(job.salary);
	return value > acc ? value : acc;
}, 0);
const formattedMaxSalary = maxSalary > 0 ? formatMoney(maxSalary) : null;
const vacancyCountText = `${filteredJobs.length} ${getVacancyPluralText(filteredJobs.length)}`;

// Some categories ship with `name` that ALREADY embeds the «Курьер»
// or «Работа курьером» prefix (constants.ts: «Курьер 16 лет», «Курьер
// 18 лет», «Работа курьером женщине»). When such a name is composed
// into a title that ALSO leads with «Курьер … » or «Работа курьером
// … », the prefix duplicates → «Курьер курьер 16 лет — до 259 560 ₽».
// `cleanCategoryName` strips that leading prefix once so the
// composing template can safely prepend its own without doubling.
// Categories without the prefix («На авто», «Подработка», …) stay
// unchanged. Falls back to the original `data.name` if the strip
// would yield an empty string (defensive).
const cleanCategoryName =
	type === 'category'
		? data.name
				.replace(/^Работа курьером\s*/i, '')
				.replace(/^Курьер\s*/i, '')
				.trim() || data.name
		: '';

const seoTitle = (
	isEzhednevLanding
		? formattedMaxSalary
			? `Курьер с ежедневной оплатой — до ${formattedMaxSalary} ₽ · ${vacancyCountText} | КурьерОк`
			: `Работа курьером с ежедневной оплатой 2026 — ${vacancyCountText} | КурьерОк`
		: isEmptyListing
			? type === 'city'
				? `Работа курьером ${data.prep} — следите за обновлениями | КурьерОк`
				: `Работа курьером (${cleanCategoryName.toLowerCase()}) — следите за обновлениями | КурьерОк`
			: type === 'city'
				? formattedMaxSalary
					? `Курьер ${data.prep} — до ${formattedMaxSalary} ₽/мес · ${vacancyCountText} | КурьерОк`
					: `Работа курьером ${data.prep} 2026: ${vacancyCountText} | КурьерОк`
				: formattedMaxSalary
					? `Курьер ${cleanCategoryName.toLowerCase()} — до ${formattedMaxSalary} ₽/мес · ${vacancyCountText} | КурьерОк`
					: `Работа курьером ${cleanCategoryName.toLowerCase()} 2026: ${vacancyCountText} | КурьерОк`
).slice(0, 70);
const seoDescription = (
	isEzhednevLanding
		? `${vacancyCountText} курьера с ежедневными выплатами: Яндекс.Еда и Купер позволяют выводить заработок прямо в день смены через встроенный кошелёк (Я.Кошелёк / СберPay). Деньги — на карту в любой момент.`
		: isEmptyListing
			? type === 'city'
				? `Сейчас активных вакансий курьером ${data.prep} нет — добавьте сайт в избранное и проверьте позже. Сравните условия в других городах России.`
				: `Сейчас активных вакансий по формату «${data.name}» нет — следите за обновлениями. Посмотрите похожие подборки на главной.`
			: type === 'city'
				? formattedMaxSalary
					? `${vacancyCountText} курьером ${data.prep} от прямых работодателей: ${companyNames.slice(0, 2).join(', ') || 'Y.Eda, Купер'}. Доход до ${formattedMaxSalary} ₽/мес. Выплаты ${paymentTypes.slice(0, 2).join(' / ').toLowerCase() || 'еженедельно'}. Свежие данные сегодня.`
					: `Свежие ${vacancyCountText} курьером ${data.prep} от прямых работодателей: ${companyNames.length} компаний. Выплаты ${paymentTypes.slice(0, 2).join(' / ').toLowerCase() || 'уточняются'}, форматы ${transportTypes.join(', ').toLowerCase() || 'разные'}.`
				: formattedMaxSalary
					? `${vacancyCountText} «${data.name}» — доход до ${formattedMaxSalary} ₽/мес. ${companyNames.length} компаний, выплаты ${paymentTypes.slice(0, 2).join(' / ').toLowerCase() || 'регулярные'}. Сравните условия и подайте заявку.`
					: `Курьер ${cleanCategoryName.toLowerCase()} 2026: ${vacancyCountText} от ${companyNames.length} компаний. Сравните выплаты, требования и оформление до отклика.`
).slice(0, 170);
const relatedArticles = articlesData
	.filter((article) => {
		const haystack = `${article.title} ${article.description}`.toLowerCase();
		if (type === 'city') {
			return haystack.includes(data.name.toLowerCase()) || haystack.includes('курьер');
		}
		return haystack.includes(data.name.toLowerCase()) || haystack.includes(searchTerm) || haystack.includes('курьер');
	})
	.slice(0, 3);
const routeLinks =
	type === 'city'
		? [
			{ name: 'Сравнение вакансий', href: '/compare/' },
			{ name: 'Компании', href: '/companies/' },
			{ name: 'Гид: доход курьера', href: '/guide/dohod/' },
			{ name: 'Гид: оформление', href: '/guide/oformlenie/' },
			...CATEGORIES.filter((cat) => cat.slug !== data.slug).slice(0, 3).map((cat) => ({
				name: cat.name,
				href: `/rabota-kurerom-${cat.slug}/`,
			})),
		]
		: [
			{ name: 'Сравнение вакансий', href: '/compare/' },
			{ name: 'Города', href: '/cities/' },
			{ name: 'Гид для курьера', href: '/guide/' },
			...getCitiesFromJobs(jobsData)
				.filter((city) => city.name !== data.name)
				.sort((a, b) => b.vacancyCount - a.vacancyCount)
				.slice(0, 3)
				.map((city) => ({
					name: city.name,
					href: `/rabota-kurerom-${city.slug}/`,
				})),
		];

const quickLaunchLinks =
	type === 'city'
		? [
			...cityScenarioRoutes.slice(0, 4),
			{ name: 'Компании', href: '/companies/' },
			{ name: 'Сравнение', href: '/compare/' },
		]
		: [
			{ name: 'Сравнение', href: '/compare/' },
			{ name: 'Города', href: '/cities/' },
			...routeLinks.slice(2, 5),
		];
const heroIntro =
	isEzhednevLanding
		? `Самые быстрые выплаты у курьеров: ${vacancyCountText} от Яндекс.Еда и Купер с опцией мгновенного вывода заработанного. Внутри приложения курьера встроен кошелёк (Я.Кошелёк / СберPay), откуда деньги можно перевести на карту в любой день — иногда несколько раз за смену. Плюс наличные от клиента остаются у курьера сразу. Ниже — все вакансии с такой моделью.`
		: type === 'city'
			? `Ниже собраны вакансии ${data.prep}. Смотрите оплату, транспорт, оформление и переходите только в те варианты, где условия похожи на ваши.`
			: `Ниже собраны вакансии по этому формату. Сначала проверьте оплату и требования, затем переходите к компаниям или городам.`;
const launchSummary =
	type === 'city'
		? `Мы уже оставили в списке только предложения ${data.prep}. Используйте фильтры, если важен конкретный транспорт или график.`
		: 'Мы уже применили нужный фильтр. Остаётся сравнить несколько вакансий и открыть те, где условия подходят.';
const factCards = [
	{ label: 'Вакансии', value: `${filteredJobs.length}` },
	{ label: 'Компании', value: `${companyNames.length}` },
	{ label: 'Форматы', value: transportTypes.join(', ') || 'Смешанные форматы' },
	{ label: 'Выплаты', value: paymentTypes.slice(0, 2).join(' / ') || 'Уточняются в карточке' },
];

const fitPoints =
	type === 'city'
		? [
			`Тем, кто ищет работу курьером ${data.prep} и хочет увидеть активные компании в одном списке.`,
			`Кандидатам, которые выбирают между пешей доставкой, велосипедом, самокатом или автомобилем.`,
			`Тем, кто хочет сначала спокойно сравнить условия, а уже потом переходить к анкете работодателя.`,
		]
		: [
			`Тем, кто рассматривает формат "${data.name}" и хочет увидеть несколько вариантов без ручного поиска.`,
			`Кандидатам, которым важно сравнить выплаты, требования и занятость до перехода к анкете.`,
			`Тем, кто хочет отсечь неподходящие вакансии и открыть только близкие по условиям.`,
		];

const cautionPoints = [
	'Финальные условия по выплатам, возрасту, гражданству и оформлению подтверждайте на странице вакансии или у работодателя.',
	'Если вам принципиальны конкретный район, официальный ТК РФ или точный график смен, открывайте карточки вакансий и сравнивайте детали поштучно.',
	'Часть ссылок ведёт на внешнюю анкету работодателя или партнёра. Перед отправкой заявки ещё раз проверьте условия.',
];

const faqItems =
	isEzhednevLanding
		? [
			{
				question: 'Есть ли в России работа курьером с ежедневной оплатой?',
				answer: 'Да. У Яндекс.Еда и Купер встроен кошелёк (Я.Кошелёк / СберPay) — заработанное за смену поступает туда сразу, и курьер выводит деньги на карту в любой день, иногда несколько раз за смену. Плюс наличные от клиента остаются на руках сразу.',
			},
			{
				question: 'Через сколько после смены деньги доступны для вывода?',
				answer: 'У Яндекс.Еда — обычно в течение 1–3 часов после закрытия заказа: оплата клиентом проходит, и сумма за вычетом комиссии падает на Я.Кошелёк. У Купер — после закрытия смены (несколько раз в день). Дальше — мгновенный вывод на карту через приложение.',
			},
			{
				question: 'Есть ли комиссия за быстрый вывод?',
				answer: 'У Яндекс.Еда стандартный вывод бесплатный, есть платная опция «Мгновенно» (~1–3% за пределами бесплатного лимита). У Купер вывод тоже без комиссии в большинстве случаев. Точный тариф уточняйте в приложении после регистрации.',
			},
			{
				question: 'Какие вакансии собраны на этой странице?',
				answer: `${vacancyCountText} от Яндекс.Еда и Купер — это компании, которые официально предлагают мгновенный вывод заработка. Сортируйте по доходу или выберите свой город фильтром.`,
			},
		]
		: type === 'city'
			? [
				{
					question: `Какие вакансии курьера есть ${data.prep}?`,
					answer: `На этой странице собраны ${filteredJobs.length} вакансий от ${companyNames.length} компаний. В подборке есть форматы ${transportTypes.join(', ').toLowerCase() || 'с разными типами занятости'} и разные графики работы.`,
				},
				{
					question: 'Это вакансии от прямых работодателей или агрегатора?',
					answer: `Все ${filteredJobs.length} вакансий ${data.prep} — от прямых работодателей: ${companyNames.slice(0, 3).join(', ') || 'Яндекс.Еда, Купер, Озон'}. Мы передаём вашу заявку напрямую в HR компании, без посредников. Звонок придёт от самой компании в день подачи заявки.`,
				},
				// AUDIT-OK (A3): «обновляется ежедневно / каждое утро» is the
				// owner-stated content commitment for the deploy cadence. The
				// build pipeline is expected to run on a daily schedule;
				// keeping this copy intentional keeps the trust signal even
				// on builds that occasionally lag. Do not re-flag in audits.
				{
					question: `Свежие ли это вакансии ${data.prep}?`,
					answer: `Да. Каталог обновляется ежедневно: мы синхронизируемся с реферальными формами Яндекс.Еда, Купер, Озон и партнёров каждое утро. На карточке каждой вакансии видна дата последнего обновления.`,
				},
				{
					question: `Кому подходит работа курьером ${data.prep}?`,
					answer: `Страница подходит тем, кто хочет сравнить локальные вакансии по выплатам, требованиям и компаниям, а затем открыть только подходящие варианты.`,
				},
				{
					question: 'Что проверить перед откликом?',
					answer: 'Перед откликом стоит открыть карточку вакансии и уточнить выплаты, оформление, возрастной порог, гражданство, медкнижку и формат занятости.',
				},
			]
			: [
				{
					question: `Что входит в подборку "${data.name}"?`,
					answer: `На странице собраны ${filteredJobs.length} вакансий от ${companyNames.length} компаний, которые подходят под формат "${data.name}".`,
				},
				{
					question: `Кому подходит формат "${data.name}"?`,
					answer: `Эта подборка подходит тем, кто хочет сравнить один конкретный формат работы курьером и выбрать вакансию по графику, выплатам и базовым требованиям.`,
				},
				{
					question: 'Нужно ли сразу откликаться?',
					answer: 'Нет. Сначала стоит открыть карточки вакансий, проверить ограничения и только потом переходить по ссылке отклика на сайт работодателя или партнёра.',
				},
			];

const pageSchemaGraph = [
	{
		'@type': 'CollectionPage',
		name: title,
		description: seoDescription,
		url: Astro.url.href,
		dateModified: new Date().toISOString(),
		mainEntity: {
			'@type': 'ItemList',
			itemListElement: filteredJobs.slice(0, 10).map((job, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: job.title,
				url: new URL(`/v/${job.slug}/`, Astro.site).toString(),
			})),
		},
	},
	...(type === 'city'
		? [
			buildPlaceSchema({
				city: data.name,
				pageUrl: Astro.url.href,
				description: seoDescription,
			}),
		]
		: []),
	{
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
	buildBreadcrumbSchema(
		type === 'city'
			? [
				{ name: 'Главная', url: '/' },
				{ name: 'Города', url: '/cities/' },
				{ name: title, url: Astro.url.pathname },
			]
			: [
				{ name: 'Главная', url: '/' },
				{ name: title, url: Astro.url.pathname },
			],
		Astro.site,
	),
];
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	schemaGraph={pageSchemaGraph}
	robots={isEmptyListing ? 'noindex, follow' : undefined}
>
	<Header />

	<main>
		<section class="hero listing-hero">
			<div class="listing-hero-panel">
				<nav class="listing-breadcrumb" aria-label="Хлебные крошки">
					<a href="/">Главная</a>
					{type === 'city' && (
						<>
							<span>&gt;</span>
							<a href="/cities/">Города</a>
						</>
					)}
					<span>&gt;</span>
					<span>{type === 'city' ? `Работа курьером ${data.prep}` : data.name}</span>
				</nav>
				<p class="section-eyebrow">{type === 'city' ? 'Вакансии в городе' : 'Готовый фильтр'}</p>
				<h1>{title}</h1>
				<p>{heroIntro}</p>
				<div class="listing-hero-actions">
					<a href="#vacancies" class="listing-primary-link">Смотреть вакансии</a>
					<a href="/compare/" class="listing-secondary-link">Сравнить</a>
				</div>
				<div class="listing-fact-grid listing-fact-grid-hero">
					{factCards.map((fact) => (
						<article class="listing-fact-card">
							<span>{fact.label}</span>
							<strong>{fact.value}</strong>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="listing-filters" aria-label="Фильтры вакансий">
			<JobFilters />
		</section>

		<JobGrid
			initialCity={type === 'city' ? data.name : undefined}
			initialTag={type === 'category' ? data.tag : undefined}
			initialSearch={type === 'category' ? data.query : undefined}
		/>

		{nearbyCityLinks.length > 0 && (
			<section class="nearby-cities" aria-labelledby="nearby-cities-title">
				<h2 id="nearby-cities-title" class="nearby-cities-title">Не нашли подходящее? Соседние города</h2>
				<p class="nearby-cities-lead">
					Те же компании (Яндекс.Еда, Купер, Озон, Самокат) работают в&nbsp;{nearbyCityLinks.length} крупнейших городах России. Перейдите в&nbsp;любой и&nbsp;посмотрите тарифы, выплаты и&nbsp;условия — вакансии одинаково «свежие, от&nbsp;прямых работодателей».
				</p>
				<ul class="nearby-cities-list">
					{nearbyCityLinks.map((city) => (
						<li class="nearby-cities-item">
							<a class="nearby-cities-link" href={`/rabota-kurerom-${city.slug}/`}>
								<span class="nearby-cities-name">{city.name}</span>
								<span class="nearby-cities-count">{city.vacancyCount}&nbsp;{getVacancyPluralText(city.vacancyCount)}</span>
							</a>
						</li>
					))}
				</ul>
				<p class="nearby-cities-footer">
					<a href="/cities/" class="nearby-cities-all-link">Все&nbsp;города&nbsp;→</a>
				</p>
			</section>
		)}

		{isMoscowCityPage && <PartnerBanner />}
	</main>

	<Footer />
</BaseLayout>

<style>
	.listing-hero,
	.listing-vacancy-launch,
	.listing-fact-grid,
	.listing-geo-grid,
	.listing-local-grid,
	.listing-faq-section,
	.listing-filters,
	.listing-trust-panel {
		max-width: 1180px;
		margin-inline: auto;
	}
	.listing-filters {
		padding: 0 1rem;
		margin-bottom: var(--space-3);
	}

	.listing-hero {
		padding: 1.25rem 1rem 0.5rem;
		margin-bottom: 1rem;
	}

	.listing-hero-panel {
		padding: 1.65rem;
		text-align: left;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		background: linear-gradient(135deg, rgba(245, 249, 242, 0.96) 0%, rgba(255, 255, 255, 0.98) 58%, rgba(242, 250, 253, 0.96) 100%);
		box-shadow: 0 14px 36px rgba(24, 45, 34, 0.07);
	}

	.listing-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		align-items: center;
		margin-bottom: 0.85rem;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.listing-breadcrumb a {
		color: var(--accent-color);
		text-decoration: none;
	}

	.listing-hero h1 {
		max-width: 14ch;
		margin: 0 0 0.7rem;
		font-size: 3.8rem;
		line-height: 0.97;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.listing-hero-panel > p:not(.section-eyebrow) {
		max-width: 720px;
		margin: 0;
		font-size: 1.08rem;
		line-height: 1.6;
	}

	.section-eyebrow {
		margin: 0 0 0.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--accent-color);
	}

	.listing-trust-panel {
		display: grid;
		grid-template-columns: minmax(220px, 0.32fr) minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
		margin-bottom: 1rem;
		padding: 1.5rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.74);
		box-shadow: var(--shadow-sm);
	}

	.listing-trust-panel h2,
	.listing-trust-panel p {
		margin: 0;
	}

	.listing-trust-panel p {
		color: var(--text-muted);
		line-height: 1.8;
	}

	.listing-hero-actions,
	.listing-vacancy-launch-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
		align-items: center;
		margin-top: 1rem;
	}

	.listing-primary-link,
	.listing-secondary-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 3rem;
		padding: 0.8rem 1.15rem;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 800;
		transition: var(--transition);
	}

	.listing-primary-link {
		background: var(--brand-800);
		border: 1px solid var(--brand-800);
		color: var(--ink-0);
	}

	.listing-secondary-link {
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid #a8c8b5;
		color: var(--brand-800);
	}

	.listing-primary-link:hover,
	.listing-secondary-link:hover {
		transform: translateY(-1px);
		box-shadow: 0 10px 24px rgba(22, 61, 43, 0.12);
	}

	.listing-vacancy-launch {
		display: grid;
		grid-template-columns: minmax(260px, 0.42fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		margin-bottom: 1rem;
		padding: 1.35rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-vacancy-launch h2,
	.listing-vacancy-launch p {
		margin: 0;
	}

	.listing-vacancy-launch-copy {
		display: grid;
		gap: 0.55rem;
	}

	.listing-vacancy-launch-copy p:not(.section-eyebrow) {
		color: var(--text-muted);
		line-height: 1.65;
	}

	.listing-vacancy-launch-actions {
		margin-top: 0;
	}

	.listing-fact-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 1rem 0 0;
	}

	.listing-fact-card {
		display: grid;
		gap: 0.25rem;
		min-height: auto;
		padding: 0.8rem 0.9rem;
		border: 1px solid var(--ink-200);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-fact-card span {
		font-size: 0.72rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.listing-fact-card strong {
		align-self: start;
		font-size: 1rem;
		line-height: 1.32;
	}

	.listing-geo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding: 0 1rem;
	}

	.listing-local-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding: 0 1rem;
	}

	.listing-geo-card,
	.listing-local-card,
	.listing-faq-section {
		padding: 1.5rem;
		border-radius: 8px;
		background: var(--bg-card);
		box-shadow: var(--shadow-sm);
	}

	.listing-geo-card {
		border: 1px solid rgba(var(--brand-700-rgb), 0.16);
		background:
			linear-gradient(180deg, var(--scrim-light-strong), rgba(247, 251, 248, 0.96)),
			var(--bg-card);
	}

	.listing-local-card {
		border: 1px solid var(--scrim-border-mid);
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.listing-geo-card-caution {
		border-color: rgba(249, 115, 22, 0.16);
	}

	.listing-geo-card h2,
	.listing-local-card h2,
	.listing-faq-section h2 {
		margin-top: 0;
		margin-bottom: 1rem;
		font-size: 1.55rem;
	}

	.listing-bullet-list {
		margin: 0;
		padding-left: 1.35rem;
		color: var(--text-main);
	}

	.listing-bullet-list li {
		margin-bottom: 0.7rem;
		line-height: 1.7;
	}

	.numbered-list li::marker {
		color: var(--accent-color);
		font-weight: 900;
	}

	.listing-faq-section {
		margin: 0 1rem 1.5rem;
	}

	.listing-company-section {
		max-width: 1180px;
		margin: 0 auto 1.5rem;
		padding: 0 1rem;
	}

	.listing-company-section h2 {
		margin: 0 0 1rem;
		font-size: 1.55rem;
	}

	.listing-company-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem;
	}

	.listing-company-card {
		display: grid;
		gap: 0.45rem;
		padding: 1.2rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
		color: var(--text-main);
		text-decoration: none;
		transition: var(--transition);
	}

	.listing-company-card:hover {
		transform: translateY(-2px);
		border-color: var(--text-main);
		box-shadow: var(--shadow-md);
	}

	.listing-company-card span,
	.listing-company-card small {
		color: var(--text-muted);
		line-height: 1.6;
	}

	.listing-faq-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.listing-faq-item {
		padding: 1.1rem;
		border: 1px solid var(--scrim-border-mid);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.72);
	}

	.listing-faq-item h3 {
		margin: 0 0 0.45rem;
		font-size: 1rem;
	}

	.listing-faq-item p {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.7;
	}

	.listing-trust-panel {
		margin: 0 1rem 2rem;
	}

	.listing-link-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		max-width: 1180px;
		margin: 0 auto 2rem;
		padding: 0 1rem;
	}

	.listing-link-card {
		padding: 1.5rem;
		border-radius: 8px;
		border: 1px solid var(--scrim-border-mid);
		background: var(--scrim-light-soft);
		box-shadow: var(--shadow-sm);
	}

	.link-chip-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.link-chip,
	.related-article-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.4rem;
		padding: 0.65rem 0.9rem;
		border-radius: 8px;
		border: 1px solid rgba(var(--brand-700-rgb), 0.18);
		background: rgba(var(--brand-700-rgb), 0.08);
		color: var(--text-main);
		text-decoration: none;
		font-weight: 800;
	}

	.related-article-stack {
		display: grid;
		gap: 0.7rem;
	}

	.listing-empty-note {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.7;
	}

	@media (min-width: 768px) {
		.listing-hero {
			padding: 2rem 1rem 0.75rem;
			margin-bottom: 1rem;
		}
	}

	@media (max-width: 960px) {
		.listing-fact-grid,
		.listing-faq-grid,
		.listing-company-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.listing-geo-grid,
		.listing-link-grid,
		.listing-local-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.listing-vacancy-launch,
		.listing-trust-panel {
			grid-template-columns: 1fr;
		}

		.listing-breadcrumb {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.listing-faq-grid,
		.listing-company-grid {
			grid-template-columns: 1fr;
		}

		.listing-hero-panel {
			padding: 1rem;
			border-radius: 8px;
		}

		.listing-fact-grid {
			display: none;
		}

		.listing-hero h1 {
			font-size: 2.4rem;
		}

		.listing-hero,
		.listing-vacancy-launch,
		.listing-local-grid,
		.listing-geo-grid,
		.listing-faq-section,
		.listing-trust-panel,
		.listing-link-grid {
			padding-inline: 1rem;
		}

		.listing-vacancy-launch,
		.listing-local-grid,
		.listing-geo-grid,
		.listing-faq-section,
		.listing-trust-panel,
		.listing-link-grid {
			padding-left: 1rem;
			padding-right: 1rem;
		}
	}

	/* === Visual refresh overrides (City/Category listing pages) === */
	.listing-hero {
		background: var(--ink-50);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-xs);
	}
	.listing-hero h1 {
		font-family: var(--font-heading);
		color: var(--ink-900);
		letter-spacing: -0.02em;
		font-weight: 800;
		line-height: 1.15;
	}
	.listing-hero p,
	.listing-hero .listing-lede {
		color: var(--ink-600);
	}
	.listing-trust-panel {
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
	}
	.listing-link-grid > a,
	.listing-link-grid > * {
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-md);
		transition: border-color var(--transition), box-shadow var(--transition);
	}
	.listing-link-grid > a:hover,
	.listing-link-grid > a:focus-visible {
		border-color: var(--brand-500);
		box-shadow: var(--shadow-sm);
		outline: none;
	}
	.listing-faq-section h2,
	.listing-faq-section h3 {
		font-family: var(--font-heading);
		color: var(--ink-900);
		letter-spacing: -0.01em;
	}

	/* Color contrast fixes — make headings/text readable in light theme */
	.listing-hero-panel h1,
	.listing-vacancy-launch h2,
	.listing-trust-panel h2,
	.listing-trust-panel h3,
	.listing-spotlight h2,
	.listing-spotlight-card h3,
	.listing-company-card h2,
	.listing-company-card h3,
	.listing-link-grid h2,
	.listing-link-grid h3 {
		color: var(--ink-900);
	}
	.listing-fact-card strong,
	.listing-trust-panel p,
	.listing-vacancy-launch p:not(.section-eyebrow),
	.listing-link-grid p,
	.listing-spotlight-card p,
	.listing-company-card p {
		color: var(--ink-700);
	}
	.listing-fact-card span {
		color: var(--ink-500);
	}

	.link-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		color: var(--ink-700);
		border-radius: var(--radius-pill);
		font-weight: 600;
		font-size: var(--fs-13);
		padding: 8px 14px;
		text-decoration: none;
		transition: border-color var(--transition), color var(--transition), background var(--transition);
	}
	.link-chip:hover,
	.link-chip:focus-visible {
		border-color: var(--brand-500);
		color: var(--brand-700);
		background: var(--brand-50);
		outline: none;
	}

	/* Dark-mode overrides for hardcoded light backgrounds in legacy rules */
	:where(html, body).dark-mode .listing-hero-panel,
