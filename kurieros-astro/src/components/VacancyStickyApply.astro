---
import vacancyStickyApplyUrl from '../scripts/vacancyStickyApply.js?url';
import { ozonDataAttrs } from '../utils/ozonAttrs';
import { getApplyHref, getApplyPartnerDomain } from '../utils/applyRoute';
import type { GeneratedJob } from '../data/vacancyTypes';

interface Props {
	job: GeneratedJob;
	isLeadFormApply: boolean;
	isLeadFormUnavailable: boolean;
	leadFormType: string | null;
	salaryMaxNumeric: number;
	applyLabel: string;
	employmentTypeText: string;
}

const {
	job,
	isLeadFormApply,
	isLeadFormUnavailable,
	leadFormType,
	salaryMaxNumeric,
	applyLabel,
	employmentTypeText,
} = Astro.props;

const applyHref = getApplyHref(job);
const applyPartnerDomain = getApplyPartnerDomain(job);

/**
 * Sticky bottom apply CTA for /v/[slug]/ pages.
 *
 * Why: on mobile the user reports the apply button isn't visible
 * while scrolling — only at the very top (hero) and at the very
 * bottom (sidebar after main scrolls down). Between those two
 * there's nothing tappable. Existing CSS at [slug].astro:1782 sets
 * `.apply-btn-hero { position: fixed }` on mobile, but something is
 * overriding it on the user's device — debugging that requires the
 * live page; meanwhile this component delivers the behaviour
 * reliably without depending on that rule.
 *
 * Behaviour:
 *  - Watches `.apply-btn-hero` with IntersectionObserver.
 *  - When the hero button is OUT of viewport → bar is shown.
 *  - When it's back in viewport → bar is hidden (no duplication).
 *  - Tap on bar → the bar itself is a real apply CTA. External vacancies
 *    render as anchors to /apply/, while Ozon lead-form vacancies render as
 *    buttons with the same data attributes consumed by OzonLeadModal.
 *  - Skipped when there's no `.apply-btn-hero` on the page.
 *
 * Z-index: 91, one above the existing mobile-fixed rule (90), so if
 * that rule does fire on some devices the new bar still wins
 * visually — no double-button cluttering the screen.
 */
---

{isLeadFormUnavailable ? null : isLeadFormApply ? (
	<button
		id="vacancy-sticky-apply"
		class="vacancy-sticky-apply hidden"
		type="button"
		aria-label="Откликнуться на вакансию"
		data-apply-cta
		data-apply-position="vacancy_sticky"
		data-apply-company={job.company}
		data-apply-city={job.location}
		data-apply-transport={job.transport}
		data-apply-employment={employmentTypeText}
		data-apply-salary-max={salaryMaxNumeric || ''}
		data-apply-vacancy-id={job.id}
		data-apply-vacancy-slug={job.slug}
		data-apply-source-slug={job.sourceSlug}
		data-lead-form-type={leadFormType}
		{...ozonDataAttrs(job.ozonLeadForm)}
	>
		<span class="vacancy-sticky-apply-icon" aria-hidden="true">🔥</span>
		<span class="vacancy-sticky-apply-label">{applyLabel}</span>
		<span class="vacancy-sticky-apply-arrow" aria-hidden="true">→</span>
	</button>
) : (
	<a
		id="vacancy-sticky-apply"
		class="vacancy-sticky-apply hidden"
		href={applyHref}
		aria-label="Откликнуться на вакансию"
		data-apply-cta
		data-apply-position="vacancy_sticky"
		data-apply-company={job.company}
		data-apply-city={job.location}
		data-apply-transport={job.transport}
		data-apply-employment={employmentTypeText}
		data-apply-salary-max={salaryMaxNumeric || ''}
		data-apply-vacancy-id={job.id}
		data-apply-vacancy-slug={job.slug}
		data-apply-source-slug={job.sourceSlug}
		data-apply-partner-domain={applyPartnerDomain}
	>
		<span class="vacancy-sticky-apply-icon" aria-hidden="true">🔥</span>
		<span class="vacancy-sticky-apply-label">{applyLabel}</span>
		<span class="vacancy-sticky-apply-arrow" aria-hidden="true">→</span>
	</a>
)}

<style>
	.vacancy-sticky-apply {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 91;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 14px 18px;
		background: linear-gradient(135deg, #ff6a3d 0%, #ff3d6a 100%);
		color: var(--ink-0);
		border: 0;
		font-weight: 800;
		font-size: 1rem;
		font-family: inherit;
		letter-spacing: 0.01em;
		text-decoration: none;
		cursor: pointer;
		box-shadow: 0 -6px 16px rgba(0, 0, 0, 0.18);
		transform: translateY(0);
		transition: transform 0.18s ease, opacity 0.18s ease;
	}
	.vacancy-sticky-apply:active {
		transform: translateY(0) scale(0.985);
	}
	.vacancy-sticky-apply.hidden {
		transform: translateY(110%);
		opacity: 0;
		pointer-events: none;
	}
	.vacancy-sticky-apply-icon {
		font-size: 1.1rem;
	}
	.vacancy-sticky-apply-arrow {
		font-size: 1.05rem;
	}
	body.has-vacancy-sticky-apply main {
		padding-bottom: 80px;
	}

	/* Mobile: .bottom-nav (Header.astro) lives at z-index 1000 with
	   height 65px. Lift the sticky bar above it; bump main padding so
	   the last in-flow element isn't hidden behind both stacked. */
	@media (max-width: 768px) {
		.vacancy-sticky-apply {
			bottom: 65px;
		}
		body.has-vacancy-sticky-apply main {
			padding-bottom: 130px;
		}
	}
</style>

{!isLeadFormUnavailable && <script is:inline type="module" src={vacancyStickyApplyUrl}></script>}
