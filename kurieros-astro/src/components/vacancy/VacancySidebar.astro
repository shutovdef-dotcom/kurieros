---
import VacancyTKey from '../VacancyTKey.astro';
import { ozonDataAttrs } from '../../utils/ozonAttrs';
import { getApplyHref, getApplyPartnerDomain } from '../../utils/applyRoute';
import type { GeneratedJob } from '../../data/vacancyTypes';
import type { VacancyCalculatorModel } from '../../utils/vacancyPage';
import { formatMoneyWithCurrency, getCurrencyLabel } from '../../utils/money';
import vacancyIncomeCalculatorUrl from '../../scripts/vacancyIncomeCalculator.js?url';

interface Props {
	job: GeneratedJob;
	isLeadFormApply: boolean;
	isLeadFormUnavailable: boolean;
	leadFormType: string | null;
	salaryMaxNumeric: number;
	applyLabel: string;
	employmentTypeText: string;
	calculatorModel: VacancyCalculatorModel;
}

const {
	job,
	isLeadFormApply,
	isLeadFormUnavailable,
	leadFormType,
	salaryMaxNumeric,
	applyLabel,
	employmentTypeText,
	calculatorModel,
} = Astro.props;

const hourlyCalculator = calculatorModel.kind === 'hourly' ? calculatorModel : null;
const meetingCalculator = calculatorModel.kind === 'meeting' ? calculatorModel : null;
const monthlyCalculator = calculatorModel.kind === 'monthly' ? calculatorModel : null;
const currencyLabel = getCurrencyLabel(job.currency);
const applyHref = getApplyHref(job);
const applyPartnerDomain = getApplyPartnerDomain(job);
---

<aside class="vacancy-sidebar">
	<div class="vacancy-card-sidebar">
		<h3 data-t="vacancy.details_title">Детали</h3>
		<div class="detail-item">
			<strong data-t="vacancy.location">Локация:</strong> <VacancyTKey jobId={job.id} field="location" fallback={job.location} />
		</div>
		<div class="detail-item">
			<strong data-t="job.schedule">График:</strong> <VacancyTKey jobId={job.id} field="details_schedule" fallback={job.details.schedule} />
		</div>
		<div class="detail-item">
			<strong data-t="vacancy.payment">Оплата:</strong> <VacancyTKey jobId={job.id} field="details_payment_freq" fallback={job.details.payment_freq} />
		</div>
		<div class="detail-item">
			<strong data-t="vacancy.age">Возраст:</strong> <VacancyTKey jobId={job.id} field="details_age" fallback={job.details.age} />
		</div>
		<div class="detail-item">
			<strong data-t="vacancy.employment">Оформление:</strong> <VacancyTKey jobId={job.id} field="details_employment_type" fallback={job.details.employment_type} />
		</div>

		{isLeadFormUnavailable ? (
			<>
				<span class="apply-btn-large apply-btn-unavailable" aria-disabled="true">
					Отклик временно недоступен
				</span>
				<p class="apply-note">Проверяем актуальность формы работодателя. Контактные данные сейчас не принимаются.</p>
			</>
		) : isLeadFormApply ? (
			<>
				<button
					type="button"
					class="apply-btn-large"
					data-apply-cta
					data-apply-position="vacancy_sidebar"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={employmentTypeText}
					data-apply-salary-max={salaryMaxNumeric || ''}
					data-apply-vacancy-id={job.id}
					data-apply-vacancy-slug={job.slug}
					data-apply-source-slug={job.sourceSlug}
					data-lead-form-type={leadFormType}
					{...ozonDataAttrs(job.ozonLeadForm)}
				>
					{applyLabel}
				</button>
				<p class="apply-note">Имя и телефон будут переданы в Ozon только для выбранной заявки</p>
			</>
		) : (
			<>
				<a
					href={applyHref}
					class="apply-btn-large"
					data-apply-cta
					data-apply-position="vacancy_sidebar"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={employmentTypeText}
					data-apply-salary-max={salaryMaxNumeric || ''}
					data-apply-vacancy-id={job.id}
					data-apply-vacancy-slug={job.slug}
					data-apply-source-slug={job.sourceSlug}
					data-apply-partner-domain={applyPartnerDomain}
				>
					{applyLabel}
				</a>
				<p class="apply-note" data-t="vacancy.apply_note">Пару секунд покажем переход — затем откроется сайт работодателя</p>
			</>
		)}
		{/* Disabled-fallback sidebar CTA removed per C3. */}
		{calculatorModel.kind !== 'hidden' && (
			<div
				class="vacancy-income-calculator"
				id="vacancy-income-calculator"
				data-calculator-kind={calculatorModel.kind}
				data-hourly-rate={hourlyCalculator?.hourlyRate ?? ''}
				data-monthly-base={meetingCalculator?.monthlyBase ?? ''}
				data-meeting-fee={meetingCalculator?.meetingFee ?? ''}
				data-currency-label={currencyLabel}
				data-city={job.location}
				data-transport={job.transport}
			>
				<p class="vacancy-income-eyebrow">Калькулятор дохода</p>

				{hourlyCalculator && (
					<p class="vacancy-income-rate">
						{hourlyCalculator.rateLabel}: <strong>{hourlyCalculator.formattedHourlyRate}</strong>
						{hourlyCalculator.helperText && <small>{hourlyCalculator.helperText}</small>}
					</p>
				)}

				{meetingCalculator && (
					<p class="vacancy-income-rate">
						База и встречи: <strong>{meetingCalculator.formattedMonthlyBase}/мес + {meetingCalculator.formattedMeetingFee} за встречу</strong>
					</p>
				)}

				{monthlyCalculator && (
					<p class="vacancy-income-rate">
						Доход указан помесячно: <strong>{monthlyCalculator.monthlyText}</strong>
					</p>
				)}

				{hourlyCalculator && (
					<div class="vacancy-income-controls">
						<label class="vacancy-income-label" for="vacancy-days-range">
							<span>Дней в месяц</span>
							<strong id="vacancy-days-value">{hourlyCalculator.initialDays}</strong>
						</label>
						<input
							class="vacancy-income-range"
							type="range"
							id="vacancy-days-range"
							min="1"
							max="31"
							step="1"
							value={hourlyCalculator.initialDays}
						/>
						<label class="vacancy-income-label" for="vacancy-hours-range">
							<span>Часов в день</span>
							<strong id="vacancy-hours-value">{hourlyCalculator.initialHours}</strong>
						</label>
						<input
							class="vacancy-income-range"
							type="range"
							id="vacancy-hours-range"
							min="1"
							max="16"
							step="1"
							value={hourlyCalculator.initialHours}
						/>
					</div>
				)}

				{meetingCalculator && (
					<div class="vacancy-income-controls">
						<label class="vacancy-income-label" for="vacancy-days-range">
							<span>Дней в месяц</span>
							<strong id="vacancy-days-value">{meetingCalculator.initialDays}</strong>
						</label>
						<input
							class="vacancy-income-range"
							type="range"
							id="vacancy-days-range"
							min="1"
							max="31"
							step="1"
							value={meetingCalculator.initialDays}
						/>
						<label class="vacancy-income-label" for="vacancy-meetings-range">
							<span>Встреч в день</span>
							<strong id="vacancy-meetings-value">{meetingCalculator.initialMeetingsPerDay}</strong>
						</label>
						<input
							class="vacancy-income-range"
							type="range"
							id="vacancy-meetings-range"
							min="1"
							max="12"
							step="1"
							value={meetingCalculator.initialMeetingsPerDay}
						/>
					</div>
				)}

				<div class="vacancy-income-output" aria-live="polite">
					<span data-t="calculator.result">{monthlyCalculator ? 'Ориентир' : 'Примерный доход'}</span>
					<strong id="vacancy-income-total">
						{hourlyCalculator
							? formatMoneyWithCurrency(hourlyCalculator.totalMonthly, job.currency)
							: meetingCalculator
								? formatMoneyWithCurrency(meetingCalculator.totalMonthly, job.currency)
								: monthlyCalculator?.monthlyText}
					</strong>
					<small id="vacancy-income-formula">
						{hourlyCalculator
							? `${hourlyCalculator.initialDays} дн × ${hourlyCalculator.initialHours} ч × ${hourlyCalculator.formattedHourlyRate}`
							: meetingCalculator
								? `${meetingCalculator.formattedMonthlyBase} база + ${meetingCalculator.initialDays} дн × ${meetingCalculator.initialMeetingsPerDay} встреч × ${meetingCalculator.formattedMeetingFee}`
								: monthlyCalculator?.helperText}
					</small>
				</div>
			</div>
		)}
	</div>
</aside>

<style>
	.vacancy-card-sidebar {
		background: var(--vacancy-card);
		padding: 2rem;
		border-radius: 8px;
		border: 1px solid var(--vacancy-border);
		box-shadow: var(--vacancy-shadow);
		position: sticky;
		top: 2rem;
	}
	.detail-item {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--vacancy-border);
		color: var(--vacancy-muted);
		gap: 1rem;
	}
	.detail-item strong,
	.detail-item span {
		color: var(--vacancy-ink);
	}

	/* === Apply CTA (sidebar) === */
	.apply-btn-large {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		margin-top: 1rem;
		background: var(--accent-500);
		color: var(--ink-0);
		border: none;
		border-radius: var(--radius-md);
		padding: 14px 28px;
		font-family: var(--font-main);
		font-weight: 700;
		font-size: var(--fs-16);
		text-decoration: none;
		transition: background var(--transition);
	}
	.apply-btn-large:hover {
		background: var(--accent-400);
	}
	.apply-btn-unavailable,
	.apply-btn-unavailable:hover {
		background: var(--vacancy-soft-strong);
		color: var(--vacancy-muted);
		border: 1px solid var(--vacancy-border);
		box-shadow: none;
		cursor: not-allowed;
	}
	.apply-btn-large:focus-visible {
		outline: none;
		box-shadow: var(--shadow-focus);
	}
	.apply-note {
		text-align: center;
		font-size: 0.75rem;
		color: var(--vacancy-muted);
		margin-top: 0.5rem;
	}

	/* === Income calculator (sidebar) === */
	.vacancy-income-calculator {
		display: grid;
		gap: 0.8rem;
		margin-top: 1rem;
		padding: 0.95rem;
		border-radius: 8px;
		border: 1px solid var(--vacancy-border-strong);
		background: var(--vacancy-soft);
	}
	.vacancy-income-eyebrow {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0;
		color: var(--vacancy-eyebrow);
	}
	.vacancy-income-rate {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--vacancy-ink);
	}
	.vacancy-income-rate strong {
		font-size: 0.94rem;
	}
	.vacancy-income-rate small {
		display: block;
		margin-top: 0.18rem;
		color: var(--vacancy-muted);
	}
	.vacancy-income-rate-muted {
		color: var(--vacancy-muted);
	}
	.vacancy-income-controls {
		display: grid;
		gap: 0.45rem;
	}
	.vacancy-income-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		font-size: 0.79rem;
		color: var(--vacancy-muted);
	}
	.vacancy-income-label strong {
		min-width: 2.4rem;
		text-align: center;
		padding: 0.2rem 0.45rem;
		border-radius: 999px;
		background: var(--vacancy-soft-strong);
		color: var(--vacancy-ink);
		font-size: 0.78rem;
	}
	.vacancy-income-range {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 0.42rem;
		border-radius: 999px;
		background: #d7e4dc;
		outline: none;
	}
	.vacancy-income-range::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--vacancy-action);
		border: 2px solid #ffffff;
		box-shadow: 0 3px 10px rgba(22, 61, 43, 0.24);
		cursor: pointer;
	}
	.vacancy-income-range::-moz-range-thumb {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		background: var(--vacancy-action);
		border: 2px solid #ffffff;
		box-shadow: 0 3px 10px rgba(22, 61, 43, 0.24);
		cursor: pointer;
	}
	.vacancy-income-range:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.vacancy-income-output {
		display: grid;
		gap: 0.18rem;
		padding: 0.68rem;
		border-radius: 8px;
		background: var(--vacancy-card);
		border: 1px solid var(--vacancy-border);
	}
	.vacancy-income-output span {
		font-size: 0.72rem;
		text-transform: uppercase;
		font-weight: 800;
		color: var(--vacancy-muted);
	}
	.vacancy-income-output strong {
		font-size: 1.2rem;
		line-height: 1.2;
		color: var(--vacancy-ink);
	}
	.vacancy-income-output small {
		font-size: 0.72rem;
		line-height: 1.35;
		color: var(--vacancy-muted);
	}

	/* === Layout (sidebar wrapper) === */
	.vacancy-sidebar {
		align-self: start;
	}
	@media (min-width: 1024px) {
		.vacancy-sidebar {
			position: sticky;
			top: 80px;
		}
	}
	.vacancy-sidebar > * {
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xs);
	}

	:global(:where(html, body).dark-mode) .vacancy-income-output {
		background: rgba(67, 77, 90, 0.86);
	}
	:global(:where(html, body).dark-mode) .vacancy-income-range {
		background: rgba(148, 163, 184, 0.34);
	}
</style>

<script is:inline type="module" src={vacancyIncomeCalculatorUrl}></script>
