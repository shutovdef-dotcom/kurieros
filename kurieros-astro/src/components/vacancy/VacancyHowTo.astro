---
interface HowToStep {
	name: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	steps: HowToStep[];
}

const { title, description, steps } = Astro.props;
---

<section class="vacancy-section vacancy-howto" id="vacancy-howto" aria-labelledby="vacancy-howto-title" itemscope itemtype="https://schema.org/HowTo">
	<p class="section-eyebrow">Быстрый старт</p>
	<h2 id="vacancy-howto-title" itemprop="name">{title}</h2>
	<meta itemprop="totalTime" content="P1D" />
	<p class="vacancy-howto-lead" itemprop="description">{description}</p>
	<ol class="vacancy-howto-steps">
		{steps.map((step, index) => (
			<li class="vacancy-howto-step" itemprop="step" itemscope itemtype="https://schema.org/HowToStep">
				<meta itemprop="position" content={String(index + 1)} />
				<span class="vacancy-howto-num" aria-hidden="true">{index + 1}</span>
				<div class="vacancy-howto-body">
					<h3 itemprop="name">{step.name}</h3>
					<p itemprop="text">{step.text}</p>
				</div>
			</li>
		))}
	</ol>
</section>

<style>
	.vacancy-section {
		margin-bottom: 1.5rem;
	}

	/* Block B: HowTo steps */
	.vacancy-howto {
		padding: 1.75rem 1.85rem;
		background: var(--vacancy-card);
		border: 1px solid var(--vacancy-border);
		border-radius: 16px;
		box-shadow: var(--vacancy-shadow);
		display: grid;
		gap: 0.85rem;
	}
	.vacancy-howto h2 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: clamp(1.4rem, 2.2vw, 1.75rem);
		line-height: 1.18;
		letter-spacing: -0.01em;
		color: var(--vacancy-ink);
	}
	.vacancy-howto-lead {
		margin: 0;
		max-width: 70ch;
		color: var(--vacancy-muted);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.vacancy-howto-steps {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}
	.vacancy-howto-step {
		position: relative;
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.95rem;
		padding: 1rem 1.15rem;
		background: var(--vacancy-soft);
		border: 1px solid var(--vacancy-border);
		border-radius: 12px;
		transition: border-color 0.18s ease, transform 0.18s ease;
	}
	.vacancy-howto-step:hover {
		border-color: var(--vacancy-chip-border);
		transform: translateY(-1px);
	}
	.vacancy-howto-num {
		flex: 0 0 auto;
		display: grid;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 999px;
		background: var(--vacancy-action);
		color: var(--ink-0);
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-weight: 800;
		font-size: 0.95rem;
		line-height: 1;
	}
	.vacancy-howto-body {
		display: grid;
		gap: 0.3rem;
	}
	.vacancy-howto-body h3 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: 1rem;
		font-weight: 700;
		color: var(--vacancy-ink);
		line-height: 1.3;
	}
	.vacancy-howto-body p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.55;
		color: var(--vacancy-muted);
	}

	.section-eyebrow {
		margin-bottom: 0.55rem;
		font-size: 0.74rem;
		font-weight: 900;
		letter-spacing: 0;
		text-transform: uppercase;
		color: var(--vacancy-eyebrow);
	}

	:global(:where(html, body).dark-mode) .vacancy-howto {
		background: rgba(20, 32, 48, 0.7);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .vacancy-howto h2,
	:global(:where(html, body).dark-mode) .vacancy-howto-body h3 {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .vacancy-howto-lead,
	:global(:where(html, body).dark-mode) .vacancy-howto-body p {
		color: rgba(231, 234, 240, 0.7);
	}
	:global(:where(html, body).dark-mode) .vacancy-howto .section-eyebrow {
		color: rgba(231, 234, 240, 0.55);
	}
	:global(:where(html, body).dark-mode) .vacancy-howto-step {
		background: rgba(15, 23, 36, 0.65);
		border-color: rgba(195, 204, 216, 0.16);
	}
	:global(:where(html, body).dark-mode) .vacancy-howto-step:hover {
		border-color: rgba(76, 175, 128, 0.55);
	}
	:global(:where(html, body).dark-mode) .vacancy-howto-num {
		background: var(--brand-500);
		color: var(--ink-0);
	}

	@media (max-width: 600px) {
		.vacancy-howto {
			padding: 1.2rem 1rem;
		}
	}
</style>
