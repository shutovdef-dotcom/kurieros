---
/* eslint-disable max-lines -- TODO(H14): JobGrid.astro is ~998 LOC (eslint count). Wave 21d (audit v5 M8) already extracted the two define:vars-free script blocks (scroll/back-to-top -> src/scripts/jobGridScroll.ts, geo-prefetch -> src/scripts/jobGridGeoPrefetch.ts) and the home-grid selection algorithm (distributeAcrossCities/cityRank -> src/utils/distributeJobs.ts). The remaining bulk is IIFE #1 (compare-list + city hot-swap + the inline stripEventHandlers twin + dropdown filtering + reveal-more) which is `is:inline` because it needs the define:vars constants and so cannot be moved to a bundled module. Next step to remove this disable: split IIFE #1's concerns into per-concern sub-components/handlers. */
import JobCard from './JobCard.astro';
import jobsData from '../data/jobs';
import { filterJobsByCriteria } from '../utils/jobFilters';
import { distributeAcrossCities } from '../utils/distributeJobs';
import type { GeneratedJob } from '../data/vacancyTypes';

interface Props {
	initialCity?: string;
	initialTag?: string;
	initialSearch?: string;
	limit?: number;
	moreHref?: string;
	moreLabel?: string;
	/**
	 * Two `limit` modes (C2):
	 *   • `revealable=false` (default — home page): top-N curated via
	 *     `distributeAcrossCities` + a more-link to /cities/.
	 *   • `revealable=true` (city / category listings): render every
	 *     matched job — first `limit` visible, the rest stashed in a
	 *     `<template>` inside `#jobs-grid` and revealed in batches by
	 *     the bottom-nav «Вакансии» button. Keeps the initial render
	 *     light while keeping all city jobs reachable on the same page.
	 */
	revealable?: boolean;
	/**
	 * Pre-filtered job set (audit ref v3 NEW-3). When the caller has
	 * already computed the matched jobs — `[slug].astro` and
	 * `api/grid/[citySlug].astro` do, via the O(1) `getCityJobsFromMap`
	 * lookup — it passes them here and this component skips its own
	 * O(n) `filterJobsByCriteria` self-scan. When omitted (the home
	 * page, which legitimately filters from scratch by city/tag/search)
	 * the component self-filters as before.
	 */
	jobs?: GeneratedJob[];
}

const {
	initialCity = '',
	initialTag = 'all',
	initialSearch = '',
	limit,
	moreHref = '/cities/',
	moreLabel = 'Открыть все города',
	revealable = false,
	jobs,
} = Astro.props;
const availableJobIds = jobsData.map((job) => job.id);

// Server-side frontmatter filter — single source of truth lives in
// `src/utils/jobFilters.ts` (shared with [slug].astro and the sitemap
// emitter so SSR + sitemap inclusion can't drift). The client-side
// DOM filter lower in this same file (search for `function filterJobs`)
// is a separate DOM-dataset adapter; semantics are kept in sync by hand.
//
// NEW-3: when the caller passes a pre-filtered `jobs` set (it already
// ran the O(1) `getCityJobsFromMap` lookup — see [slug].astro /
// api/grid/[citySlug].astro), use it directly and skip the redundant
// O(n) self-scan. Only the home page omits `jobs` → it self-filters.
const matchedJobs = jobs ?? filterJobsByCriteria(jobsData, {
	city: initialCity,
	tag: initialTag,
	search: initialSearch,
});

// When `limit` is used (home page), `distributeAcrossCities` (now
// `src/utils/distributeJobs.ts` — Wave 21d / audit v5 M8) picks a curated
// top-N distributed across companies AND priority cities so no two cards
// of the same company appear in a row and every brand is represented
// before any second pick.
const limitActive = typeof limit === 'number' && limit > 0;
// `limitActive && !revealable` is the legacy curated-home mode: pick a
// distributed top-N and link to /cities/ for "more". `limitActive &&
// revealable` (C2) keeps every matched job rendered on the same page —
// first N visible, the rest in a hidden <template> the bottom-nav
// «Вакансии» button reveals in batches.
const filteredJobs = (limitActive && !revealable)
	? distributeAcrossCities(matchedJobs, limit!)
	: matchedJobs;
const visibleJobs = limitActive && revealable
	? filteredJobs.slice(0, limit!)
	: filteredJobs;
const overflowJobs = limitActive && revealable
	? filteredJobs.slice(limit!)
	: [];
const overflowCount = overflowJobs.length;
const batchSize = limitActive ? limit! : 24;
const hasMore = limitActive && !revealable && matchedJobs.length > limit!;
const totalMatched = matchedJobs.length;
const hasVacancies = jobsData.length > 0;
---

<div class="job-grid-container">
	<!-- Surfaces when the filter dropdowns hide every card on the page.
	     filterJobs() shows the notice AND restores all cards so the user
	     never lands on an empty list. -->
	<div class="no-filter-match hidden" id="no-filter-match" role="status" aria-live="polite">
		<p>
			<strong>По заданным критериям ничего не найдено.</strong>
			Посмотрите другие вакансии — показываем все доступные.
		</p>
	</div>

	<section id="vacancies">
		<div
			class="jobs-grid"
			id="jobs-grid"
			data-overflow-count={overflowCount}
			data-batch-size={batchSize}
		>
			{visibleJobs.length > 0 ? (
				visibleJobs.map((job) => (
					<JobCard job={job} />
				))
			) : (
				<div class="no-results">
					<h3 data-t={hasVacancies ? 'jobgrid.empty_title' : undefined}>
						{hasVacancies ? 'Ничего не найдено' : 'Вакансии пока не опубликованы'}
					</h3>
					<p data-t={hasVacancies ? 'jobgrid.empty_desc' : undefined}>
						{hasVacancies
							? 'Попробуйте сбросить фильтры или изменить поиск.'
							: 'Текущий список очищен. Новые карточки появятся после публикации вакансий.'}
					</p>
					{hasVacancies && <a class="btn-secondary" href="/" data-t="jobgrid.reset">Сбросить всё</a>}
				</div>
			)}
			{/* C2 overflow stash — bottom-nav «Вакансии» reveals in batches.
			    Lives inside #jobs-grid so the home page's `swapGridContent`
			    city-fetch swap clones it along with the visible cards
			    (it's an explicitly whitelisted node — see JobGrid script). */}
			{overflowCount > 0 && (
				<template class="jobs-grid-overflow">
					{overflowJobs.map((job) => (
						<JobCard job={job} />
					))}
				</template>
			)}
		</div>
		{hasMore && (
			<div class="jobs-grid-more">
				<p class="jobs-grid-more-text">
					Показано {filteredJobs.length} из {totalMatched} вакансий
				</p>
				<a class="jobs-grid-more-btn" href={moreHref}>{moreLabel}</a>
			</div>
		)}
	</section>
	<button
		id="back-to-top"
		class="back-to-top hidden"
		type="button"
		aria-label="Наверх к началу списка вакансий"
	>
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polyline points="18 15 12 9 6 15"></polyline>
		</svg>
	</button>
</div>

<style>
