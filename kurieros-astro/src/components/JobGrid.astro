---
import JobCard from './JobCard.astro';
import jobsData from '../data/jobs';
import { filterJobsByCriteria } from '../utils/jobFilters';
import { distributeAcrossCities } from '../utils/distributeJobs';
import { getListingBatchUrl } from '../utils/listingBatches';
import type { GeneratedJob } from '../data/vacancyTypes';

interface Props {
	initialCity?: string;
	initialTag?: string;
	initialSearch?: string;
	limit?: number;
	moreHref?: string;
	moreLabel?: string;
	/**
	 * Two `limit` modes (C2):
	 *   • `revealable=false` (default — home page): top-N curated via
	 *     `distributeAcrossCities` + a more-link to /cities/.
	 *   • `revealable=true` (city / category / hub listings): render only
	 *     the first `limit` jobs in the main HTML and point the bottom-nav
	 *     «Вакансии» reveal flow at a static `/api/grid-batch/.../`
	 *     fragment for the next batch. Keeps the initial listing HTML
	 *     crawler-sized while keeping the full set reachable on demand.
	 */
	revealable?: boolean;
	/**
	 * Pre-filtered job set (audit ref v3 NEW-3). When the caller has
	 * already computed the matched jobs — `[slug].astro` and
	 * `api/grid/[citySlug].astro` do, via the O(1) `getCityJobsFromMap`
	 * lookup — it passes them here and this component skips its own
	 * O(n) `filterJobsByCriteria` self-scan. When omitted (the home
	 * page, which legitimately filters from scratch by city/tag/search)
	 * the component self-filters as before.
	 */
	jobs?: GeneratedJob[];
	/**
	 * URL slug used by `/api/grid-batch/[listingSlug]/[page]/`.
	 * Required for `revealable` grids that have more than `limit` jobs.
	 */
	listingSlug?: string;
}

const {
	initialCity = '',
	initialTag = 'all',
	initialSearch = '',
	limit,
	moreHref = '/cities/',
	moreLabel = 'Открыть все города',
	revealable = false,
	jobs,
	listingSlug,
} = Astro.props;

// Server-side frontmatter filter — single source of truth lives in
// `src/utils/jobFilters.ts` (shared with [slug].astro and the sitemap
// emitter so SSR + sitemap inclusion can't drift). The client-side
// DOM filter lower in this same file (search for `function filterJobs`)
// is a separate DOM-dataset adapter; semantics are kept in sync by hand.
//
// NEW-3: when the caller passes a pre-filtered `jobs` set (it already
// ran the O(1) `getCityJobsFromMap` lookup — see [slug].astro /
// api/grid/[citySlug].astro), use it directly and skip the redundant
// O(n) self-scan. Only the home page omits `jobs` → it self-filters.
const matchedJobs = jobs ?? filterJobsByCriteria(jobsData, {
	city: initialCity,
	tag: initialTag,
	search: initialSearch,
});

// When `limit` is used (home page), `distributeAcrossCities` (now
// `src/utils/distributeJobs.ts` — Wave 21d / audit v5 M8) picks a curated
// top-N distributed across companies AND priority cities so no two cards
// of the same company appear in a row and every brand is represented
// before any second pick.
const limitActive = typeof limit === 'number' && limit > 0;
// `limitActive && !revealable` is the legacy curated-home mode: pick a
// distributed top-N and link to /cities/ for "more". `limitActive &&
// revealable` (C2) renders first N jobs and lazy-loads the rest from
// `/api/grid-batch/.../` instead of stashing thousands of hidden cards
// into the initial HTML.
const filteredJobs = (limitActive && !revealable)
	? distributeAcrossCities(matchedJobs, limit!)
	: matchedJobs;
const visibleJobs = limitActive && revealable
	? filteredJobs.slice(0, limit!)
	: filteredJobs;
const canLoadOverflow = Boolean(listingSlug);
const overflowCount = limitActive && revealable && canLoadOverflow
	? Math.max(0, filteredJobs.length - limit!)
	: 0;
const batchSize = limitActive ? limit! : 24;
const nextBatchUrl = overflowCount > 0
	? getListingBatchUrl(listingSlug!, 2)
	: undefined;
const hasMore = limitActive && !revealable && matchedJobs.length > limit!;
const hasRevealMore = limitActive && revealable && overflowCount > 0;
const totalMatched = matchedJobs.length;
const nextRevealCount = Math.min(batchSize, overflowCount);
const hasVacancies = jobsData.length > 0;

const vacancyWord = (count: number) => {
	const abs = Math.abs(count) % 100;
	const last = abs % 10;
	if (abs > 10 && abs < 20) return 'вакансий';
	if (last === 1) return 'вакансия';
	if (last >= 2 && last <= 4) return 'вакансии';
	return 'вакансий';
};
---

<div class="job-grid-container">
	<!-- Surfaces when the filter dropdowns hide every card on the page.
	     filterJobs() shows the notice AND restores all cards so the user
	     never lands on an empty list. -->
	<div class="no-filter-match hidden" id="no-filter-match" role="status" aria-live="polite">
		<p>
			<strong>По заданным критериям ничего не найдено.</strong>
			Посмотрите другие вакансии — показываем все доступные.
		</p>
	</div>

	<section id="vacancies">
		<div
			class="jobs-grid"
			id="jobs-grid"
			data-overflow-count={overflowCount}
			data-batch-size={batchSize}
			data-total-count={filteredJobs.length}
			data-next-batch-url={nextBatchUrl}
			data-initial-city={initialCity}
			data-initial-search={initialSearch}
		>
			{visibleJobs.length > 0 ? (
				visibleJobs.map((job) => (
					<JobCard job={job} />
				))
			) : (
				<div class="no-results">
					<h3 data-t={hasVacancies ? 'jobgrid.empty_title' : undefined}>
						{hasVacancies ? 'Ничего не найдено' : 'Вакансии пока не опубликованы'}
					</h3>
					<p data-t={hasVacancies ? 'jobgrid.empty_desc' : undefined}>
						{hasVacancies
							? 'Попробуйте сбросить фильтры или изменить поиск.'
							: 'Текущий список очищен. Новые карточки появятся после публикации вакансий.'}
					</p>
					{hasVacancies && <a class="btn-secondary" href="/" data-t="jobgrid.reset">Сбросить всё</a>}
				</div>
			)}
		</div>
		{hasMore && (
			<div class="jobs-grid-more">
				<p class="jobs-grid-more-text">
					Показано {filteredJobs.length} из {totalMatched} вакансий
				</p>
				<a class="jobs-grid-more-btn" href={moreHref}>{moreLabel}</a>
			</div>
		)}
		{hasRevealMore && (
			<div class="jobs-grid-more jobs-grid-reveal-more" id="jobs-grid-reveal-more">
				<p class="jobs-grid-more-text" id="jobs-grid-reveal-more-text" aria-live="polite">
					{visibleJobs.length} {vacancyWord(visibleJobs.length)} из {filteredJobs.length} {vacancyWord(filteredJobs.length)}
				</p>
				<a
					class="jobs-grid-more-btn"
					id="jobs-grid-reveal-more-btn"
					href={nextBatchUrl}
					aria-controls="jobs-grid"
				>
					Показать ещё {nextRevealCount} {vacancyWord(nextRevealCount)}
				</a>
			</div>
		)}
	</section>
	<button
		id="back-to-top"
		class="back-to-top hidden"
		type="button"
		aria-label="Наверх к началу списка вакансий"
	>
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<polyline points="18 15 12 9 6 15"></polyline>
		</svg>
	</button>
</div>

<style>
	.job-grid-container {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.jobs-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}
	@media (min-width: 768px) {
		.jobs-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1280px) {
		.jobs-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.no-results {
		grid-column: 1 / -1;
		text-align: center;
		padding: var(--space-12) var(--space-6);
		background: var(--ink-50);
		border-radius: var(--radius-lg);
		border: 1px dashed var(--ink-200);
		color: var(--ink-600);
	}
	.no-filter-match {
		background: var(--brand-50);
		border: 1px solid var(--brand-300);
		border-radius: var(--radius-md);
		padding: var(--space-3) var(--space-4);
		margin: 0 0 var(--space-4);
		color: var(--brand-800);
		font-size: var(--fs-14);
		line-height: 1.45;
	}
	.no-filter-match.hidden {
		display: none;
	}
	.no-filter-match p {
		margin: 0;
	}
	.no-filter-match strong {
		display: block;
		font-weight: 700;
		margin-bottom: 2px;
	}
	:global(:where(html, body).dark-mode) .no-filter-match {
		background: var(--brand-50);
		border-color: var(--brand-200);
		color: var(--brand-700);
	}
	.no-results h3 {
		font-family: var(--font-heading);
		font-size: var(--fs-20);
		font-weight: 700;
		color: var(--ink-800);
		margin: 0 0 8px 0;
	}
	.no-results p {
		font-size: var(--fs-14);
		margin: 0 0 var(--space-4) 0;
	}
	.no-results .btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 18px;
		border-radius: var(--radius-md);
		background: var(--ink-0);
		color: var(--ink-700);
		border: 1px solid var(--ink-200);
		font-weight: 700;
		font-size: var(--fs-14);
		text-decoration: none;
		transition: background var(--transition), border-color var(--transition);
	}
	.no-results .btn-secondary:hover,
	.no-results .btn-secondary:focus-visible {
		background: var(--ink-50);
		border-color: var(--brand-400);
		outline: none;
	}
	.no-results .btn-secondary:focus-visible {
		box-shadow: var(--shadow-focus);
	}
	.jobs-grid-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 24px;
		padding: 20px;
		text-align: center;
	}
	.jobs-grid-more-text {
		margin: 0;
		font-size: 14px;
		color: var(--ink-500);
	}
	.jobs-grid-more-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border: 0;
		padding: 12px 24px;
		border-radius: 999px;
		background: var(--brand-700);
		color: #fff;
		font-family: inherit;
		text-decoration: none;
		font-weight: 700;
		font-size: 15px;
		cursor: pointer;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}
	.jobs-grid-more-btn:hover {
		background: var(--brand-800);
		transform: translateY(-1px);
	}
	.jobs-grid-more-btn[aria-disabled="true"] {
		cursor: wait;
		opacity: 0.72;
		transform: none;
		pointer-events: none;
	}
	:global(:where(html, body).dark-mode) .jobs-grid-more-btn {
		background: var(--brand-500);
		color: var(--ink-0);
	}
	:global(:where(html, body).dark-mode) .jobs-grid-more-btn:hover {
		background: var(--brand-400);
	}

	/* QW14 — Back-to-top button.
	   Appears once the user has scrolled past the 8th card so it never
	   eats space above the fold on short lists. Sits above the mobile
	   sticky CTA (z-index 91, bottom 65px) by claiming bottom 88px on
	   mobile; tucked into the page corner on desktop. */
	.back-to-top {
		position: fixed;
		right: 16px;
		bottom: 88px;
		width: 48px;
		height: 48px;
		border: 1px solid var(--ink-200);
		border-radius: 50%;
		background: var(--ink-0);
		color: var(--ink-700);
		display: grid;
		place-items: center;
		cursor: pointer;
		z-index: 80;
		box-shadow: var(--shadow-md);
		transition: opacity 0.18s ease, transform 0.18s ease, background 0.15s ease;
	}
	.back-to-top:hover,
	.back-to-top:focus-visible {
		background: var(--brand-50);
		color: var(--brand-700);
		outline: none;
	}
	.back-to-top:focus-visible {
		box-shadow: var(--shadow-focus);
	}
	.back-to-top.hidden {
		opacity: 0;
		pointer-events: none;
		transform: translateY(8px);
	}
	@media (min-width: 768px) {
		.back-to-top { bottom: 24px; }
	}
	:global(:where(html, body).dark-mode) .back-to-top {
		background: rgba(15, 23, 36, 0.85);
		border-color: rgba(195, 204, 216, 0.2);
		color: var(--ink-200);
	}

	/* QW7 — Skeleton loader для city-switch hot-swap.
	   Селекторы помечены `:global()` потому что скелеты инжектятся
	   через `grid.innerHTML = ...` в JS — Astro `data-astro-cid-*`
	   атрибут на них не вешается, scoped CSS не сработал бы. */
	:global(.job-card-skeleton) {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		box-shadow: var(--shadow-sm);
		min-height: 290px;
		overflow: hidden;
	}
	:global(.job-card-skeleton)::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			100deg,
			transparent 20%,
			rgba(255, 255, 255, 0.55) 45%,
			transparent 70%
		);
		background-size: 200% 100%;
		animation: jobgrid-shimmer 1.4s linear infinite;
		pointer-events: none;
	}
	:global(.job-card-skeleton-row) {
		background: var(--ink-100);
		border-radius: var(--radius-md);
	}
	:global(.job-card-skeleton-logo) {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		flex-shrink: 0;
	}
	:global(.job-card-skeleton-title) { height: 18px; width: 70%; }
	:global(.job-card-skeleton-company) { height: 12px; width: 40%; }
	:global(.job-card-skeleton-meta) { height: 14px; width: 85%; }
	:global(.job-card-skeleton-cols) { height: 64px; width: 100%; }
	:global(.job-card-skeleton-actions) { height: 44px; width: 100%; }
	:global(.job-card-skeleton-top) {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}
	:global(.job-card-skeleton-top > div + div) {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	@keyframes jobgrid-shimmer {
		from { background-position: 200% 0; }
		to { background-position: -200% 0; }
	}
	:global(:where(html, body).dark-mode .job-card-skeleton) {
		background: rgba(28, 36, 52, 0.95);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode .job-card-skeleton-row) {
		background: rgba(195, 204, 216, 0.14);
	}
	:global(:where(html, body).dark-mode .job-card-skeleton)::before {
		background: linear-gradient(
			100deg,
			transparent 20%,
			rgba(255, 255, 255, 0.06) 45%,
			transparent 70%
		);
	}

	/* Top loading bar — показывается над скелетами. Маленький спиннер +
	   текст «грузим вакансии», чтобы пользователь понимал что фетч идёт. */
	:global(.job-grid-loading) {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 10px 16px;
		background: var(--brand-50);
		color: var(--brand-700);
		border: 1px solid var(--brand-300);
		border-radius: var(--radius-md);
		font-size: var(--fs-14);
		font-weight: 600;
		margin-bottom: 4px;
	}
	:global(.job-grid-loading-spinner) {
		width: 16px;
		height: 16px;
		border: 2px solid currentColor;
		border-right-color: transparent;
		border-radius: 50%;
		animation: jobgrid-spin 0.7s linear infinite;
		flex-shrink: 0;
	}
	@keyframes jobgrid-spin {
		to { transform: rotate(360deg); }
	}
	:global(:where(html, body).dark-mode .job-grid-loading) {
		background: rgba(94, 191, 156, 0.18);
		color: var(--brand-300);
		border-color: rgba(94, 191, 156, 0.4);
	}
</style>

<script>
	// Main JobGrid browser controller.
	// Extracted to a bundled ES module so JobGrid.astro keeps markup/server logic only.
	import '../scripts/jobGridController.js';
</script>

<script>
	// QW6 + QW14 — scroll restore on back-nav, back-to-top button.
	// Extracted to a typed ES module (Wave 21d, audit v5 M8 / TODO H14):
	// it uses no `define:vars` constants, so it is bundled + tree-shaken
	// by Astro instead of being `is:inline` — the same mechanism
	// `compare.astro` uses for `compareInit.ts`.
	import '../scripts/jobGridScroll';
</script>

<script>
	// Bug2 fix — Geo-aware city prefetch on idle.
	// Extracted to a typed ES module (Wave 21d, audit v5 M8 / TODO H14):
	// it uses no `define:vars` constants, so it is bundled + tree-shaken
	// by Astro instead of being `is:inline`. The module keeps its own
	// `location.pathname === '/'` self-gate, so even though Astro may
	// load it on every listing page it no-ops everywhere but the home
	// page.
	import '../scripts/jobGridGeoPrefetch';
</script>
