	.no-results .btn-secondary:focus-visible {
		background: var(--ink-50);
		border-color: var(--brand-400);
		outline: none;
	}
	.no-results .btn-secondary:focus-visible {
		box-shadow: var(--shadow-focus);
	}
	.jobs-grid-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 24px;
		padding: 20px;
		text-align: center;
	}
	.jobs-grid-more-text {
		margin: 0;
		font-size: 14px;
		color: var(--ink-500);
	}
	.jobs-grid-more-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 24px;
		border-radius: 999px;
		background: var(--brand-700);
		color: #fff;
		text-decoration: none;
		font-weight: 700;
		font-size: 15px;
		transition: background-color 0.15s ease, transform 0.15s ease;
