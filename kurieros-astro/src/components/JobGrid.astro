	}
	:global(:where(html, body).dark-mode) .jobs-grid-more-btn {
		background: var(--brand-500);
		color: var(--ink-0);
	}
	:global(:where(html, body).dark-mode) .jobs-grid-more-btn:hover {
		background: var(--brand-400);
	}

	/* QW14 — Back-to-top button.
	   Appears once the user has scrolled past the 8th card so it never
	   eats space above the fold on short lists. Sits above the mobile
	   sticky CTA (z-index 91, bottom 65px) by claiming bottom 88px on
	   mobile; tucked into the page corner on desktop. */
	.back-to-top {
		position: fixed;
		right: 16px;
		bottom: 88px;
		width: 48px;
		height: 48px;
		border: 1px solid var(--ink-200);
		border-radius: 50%;
		background: var(--ink-0);
		color: var(--ink-700);
		display: grid;
		place-items: center;
		cursor: pointer;
		z-index: 80;
		box-shadow: var(--shadow-md);
		transition: opacity 0.18s ease, transform 0.18s ease, background 0.15s ease;
	}
	.back-to-top:hover,
	.back-to-top:focus-visible {
		background: var(--brand-50);
		color: var(--brand-700);
		outline: none;
	}
	.back-to-top:focus-visible {
		box-shadow: var(--shadow-focus);
	}
