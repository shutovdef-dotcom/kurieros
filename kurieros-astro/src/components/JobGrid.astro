---
import JobCard from './JobCard.astro';
import jobsData from '../data/jobs';

interface Props {
	initialCity?: string;
	initialTag?: string;
	initialSearch?: string;
	limit?: number;
	moreHref?: string;
	moreLabel?: string;
}

const {
	initialCity = '',
	initialTag = 'all',
	initialSearch = '',
	limit,
	moreHref = '/cities/',
	moreLabel = 'Все вакансии — выбрать город',
} = Astro.props;
const availableJobIds = jobsData.map((job) => job.id);

const matchedJobs = jobsData.filter((job) => {
	const searchTerm = initialSearch.toLowerCase();
	const cityTerm = initialCity.toLowerCase();
	const matchesCity = !initialCity || job.location.toLowerCase().includes(cityTerm) || job.location === 'Вся Россия';
	const matchesTag = initialTag === 'all' || job.tags.includes(initialTag);
	const matchesSearch =
		!searchTerm ||
		job.title.toLowerCase().includes(searchTerm) ||
		job.company.toLowerCase().includes(searchTerm) ||
		job.location.toLowerCase().includes(searchTerm) ||
		job.salary.toLowerCase().includes(searchTerm);

	return matchesCity && matchesTag && matchesSearch;
});

// When `limit` is used (home page), distribute selection across multiple
// top cities via round-robin so the JS city filter has matches for ANY
// of the priority cities (was: top-24 all from Москва → switching city
// → empty grid). Top-12 priority cities × 2 jobs each ≈ 24 jobs.
const CITY_PRIORITY = [
	'Москва', 'Санкт-Петербург', 'Екатеринбург', 'Новосибирск', 'Казань',
	'Нижний Новгород', 'Краснодар', 'Самара', 'Уфа', 'Челябинск',
	'Ростов-на-Дону', 'Воронеж',
];
const cityRank = (loc: string): number => {
	const lower = loc.toLowerCase();
	for (let i = 0; i < CITY_PRIORITY.length; i++) {
		if (lower.includes(CITY_PRIORITY[i].toLowerCase())) return i;
	}
	return CITY_PRIORITY.length;
};

type JobItem = (typeof matchedJobs)[number];
const distributeAcrossCities = (jobs: JobItem[], max: number): JobItem[] => {
	// Group jobs by primary priority-city, then round-robin pick to maximize
	// city diversity. Jobs from non-priority cities go into a single bucket
	// and are appended after priority cities.
	const buckets: JobItem[][] = Array.from({ length: CITY_PRIORITY.length + 1 }, () => []);
	for (const job of jobs) {
		buckets[cityRank(job.location)].push(job);
	}
	const out: JobItem[] = [];
	let cursor = 0;
	const nonEmpty = () => buckets.some((b) => b.length > 0);
	while (out.length < max && nonEmpty()) {
		const bucket = buckets[cursor % buckets.length];
		if (bucket.length > 0) {
			out.push(bucket.shift()!);
		}
		cursor++;
		if (cursor > buckets.length * (max + 1)) break;
	}
	return out;
};

const filteredJobs = typeof limit === 'number' && limit > 0
	? distributeAcrossCities(matchedJobs, limit)
	: matchedJobs;
const hasMore = typeof limit === 'number' && limit > 0 && matchedJobs.length > limit;
const totalMatched = matchedJobs.length;
const hasVacancies = jobsData.length > 0;
---

<div class="job-grid-container">
	<div class="compare-inline-alert hidden" id="compare-limit-message" aria-live="polite"></div>

	<section id="vacancies">
		<div class="jobs-grid" id="jobs-grid">
			{filteredJobs.length > 0 ? (
				filteredJobs.map((job) => (
					<JobCard job={job} />
				))
			) : (
				<div class="no-results">
					<h3 data-t={hasVacancies ? 'jobgrid.empty_title' : undefined}>
						{hasVacancies ? 'Ничего не найдено' : 'Вакансии пока не опубликованы'}
					</h3>
					<p data-t={hasVacancies ? 'jobgrid.empty_desc' : undefined}>
						{hasVacancies
							? 'Попробуйте сбросить фильтры или изменить поиск.'
							: 'Текущий список очищен. Новые карточки появятся после публикации вакансий.'}
					</p>
					{hasVacancies && <a class="btn-secondary" href="/" data-t="jobgrid.reset">Сбросить всё</a>}
				</div>
			)}
		</div>
		{hasMore && (
			<div class="jobs-grid-more">
				<p class="jobs-grid-more-text">
					Показано {filteredJobs.length} из {totalMatched} вакансий
				</p>
				<a class="jobs-grid-more-btn" href={moreHref}>{moreLabel}</a>
			</div>
		)}
	</section>
</div>

<style>
	.job-grid-container {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.compare-inline-alert {
		margin-bottom: 0;
		padding: 12px 16px;
		border-radius: var(--radius-md);
		border: 1px solid var(--danger-fg);
		background: var(--danger-bg);
		color: var(--danger-fg);
		font-size: var(--fs-14);
		font-weight: 600;
		line-height: var(--lh-14);
	}
	.compare-inline-alert.hidden {
		display: none;
	}

	.jobs-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}
	@media (min-width: 768px) {
		.jobs-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1280px) {
		.jobs-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.no-results {
		grid-column: 1 / -1;
		text-align: center;
		padding: var(--space-12) var(--space-6);
		background: var(--ink-50);
		border-radius: var(--radius-lg);
		border: 1px dashed var(--ink-200);
		color: var(--ink-600);
	}
	.no-results h3 {
		font-family: var(--font-heading);
		font-size: var(--fs-20);
		font-weight: 700;
		color: var(--ink-800);
		margin: 0 0 8px 0;
	}
	.no-results p {
		font-size: var(--fs-14);
		margin: 0 0 var(--space-4) 0;
	}
	.no-results .btn-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 18px;
		border-radius: var(--radius-md);
		background: var(--ink-0);
		color: var(--ink-700);
		border: 1px solid var(--ink-200);
		font-weight: 700;
		font-size: var(--fs-14);
		text-decoration: none;
		transition: background var(--transition), border-color var(--transition);
	}
	.no-results .btn-secondary:hover,
	.no-results .btn-secondary:focus-visible {
		background: var(--ink-50);
		border-color: var(--brand-400);
		outline: none;
	}
	.no-results .btn-secondary:focus-visible {
		box-shadow: var(--shadow-focus);
	}
	.jobs-grid-more {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		margin-top: 24px;
		padding: 20px;
		text-align: center;
	}
	.jobs-grid-more-text {
		margin: 0;
		font-size: 14px;
		color: var(--ink-500, #6c7785);
	}
	.jobs-grid-more-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 24px;
		border-radius: 999px;
		background: var(--brand-700, #16734c);
		color: #fff;
		text-decoration: none;
		font-weight: 700;
		font-size: 15px;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}
	.jobs-grid-more-btn:hover {
		background: var(--brand-800, #105838);
		transform: translateY(-1px);
	}
	:global(body.dark-mode) .jobs-grid-more-btn {
		background: var(--brand-500, #2eb37a);
		color: #0e1622;
	}
	:global(body.dark-mode) .jobs-grid-more-btn:hover {
		background: var(--brand-400, #57c897);
	}
</style>

<script is:inline define:vars={{ initialCity, initialTag, initialSearch, availableJobIds }}>
	let compareList = [];
	const availableJobIdSet = new Set(availableJobIds);
	let selectedCity = initialCity || '';
	const normalizedInitialSearch = initialSearch.toLowerCase();
	let compareNoticeTimeout = null;

	function parseStoredCompareList() {
		try {
			const rawList = JSON.parse(localStorage.getItem('compareList') || '[]');
			if (!Array.isArray(rawList)) return [];

			return rawList
				.map((id) => Number.parseInt(String(id), 10))
				.filter((id) => Number.isFinite(id));
		} catch {
			return [];
		}
	}

	function normalizeCompareList(ids) {
		return ids
			.filter((id, index, list) => availableJobIdSet.has(id) && list.indexOf(id) === index)
			.slice(0, 4);
	}

	function syncCompareList({ emitEvent = true } = {}) {
		const rawList = parseStoredCompareList();
		const normalizedList = normalizeCompareList(rawList);
		compareList = normalizedList;

		if (JSON.stringify(rawList) !== JSON.stringify(normalizedList)) {
			localStorage.setItem('compareList', JSON.stringify(normalizedList));
			if (emitEvent) {
				window.dispatchEvent(new CustomEvent('compareUpdate'));
			}
		}

		return normalizedList;
	}

	function getTranslation(key, defaultText) {
		const lang = window.kurieros_i18n?.currentLang || 'ru';
		const dict = window.translations ? (window.translations[lang] || window.translations['ru']) : null;
		if (!dict) return defaultText;
		return key.split('.').reduce((prev, curr) => prev && prev[curr], dict) || defaultText;
	}

	function showCompareNotice(message) {
		const compareNotice = document.getElementById('compare-limit-message');
		if (!compareNotice) return;

		compareNotice.textContent = message;
		compareNotice.classList.remove('hidden');

		if (compareNoticeTimeout) {
			window.clearTimeout(compareNoticeTimeout);
		}

		compareNoticeTimeout = window.setTimeout(() => {
			compareNotice.classList.add('hidden');
		}, 3200);
	}

	function getCompareButtonLabel(isActive) {
		return isActive
			? `<span data-t="job.in_compare">${getTranslation('job.in_compare', 'В сравнении')}</span> ✓`
			: `<span data-t="job.compare">${getTranslation('job.compare', '+ Сравнить')}</span>`;
	}

	function setCompareButtonState(button, isActive) {
		if (!button) return;
		button.classList.toggle('active', isActive);
		button.innerHTML = getCompareButtonLabel(isActive);
	}

	function matchesSearch(card, searchTerm) {
		if (!searchTerm) return true;

		const title = card.querySelector('.job-title')?.textContent?.toLowerCase() || '';
		const company = card.querySelector('.company-name')?.textContent?.toLowerCase() || '';
		const location = (card.dataset.location || '').toLowerCase();

		return title.includes(searchTerm) || company.includes(searchTerm) || location.includes(searchTerm);
	}

	function mapAgeFilterToTag(value) {
		if (value === '16plus') return '16plus';
		if (value === '18plus') return '18+';
		return 'all';
	}

	function hasTag(card, tag) {
		if (!tag || tag === 'all') return true;
		const tags = (card.dataset.tags || '')
			.split(',')
			.map((item) => item.trim().toLowerCase())
			.filter(Boolean);

		return tags.includes(tag.toLowerCase());
	}

	function toggleCompare(id) {
		syncCompareList({ emitEvent: false });
		const index = compareList.indexOf(id);
		if (index === -1) {
			if (compareList.length >= 4) {
				compareList = [...compareList.slice(1), id];
			} else {
				compareList = [...compareList, id];
			}
		} else {
			compareList = compareList.filter((item) => item !== id);
		}

		localStorage.setItem('compareList', JSON.stringify(compareList));
		window.dispatchEvent(new CustomEvent('compareUpdate'));

		document.querySelectorAll('.btn-compare').forEach((btn) => {
			const buttonId = Number.parseInt(btn.dataset.id || '', 10);
			setCompareButtonState(btn, compareList.includes(buttonId));
		});
	}

	document.addEventListener('DOMContentLoaded', () => {
		const jobCards = document.querySelectorAll('.job-card');
		const ageFilterSelect = document.getElementById('vacancy-age-filter');
		const transportFilterSelect = document.getElementById('vacancy-transport-filter');
		syncCompareList();

		document.querySelectorAll('.btn-compare').forEach((btn) => {
			const id = Number.parseInt(btn.dataset.id || '', 10);
			setCompareButtonState(btn, compareList.includes(id));
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				toggleCompare(id);
			});
		});

		const grid = document.getElementById('jobs-grid');
		const cityCache = new Map();
		let activeFetch = 0;

		function escapeAttr(s) {
			return String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		}
		function escapeText(s) {
			return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
		}

		function renderJobCard(job) {
			const tagsAttr = (job.tags || []).join(',');
			const labels = (job.tags || []).slice(0, 3).map((t) => `<span class="job-label">${escapeText(t)}</span>`).join('');
			return `
				<article class="job-card" data-location="${escapeAttr(job.location)}" data-tags="${escapeAttr(tagsAttr)}">
					<div class="job-card-head">
						<img src="${escapeAttr(job.companyLogo)}" alt="${escapeAttr(job.company)} logo" width="48" height="48" loading="lazy" decoding="async" />
						<div class="job-card-title">
							<a href="/v/${escapeAttr(job.slug)}/"><h3>${escapeText(job.title)}</h3></a>
							<span class="company-name">${escapeText(job.company)}</span>
						</div>
					</div>
					<div class="job-card-meta">
						<span class="salary">${escapeText(job.salary)}</span>
						<span class="location">${escapeText(job.location)}</span>
					</div>
					<div class="job-card-labels">${labels}</div>
					<div class="job-card-actions">
						<a class="btn-primary" href="/v/${escapeAttr(job.slug)}/">Подробнее</a>
						<button type="button" class="btn-compare" data-id="${escapeAttr(job.id)}">Сравнить</button>
					</div>
				</article>
			`;
		}

		function renderEmptyForCity(cityName, citySlug) {
			const safeCity = escapeText(cityName || '');
			const safeSlug = escapeAttr(citySlug || '');
			const cityHref = safeSlug ? `/rabota-kurerom-${safeSlug}/` : '/cities/';
			grid.innerHTML = `
				<div class="no-results">
					<h3>В городе ${safeCity} нет вакансий в коротком списке</h3>
					<p>Полный список доступен на отдельной странице города.</p>
					<a class="btn-primary" href="${cityHref}">Открыть вакансии ${safeCity}</a>
				</div>
			`;
		}

		async function renderJobsForCity(citySlug, cityName) {
			if (!grid) return;
			if (!citySlug) {
				// Fallback to server-rendered cards visibility filter.
				filterJobs();
				return;
			}
			const ticket = ++activeFetch;
			let payload = cityCache.get(citySlug);
			if (!payload) {
				try {
					const res = await fetch(`/api/jobs-by-city/${citySlug}.json`, { cache: 'force-cache' });
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					payload = await res.json();
					cityCache.set(citySlug, payload);
				} catch (err) {
					console.warn('jobs-by-city fetch failed', err);
					return;
				}
			}
			if (ticket !== activeFetch) return; // stale response
			const items = (payload && payload.items) || [];
			if (items.length === 0) {
				renderEmptyForCity(cityName || payload?.city || '', citySlug);
				return;
			}
			grid.innerHTML = items.map(renderJobCard).join('');
			// Re-bind compare buttons for new cards.
			grid.querySelectorAll('.btn-compare').forEach((btn) => {
				const id = Number.parseInt(btn.dataset.id || '', 10);
				setCompareButtonState(btn, compareList.includes(id));
				btn.addEventListener('click', (e) => {
					e.preventDefault();
					toggleCompare(id);
				});
			});
			// Apply age/transport filters on top of fetched cards.
			filterJobs();
		}

		window.addEventListener('kurieros:city-selected', (event) => {
			selectedCity = event.detail?.city || '';
			const slug = event.detail?.slug || '';
			renderJobsForCity(slug, selectedCity);
		});

		window.addEventListener('storage', (event) => {
			if (event.key !== 'compareList') return;
			syncCompareList({ emitEvent: false });
			document.querySelectorAll('.btn-compare').forEach((btn) => {
				const id = Number.parseInt(btn.dataset.id || '', 10);
				setCompareButtonState(btn, compareList.includes(id));
			});
		});

		ageFilterSelect?.addEventListener('change', () => {
			filterJobs();
		});

		transportFilterSelect?.addEventListener('change', () => {
			filterJobs();
		});

		function filterJobs() {
			const term = normalizedInitialSearch;
			const selectedAgeTag = mapAgeFilterToTag(ageFilterSelect?.value || 'all');
			const selectedTransportTag = transportFilterSelect?.value || 'all';

			jobCards.forEach((card) => {
				const location = (card.dataset.location || '').toLowerCase();
				const matchesCity = !selectedCity || location.includes(selectedCity.toLowerCase()) || location === 'вся россия';
				const matchesSearchTerm = matchesSearch(card, term);
				const matchesAge = hasTag(card, selectedAgeTag);
				const matchesTransport = hasTag(card, selectedTransportTag);

				if (matchesSearchTerm && matchesCity && matchesAge && matchesTransport) {
					card.style.display = 'flex';
				} else {
					card.style.display = 'none';
				}
			});
		}

		filterJobs();
	});
</script>
