---
import vpnModalUrl from '../scripts/vpnModal.js?url';
---
<div id="vpn-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="vpn-modal-title">
    <div class="modal-content">
        <div class="modal-icon" aria-hidden="true">🌐</div>
        <h3 id="vpn-modal-title" data-t="vpn.title">Регион не определён автоматически</h3>
        <p data-t="vpn.text">Мы не смогли уверенно определить ваш город по IP. Выберите его вручную, а если списка на этой странице нет, мы откроем раздел с городами.</p>
        
        <div class="modal-actions">
            <button class="btn-primary" id="btn-vpn-ok" data-t="vpn.btn_manual" type="button">Выбрать город</button>
            <button class="btn-secondary" id="btn-vpn-close" data-t="vpn.btn_close" type="button">Продолжить без выбора</button>
        </div>
    </div>
</div>

<script is:inline type="module" src={vpnModalUrl}></script>

<style>
    .modal-icon {
        font-size: 3rem;
        margin-bottom: var(--space-4);
        line-height: 1;
    }
    #vpn-modal {
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(19, 16, 13, 0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }
    .modal-content {
        background: var(--ink-0);
        border: 1px solid var(--ink-200);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-lg);
        padding: var(--space-8);
        color: var(--ink-700);
    }
    .modal-content h3 {
        font-family: var(--font-heading);
        font-weight: 800;
        margin-bottom: 0.75rem;
    }
    .modal-content p {
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.75rem;
    }
    .modal-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
</style>
