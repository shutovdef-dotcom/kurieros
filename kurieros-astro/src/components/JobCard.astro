---
import { ozonDataAttrs } from '../utils/ozonAttrs';

const { job, isInCompare = false } = Astro.props;

// `applyLink: 'lead-form:<provider>'` is a magic marker (set in
// src/data/vacancies.ts) that swaps the external `<a>` CTA for an
// in-page modal opener. The `<provider>` segment is forwarded to
// `data-lead-form-type` and consumed by the matching modal component.
const isLeadFormApply = typeof job.applyLink === 'string' && job.applyLink.startsWith('lead-form:');
const leadFormType = isLeadFormApply ? job.applyLink.slice('lead-form:'.length) : null;

const applyHref = !isLeadFormApply && job.applyLink && job.applyLink !== '#'
	? job.applyLink
	: `/v/${job.slug}/`;
const applyExternal = !isLeadFormApply && job.applyLink && job.applyLink !== '#';

// Extract a numeric ceiling from the human salary string (e.g.
// «до 298 800 ₽/мес» → 298800). Used for the GA4 `apply_click` event
// payload so we can analyse click-through value distribution.
// Best-effort: returns 0 on parse miss.
const salaryMaxNumeric = (() => {
	const raw = (job.salary ?? '').replace(/[  ]/g, ' ');
	const matches = raw.match(/(\d[\d\s]*)/g);
	if (!matches) return 0;
	const numbers = matches
		.map((m: string) => Number.parseInt(m.replace(/\s+/g, ''), 10))
		.filter((n: number) => Number.isFinite(n) && n > 0);
	return numbers.length ? Math.max(...numbers) : 0;
})();
const applyEmploymentText = job.details?.employment_type ?? '';
// Ceiling-anchored CTA: when the parsed monthly max is meaningful
// (≥10k) the button advertises it as «зп до Nк. руб», giving the
// user a concrete payoff in the click decision. Floor to a thousand
// keeps the number from over-promising (298800 → 298к, not 299к).
// Hourly/per-shift values fall below the threshold and quietly fall
// back to the plain CTA so the button never reads «до 0к. руб».
const applyLabel = salaryMaxNumeric >= 10000
	? `Откликнуться, зп до ${Math.floor(salaryMaxNumeric / 1000)}к. руб`
	: 'Откликнуться';
// QW13 demo — surface a prominent «Без опыта» badge.
// Trigger combines two signals so it actually fires on real data:
//   1) Explicit `'Без опыта'` in labels (currently dormant — no
//      vacancySource sets it, but kept for forward-compat).
//   2) `'16plus'` in tags — deterministic entry-level marker derived
//      in jobs.ts:`getAgeTag(ageFrom)` for vacancies that accept
//      16-year-olds (the truly low-barrier subset).
// The `data-no-experience` attr lets demo CSS key off only the
// vacancies that genuinely qualify.
const hasNoExperience = (Array.isArray(job.labels) && job.labels.includes('Без опыта'))
	|| (Array.isArray(job.tags) && job.tags.includes('16plus'));
---

<div
	class="job-card"
	data-id={job.id}
	data-slug={job.slug}
	data-tags={job.tags.join(',')}
	data-location={job.location}
	data-no-experience={hasNoExperience ? 'true' : undefined}
>
	{job.isHot && <div class="hot-badge">🔥 ТОП</div>}
	<div class="share-wrap">
		<button
			class="share-btn"
			type="button"
			aria-label="Поделиться вакансией"
			aria-haspopup="menu"
			aria-expanded="false"
			data-share-vacancy
			data-share-slug={job.slug}
			data-share-title={job.title}
			data-share-salary={job.salary}
		>
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<circle cx="18" cy="5" r="3"></circle>
				<circle cx="6" cy="12" r="3"></circle>
				<circle cx="18" cy="19" r="3"></circle>
				<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
				<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
			</svg>
		</button>
		<div class="share-dropdown" role="menu" hidden>
			<button type="button" role="menuitem" class="share-option" data-share-target="telegram">
				<span class="share-option-icon" aria-hidden="true">✈️</span> Telegram
			</button>
			<button type="button" role="menuitem" class="share-option" data-share-target="whatsapp">
				<span class="share-option-icon" aria-hidden="true">💬</span> WhatsApp
			</button>
			<button type="button" role="menuitem" class="share-option" data-share-target="vk">
				<span class="share-option-icon" aria-hidden="true">🌐</span> ВКонтакте
			</button>
			<button type="button" role="menuitem" class="share-option" data-share-target="copy">
				<span class="share-option-icon" aria-hidden="true">📋</span> Скопировать ссылку
			</button>
		</div>
	</div>
	<div class="job-row-main">
		<div class="company-logo">
			<img src={job.companyLogo} alt={`${job.company} logo`} width="48" height="48" loading="lazy" decoding="async" />
		</div>
		<div class="job-content">
			<div class="job-heading">
				<div>
					<a href={`/v/${job.slug}/`} class="job-title" data-t={`vacancies.${job.id}.title`}>{job.title}</a>
					<div class="company-name" data-t={`vacancies.${job.id}.company`}>{job.company}</div>
					{job.shortDescription && <p class="job-short-desc" data-t={`vacancies.${job.id}.shortDescription`}>{job.shortDescription}</p>}
				</div>
				<div class="salary-tag" data-t={`vacancies.${job.id}.salary`}>{job.salary}</div>
			</div>
		</div>
	</div>
	<div class="job-meta">
		<div class="location">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
				<circle cx="12" cy="10" r="3"></circle>
			</svg>
			<span data-t={`vacancies.${job.id}.location`}>{job.location}</span>
		</div>
		<div class="tags">
			{job.labels.map((label: string, i: number) => (
				<span class="tag" data-t={`vacancies.${job.id}.label_${i}`}>{label}</span>
			))}
		</div>
	</div>
	<div class="job-columns">
		<div class="job-column">
			<span class="job-column-label" data-t="job.salary">Зарплата</span>
			<strong data-t={`vacancies.${job.id}.salary`}>{job.salary}</strong>
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.schedule">График</span>
			<strong data-t={`vacancies.${job.id}.details_schedule`}>{job.details.schedule}</strong>
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.education">Образование</span>
			<strong data-t={`vacancies.${job.id}.details_education`}>{job.details.education}</strong>
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.experience">Опыт</span>
			{hasNoExperience ? (
				<span class="job-column-noexp" aria-label="Без опыта">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
					Без опыта
				</span>
			) : (
				<strong><span data-t="job.see_vacancy">См. вакансию</span></strong>
			)}
		</div>
	</div>
	<div class="job-row-actions">
		<div class="job-actions">
			<button class={`btn-compare ${isInCompare ? 'active' : ''}`} data-id={job.id} type="button">
				{isInCompare ? <><span data-t="job.in_compare">В сравнении</span> ✓</> : <span data-t="job.compare">+ Сравнить</span>}
			</button>
			{isLeadFormApply ? (
				<button
					type="button"
					class="apply-btn"
					data-apply-cta
					data-apply-position="grid_card"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={applyEmploymentText}
					data-apply-salary-max={salaryMaxNumeric || ''}
					data-lead-form-type={leadFormType}
					{...ozonDataAttrs(job.ozonLeadForm)}
				>{applyLabel}</button>
			) : (
				<a
					href={applyHref}
					class="apply-btn"
					target={applyExternal ? '_blank' : undefined}
					rel={applyExternal ? 'noopener noreferrer nofollow sponsored' : undefined}
					data-apply-cta
					data-apply-position="grid_card"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={applyEmploymentText}
					data-apply-salary-max={salaryMaxNumeric || ''}
				>{applyLabel}</a>
			)}
		</div>
	</div>
</div>

<style>
	.job-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		box-shadow: var(--shadow-sm);
		transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
	}
	.job-card:hover {
		transform: translateY(-1px);
		border-color: var(--brand-400);
		box-shadow: var(--shadow-md);
	}

	.hot-badge {
		position: absolute;
		top: 10px;
		right: -6px;
		background: var(--accent-500);
		color: var(--ink-0);
		font-size: var(--fs-12);
		font-weight: 800;
		padding: 4px 10px;
		border-radius: var(--radius-sm) 0 0 var(--radius-sm);
		letter-spacing: 0.04em;
		box-shadow: var(--shadow-sm);
	}

	/* QW13 — «Без опыта» green pill rendered inline inside the «Опыт»
	   column instead of a separate row, so entry-level vacancies don't
	   stretch the card vertically vs. the «См. вакансию» fallback. */
	.job-column-noexp {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		align-self: flex-start;
		padding: 4px 9px;
		background: #e8f6ec;
		color: #117a3a;
		border: 1px solid #b8e3c4;
		border-radius: var(--radius-pill);
		font-size: 12px;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.01em;
		max-width: 100%;
		white-space: nowrap;
	}
	.job-column-noexp svg {
		flex-shrink: 0;
		display: block;
	}
	:global(body.dark-mode) .job-column-noexp {
		background: rgba(46, 160, 67, 0.18);
		color: #67d086;
		border-color: rgba(46, 160, 67, 0.45);
	}

	.job-row-main {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}
	.company-logo {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		background: var(--brand-50);
		display: grid;
		place-items: center;
		overflow: hidden;
		/* Inner padding so wide-aspect logos like Купер (420×264) keep
		   a visible margin around the artwork inside the 48×48 frame. */
		padding: 4px;
	}
	.company-logo img {
		width: 100%;
		height: 100%;
		/* `contain` preserves the full logo regardless of aspect ratio.
		   `cover` was cropping wide rectangular logos (e.g. Купер) to a
		   centre slice, leaving only the swirl icon visible. */
		object-fit: contain;
	}

	.job-content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.job-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--space-3);
	}
	.job-title {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--fs-18);
		font-weight: 700;
		color: var(--ink-900);
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.job-title:hover,
	.job-title:focus-visible {
		color: var(--brand-700);
		outline: none;
	}
	.company-name {
		font-size: var(--fs-13);
		color: var(--ink-500);
		font-weight: 600;
		margin-top: 2px;
	}
	.job-short-desc {
		font-size: var(--fs-14);
		color: var(--ink-600);
		margin: 6px 0 0;
		line-height: var(--lh-14);
	}
	.salary-tag {
		flex-shrink: 0;
		background: var(--brand-50);
		color: var(--brand-700);
		font-size: var(--fs-14);
		font-weight: 700;
		padding: 6px 12px;
		border-radius: var(--radius-pill);
		white-space: nowrap;
	}

	.job-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	.location {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--ink-500);
		font-size: var(--fs-13);
	}
	.location svg {
		opacity: 0.8;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		font-size: var(--fs-12);
		font-weight: 600;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--ink-100);
		color: var(--ink-700);
	}

	.job-columns {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
		padding-top: var(--space-3);
		border-top: 1px dashed var(--ink-200);
	}
	@media (max-width: 480px) {
		/* Очень узкий моб — 4 колонки физически не помещаются. */
		.job-columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: var(--space-3);
		}
	}
	.job-column {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		padding: 0 4px;
		/* Вертикальный пунктир в стиле горизонтального dashed-разделителя
		   между описанием и колонками. На первой колонке каждой
		   логической строки убирается. */
		border-left: 1px dashed var(--ink-200);
	}
	.job-column:first-child {
		padding-left: 0;
		border-left: none;
	}
	@media (max-width: 480px) {
		.job-column:nth-child(2n+1) {
			padding-left: 0;
			border-left: none;
		}
		.job-column:nth-child(2n) {
			padding-left: 4px;
			border-left: 1px dashed var(--ink-200);
		}
	}
	.job-column-label {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--ink-500);
		font-weight: 600;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}
	.job-column strong {
		font-size: var(--fs-13);
		font-weight: 600;
		color: var(--ink-800);
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.job-row-actions {
		display: flex;
	}
	.job-actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: 100%;
	}
	.btn-compare,
	.apply-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 18px;
		border-radius: var(--radius-md);
		font-family: var(--font-main);
		font-weight: 700;
		font-size: var(--fs-14);
		cursor: pointer;
		text-decoration: none;
		transition: background var(--transition), color var(--transition), border-color var(--transition);
	}
	.btn-compare {
		background: var(--ink-0);
		color: var(--ink-700);
		border: 1px solid var(--ink-200);
	}
	.btn-compare:hover,
	.btn-compare:focus-visible {
		background: var(--ink-50);
		border-color: var(--ink-300);
		outline: none;
	}
	.btn-compare.active {
		background: var(--brand-50);
		border-color: var(--brand-300);
		color: var(--brand-700);
	}
	.apply-btn {
		background: var(--accent-600);
		color: var(--ink-0);
		border: none;
	}
	.apply-btn:hover {
		background: var(--accent-500);
	}
	.btn-compare:focus-visible,
	.apply-btn:focus-visible {
		box-shadow: var(--shadow-focus);
	}

	/* HV19 — Share button in absolute top-right corner (does NOT take
	   vertical space in the card). Clicking on touch devices opens
	   native share-sheet; on desktop opens custom RU dropdown
	   (Telegram / WhatsApp / VK / Copy link). */
	.share-wrap {
		position: absolute;
		top: 10px;
		right: 12px;
		z-index: 3;
	}
	.job-card.viewed .share-wrap {
		/* Viewed cards have opacity 0.78 — but share button stays full opacity. */
		opacity: 1.28;
	}
	.share-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--ink-0);
		color: var(--ink-600);
		border: 1px solid var(--ink-200);
		cursor: pointer;
		padding: 0;
		transition: background var(--transition), color var(--transition), border-color var(--transition);
		box-shadow: var(--shadow-sm);
	}
	.share-btn:hover,
	.share-btn:focus-visible {
		background: var(--brand-50);
		color: var(--brand-700);
		border-color: var(--brand-300);
		outline: none;
	}
	.share-btn:focus-visible {
		box-shadow: var(--shadow-focus);
	}
	/* Hot-card has «ТОП» badge at top-right — shift share-btn left to clear it. */
	.job-card:has(.hot-badge) .share-wrap {
		right: 64px;
	}

	.share-dropdown {
		position: absolute;
		top: calc(100% + 4px);
		right: 0;
		min-width: 200px;
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-md);
		padding: 6px;
		display: flex;
		flex-direction: column;
		gap: 2px;
		z-index: 10;
	}
	.share-dropdown[hidden] {
		display: none;
	}
	.share-option {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 8px 12px;
		background: transparent;
		border: none;
		border-radius: var(--radius-sm, 6px);
		color: var(--ink-800);
		font-family: var(--font-main);
		font-size: var(--fs-14);
		font-weight: 500;
		cursor: pointer;
		text-align: left;
		transition: background 0.12s ease;
	}
	.share-option:hover,
	.share-option:focus-visible {
		background: var(--ink-50);
		outline: none;
	}
	.share-option-icon {
		font-size: 1rem;
		line-height: 1;
	}

	:global(body.dark-mode) .share-btn {
		background: rgba(15, 23, 36, 0.92);
		color: var(--ink-300);
		border-color: rgba(195, 204, 216, 0.25);
	}
	:global(body.dark-mode) .share-btn:hover {
		color: var(--brand-300);
		border-color: rgba(94, 191, 156, 0.5);
	}
	:global(body.dark-mode) .share-dropdown {
		background: #1b2533;
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(body.dark-mode) .share-option {
		color: #e7eaf0;
	}
	:global(body.dark-mode) .share-option:hover {
		background: rgba(231, 234, 240, 0.08);
	}

	/* HV9 — Viewed-vacancy marker.
	   Inline-маркер сразу после названия компании («Яндекс Еда · просмотрено»).
	   Pseudo-element `::after` на `.company-name` не вступает в конфликт с
	   i18n-логикой BaseLayout (`textContent = ...`), потому что generated
	   content псевдо-элементов не входит в textContent. */
	.job-card.viewed {
		opacity: 0.78;
		transition: opacity 0.2s ease;
	}
	.job-card.viewed:hover {
		opacity: 1;
	}
	.job-card.viewed .company-name::after {
		content: " · просмотрено";
		font-size: var(--fs-12);
		font-weight: 500;
		color: var(--ink-500);
		letter-spacing: 0.01em;
	}
	:global(body.dark-mode) .job-card.viewed .company-name::after {
		color: var(--ink-400, rgba(231, 234, 240, 0.55));
	}

	/* HV11 — Compact JobCard on mobile.
	   Сжимаем padding/gap/heights чтобы 3 карточки помещались выше fold
	   на iPhone 12 mini (375×812). Все интерактивные элементы остаются
	   ≥40px (WCAG 2.5.5 minimum). */
	@media (max-width: 768px) {
		.job-card {
			gap: var(--space-3);
			padding: var(--space-4);
		}
		.job-row-main {
			gap: 10px;
		}
		.company-logo {
			width: 40px;
			height: 40px;
		}
		.job-title {
			font-size: var(--fs-16);
			line-height: 1.25;
		}
		.salary-tag {
			font-size: var(--fs-13);
			padding: 4px 10px;
		}
		.job-columns {
			padding-top: var(--space-2);
		}
		.btn-compare,
		.apply-btn {
			height: 40px;
			padding: 0 14px;
		}
	}
</style>

<script>
	// HV9 + HV19 — viewed-vacancy marker + share button.
	// Hoisted script (no `is:inline`) — Astro дедуплицирует и инжектит
	// один раз на страницу, даже если JobCard рендерится N раз.

	const VIEWED_KEY = 'kurieros:viewed-vacancies';
	const MAX_VIEWED = 200; // cap localStorage usage

	function readViewed(): Set<string> {
		try {
			const raw = localStorage.getItem(VIEWED_KEY);
			if (!raw) return new Set();
			const arr = JSON.parse(raw);
			return new Set(Array.isArray(arr) ? arr.map(String) : []);
		} catch {
			return new Set();
		}
	}

	function persistViewed(set: Set<string>) {
		try {
			const arr = Array.from(set).slice(-MAX_VIEWED);
			localStorage.setItem(VIEWED_KEY, JSON.stringify(arr));
		} catch {
			/* private mode / quota — silently skip */
		}
	}

	function markViewedCards() {
		const viewed = readViewed();
		if (viewed.size === 0) return;
		document.querySelectorAll<HTMLElement>('.job-card[data-id]').forEach((card) => {
			const id = card.dataset.id;
			if (id && viewed.has(id)) card.classList.add('viewed');
		});
	}

	// Initial mark + re-mark after city-swap / reveal-more (grid swaps innerHTML).
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', markViewedCards, { once: true });
	} else {
		markViewedCards();
	}
	window.addEventListener('kurieros:city-selected', () => setTimeout(markViewedCards, 100));
	window.addEventListener('kurieros:reveal-more-jobs', markViewedCards);

	// Click delegation: capture clicks on `.job-card .job-title` and persist.
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const titleLink = target.closest('.job-card .job-title');
		if (titleLink) {
			const card = titleLink.closest<HTMLElement>('.job-card[data-id]');
			const id = card?.dataset.id;
			if (id) {
				const viewed = readViewed();
				viewed.add(id);
				persistViewed(viewed);
				card.classList.add('viewed');
			}
			return;
		}

		// HV19 — Share button: touch → native share, desktop → RU dropdown.
		const shareBtn = target.closest<HTMLElement>('[data-share-vacancy]');
		if (shareBtn) {
			event.preventDefault();
			event.stopPropagation();
			const slug = shareBtn.dataset.shareSlug || '';
			const title = shareBtn.dataset.shareTitle || 'Вакансия курьера';
			const salary = shareBtn.dataset.shareSalary || '';
			const url = `https://kurerok.ru/v/${slug}/?utm_source=share&utm_medium=user`;
			const text = `${title}${salary ? ' · ' + salary : ''}\n${url}`;

			// Prefer native share on touch devices — iOS/Android sheet
			// already includes Telegram/WhatsApp/VK/Copy as installed apps.
			const isTouch = window.matchMedia('(pointer: coarse)').matches;
			if (isTouch && typeof navigator.share === 'function') {
				navigator.share({ title, text, url }).catch(() => {});
				if (typeof (window as any).gtag === 'function') {
					(window as any).gtag('event', 'share_vacancy', { vacancy_slug: slug, method: 'native' });
				}
				return;
			}

			// Desktop / no native share — toggle custom RU dropdown.
			const wrap = shareBtn.closest('.share-wrap');
			const dropdown = wrap?.querySelector('.share-dropdown') as HTMLElement | null;
			if (!dropdown) return;
			// Close any other open dropdowns first.
			document.querySelectorAll('.share-dropdown:not([hidden])').forEach((d) => {
				if (d !== dropdown) d.setAttribute('hidden', '');
			});
			const willOpen = dropdown.hasAttribute('hidden');
			if (willOpen) {
				dropdown.removeAttribute('hidden');
				shareBtn.setAttribute('aria-expanded', 'true');
			} else {
				dropdown.setAttribute('hidden', '');
				shareBtn.setAttribute('aria-expanded', 'false');
			}
			return;
		}

		// HV19 — Share dropdown option click (Telegram / WhatsApp / VK / Copy).
		const shareOption = target.closest<HTMLElement>('[data-share-target]');
		if (shareOption) {
			event.preventDefault();
			const wrap = shareOption.closest('.share-wrap') as HTMLElement | null;
			const trigger = wrap?.querySelector('[data-share-vacancy]') as HTMLElement | null;
			const slug = trigger?.dataset.shareSlug || '';
			const title = trigger?.dataset.shareTitle || 'Вакансия курьера';
			const salary = trigger?.dataset.shareSalary || '';
			const url = `https://kurerok.ru/v/${slug}/?utm_source=share&utm_medium=user`;
			const text = `${title}${salary ? ' · ' + salary : ''}`;
			const action = shareOption.dataset.shareTarget;

			if (action === 'telegram') {
				const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`;
				window.open(tgUrl, '_blank', 'noopener,noreferrer');
			} else if (action === 'whatsapp') {
				const waUrl = `https://wa.me/?text=${encodeURIComponent(text + '\n' + url)}`;
				window.open(waUrl, '_blank', 'noopener,noreferrer');
			} else if (action === 'vk') {
				const vkUrl = `https://vk.com/share.php?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}&description=${encodeURIComponent(salary)}`;
				window.open(vkUrl, '_blank', 'noopener,noreferrer');
			} else if (action === 'copy') {
				if (navigator.clipboard?.writeText) {
					navigator.clipboard.writeText(url).then(() => {
						// Optional: brief inline feedback via the option label.
						const orig = shareOption.innerHTML;
						shareOption.innerHTML = '<span class="share-option-icon" aria-hidden="true">✓</span> Ссылка скопирована';
						setTimeout(() => { shareOption.innerHTML = orig; }, 1500);
					}).catch(() => {});
				}
			}

			// Close dropdown + emit analytics.
			const dropdown = wrap?.querySelector('.share-dropdown') as HTMLElement | null;
			if (action !== 'copy' && dropdown) {
				dropdown.setAttribute('hidden', '');
				trigger?.setAttribute('aria-expanded', 'false');
			}
			if (typeof (window as any).gtag === 'function') {
				(window as any).gtag('event', 'share_vacancy', { vacancy_slug: slug, method: action });
			}
			return;
		}

		// Click outside any open share-dropdown — close all.
		if (!target.closest('.share-wrap')) {
			document.querySelectorAll('.share-dropdown:not([hidden])').forEach((d) => {
				d.setAttribute('hidden', '');
				const wrap = (d.parentElement as HTMLElement | null);
				const trigger = wrap?.querySelector('[data-share-vacancy]') as HTMLElement | null;
				trigger?.setAttribute('aria-expanded', 'false');
			});
		}
	}, true);

	// Close share dropdown on Escape.
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		document.querySelectorAll('.share-dropdown:not([hidden])').forEach((d) => {
			d.setAttribute('hidden', '');
			const trigger = d.parentElement?.querySelector('[data-share-vacancy]') as HTMLElement | null;
			trigger?.setAttribute('aria-expanded', 'false');
		});
	});
</script>
