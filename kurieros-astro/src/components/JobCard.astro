---
const { job, isInCompare = false } = Astro.props;
const applyHref = job.applyLink && job.applyLink !== '#' ? job.applyLink : `/v/${job.slug}/`;
const applyExternal = job.applyLink && job.applyLink !== '#';
---

<div class="job-card" data-tags={job.tags.join(',')} data-location={job.location}>
	{job.isHot && <div class="hot-badge">🔥 ТОП</div>}
	<div class="job-row-main">
		<div class="company-logo">
			<img src={job.companyLogo} alt={`${job.company} logo`} width="48" height="48" loading="lazy" decoding="async" />
		</div>
		<div class="job-content">
			<div class="job-heading">
				<div>
					<a href={`/v/${job.slug}/`} class="job-title" data-t={`vacancies.${job.id}.title`}>{job.title}</a>
					<div class="company-name" data-t={`vacancies.${job.id}.company`}>{job.company}</div>
					{job.shortDescription && <p class="job-short-desc" data-t={`vacancies.${job.id}.shortDescription`}>{job.shortDescription}</p>}
				</div>
				<div class="salary-tag" data-t={`vacancies.${job.id}.salary`}>{job.salary}</div>
			</div>
			<div class="job-meta">
				<div class="location">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<span data-t={`vacancies.${job.id}.location`}>{job.location}</span>
				</div>
				<div class="tags">
					{job.labels.map((label: string, i: number) => (
						<span class="tag" data-t={`vacancies.${job.id}.label_${i}`}>{label}</span>
					))}
				</div>
			</div>
			<div class="job-columns">
				<div class="job-column">
					<span class="job-column-label" data-t="job.salary">Зарплата</span>
					<strong data-t={`vacancies.${job.id}.salary`}>{job.salary}</strong>
				</div>
				<div class="job-column">
					<span class="job-column-label" data-t="job.schedule">График</span>
					<strong data-t={`vacancies.${job.id}.details_schedule`}>{job.details.schedule}</strong>
				</div>
				<div class="job-column">
					<span class="job-column-label" data-t="job.education">Образование</span>
					<strong data-t={`vacancies.${job.id}.details_education`}>{job.details.education}</strong>
				</div>
				<div class="job-column">
					<span class="job-column-label" data-t="job.experience">Опыт</span>
					<strong>{job.labels.includes('Без опыта') ? <span data-t="job.no_experience">Без опыта</span> : <span data-t="job.see_vacancy">См. вакансию</span>}</strong>
				</div>
			</div>
		</div>
	</div>
	<div class="job-row-actions">
		<div class="job-actions">
			<button class={`btn-compare ${isInCompare ? 'active' : ''}`} data-id={job.id} type="button">
				{isInCompare ? <><span data-t="job.in_compare">В сравнении</span> ✓</> : <span data-t="job.compare">+ Сравнить</span>}
			</button>
			<a href={applyHref} class="apply-btn" target={applyExternal ? '_blank' : undefined} rel={applyExternal ? 'noopener noreferrer' : undefined} data-t="job.apply">Заполнить заявку</a>
		</div>
	</div>
</div>

<style>
	.job-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		box-shadow: var(--shadow-sm);
		transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
	}
	.job-card:hover {
		transform: translateY(-1px);
		border-color: var(--brand-400);
		box-shadow: var(--shadow-md);
	}

	.hot-badge {
		position: absolute;
		top: 10px;
		right: -6px;
		background: var(--accent-500);
		color: var(--ink-0);
		font-size: var(--fs-12);
		font-weight: 800;
		padding: 4px 10px;
		border-radius: var(--radius-sm) 0 0 var(--radius-sm);
		letter-spacing: 0.04em;
		box-shadow: var(--shadow-sm);
	}

	.job-row-main {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}
	.company-logo {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		background: var(--brand-50);
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.company-logo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.job-content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.job-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--space-3);
	}
	.job-title {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--fs-18);
		font-weight: 700;
		color: var(--ink-900);
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.job-title:hover,
	.job-title:focus-visible {
		color: var(--brand-700);
		outline: none;
	}
	.company-name {
		font-size: var(--fs-13);
		color: var(--ink-500);
		font-weight: 600;
		margin-top: 2px;
	}
	.job-short-desc {
		font-size: var(--fs-14);
		color: var(--ink-600);
		margin: 6px 0 0;
		line-height: var(--lh-14);
	}
	.salary-tag {
		flex-shrink: 0;
		background: var(--brand-50);
		color: var(--brand-700);
		font-size: var(--fs-14);
		font-weight: 700;
		padding: 6px 12px;
		border-radius: var(--radius-pill);
		white-space: nowrap;
	}

	.job-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	.location {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--ink-500);
		font-size: var(--fs-13);
	}
	.location svg {
		opacity: 0.8;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		font-size: var(--fs-12);
		font-weight: 600;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--ink-50);
		color: var(--ink-700);
		border: 1px solid var(--ink-200);
	}

	.job-columns {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px dashed var(--ink-200);
	}
	@media (max-width: 640px) {
		.job-columns {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.job-column {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.job-column-label {
		font-size: var(--fs-12);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-500);
		font-weight: 600;
	}
	.job-column strong {
		font-size: var(--fs-14);
		font-weight: 600;
		color: var(--ink-800);
	}

	.job-row-actions {
		display: flex;
		justify-content: flex-end;
	}
	.job-actions {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
	}
	.btn-compare,
	.apply-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 18px;
		border-radius: var(--radius-md);
		font-family: var(--font-main);
		font-weight: 700;
		font-size: var(--fs-14);
		cursor: pointer;
		text-decoration: none;
		transition: background var(--transition), color var(--transition), border-color var(--transition);
	}
	.btn-compare {
		background: var(--ink-0);
		color: var(--ink-700);
		border: 1px solid var(--ink-200);
	}
	.btn-compare:hover,
	.btn-compare:focus-visible {
		background: var(--ink-50);
		border-color: var(--ink-300);
		outline: none;
	}
	.btn-compare.active {
		background: var(--brand-50);
		border-color: var(--brand-300);
		color: var(--brand-700);
	}
	.apply-btn {
		background: var(--accent-500);
		color: var(--ink-0);
		border: none;
	}
	.apply-btn:hover {
		background: var(--accent-400);
	}
	.btn-compare:focus-visible,
	.apply-btn:focus-visible {
		box-shadow: var(--shadow-focus);
	}
</style>
