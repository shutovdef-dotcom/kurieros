---
import { ozonDataAttrs } from '../utils/ozonAttrs';
import { getApplyCta } from '../utils/applyCta';
import VacancyTKey from './VacancyTKey.astro';

const { job, isInCompare = false } = Astro.props;

// `applyLink: 'lead-form:<provider>'` is a magic marker (set in
// src/data/vacancies.ts) that swaps the external `<a>` CTA for an
// in-page modal opener. The `<provider>` segment is forwarded to
// `data-lead-form-type` and consumed by the matching modal component.
const isLeadFormApply = typeof job.applyLink === 'string' && job.applyLink.startsWith('lead-form:');
const leadFormType = isLeadFormApply ? job.applyLink.slice('lead-form:'.length) : null;

const applyHref = !isLeadFormApply && job.applyLink && job.applyLink !== '#'
	? job.applyLink
	: `/v/${job.slug}/`;
const applyExternal = !isLeadFormApply && job.applyLink && job.applyLink !== '#';

// Apply CTA — single source of truth in src/utils/applyCta.ts.
// Drift between the JobCard and detail-page copies of this computation
// directly hits GA4 `apply_click` value and visible button text, so the
// helper is the only place this lives. Audit ref: v2 H4.
const { salaryMaxNumeric, applyLabel } = getApplyCta(job);
const applyEmploymentText = job.details?.employment_type ?? '';
// QW13 demo — surface a prominent «Без опыта» badge.
// Trigger combines two signals so it actually fires on real data:
//   1) Explicit `'Без опыта'` in labels (currently dormant — no
//      vacancySource sets it, but kept for forward-compat).
//   2) `'16plus'` in tags — deterministic entry-level marker derived
//      in jobs.ts:`getAgeTag(ageFrom)` for vacancies that accept
//      16-year-olds (the truly low-barrier subset).
// The `data-no-experience` attr lets demo CSS key off only the
// vacancies that genuinely qualify.
const hasNoExperience = (Array.isArray(job.labels) && job.labels.includes('Без опыта'))
	|| (Array.isArray(job.tags) && job.tags.includes('16plus'));
---

<div
	class="job-card"
	data-id={job.id}
	data-slug={job.slug}
	data-vacancy-source-slug={job.sourceSlug}
	data-tags={job.tags.join(',')}
	data-location={job.location}
	data-no-experience={hasNoExperience ? 'true' : undefined}
>
	{job.isHot && <div class="hot-badge">🔥 ТОП</div>}
	<div class="job-row-main">
		<div class="company-logo">
			<img src={job.companyLogo} alt={`${job.company} logo`} width="48" height="48" loading="lazy" decoding="async" />
		</div>
		<div class="job-content">
			<div class="job-heading">
				{/* Use <VacancyTKey> for any new vacancies.* keys; co-emits proper data attribute */}
				<div>
					<VacancyTKey jobId={job.id} field="title" fallback={job.title} as="a" class="job-title" href={`/v/${job.slug}/`} />
					<VacancyTKey jobId={job.id} field="company" fallback={job.company} as="div" class="company-name" />
					{job.shortDescription && <VacancyTKey jobId={job.id} field="shortDescription" fallback={job.shortDescription} as="p" class="job-short-desc" />}
				</div>
				<VacancyTKey jobId={job.id} field="salary" fallback={job.salary} as="div" class="salary-tag" />
			</div>
		</div>
	</div>
	<div class="job-meta">
		<div class="location">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
				<circle cx="12" cy="10" r="3"></circle>
			</svg>
			<VacancyTKey jobId={job.id} field="location" fallback={job.location} />
		</div>
		<div class="tags">
			{job.labels.map((label: string, i: number) => (
				<VacancyTKey jobId={job.id} field={`label_${i}` as const} fallback={label} class="tag" />
			))}
		</div>
	</div>
	<div class="job-columns">
		<div class="job-column">
			<span class="job-column-label" data-t="job.salary">Зарплата</span>
			<VacancyTKey jobId={job.id} field="salary" fallback={job.salary} as="strong" />
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.schedule">График</span>
			<VacancyTKey jobId={job.id} field="details_schedule" fallback={job.details.schedule} as="strong" />
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.education">Образование</span>
			<VacancyTKey jobId={job.id} field="details_education" fallback={job.details.education} as="strong" />
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.experience">Опыт</span>
			{hasNoExperience ? (
				<span class="job-column-noexp" aria-label="Без опыта">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
					Без опыта
				</span>
			) : (
				<strong><span data-t="job.see_vacancy">См. вакансию</span></strong>
			)}
		</div>
	</div>
	<div class="job-row-actions">
		<div class="job-actions">
			<button class={`btn-compare ${isInCompare ? 'active' : ''}`} data-id={job.id} type="button">
				{isInCompare ? <><span data-t="job.in_compare">В сравнении</span> ✓</> : <span data-t="job.compare">+ Сравнить</span>}
			</button>
			{isLeadFormApply ? (
				<button
					type="button"
					class="apply-btn"
					data-apply-cta
					data-apply-position="grid_card"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={applyEmploymentText}
					data-apply-salary-max={salaryMaxNumeric || ''}
					data-lead-form-type={leadFormType}
					{...ozonDataAttrs(job.ozonLeadForm)}
				>{applyLabel}</button>
			) : (
				<a
					href={applyHref}
					class="apply-btn"
					target={applyExternal ? '_blank' : undefined}
					rel={applyExternal ? 'noopener noreferrer nofollow sponsored' : undefined}
					data-apply-cta
					data-apply-position="grid_card"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={applyEmploymentText}
					data-apply-salary-max={salaryMaxNumeric || ''}
				>{applyLabel}</a>
			)}
		</div>
	</div>
</div>

<style>
	.job-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		background: var(--ink-0);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		box-shadow: var(--shadow-sm);
		transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
	}
	.job-card:hover {
		transform: translateY(-1px);
		border-color: var(--brand-400);
		box-shadow: var(--shadow-md);
	}

	.hot-badge {
		position: absolute;
		top: 10px;
		right: -6px;
		background: var(--accent-500);
		color: var(--ink-0);
		font-size: var(--fs-12);
		font-weight: 800;
		padding: 4px 10px;
		border-radius: var(--radius-sm) 0 0 var(--radius-sm);
		letter-spacing: 0.04em;
		box-shadow: var(--shadow-sm);
	}

	/* QW13 — «Без опыта» green pill rendered inline inside the «Опыт»
	   column instead of a separate row, so entry-level vacancies don't
	   stretch the card vertically vs. the «См. вакансию» fallback. */
	.job-column-noexp {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		align-self: flex-start;
		padding: 4px 9px;
		background: #e8f6ec;
		color: #117a3a;
		border: 1px solid #b8e3c4;
		border-radius: var(--radius-pill);
		font-size: 12px;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.01em;
		max-width: 100%;
		white-space: nowrap;
	}
	.job-column-noexp svg {
		flex-shrink: 0;
		display: block;
	}
	:global(body.dark-mode) .job-column-noexp {
		background: rgba(46, 160, 67, 0.18);
		color: #67d086;
		border-color: rgba(46, 160, 67, 0.45);
	}

	.job-row-main {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}
	.company-logo {
		flex-shrink: 0;
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		background: var(--brand-50);
		display: grid;
		place-items: center;
		overflow: hidden;
		/* Inner padding so wide-aspect logos like Купер (420×264) keep
		   a visible margin around the artwork inside the 48×48 frame. */
		padding: 4px;
	}
	.company-logo img {
		width: 100%;
		height: 100%;
		/* `contain` preserves the full logo regardless of aspect ratio.
		   `cover` was cropping wide rectangular logos (e.g. Купер) to a
		   centre slice, leaving only the swirl icon visible. */
		object-fit: contain;
	}

	.job-content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.job-heading {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--space-3);
	}
	.job-title {
		display: block;
		font-family: var(--font-heading);
		font-size: var(--fs-18);
		font-weight: 700;
		color: var(--ink-900);
		line-height: 1.3;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.job-title:hover,
	.job-title:focus-visible {
		color: var(--brand-700);
		outline: none;
	}
	.company-name {
		font-size: var(--fs-13);
		color: var(--ink-500);
		font-weight: 600;
		margin-top: 2px;
	}
	.job-short-desc {
		font-size: var(--fs-14);
		color: var(--ink-600);
		margin: 6px 0 0;
		line-height: var(--lh-14);
	}
	.salary-tag {
		flex-shrink: 0;
		background: var(--brand-50);
		color: var(--brand-700);
		font-size: var(--fs-14);
		font-weight: 700;
		padding: 6px 12px;
		border-radius: var(--radius-pill);
		white-space: nowrap;
	}

	.job-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px;
	}
	.location {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--ink-500);
		font-size: var(--fs-13);
	}
	.location svg {
		opacity: 0.8;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		font-size: var(--fs-12);
		font-weight: 600;
		padding: 4px 10px;
		border-radius: var(--radius-pill);
		background: var(--ink-100);
		color: var(--ink-700);
	}

	.job-columns {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
		padding-top: var(--space-3);
		border-top: 1px dashed var(--ink-200);
	}
	@media (max-width: 480px) {
		/* Очень узкий моб — 4 колонки физически не помещаются. */
		.job-columns {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: var(--space-3);
		}
	}
	.job-column {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		padding: 0 4px;
		/* Вертикальный пунктир в стиле горизонтального dashed-разделителя
		   между описанием и колонками. На первой колонке каждой
		   логической строки убирается. */
		border-left: 1px dashed var(--ink-200);
	}
	.job-column:first-child {
		padding-left: 0;
		border-left: none;
	}
	@media (max-width: 480px) {
		.job-column:nth-child(2n+1) {
			padding-left: 0;
			border-left: none;
		}
		.job-column:nth-child(2n) {
			padding-left: 4px;
			border-left: 1px dashed var(--ink-200);
		}
	}
	.job-column-label {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--ink-500);
		font-weight: 600;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}
	.job-column strong {
		font-size: var(--fs-13);
		font-weight: 600;
		color: var(--ink-800);
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.job-row-actions {
		display: flex;
	}
	.job-actions {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: 100%;
	}
	.btn-compare,
	.apply-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 44px;
		padding: 0 18px;
		border-radius: var(--radius-md);
		font-family: var(--font-main);
		font-weight: 700;
		font-size: var(--fs-14);
		cursor: pointer;
		text-decoration: none;
		transition: background var(--transition), color var(--transition), border-color var(--transition);
	}
	.btn-compare {
		background: var(--ink-0);
		color: var(--ink-700);
		border: 1px solid var(--ink-200);
	}
	.btn-compare:hover,
	.btn-compare:focus-visible {
		background: var(--ink-50);
		border-color: var(--ink-300);
		outline: none;
	}
	.btn-compare.active {
		background: var(--brand-50);
		border-color: var(--brand-300);
		color: var(--brand-700);
	}
	.apply-btn {
		background: var(--accent-600);
		color: var(--ink-0);
		border: none;
	}
	.apply-btn:hover {
		background: var(--accent-500);
	}
	.btn-compare:focus-visible,
	.apply-btn:focus-visible {
		box-shadow: var(--shadow-focus);
	}

	/* HV9 — Viewed-vacancy marker.
	   Inline-маркер сразу после названия компании («Яндекс Еда · просмотрено»).
	   Pseudo-element `::after` на `.company-name` не вступает в конфликт с
	   i18n-логикой BaseLayout (`textContent = ...`), потому что generated
	   content псевдо-элементов не входит в textContent. */
	.job-card.viewed {
		opacity: 0.78;
		transition: opacity 0.2s ease;
	}
	.job-card.viewed:hover {
		opacity: 1;
	}
	.job-card.viewed .company-name::after {
		content: " · просмотрено";
		font-size: var(--fs-12);
		font-weight: 500;
		color: var(--ink-500);
		letter-spacing: 0.01em;
	}
	:global(body.dark-mode) .job-card.viewed .company-name::after {
		color: var(--ink-400, rgba(231, 234, 240, 0.55));
	}

	/* HV11 — Compact JobCard on mobile.
	   Сжимаем padding/gap/heights чтобы 3 карточки помещались выше fold
	   на iPhone 12 mini (375×812). Все интерактивные элементы остаются
	   ≥40px (WCAG 2.5.5 minimum). */
	@media (max-width: 768px) {
		.job-card {
			gap: var(--space-3);
			padding: var(--space-4);
		}
		.job-row-main {
			gap: 10px;
		}
		.company-logo {
			width: 40px;
			height: 40px;
		}
		.job-title {
			font-size: var(--fs-16);
			line-height: 1.25;
		}
		.salary-tag {
			font-size: var(--fs-13);
			padding: 4px 10px;
		}
		.job-columns {
			padding-top: var(--space-2);
		}
		.btn-compare,
		.apply-btn {
			height: 40px;
			padding: 0 14px;
		}
	}
</style>

<script>
	// HV9 + HV19 — viewed-vacancy marker + share button.
	// Hoisted script (no `is:inline`) — Astro дедуплицирует и инжектит
	// один раз на страницу, даже если JobCard рендерится N раз.

	const VIEWED_KEY = 'kurieros:viewed-vacancies';
	const MAX_VIEWED = 200; // cap localStorage usage

	function readViewed(): Set<string> {
		try {
			const raw = localStorage.getItem(VIEWED_KEY);
			if (!raw) return new Set();
			const arr = JSON.parse(raw);
			return new Set(Array.isArray(arr) ? arr.map(String) : []);
		} catch {
			return new Set();
		}
	}

	function persistViewed(set: Set<string>) {
		try {
			const arr = Array.from(set).slice(-MAX_VIEWED);
			localStorage.setItem(VIEWED_KEY, JSON.stringify(arr));
		} catch {
			/* private mode / quota — silently skip */
		}
	}

	function markViewedCards() {
		const viewed = readViewed();
		if (viewed.size === 0) return;
		document.querySelectorAll<HTMLElement>('.job-card[data-id]').forEach((card) => {
			const id = card.dataset.id;
			if (id && viewed.has(id)) card.classList.add('viewed');
		});
	}

	// Initial mark + re-mark after city-swap / reveal-more (grid swaps innerHTML).
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', markViewedCards, { once: true });
	} else {
		markViewedCards();
	}
	window.addEventListener('kurieros:city-selected', () => setTimeout(markViewedCards, 100));
	window.addEventListener('kurieros:reveal-more-jobs', markViewedCards);

	// Click delegation: capture clicks on `.job-card .job-title` and persist.
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const titleLink = target.closest('.job-card .job-title');
		if (titleLink) {
			const card = titleLink.closest<HTMLElement>('.job-card[data-id]');
			const id = card?.dataset.id;
			if (id) {
				const viewed = readViewed();
				viewed.add(id);
				persistViewed(viewed);
				card.classList.add('viewed');
			}
			return;
		}

	}, true);
</script>
