---
import { ozonDataAttrs } from '../utils/ozonAttrs';
import { getApplyCta } from '../utils/applyCta';
import { getApplyHref, getApplyPartnerDomain, isExternalApplyLink } from '../utils/applyRoute';
import { getLeadFormEligibility } from '../utils/leadFormEligibility';
import { getVacancyDetailPath } from '../utils/vacancyUrl';
import type { JobCardViewModel } from '../utils/jobCardViewModel';
import VacancyTKey from './VacancyTKey.astro';

interface Props {
	job: JobCardViewModel;
	isInCompare?: boolean;
}

const { job, isInCompare = false } = Astro.props as Props;
const isCargoPartnership = job.sourceSlug === 'yandex-delivery-cargo-driver';

// `applyLink: 'lead-form:<provider>'` is a magic marker (the constant
// `OZON_LEAD_APPLY` defined in src/data/partnerLinks.ts, wired onto
// offers in src/data/ozonOffers.ts) that swaps the external `<a>` CTA
// for an in-page modal opener. The `<provider>` segment is forwarded to
// `data-lead-form-type` and consumed by the matching modal component.
const isLeadFormMarker = typeof job.applyLink === 'string' && job.applyLink.startsWith('lead-form:');
const leadFormEligibility = isLeadFormMarker ? getLeadFormEligibility(job) : null;
const isLeadFormApply = leadFormEligibility?.eligible === true;
const isLeadFormUnavailable = isLeadFormMarker && !isLeadFormApply;
const leadFormType = isLeadFormApply ? job.applyLink.slice('lead-form:'.length) : null;
const detailHref = getVacancyDetailPath(job);

const applyHref = getApplyHref(job, detailHref);
const applyExternal = !isLeadFormApply && isExternalApplyLink(applyHref);
const applyPartnerDomain = getApplyPartnerDomain(job);

// Apply CTA — single source of truth in src/utils/applyCta.ts.
// Drift between the JobCard and detail-page copies of this computation
// directly hits GA4 `apply_click` value and visible button text, so the
// helper is the only place this lives. Audit ref: v2 H4.
const { salaryMaxNumeric, applyLabel } = getApplyCta(job);
const applyEmploymentText = job.details?.employment_type ?? '';
// Surface a prominent «Без опыта» badge on entry-level vacancies.
// Trigger combines two signals so it fires on real data:
//   1) Explicit `'Без опыта'` in labels — DORMANT: no vacancySource
//      currently emits this label. Kept as a forward-compat hook in
//      case a partner adds it; remove if it stays unused long-term.
//   2) `'16plus'` in tags — the ACTIVE trigger: a deterministic
//      entry-level marker derived in jobs.ts:`getAgeTag(ageFrom)` for
//      vacancies that accept 16-year-olds (the truly low-barrier
//      subset). This is what actually drives the badge in production.
// The `data-no-experience` attr lets the CSS below key off only the
// vacancies that genuinely qualify.
const hasNoExperience = (Array.isArray(job.labels) && job.labels.includes('Без опыта'))
	|| (Array.isArray(job.tags) && job.tags.includes('16plus'));
const searchText = [
	job.title,
	job.company,
	job.location,
	job.salary,
	job.details?.payment_freq,
].filter(Boolean).join(' ');
---

<div
	class="job-card"
	data-id={job.id}
	data-slug={job.slug}
	data-vacancy-source-slug={job.sourceSlug}
	data-tags={job.tags.join(',')}
	data-location={job.location}
	data-search-text={searchText}
	data-no-experience={hasNoExperience ? 'true' : undefined}
>
	{job.isHot && <div class="hot-badge">ТОП</div>}
	<div class="job-row-main">
		<div class="company-logo">
			<img src={job.companyLogo} alt={`${job.company} logo`} width="48" height="48" loading="lazy" decoding="async" />
		</div>
		<div class="job-content">
			<div class="job-heading">
				{/* Use <VacancyTKey> for any new vacancies.* keys; co-emits proper data attribute */}
				<div>
					<VacancyTKey jobId={job.id} field="title" fallback={job.title} as="a" class="job-title" href={detailHref} />
					<VacancyTKey jobId={job.id} field="company" fallback={job.company} as="div" class="company-name" />
					{job.shortDescription && <VacancyTKey jobId={job.id} field="shortDescription" fallback={job.shortDescription} as="p" class="job-short-desc" />}
				</div>
				<VacancyTKey jobId={job.id} field="salary" fallback={job.salary} as="div" class="salary-tag" />
			</div>
		</div>
	</div>
	<div class="job-meta">
		<div class="location">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
				<circle cx="12" cy="10" r="3"></circle>
			</svg>
			<VacancyTKey jobId={job.id} field="location" fallback={job.location} />
		</div>
		<div class="tags">
			{job.labels.map((label: string, i: number) => (
				<VacancyTKey jobId={job.id} field={`label_${i}` as const} fallback={label} class="tag" />
			))}
		</div>
	</div>
	<div class="job-columns">
		<div class="job-column">
			<span class="job-column-label" data-t="job.salary">Доход</span>
			<VacancyTKey jobId={job.id} field="salary" fallback={job.salary} as="strong" />
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t={isCargoPartnership ? undefined : 'job.schedule'}>{isCargoPartnership ? 'Расписание' : 'График'}</span>
			<VacancyTKey jobId={job.id} field="details_schedule" fallback={job.details.schedule} as="strong" />
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.education">Образование</span>
			<VacancyTKey jobId={job.id} field="details_education" fallback={job.details.education} as="strong" />
		</div>
		<div class="job-column">
			<span class="job-column-label" data-t="job.experience">Опыт</span>
			{hasNoExperience ? (
				<span class="job-column-noexp">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
					Без опыта
				</span>
			) : (
				<strong><span data-t="job.see_vacancy">См. вакансию</span></strong>
			)}
		</div>
	</div>
	<div class="job-row-actions">
		<div class="job-actions">
			<button class={`btn-compare ${isInCompare ? 'active' : ''}`} data-id={job.id} type="button">
				{isInCompare ? <><span data-t="job.in_compare">В сравнении</span> ✓</> : <span data-t="job.compare">+ Сравнить</span>}
			</button>
			{isLeadFormUnavailable ? (
				<span class="apply-btn apply-btn-unavailable" aria-disabled="true">
					Отклик временно недоступен
				</span>
			) : isLeadFormApply ? (
				<button
					type="button"
					class="apply-btn"
					data-apply-cta
					data-apply-position="grid_card"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={applyEmploymentText}
					data-apply-salary-max={salaryMaxNumeric || ''}
					data-apply-vacancy-id={job.id}
					data-apply-vacancy-slug={job.slug}
					data-apply-source-slug={job.sourceSlug}
					data-lead-form-type={leadFormType}
					{...ozonDataAttrs(job.ozonLeadForm)}
				>{applyLabel}</button>
			) : (
				<a
					href={applyHref}
					class="apply-btn"
					target={applyExternal ? '_blank' : undefined}
					rel={applyExternal ? 'noopener noreferrer nofollow sponsored' : undefined}
					data-apply-cta
					data-apply-position="grid_card"
					data-apply-company={job.company}
					data-apply-city={job.location}
					data-apply-transport={job.transport}
					data-apply-employment={applyEmploymentText}
					data-apply-salary-max={salaryMaxNumeric || ''}
					data-apply-vacancy-id={job.id}
					data-apply-vacancy-slug={job.slug}
					data-apply-source-slug={job.sourceSlug}
					data-apply-partner-domain={applyPartnerDomain}
				>{applyLabel}</a>
			)}
		</div>
	</div>
</div>

<style>
  .job-card {
    position: relative; display: grid; container-type: normal;
    grid-template-columns: 38px minmax(0,1fr) 270px;
    grid-template-areas: "logo company pay" "logo location pay" "title title pay" "description description actions" "tags tags actions" "columns columns actions";
    gap: 4px 12px; padding: 26px 0; border: 0; border-bottom: 1px solid var(--ink-200); border-radius: 0;
    background: var(--ink-0); box-shadow: none; overflow: visible; align-items: start;
  }
  .job-card:hover { transform: none; box-shadow: none; border-color: var(--ink-200); }
  .job-card::before { content: none; }
  .job-row-main, .job-content, .job-heading, .job-heading > div:not(.salary-tag), .job-meta, .job-row-actions { display: contents; }
  .company-logo { grid-area: logo; width: 38px; height: 38px; padding: 3px; background: #fff; border-radius: 5px; overflow: hidden; box-shadow: none; }
  .company-logo img { width: 100%; height: 100%; object-fit: contain; background: #fff; border-radius: 0; }
  .job-card :global(.company-name) { grid-area: company; color: var(--ink-700); font-size: 13px; line-height: 1.5; font-weight: 500; margin: 0; padding-right: 45px; }
  .location { grid-area: location; display: flex; align-items: center; gap: 6px; color: var(--ink-500); font-size: 12px; line-height: 1.5; }
  .location svg { display: none; }
  .job-card :global(.job-title) { grid-area: title; display: block; color: var(--ink-700); font-size: 22px; font-weight: 600; line-height: 1.3; letter-spacing: -.03em; text-decoration: none; margin: 14px 0 0; overflow-wrap: anywhere; }
  .job-card :global(.job-title:hover) { color: var(--brand-500); }
  .job-card :global(.salary-tag) { grid-area: pay; align-self: start; justify-self: end; margin: 5px 0 0; padding: 0; background: none; border: 0; border-radius: 0; color: var(--ink-700); font-size: 24px; font-weight: 600; letter-spacing: -.035em; line-height: 1.25; text-align: right; white-space: normal; max-width: 100%; }
  .job-card :global(.job-short-desc) { grid-area: description; color: var(--ink-500); font-size: 13px; line-height: 1.6; margin: 10px 0 0; display: block; -webkit-line-clamp: unset; line-clamp: unset; overflow: visible; }
  .tags { grid-area: tags; display: flex; flex-wrap: wrap; gap: 4px 8px; margin-top: 12px; }
  .job-card :global(.tag) { color: var(--ink-500); font-size: 12px; font-weight: 400; line-height: 1.5; background: transparent; border: 0; border-radius: 0; padding: 0; }
  .job-card :global(.tag + .tag)::before { content: '·'; margin-right: 8px; color: var(--ink-400); }
  .job-columns { grid-area: columns; display: grid; grid-template-columns: 1.5fr 1fr .7fr; gap: 12px; border: 0; padding: 0; margin-top: 12px; }
  .job-column { display: flex; flex-direction: column; gap: 3px; min-width: 0; border: 0; padding: 0; }
  .job-column:first-child { display: none; }
  .job-column-label { color: var(--ink-500); font-size: 11px; font-weight: 400; line-height: 1.5; text-transform: none; letter-spacing: 0; }
  .job-column :global(strong), .job-column-noexp { color: var(--ink-700); font-size: 12px; font-weight: 400; line-height: 1.5; overflow-wrap: anywhere; }
  .job-column-noexp { border: 0; background: transparent; padding: 0; }
  .job-column-noexp svg { display: none; }
  .hot-badge { grid-area: company; position: static; transform: none; justify-self: end; align-self: center; color: var(--brand-500); background: transparent; border: 0; border-radius: 0; box-shadow: none; padding: 0; font-size: 11px; font-weight: 500; letter-spacing: 0; }
  .job-actions { grid-area: actions; display: flex; flex-direction: column; align-items: flex-end; width: 100%; gap: 6px; margin: 8px 0 0; }
  .btn-compare, .apply-btn { display: inline-flex; justify-content: center; align-items: center; min-height: 44px; height: auto; max-width: 100%; padding: 11px 16px; text-decoration: none; font: inherit; font-size: 13px; font-weight: 500; border-radius: 3px; box-shadow: none; text-align: center; line-height: 1.4; cursor: pointer; }
  .apply-btn { order: 0; background: var(--action-blue); color: var(--action-on-blue); border: 1px solid var(--action-blue); }
  .btn-compare { order: 1; width: auto; flex: none; color: var(--ink-500); background: transparent; border: 0; padding: 8px 0; font-size: 12px; font-weight: 400; }
  .btn-compare:hover { color: var(--brand-500); background: transparent; }
  .btn-compare.active { color: var(--brand-500); background: transparent; font-weight: 500; }
  .apply-btn-unavailable { background: var(--ink-50); color: var(--ink-500); border-color: var(--ink-200); cursor: not-allowed; }
  .job-card.viewed { opacity: .78; transition: opacity .2s ease; }
  .job-card.viewed:hover { opacity: 1; }
  .job-card.viewed :global(.company-name)::after { content: " · просмотрено"; font-size: 12px; font-weight: 400; color: var(--ink-500); }
  @media (max-width:768px) {
    .job-card { grid-template-columns: 36px minmax(0,1fr); grid-template-areas: "logo company" "logo location" "title title" "pay pay" "description description" "actions actions" "tags tags" "columns columns"; gap: 4px 10px; padding: 22px 0 24px; }
    .company-logo { width: 36px; height: 36px; }
    .job-card :global(.job-title) { margin-top: 13px; font-size: 22px; }
    .job-card :global(.salary-tag) { justify-self: start; text-align: left; margin-top: 12px; font-size: 24px; }
    .job-card :global(.job-short-desc) { margin-top: 12px; }
    .job-actions { flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-items: center; gap: 8px 18px; margin-top: 14px; }
    .apply-btn { order: 0; padding: 11px 14px; font-size: 13px; }
    .btn-compare { order: 1; }
    .job-columns { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px 16px; }
    .job-column:nth-child(2) { grid-column: 1/-1; }
    .tags { margin-top: 14px; }
  }
  @media (max-width:359px) { .job-card :global(.job-title) { font-size: 21px; } .job-card :global(.salary-tag) { font-size: 22px; } }
</style>

<script>
	// HV9 + HV19 — viewed-vacancy marker + share button.
	// Hoisted script (no `is:inline`) — Astro дедуплицирует и инжектит
	// один раз на страницу, даже если JobCard рендерится N раз.

	const VIEWED_KEY = 'kurieros:viewed-vacancies';
	const MAX_VIEWED = 200; // cap localStorage usage

	function readViewed(): Set<string> {
		try {
			const raw = localStorage.getItem(VIEWED_KEY);
			if (!raw) return new Set();
			const arr = JSON.parse(raw);
			return new Set(Array.isArray(arr) ? arr.map(String) : []);
		} catch {
			return new Set();
		}
	}

	function persistViewed(set: Set<string>) {
		try {
			const arr = Array.from(set).slice(-MAX_VIEWED);
			localStorage.setItem(VIEWED_KEY, JSON.stringify(arr));
		} catch {
			/* private mode / quota — silently skip */
		}
	}

	function markViewedCards() {
		const viewed = readViewed();
		if (viewed.size === 0) return;
		document.querySelectorAll<HTMLElement>('.job-card[data-id]').forEach((card) => {
			const id = card.dataset.id;
			if (id && viewed.has(id)) card.classList.add('viewed');
		});
	}

	// Initial mark + re-mark after city-swap / reveal-more (grid swaps innerHTML).
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', markViewedCards, { once: true });
	} else {
		markViewedCards();
	}
	window.addEventListener('kurieros:city-selected', () => setTimeout(markViewedCards, 100));
	window.addEventListener('kurieros:reveal-more-jobs', markViewedCards);

	// Click delegation: capture clicks on `.job-card .job-title` and persist.
	document.addEventListener('click', (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;

		const titleLink = target.closest('.job-card .job-title');
		if (titleLink) {
			const card = titleLink.closest<HTMLElement>('.job-card[data-id]');
			const id = card?.dataset.id;
			if (id) {
				const viewed = readViewed();
				viewed.add(id);
				persistViewed(viewed);
				card.classList.add('viewed');
			}
			return;
		}

	}, true);
</script>
