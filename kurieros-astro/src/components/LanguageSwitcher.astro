---
import { SUPPORTED_LANGUAGES, type SupportedLanguage } from '../data/translations';
import languageSwitcherUrl from '../scripts/languageSwitcher.js?url';

const languageNames: Record<SupportedLanguage, { name: string; flag: string }> = {
    ru: { name: 'Русский', flag: '🇷🇺' },
    uz: { name: "O'zbek", flag: '🇺🇿' },
    tg: { name: 'Тоҷикӣ', flag: '🇹🇯' },
    ky: { name: 'Кыргызча', flag: '🇰🇬' },
    hy: { name: 'Հայերեն', flag: '🇦🇲' },
    kk: { name: 'Қазақ', flag: '🇰🇿' },
    az: { name: 'Azərbaycan', flag: '🇦🇿' },
    uk: { name: 'Українська', flag: '🇺🇦' },
    be: { name: 'Беларуская', flag: '🇧🇾' },
    hi: { name: 'हिन्दी', flag: '🇮🇳' },
    vi: { name: 'Tiếng Việt', flag: '🇻🇳' },
    zh: { name: '中文', flag: '🇨🇳' },
};

const languages = SUPPORTED_LANGUAGES.map((code) => ({
    code,
    ...languageNames[code],
}));

---

<div class="lang-switcher" data-lang-switcher>
    <button
        class="lang-toggle"
        data-lang-toggle
        type="button"
        aria-haspopup="true"
        aria-expanded="false"
        aria-label="Сменить язык"
    >
        <span class="lang-flag" data-current-lang-flag aria-hidden="true">🇷🇺</span>
        <span class="lang-code" data-current-lang-code>RU</span>
        <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>

    <div class="lang-dropdown" data-lang-dropdown hidden>
        {languages.map((language) => (
            <button class="lang-option" data-lang-option data-lang={language.code} type="button">
                <span class="flag" aria-hidden="true">{language.flag}</span>
                <span class="name">{language.name}</span>
            </button>
        ))}
    </div>
</div>

<script is:inline type="module" src={languageSwitcherUrl}></script>

<style>
    .lang-switcher {
        position: relative;
        font-family: var(--font-main);
        line-height: 1;
    }

    .lang-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        min-width: 4.2rem;
        min-height: 2.35rem;
        padding: 0 0.7rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--glass-bg);
        color: var(--text-main);
        box-shadow: var(--shadow-sm);
        cursor: pointer;
        font-size: 0.86rem;
        font-weight: 800;
        transition: var(--transition);
    }

    .lang-toggle:hover,
    .lang-toggle:focus-visible {
        border-color: var(--primary-color);
        outline: none;
        transform: translateY(-1px);
    }

    .lang-code {
        letter-spacing: 0;
    }

    .lang-chevron {
        flex: 0 0 auto;
    }

    .lang-dropdown {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        z-index: 1100;
        display: flex;
        width: min(13rem, calc(100vw - 2rem));
        /* 100dvh tracks dynamic viewport so the dropdown doesn't overflow
           the visible area on iOS Chrome where the toolbar collapses on scroll */
        max-height: min(24rem, calc(100vh - 7rem));
        max-height: min(24rem, calc(100dvh - 7rem));
        flex-direction: column;
        gap: 0.15rem;
        overflow-y: auto;
        padding: 0.45rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--surface-color);
        box-shadow: var(--shadow-md);
    }

    .lang-dropdown[hidden] {
        display: none;
    }

    .lang-option {
        display: flex;
        width: 100%;
        align-items: center;
        gap: 0.7rem;
        padding: 0.65rem 0.7rem;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--text-main);
        cursor: pointer;
        font: inherit;
        text-align: left;
        transition: var(--transition);
    }

    .lang-option:hover,
    .lang-option:focus-visible,
    .lang-option.active {
        background: rgba(var(--brand-700-rgb), 0.12);
        color: var(--primary-color);
        outline: none;
    }

    .flag {
        font-size: 1.05rem;
    }

    :global(:where(html, body).dark-mode) .lang-toggle {
        background: var(--dm-green-surface);
        border-color: var(--dm-green-border);
        color: var(--dm-green-text);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.28);
    }

    :global(:where(html, body).dark-mode) .lang-toggle:hover,
    :global(:where(html, body).dark-mode) .lang-toggle:focus-visible {
        background: var(--dm-green-surface-hover);
        border-color: var(--dm-green-surface-hover);
    }

    :global(:where(html, body).dark-mode) .lang-dropdown {
        background: rgba(31, 74, 60, 0.96);
        border-color: rgba(114, 184, 157, 0.44);
        box-shadow: 0 14px 32px rgba(15, 23, 42, 0.34);
    }

    :global(:where(html, body).dark-mode) .lang-option {
        color: var(--dm-green-text);
    }

    :global(:where(html, body).dark-mode) .lang-option:hover,
    :global(:where(html, body).dark-mode) .lang-option:focus-visible,
    :global(:where(html, body).dark-mode) .lang-option.active {
        background: rgba(91, 170, 141, 0.24);
        color: var(--ink-800);
    }
</style>
