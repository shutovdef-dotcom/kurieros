---
/**
 * Z1.1 — per-city "рынок и заработок" content, embedded INTO the city hero
 * panel (see [slug].astro). Layout: a row of stat tiles, then the hero CTAs
 * (injected via the default <slot/>), then a two-column "shelf" — the
 * Купер/Yandex shift-rate table (or a vacancy-derived estimate) on the left,
 * nearest cities as link pills on the right. Chromeless: the hero panel
 * supplies the card background; this component only lays out the data.
 * Presentational only — [slug].astro does the data lookups.
 */
import { formatMoney, formatRussianPlural, getVacancyPluralText } from '../utils/format';
import { getCurrencyLabel } from '../utils/money';
import type { CurrencyCode } from '../data/vacancyTypes';
import type { SalaryRow } from '../utils/cityInsights';

interface Props {
	/** City population (0 → tile omitted). */
	population: number;
	/** Live vacancy count for the city. */
	vacancyCount: number;
	/** Distinct employer count. */
	companyCount: number;
	/** Max monthly salary across active vacancies (0 → income tile omitted). */
	maxSalary: number;
	/** Currency shared by active vacancies on this listing; null means mixed currencies. */
	maxSalaryCurrency: CurrencyCode | null;
	/** Auto-courier shift rate vs the national mean, in %; null when the source has no auto rate. */
	comparisonPct: number | null;
	/** Salary rows: Купер/Yandex shift roles, or a single vacancy-derived row. */
	salaryRows: SalaryRow[];
	/** Which source produced salaryRows — drives the caption text + tile layout. */
	rateSource: 'kuper' | 'yandex' | 'vacancies';
	/** Rate-source export date (YYYY-MM-DD); shown in the Купер/Yandex caption. */
	updatedAt: string;
	/** Nearest cities (that have pages) for internal linking; empty → column hidden. */
	neighbours: { slug: string; name: string; vacancyCount: number }[];
}

const {
	population,
	vacancyCount,
	companyCount,
	maxSalary,
	maxSalaryCurrency,
	comparisonPct,
	salaryRows,
	rateSource,
	updatedAt,
	neighbours,
} = Astro.props;

const ROLE_ICON: Record<string, string> = {
	Авто: '🚗',
	'Пеший / вело': '🚲',
	'Сборщик заказов': '📦',
};

/** Compact population label: «1,31 млн» / «57 тыс» / «8 400». */
function shortPopulation(n: number): string {
	if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(2).replace('.', ',')} млн`;
	if (n >= 100_000) return `${Math.round(n / 1000)} тыс`;
	return formatMoney(n);
}

const companiesWord = formatRussianPlural(companyCount, ['компании', 'компаний', 'компаний']);
const perShift = salaryRows[0]?.perShift ?? 0;
const salaryCurrency = maxSalaryCurrency ?? 'RUB';
const salaryCurrencyLabel = getCurrencyLabel(salaryCurrency);
const comparisonLabel =
	comparisonPct === null ? '' : `${comparisonPct >= 0 ? '+' : '−'}${Math.abs(comparisonPct)}%`;

// Купер and Yandex both yield a real per-role shift table + auto-vs-РФ
// comparison; only the vacancy-derived fallback uses the minimal pay tiles.
const showRateTable = rateSource !== 'vacancies';
---

<dl class="ci-stats">
	{population > 0 && (
		<div class="ci-stat">
			<dt class="ci-k">Население</dt>
			<dd class="ci-v">{shortPopulation(population)}</dd>
		</div>
	)}
	<div class="ci-stat">
		<dt class="ci-k">Вакансий</dt>
		<dd class="ci-v">{vacancyCount}</dd>
		<dd class="ci-u">от {companyCount}&nbsp;{companiesWord}</dd>
	</div>
	{showRateTable ? (
		<>
			{maxSalary > 0 && (
				<div class="ci-stat">
					<dt class="ci-k">Доход до</dt>
					<dd class="ci-v">{formatMoney(maxSalary)}</dd>
					<dd class="ci-u">{salaryCurrencyLabel}/мес</dd>
				</div>
			)}
			{comparisonPct !== null && (
				<div class="ci-stat">
					<dt class="ci-k">Авто-ставка</dt>
					<dd class="ci-v ci-v-accent">{comparisonLabel}</dd>
					<dd class="ci-u">к средней по РФ</dd>
				</div>
			)}
		</>
	) : (
		<>
			{perShift > 0 && (
				<div class="ci-stat">
					<dt class="ci-k">За смену</dt>
					<dd class="ci-v">≈ {formatMoney(perShift)}</dd>
					<dd class="ci-u">{salaryCurrencyLabel}</dd>
				</div>
			)}
			{maxSalary > 0 && (
				<div class="ci-stat">
					<dt class="ci-k">За месяц до</dt>
					<dd class="ci-v">{formatMoney(maxSalary)}</dd>
					<dd class="ci-u">{salaryCurrencyLabel}</dd>
				</div>
			)}
		</>
	)}
</dl>

<slot />

<div class="ci-shelf">
	<div class="ci-shelf-col">
		{showRateTable && salaryRows.length > 0 ? (
			<>
				<h2 class="ci-h3">Сколько платят за смену</h2>
				<div class="ci-table-wrap">
					<table class="ci-rates">
						<thead>
							<tr>
								<th scope="col">Формат</th>
								<th scope="col">За смену</th>
								<th scope="col">≈ в месяц</th>
							</tr>
						</thead>
						<tbody>
							{salaryRows.map((row) => (
								<tr>
									<td>{ROLE_ICON[row.label] ? `${ROLE_ICON[row.label]} ` : ''}{row.label}</td>
									<td>{formatMoney(row.perShift)}&nbsp;{salaryCurrencyLabel}</td>
									<td>≈&nbsp;{formatMoney(row.perMonth)}&nbsp;{salaryCurrencyLabel}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="ci-note">
					{rateSource === 'yandex' ? (
						<>Ставки Яндекс&nbsp;Еда (час&nbsp;×&nbsp;12&nbsp;ч&nbsp;смена); месяц — оценка при&nbsp;22&nbsp;сменах.</>
					) : (
						<>Ставки Купер за смену (до&nbsp;12&nbsp;ч); месяц — оценка при&nbsp;22&nbsp;сменах.</>
					)}
					{maxSalary > 0 && (
						<> Максимум по активным вакансиям — до&nbsp;{formatMoney(maxSalary)}&nbsp;{salaryCurrencyLabel}/мес.</>
					)}
					{' '}Данные обновлены: {updatedAt}.
				</p>
			</>
		) : (
			<>
				<h2 class="ci-h3">Оценка дохода</h2>
				<p class="ci-note">По&nbsp;активным вакансиям города; смена — оценка при&nbsp;22&nbsp;сменах.</p>
			</>
		)}
	</div>

	{neighbours.length > 0 && (
		<nav class="ci-shelf-col ci-nb" aria-label="Соседние города">
			<h2 class="ci-h3">Работа курьером в соседних городах</h2>
			<ul class="ci-nb-list">
				{neighbours.map((city) => (
					<li>
						<a class="ci-nb-link" href={`/rabota-kurerom-${city.slug}/`}>
							{city.name}
							<span class="ci-nb-cnt" title={`${city.vacancyCount} ${getVacancyPluralText(city.vacancyCount)}`}>{city.vacancyCount}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	)}
</div>

<style>
	/* ── Stat tiles (replace the generic hero fact-grid on city pages) ── */
	.ci-stats {
		margin: 0.9rem 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 0.6rem;
	}
	.ci-stat {
		display: grid;
		gap: 0.05rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--ink-200);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.85);
	}
	.ci-k {
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--ink-500);
	}
	.ci-v {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: 1.25rem;
		font-weight: 900;
		line-height: 1.1;
		color: var(--ink-900);
		font-variant-numeric: tabular-nums;
	}
	.ci-v-accent {
		color: var(--brand-700);
	}
	.ci-u {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--ink-500);
	}

	/* ── Shelf — two columns under the CTAs, split off by a divider ── */
	.ci-shelf {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 1.2rem 1.6rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--ink-200);
	}
	@media (max-width: 720px) {
		.ci-shelf {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
	.ci-shelf-col {
		min-width: 0;
	}
	.ci-h3 {
		margin: 0 0 0.5rem;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--brand-700);
	}
	.ci-table-wrap {
		overflow-x: auto;
	}
	.ci-rates {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}
	.ci-rates th,
	.ci-rates td {
		padding: 0.4rem 0.5rem;
		text-align: left;
		border-bottom: 1px solid var(--ink-200);
	}
	.ci-rates th {
		font-size: 0.64rem;
		font-weight: 800;
		text-transform: uppercase;
		color: var(--ink-500);
	}
	.ci-rates td:nth-child(2),
	.ci-rates td:nth-child(3),
	.ci-rates th:nth-child(2),
	.ci-rates th:nth-child(3) {
		text-align: right;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.ci-rates td:first-child {
		font-weight: 600;
		color: var(--ink-900);
	}
	.ci-rates tr:last-child td {
		border-bottom: none;
	}
	.ci-note {
		margin: 0.5rem 0 0;
		color: var(--ink-500);
		font-size: 0.75rem;
		line-height: 1.5;
	}

	/* ── Neighbours (link pills) ── */
	.ci-nb {
		display: block;
	}
	.ci-nb-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.ci-nb-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.4rem 0.7rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.8);
		border: 1px solid var(--ink-200);
		text-decoration: none;
		color: var(--ink-900);
		font-size: 0.84rem;
		font-weight: 600;
		transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
	}
	.ci-nb-link:hover,
	.ci-nb-link:focus-visible {
		border-color: var(--brand-700);
		background: var(--ink-0, #fff);
		transform: translateY(-1px);
		outline: none;
	}
	.ci-nb-cnt {
		font-size: 0.74rem;
		font-weight: 800;
		color: var(--brand-700);
		background: rgba(var(--brand-700-rgb), 0.12);
		border-radius: 999px;
		padding: 0.05rem 0.4rem;
	}

	/* ── Dark mode — embedded in the hero panel's dark variant ── */
	:global(:where(html, body).dark-mode) .ci-stat,
	:global(:where(html, body).dark-mode) .ci-nb-link {
		background: rgba(20, 32, 48, 0.6);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .ci-v,
	:global(:where(html, body).dark-mode) .ci-rates td:first-child {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .ci-v-accent,
	:global(:where(html, body).dark-mode) .ci-h3 {
		color: #4caf80;
	}
	:global(:where(html, body).dark-mode) .ci-shelf,
	:global(:where(html, body).dark-mode) .ci-rates th,
	:global(:where(html, body).dark-mode) .ci-rates td {
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .ci-k,
	:global(:where(html, body).dark-mode) .ci-u,
	:global(:where(html, body).dark-mode) .ci-note,
	:global(:where(html, body).dark-mode) .ci-rates th {
		color: rgba(231, 234, 240, 0.6);
	}
	:global(:where(html, body).dark-mode) .ci-nb-cnt {
		color: #4caf80;
		background: rgba(76, 175, 128, 0.16);
	}
</style>
