---
// Typed wrapper for emitting data-t="vacancies.<jobId>.<field>" attributes.
// Using this component documents the contract that any vacancy-translation
// key must be co-emitted with a data-vacancy-source-slug ancestor (see
// JobCard.astro and BaseLayout's i18n manager).
//
// `field` accepts the canonical static-name union plus indexed variants
// (`label_${n}`, `req_${n}`, `doc_${n}`, `ben_${n}`) used for repeated
// list items where the index is the array position.
type StaticField =
  | 'title' | 'company' | 'salary' | 'location' | 'shortDescription' | 'description'
  | 'updated_date'
  | 'details_schedule' | 'details_education' | 'details_payment_freq'
  | 'details_age' | 'details_rate'
  | 'details_employment_type';
type IndexedField =
  | `label_${number}` | `req_${number}` | `doc_${number}` | `ben_${number}`;
interface Props {
  jobId: number;
  field: StaticField | IndexedField;
  fallback: string;
  as?: 'span' | 'div' | 'p' | 'li' | 'a' | 'h1' | 'h2' | 'h3' | 'strong' | 'small';
  class?: string;
  href?: string;
}
const { jobId, field, fallback, as = 'span', class: className, href } = Astro.props as Props;
const Tag = (as ?? 'span') as keyof HTMLElementTagNameMap;
---
<Tag data-t={`vacancies.${jobId}.${field}`} class={className} href={href}>{fallback}</Tag>
