---
// Compare-page hero: breadcrumb, H1, subtitle, and the two action links
// ("To table" anchor + "Back to vacancies"). No props, no client-side state.
// Extracted from `src/pages/compare.astro` (audit finding H14).
---

<div class="compare-header">
  <div class="compare-header-copy">
    <nav class="compare-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Главная</a>
      <span>/</span>
      <span>Сравнение вакансий</span>
    </nav>
    <h1>Сравнение вакансий</h1>
    <p class="compare-subtitle">Сравните базовые условия, а потом открывайте только те карточки, которые действительно подходят.</p>
  </div>
  <div class="compare-header-actions">
    <a href="#compare-table" class="compare-table-link">К таблице</a>
    <a href="/" class="back-link">← К вакансиям</a>
  </div>
</div>

<style>
  .compare-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .compare-header-copy {
    display: grid;
    gap: 0.35rem;
  }

  .compare-header h1 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 0.35rem;
  }

  .compare-subtitle {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 52ch;
  }

  .compare-breadcrumb {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.8rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .compare-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .compare-breadcrumb a:hover {
    color: var(--primary-color);
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 1.05rem;
    transition: var(--transition);
  }

  .back-link:hover {
    color: var(--primary-color);
  }

  .compare-header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: flex-end;
  }

  .compare-table-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.7rem 1rem;
    border-radius: 8px;
    background: var(--brand-700);
    border: 1px solid var(--brand-700);
    color: var(--ink-0);
    text-decoration: none;
    font-weight: 800;
    transition: var(--transition);
  }

  .compare-table-link:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .compare-breadcrumb {
      display: none;
    }

    .compare-header {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .compare-header-actions {
      width: 100%;
      justify-content: flex-start;
    }
  }

  @media (max-width: 480px) {
    .compare-header {
      margin-bottom: 1rem;
    }
  }
</style>
