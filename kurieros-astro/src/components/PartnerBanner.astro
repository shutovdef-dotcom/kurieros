---
import { PARTNER_BANNER_DEFAULT_HREF } from '../data/partnerLinks';

interface Props {
	href?: string;
	imageSrc?: string;
	imageAlt?: string;
}

const {
	href = PARTNER_BANNER_DEFAULT_HREF,
	imageSrc = '/banners/masters-728x90.jpg',
	imageAlt = 'Ищем мастеров по ремонту: доход 200 000 ₽ в месяц',
} = Astro.props as Props;
---

<section class="partner-banner" aria-label="Партнерский баннер">
	<a class="partner-banner-link" href={href} target="_blank" rel="noopener noreferrer nofollow sponsored">
		<img
			src={imageSrc}
			alt={imageAlt}
			width="728"
			height="90"
			loading="lazy"
			decoding="async"
		/>
	</a>
</section>

<style>
	.partner-banner {
		max-width: 1180px;
		margin: 1.5rem auto 0;
		padding: 0 1rem;
	}
	.partner-banner-link {
		display: block;
		max-width: 728px;
		margin: 0 auto;
		line-height: 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-md);
		transition: transform var(--transition), box-shadow var(--transition);
	}
	.partner-banner-link:hover,
	.partner-banner-link:focus-visible {
		transform: translateY(-1px);
		box-shadow: var(--shadow-lg);
		outline: none;
	}
	.partner-banner-link:focus-visible {
		box-shadow: var(--shadow-lg), var(--shadow-focus);
	}
	.partner-banner-link img {
		display: block;
		width: 100%;
		height: auto;
	}
	@media (max-width: 768px) {
		.partner-banner {
			margin-top: 1rem;
			padding: 0 0.75rem;
		}
	}
</style>
