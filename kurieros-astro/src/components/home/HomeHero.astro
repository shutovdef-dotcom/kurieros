---
// Hero v2 — homepage above-the-fold panel.
// Extracted verbatim from src/pages/index.astro (W6-2 god-file split).
// Receives the topline counts so the same numbers stay consistent
// between the lead paragraph and the trustbar.
interface Props {
	totalVacancies: number;
	companiesCount: number;
	citiesCount: number;
	variant?: 'intro' | 'details';
}

const { totalVacancies, companiesCount, citiesCount, variant = 'intro' } = Astro.props;
---

{variant === 'intro' ? (
  <section class="hero-v2" aria-labelledby="hero-v2-title">
    <h1 id="hero-v2-title" class="hero-v2-title">
      <span class="hero-v2-title-main">Работа курьером</span>
      <span class="hero-v2-title-secondary">— найди свою смену. <span class="hero-v2-title-accent">Получи деньги уже&nbsp;завтра.</span></span>
    </h1>
  </section>
) : (
  <section class="home-service-info" aria-labelledby="home-service-title">
    <h2 id="home-service-title">Агрегатор вакансий</h2>
		<p class="hero-v2-lead">
			{totalVacancies}&nbsp;проверенных вакансий от&nbsp;{companiesCount}&nbsp;крупных компаний
			в&nbsp;{citiesCount}&nbsp;городах. Прозрачные выплаты, открытая статистика,
			выход на смену за&nbsp;1&nbsp;день.
		</p>
		<dl class="hero-v2-trustbar">
			<div class="hero-v2-trust-item">
				<dt class="hero-v2-trust-label">Вакансий</dt>
				<dd class="hero-v2-trust-num">{totalVacancies}</dd>
			</div>
			<div class="hero-v2-trust-item">
				<dt class="hero-v2-trust-label">Компаний</dt>
				<dd class="hero-v2-trust-num">{companiesCount}</dd>
			</div>
			<div class="hero-v2-trust-item">
				<dt class="hero-v2-trust-label">Городов</dt>
				<dd class="hero-v2-trust-num">{citiesCount}</dd>
			</div>
		</dl>		<ul class="hero-v2-features">
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">⚡</span>
				<strong class="hero-v2-feature-title">Старт за 1 день</strong>
				<span class="hero-v2-feature-text">Без долгих собеседований</span>
			</li>
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">💸</span>
				<strong class="hero-v2-feature-title">Прозрачные выплаты</strong>
				<span class="hero-v2-feature-text">Тариф за&nbsp;заказ открыт</span>
			</li>
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">🎯</span>
				<strong class="hero-v2-feature-title">Любой формат</strong>
				<span class="hero-v2-feature-text">Авто, вело, пеший, удалённо</span>
			</li>
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">🎓</span>
				<strong class="hero-v2-feature-title">С 16 лет</strong>
				<span class="hero-v2-feature-text">Без опыта и образования</span>
			</li>
		</ul>
		<div class="hero-v2-ctas">
			<a href="#jobs-grid" class="hero-v2-cta-primary" data-t="hero.cta_primary">
				Подобрать вакансию
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
			</a>
			<a href="/calculator/" class="hero-v2-cta-secondary" data-t="hero.cta_secondary">
				Калькулятор дохода
			</a>
		</div>

  </section>
)}

<style>
  .hero-v2 { padding: 34px 0 28px; background: transparent; border: 0; box-shadow: none; margin: 0; }
  .hero-v2-title { margin: 0; font-weight: 600; letter-spacing: -.03em; line-height: 1.2; color: var(--ink-700); }
  .hero-v2-title-main { display: block; font-size: 34px; }
  .hero-v2-title-secondary { display: block; margin-top: 9px; font-size: 16px; line-height: 1.5; font-weight: 400; letter-spacing: 0; color: var(--ink-500); }
  .home-service-info { border-top: 1px solid var(--ink-200); padding: 32px 0; margin-top: 28px; }
  .home-service-info h2 { font-size: 23px; line-height: 1.3; font-weight: 600; margin-bottom: 12px; }
  .hero-v2-lead { max-width: 720px; font-size: 15px; line-height: 1.6; color: var(--ink-500); }
  .hero-v2-trustbar { display: flex; flex-wrap: wrap; gap: 24px; margin: 20px 0; }
  .hero-v2-trust-item { display: flex; align-items: baseline; gap: 6px; }
  .hero-v2-trust-label { font-size: 13px; color: var(--ink-500); }
  .hero-v2-trust-num { margin: 0; font-size: 16px; font-weight: 600; color: var(--ink-700); }
  .hero-v2-features { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 24px; list-style: none; padding: 20px 0; margin: 0; border-block: 1px solid var(--ink-200); }
  .hero-v2-feature { display: flex; flex-direction: column; gap: 5px; }
  .hero-v2-feature-icon { display: none; }
  .hero-v2-feature-title { font-size: 14px; font-weight: 500; }
  .hero-v2-feature-text { font-size: 13px; line-height: 1.5; color: var(--ink-500); }
  .hero-v2-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; padding-top: 20px; }
  .hero-v2-cta-primary { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; text-decoration: none; font-size: 14px; }
  .hero-v2-cta-secondary { color: var(--brand-500); font-size: 14px; text-decoration: none; }
  .hero-v2-cta-secondary:hover { text-decoration: underline; }
  @media (max-width:768px) {
    .hero-v2 { padding: 24px 0; }
    .hero-v2-title-main { font-size: 28px; }
    .hero-v2-title-secondary { font-size: 14px; max-width: 36ch; margin-top: 8px; }
    .hero-v2-features { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
    .hero-v2-trustbar { gap: 14px; }
  }
  @media (max-width:359px) { .hero-v2-title-main { font-size: 26px; } }
</style>
