---
// Hero v2 — homepage above-the-fold panel.
// Extracted verbatim from src/pages/index.astro (W6-2 god-file split).
// Receives the topline counts so the same numbers stay consistent
// between the lead paragraph and the trustbar.
interface Props {
	totalVacancies: number;
	companiesCount: number;
	citiesCount: number;
}

const { totalVacancies, companiesCount, citiesCount } = Astro.props;
---

<section class="hero-v2" aria-labelledby="hero-v2-title">
	<div class="hero-v2-bg" aria-hidden="true"></div>
	<div class="hero-v2-inner">
		{/* AUDIT-OK (A3): «обновлено сегодня» — owner-stated commitment
		    matching the daily build cadence. Do not re-flag. */}
		<div class="hero-v2-eyebrow">
			<span class="hero-v2-live-dot" aria-hidden="true"></span>
			<span>Агрегатор курьерских вакансий · обновлено сегодня</span>
		</div>
		<h1 id="hero-v2-title" class="hero-v2-title">
			Найди свою смену.
			<span class="hero-v2-title-accent">Получи деньги уже&nbsp;завтра.</span>
		</h1>
		<p class="hero-v2-lead">
			{totalVacancies}&nbsp;проверенных вакансий от&nbsp;{companiesCount}&nbsp;крупных компаний
			в&nbsp;{citiesCount}&nbsp;городах. Прозрачные выплаты, открытая статистика,
			выход на смену за&nbsp;1&nbsp;день.
		</p>
		<ul class="hero-v2-features">
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">⚡</span>
				<strong class="hero-v2-feature-title">Старт за 1 день</strong>
				<span class="hero-v2-feature-text">Без долгих собеседований</span>
			</li>
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">💸</span>
				<strong class="hero-v2-feature-title">Прозрачные выплаты</strong>
				<span class="hero-v2-feature-text">Тариф за&nbsp;заказ открыт</span>
			</li>
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">🎯</span>
				<strong class="hero-v2-feature-title">Любой формат</strong>
				<span class="hero-v2-feature-text">Авто, вело, пеший, удалённо</span>
			</li>
			<li class="hero-v2-feature">
				<span class="hero-v2-feature-icon" aria-hidden="true">🎓</span>
				<strong class="hero-v2-feature-title">С 16 лет</strong>
				<span class="hero-v2-feature-text">Без опыта и образования</span>
			</li>
		</ul>
		<div class="hero-v2-ctas">
			<a href="#jobs-grid" class="hero-v2-cta-primary" data-t="hero.cta_primary">
				Подобрать вакансию
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
			</a>
			<a href="/calculator/" class="hero-v2-cta-secondary" data-t="hero.cta_secondary">
				Калькулятор дохода
			</a>
		</div>
		<dl class="hero-v2-trustbar">
			<div class="hero-v2-trust-item">
				<dt class="hero-v2-trust-label">Вакансий</dt>
				<dd class="hero-v2-trust-num">{totalVacancies}</dd>
			</div>
			<span class="hero-v2-trust-sep" aria-hidden="true">·</span>
			<div class="hero-v2-trust-item">
				<dt class="hero-v2-trust-label">Компаний</dt>
				<dd class="hero-v2-trust-num">{companiesCount}</dd>
			</div>
			<span class="hero-v2-trust-sep" aria-hidden="true">·</span>
			<div class="hero-v2-trust-item">
				<dt class="hero-v2-trust-label">Городов</dt>
				<dd class="hero-v2-trust-num">{citiesCount}</dd>
			</div>
		</dl>
	</div>
</section>

<style>
	/* === Hero v2 — fresh build === */
	.hero-v2 {
		position: relative;
		display: block;
		padding: clamp(1.6rem, 3.5vw, 3rem) clamp(1.25rem, 3vw, 2.25rem);
		margin: 0 0 var(--space-6, 1.5rem);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-xl, 20px);
		background: linear-gradient(135deg,
			rgba(232, 246, 230, 0.78) 0%,
			rgba(255, 255, 255, 0.95) 48%,
			rgba(232, 240, 246, 0.7) 100%
		);
		box-shadow: 0 14px 40px rgba(24, 45, 34, 0.06);
		overflow: hidden;
	}
	.hero-v2-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 88% 14%, rgba(46, 139, 87, 0.10) 0%, transparent 55%),
			radial-gradient(circle at 4% 92%, rgba(70, 130, 180, 0.08) 0%, transparent 50%);
	}
	.hero-v2-inner {
		position: relative;
		display: grid;
		gap: clamp(0.85rem, 1.6vw, 1.4rem);
		max-width: 920px;
	}
	.hero-v2-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.4rem 0.9rem;
		background: rgba(255, 255, 255, 0.85);
		border: 1px solid var(--ink-200);
		border-radius: 999px;
		font-family: var(--font-main);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-700);
		width: fit-content;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}
	.hero-v2-live-dot {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-success);
		box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
		animation: hero-v2-pulse 2s ease-out infinite;
	}
	@keyframes hero-v2-pulse {
		0%   { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
		70%  { box-shadow: 0 0 0 9px rgba(34, 197, 94, 0); }
		100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
	}
	.hero-v2-title {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 800;
		/* clamp lower-bound 1.55rem keeps the title compact on phones
		   (was 2.1rem → 33.6px → 4-line H1 that ate the whole viewport). */
		font-size: clamp(1.55rem, 5vw, 3.5rem);
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--ink-900);
		text-wrap: balance;
		max-width: 18ch;
	}
	.hero-v2-title-accent {
		display: inline-block;
		position: relative;
		color: var(--brand-700);
	}
	.hero-v2-title-accent::after {
		content: '';
		position: absolute;
		left: -0.05em;
		right: -0.05em;
		bottom: 0.07em;
		height: 0.22em;
		background: rgba(46, 139, 87, 0.18);
		border-radius: 4px;
		z-index: -1;
	}
	.hero-v2-lead {
		margin: 0;
		font-family: var(--font-main);
		font-size: clamp(0.98rem, 1.3vw, 1.12rem);
		line-height: 1.55;
		color: var(--ink-700);
		max-width: 60ch;
	}
	.hero-v2-features {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
		display: grid;
		/* minmax(140px) lets two cards fit side-by-side at ~343px-wide
		   hero (was 180px → forced single column on phones, hero became
		   tall enough to push the JobGrid past the fold). Above 768px
		   the auto-fit still produces 4 columns naturally. */
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 0.7rem;
	}
	.hero-v2-feature {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 0.65rem;
		row-gap: 0.1rem;
		padding: 0.85rem 1rem;
		background: rgba(255, 255, 255, 0.88);
		border: 1px solid var(--ink-200);
		border-radius: var(--radius-md, 12px);
		transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
	}
	.hero-v2-feature:hover {
		border-color: var(--brand-500);
		transform: translateY(-2px);
		box-shadow: 0 10px 22px rgba(24, 45, 34, 0.07);
	}
	.hero-v2-feature-icon {
		grid-row: 1 / 3;
		align-self: center;
		font-size: 1.55rem;
		line-height: 1;
	}
	.hero-v2-feature-title {
		font-family: var(--font-heading);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--ink-900);
	}
	.hero-v2-feature-text {
		font-family: var(--font-main);
		font-size: 0.82rem;
		color: var(--ink-500);
		line-height: 1.35;
	}
	.hero-v2-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 0.35rem;
	}
	.hero-v2-cta-primary,
	.hero-v2-cta-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-height: 52px;
		padding: 0 1.6rem;
		border-radius: 12px;
		font-family: var(--font-main);
		font-weight: 700;
		font-size: 1rem;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
	}
	.hero-v2-cta-primary {
		background: var(--brand-700);
		color: var(--ink-0);
		border: 1px solid var(--brand-700);
		box-shadow: 0 8px 20px rgba(var(--brand-700-rgb), 0.22);
	}
	.hero-v2-cta-primary:hover,
	.hero-v2-cta-primary:focus-visible {
		background: var(--brand-600);
		transform: translateY(-1px);
		box-shadow: 0 12px 26px rgba(var(--brand-700-rgb), 0.32);
		outline: none;
	}
	.hero-v2-cta-secondary {
		background: rgba(255, 255, 255, 0.9);
		color: var(--ink-900);
		border: 1px solid var(--ink-200);
	}
	.hero-v2-cta-secondary:hover,
	.hero-v2-cta-secondary:focus-visible {
		background: var(--ink-0);
		border-color: var(--brand-500);
		transform: translateY(-1px);
		outline: none;
	}
	.hero-v2-trustbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.65rem;
		margin: 0.4rem 0 0;
		padding: 0;
	}
	.hero-v2-trust-item {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		margin: 0;
	}
	.hero-v2-trust-label {
		margin: 0;
		font-family: var(--font-main);
		font-size: 0.82rem;
		color: var(--ink-500);
		font-weight: 500;
	}
	.hero-v2-trust-num {
		margin: 0;
		font-family: var(--font-heading);
		font-weight: 800;
		font-size: 1.05rem;
		color: var(--ink-900);
	}
	.hero-v2-trust-sep {
		color: var(--ink-300);
		font-weight: 600;
	}

	/* Dark mode for .hero-v2 */
	:global(:where(html, body).dark-mode) .hero-v2 {
		background: linear-gradient(135deg,
			rgba(20, 32, 48, 0.85) 0%,
			rgba(12, 22, 36, 0.95) 50%,
			rgba(18, 28, 44, 0.8) 100%
		);
		border-color: rgba(195, 204, 216, 0.18);
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.32);
	}
	:global(:where(html, body).dark-mode) .hero-v2-bg {
		background:
			radial-gradient(circle at 88% 14%, rgba(76, 175, 128, 0.10) 0%, transparent 55%),
			radial-gradient(circle at 4% 92%, rgba(96, 165, 250, 0.08) 0%, transparent 50%);
	}
	:global(:where(html, body).dark-mode) .hero-v2-eyebrow {
		background: rgba(20, 32, 48, 0.6);
		border-color: rgba(195, 204, 216, 0.18);
		color: rgba(231, 234, 240, 0.85);
	}
	:global(:where(html, body).dark-mode) .hero-v2-title {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .hero-v2-title-accent {
		color: var(--brand-500);
	}
	:global(:where(html, body).dark-mode) .hero-v2-title-accent::after {
		background: rgba(76, 175, 128, 0.22);
	}
	:global(:where(html, body).dark-mode) .hero-v2-lead {
		color: rgba(231, 234, 240, 0.78);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature {
		background: rgba(20, 32, 48, 0.7);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature:hover {
		border-color: rgba(76, 175, 128, 0.6);
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature-title {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .hero-v2-feature-text {
		color: rgba(231, 234, 240, 0.6);
	}
	:global(:where(html, body).dark-mode) .hero-v2-cta-secondary {
		background: rgba(20, 32, 48, 0.7);
		color: var(--ink-800);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .hero-v2-cta-secondary:hover,
	:global(:where(html, body).dark-mode) .hero-v2-cta-secondary:focus-visible {
		background: rgba(20, 32, 48, 0.9);
		border-color: rgba(76, 175, 128, 0.6);
	}
	:global(:where(html, body).dark-mode) .hero-v2-trust-label {
		color: rgba(231, 234, 240, 0.55);
	}
	:global(:where(html, body).dark-mode) .hero-v2-trust-num {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .hero-v2-trust-sep {
		color: rgba(231, 234, 240, 0.3);
	}

	/* === ATF compression for .hero-v2 (≥768px) ==========================
	 * Goal: keep hero from pushing the JobGrid below the fold on a 1080×900
	 * desktop viewport. Header (~72px) + toolbar (~80px sticky) + hero
	 * (~700px before compression) = ~850px → no vacancies visible above
	 * fold. After compression: hero ~450-490px → 1-2 JobCards visible.
	 *
	 * Mobile (<768px) keeps the more spacious layout — vertical real
	 * estate is less precious there and the larger H1 is good for the
	 * "first impression" on a narrow phone screen.
	 *
	 * Trade-offs:
	 *   • Title cap drops 3.5rem → 2.4rem (still feels like a hero,
	 *     not a sentence — passes editorial test).
	 *   • Padding tightened ~33% top/bottom.
	 *   • Features grid forced to 4 columns ≥1024px so the four
	 *     cards land in one row instead of wrapping to two.
	 *   • CTA buttons drop 52px → 44px (still WCAG touch-safe).
	 *   • Inter-block gaps ~30% smaller.
	 */
	@media (min-width: 768px) {
		.hero-v2 {
			padding: clamp(1rem, 2vw, 1.6rem) clamp(1.1rem, 2.4vw, 1.85rem);
			margin-bottom: var(--space-4, 1rem);
		}
		.hero-v2-inner {
			gap: clamp(0.55rem, 1.1vw, 0.85rem);
		}
		.hero-v2-title {
			font-size: clamp(1.65rem, 3.4vw, 2.4rem);
			line-height: 1.08;
		}
		.hero-v2-lead {
			font-size: clamp(0.92rem, 1.1vw, 1.02rem);
			line-height: 1.45;
		}
		.hero-v2-features {
			margin-top: 0;
			gap: 0.5rem;
		}
		.hero-v2-feature {
			padding: 0.6rem 0.8rem;
		}
		.hero-v2-feature-icon {
			font-size: 1.25rem;
		}
		.hero-v2-feature-title {
			font-size: 0.88rem;
		}
		.hero-v2-feature-text {
			font-size: 0.76rem;
			line-height: 1.3;
		}
		.hero-v2-cta-primary,
		.hero-v2-cta-secondary {
			min-height: 44px;
			padding: 0 1.25rem;
			font-size: 0.95rem;
		}
		.hero-v2-trustbar {
			margin-top: 0.2rem;
		}
		.hero-v2-eyebrow {
			padding: 0.3rem 0.75rem;
			font-size: 0.72rem;
		}
	}

	/* Force 4-column features row on wider desktops so they don't wrap. */
	@media (min-width: 1024px) {
		.hero-v2-features {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	/* Mobile for .hero-v2 */
	@media (max-width: 600px) {
		.hero-v2 {
			padding: 1.4rem 1.1rem;
		}
		.hero-v2-features {
			grid-template-columns: 1fr 1fr;
		}
		.hero-v2-cta-primary,
		.hero-v2-cta-secondary {
			width: 100%;
		}
		.hero-v2-trustbar {
			gap: 0.4rem 0.5rem;
		}
	}
	@media (max-width: 400px) {
		.hero-v2-features {
			grid-template-columns: 1fr;
		}
	}

	/* Mobile compaction overrides for hero — kept with the rest of the
	   hero rules so dark-mode + responsive logic stays cohesive. */
	@media (max-width: 768px) {
		.hero-v2 {
			padding: 1.1rem 1rem 1.4rem;
			gap: 0.85rem;
		}
		.hero-v2-features {
			/* Force 2-column layout on phones — auto-fit at minmax(140px, 1fr)
			   was collapsing to a single column when card content (e.g.
			   «Прозрачные выплаты») exceeded the 140px floor, making the hero
			   ~900px tall and pushing the JobGrid past the fold. 2x2 keeps
			   it ~600px and fits in a 812px viewport. */
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.5rem;
		}
		.hero-v2-feature {
			padding: 0.7rem 0.75rem;
			grid-template-columns: auto;
			grid-template-rows: auto auto auto;
			column-gap: 0;
		}
		.hero-v2-lead {
			margin: 0;
			max-width: none;
		}
		.hero-v2-trustbar {
			/* Single-line stats on phones — was wrapping to 2 lines and
			   eating ~30px. Compact label + bold number, smaller font,
			   tighter gap fit «Вакансий 4584 · Компаний 7 · Городов 933»
			   in 343px. */
			flex-wrap: nowrap;
			gap: 0.3rem;
			justify-content: space-between;
		}
		.hero-v2-trust-item {
			gap: 0.25rem;
			min-width: 0;
		}
		.hero-v2-trust-label {
			font-size: 0.7rem;
		}
		.hero-v2-trust-num {
			font-size: 0.9rem;
		}
		.hero-v2-trust-sep {
			font-size: 0.7rem;
		}
	}

	/* Mobile-final overrides — must win over the 768px breakpoint above
	   for label + num + sep colors after a previous refactor inverted them. */
	@media (max-width: 768px) {
		.hero-v2-trust-label {
			font-size: 0.7rem;
		}
		.hero-v2-trust-num {
			font-size: 0.95rem;
		}
		.hero-v2-trust-sep {
			font-size: 0.7rem;
			color: var(--ink-300);
		}
	}
</style>
