---
// Homepage toolbar — sticky city selector + 4 vacancy filters.
// Extracted from src/pages/index.astro (W6-2 god-file split).
//
// IDs are kept stable (`#city-select`, `#city-page-link`, `#vacancy-*-filter`)
// because the `is:inline` city-detection script in index.astro reads
// them via `document.getElementById`. Moving the markup does not break
// that wiring — DOM IDs are global.

interface Props {
	availableCities: string[];
}

const { availableCities } = Astro.props;
---

<section class="home-toolbar-section">
	<div class="hero-toolbar hero-toolbar-only">
		<div class="toolbar-top">
			<div class="city-selector-container" data-region-autoprompt="manual-only">
				<svg class="city-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
				<label class="city-field-label" for="city-select">Выберите город</label>
				<select id="city-select" class="city-select">
					<option value="" data-t="location.all_cities">Все города</option>
					{availableCities.map((city) => (
						<option value={city}>{city}</option>
					))}
				</select>
			</div>
			<button class="home-filter-toggle" type="button" aria-expanded="false" aria-controls="home-filter-panel">Фильтры</button>
		</div>
		<div class="home-filter-row" id="home-filter-panel">
			<div class="home-filter-field"><label for="vacancy-age-filter">Возраст</label>
<select id="vacancy-age-filter" class="home-filter-select" aria-label="Фильтр по возрасту">
				<option value="all">любой</option>
				<option value="16plus">с 16 лет</option>
				<option value="18plus">с 18 лет</option>
			</select>
</div>
			<div class="home-filter-field"><label for="vacancy-transport-filter">Транспорт</label>
<select id="vacancy-transport-filter" class="home-filter-select" aria-label="Фильтр по транспорту">
				<option value="all">любой</option>
				<option value="foot">пешком</option>
				<option value="bicycle">велосипед / самокат</option>
				<option value="auto">авто</option>
				<option value="remote">работа из дома</option>
				<option value="office">офис</option>
				<option value="service">выездные услуги</option>
			</select>
</div>
			<div class="home-filter-field"><label for="vacancy-employment-filter">Тип трудоустройства</label>
<select id="vacancy-employment-filter" class="home-filter-select" aria-label="Фильтр по типу трудоустройства">
				<option value="all">любой</option>
				<option value="gph">ГПХ</option>
				<option value="self_employed">самозанятость</option>
				<option value="individual_entrepreneur">ИП</option>
				<option value="official">ТК РФ</option>
			</select>
</div>
			<div class="home-filter-field"><label for="vacancy-citizenship-filter">Гражданство</label>
<select id="vacancy-citizenship-filter" class="home-filter-select" aria-label="Фильтр по гражданству">
				<option value="all">любое</option>
				<option value="rf">РФ</option>
				<option value="cis">СНГ</option>
			</select>
</div>
		</div>
		<a id="city-page-link" class="hero-city-link hidden" href="/" data-t="location.view_jobs">Все вакансии в этом городе</a>
	</div>
</section>

<style>
  .home-toolbar-section { margin: 0; }
  .hero-toolbar { display: grid; grid-template-columns: minmax(160px,1.25fr) minmax(0,4.4fr); gap: 20px; padding: 16px 20px; background: var(--ink-50); border: 0; border-radius: 0; box-shadow: none; }
  .toolbar-top { display: flex; min-width: 0; align-items: center; }
  .city-selector-container { display: grid; grid-template-columns: minmax(0,1fr); width: 100%; min-width: 0; background: transparent; padding: 0 15px 0 0; margin: 0; border: 0; border-radius: 0; box-shadow: none; border-right: 1px solid var(--ink-200); }
  .city-icon, .city-selector-container::after { display: none; }
  .city-field-label { color: var(--ink-500); font-size: 12px; line-height: 18px; }
  .city-select { width: 100%; min-width: 0; max-width: 100%; height: 30px; padding: 0 16px 0 0; font-family: inherit; font-size: 15px; font-weight: 500; color: var(--brand-500); background: transparent; border: 0; border-radius: 0; cursor: pointer; }
  .home-filter-field { min-width: 0; }
  .home-filter-field label { display: block; color: var(--ink-500); font-size: 12px; line-height: 18px; }
  .home-filter-row { display: grid; grid-template-columns: .8fr 1fr 1.6fr 1fr; align-items: center; gap: 12px; min-width: 0; }
  .home-filter-select { width: 100%; min-width: 0; height: 30px; padding: 0 14px 0 0; border: 0; border-radius: 0; background: transparent; color: var(--ink-700); font: inherit; font-size: 13px; cursor: pointer; }
  .hero-city-link { grid-column: 1/-1; color: var(--brand-500); font-size: 13px; text-decoration: none; }
  .home-filter-toggle { display: none; }
  .hidden { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (max-width:920px) {
    .hero-toolbar { grid-template-columns: 1fr; gap: 0; padding: 14px 16px; }
    .toolbar-top { gap: 12px; justify-content: space-between; }
    .city-selector-container { border: 0; padding: 0; flex: 1; }
    .city-select { font-size: 16px; height: 44px; }
    .home-filter-toggle { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 12px; border: 1px solid var(--ink-200); border-radius: 3px; background: var(--ink-0); color: var(--ink-700); font: inherit; font-size: 13px; cursor: pointer; }
    .home-filter-toggle[aria-expanded=true] { border-color: var(--brand-500); color: var(--brand-500); }
    .home-filter-row { display: none; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px 16px; padding-top: 14px; margin-top: 14px; border-top: 1px solid var(--ink-200); }
    .hero-toolbar.filters-open .home-filter-row { display: grid; }
    .home-filter-select { font-size: 16px; min-height: 44px; }
    .hero-city-link { padding-top: 8px; }
  }
  @media (max-width:480px) { .home-filter-row { grid-template-columns: 1fr; } }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('.home-filter-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      button.setAttribute('aria-expanded', String(expanded));
      button.closest('.hero-toolbar')?.classList.toggle('filters-open', expanded);
    });
  });
</script>
