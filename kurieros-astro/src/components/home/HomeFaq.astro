---
// Homepage FAQ / База знаний block — extracted from src/pages/index.astro
// (W6-2 god-file split). Owns the `.kb-*` scoped CSS (those classes
// only appear inside this component). The `:global(.faq-*)` rules
// continue to live in index.astro because they're cross-cutting and
// also affect the shared `.section-heading` rhythm.
interface FaqItem {
	id: string;
	question: string;
	answer_short: string;
	topicSlug: string;
	topicTitle: string;
}

interface Props {
	items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="faq-section home-section">
	<div class="section-heading">
		<h2>База знаний для курьера</h2>
		<p>Главные ответы из 23 проверенных источников. Можно открыть любую тему и получить структурированный разбор.</p>
	</div>
	<div class="kb-grid">
		{items.map((item) => (
			<details class="faq-item kb-item">
				<summary class="faq-question">{item.question}</summary>
				<div class="faq-answer">
					<p>{item.answer_short}</p>
					{item.topicSlug && (
						<p class="kb-item-link">
							<a href={`/guide/${item.topicSlug}/#${item.id}`}>
								Подробнее в разделе «{item.topicTitle}» →
							</a>
						</p>
					)}
				</div>
			</details>
		))}
	</div>
	<div class="kb-section-cta">
		<a href="/guide/" class="kb-cta-link">Все вопросы и ответы — Гид для курьера →</a>
	</div>
</section>

<style>
	.kb-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
	}
	@media (max-width: 720px) {
		.kb-grid {
			grid-template-columns: 1fr;
		}
	}
	.kb-item-link {
		margin: 8px 0 0;
		font-size: 14px;
	}
	.kb-item-link a {
		color: var(--brand-700);
		text-decoration: none;
		border-bottom: 1px dashed currentColor;
		font-weight: 600;
	}
	.kb-item-link a:hover {
		color: var(--ink-900);
	}
	.kb-section-cta {
		display: flex;
		justify-content: center;
		margin-top: 20px;
	}
	.kb-cta-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 12px 20px;
		border-radius: 999px;
		background: var(--brand-700);
		color: var(--ink-0);
		text-decoration: none;
		font-weight: 700;
		font-size: 14px;
		transition: background-color 0.15s ease, transform 0.15s ease;
	}
	.kb-cta-link:hover {
		background: var(--brand-800);
		transform: translateY(-1px);
	}
	:global(:where(html, body).dark-mode) .kb-cta-link {
		background: var(--brand-500);
		color: var(--ink-900);
	}
	:global(:where(html, body).dark-mode) .kb-cta-link:hover {
		background: var(--brand-400);
	}
</style>
