---
/**
 * Ozon lead-capture modal.
 *
 * Mounted once in BaseLayout. Hidden by default — opened by a global
 * click delegate inside this component's inline script when JobCard
 * or the vacancy page renders an apply CTA tagged
 * `data-lead-form-type="ozon"` (used for vacancies whose data has
 * `applyLink: 'lead-form:ozon'`, the magic prefix from
 * `src/data/vacancies.ts`).
 *
 * Flow:
 *  1. User submits the form (name, phone, transport).
 *  2. Browser POSTs `{ name, phone, transport }` to the Cloudflare
 *     Worker (PUBLIC_OZON_LEAD_API).
 *  3. Worker fills the Ozon recruitment form on the user's behalf
 *     using the site owner's referrer credentials (Worker secrets)
 *     and pings Telegram for alerts. The user never sees the
 *     referrer phone or the bot token — both stay server-side.
 *  4. On success Ozon sends an SMS directly to the candidate's phone.
 *
 * Env var (build-time, prefixed PUBLIC_ so Astro inlines it):
 *  - PUBLIC_OZON_LEAD_API — Worker URL like
 *    https://kurerok-ozon-lead.<account>.workers.dev/lead
 *
 * If the env var is blank (dev / not deployed yet), submit shows the
 * success state without dispatching — useful for previews and
 * keeps the build green before Worker deployment.
 */
const ozonLeadApi = String(import.meta.env.PUBLIC_OZON_LEAD_API ?? '').trim();
---

<div
	id="ozon-lead-modal"
	class="ozon-lead-modal hidden"
	role="dialog"
	aria-modal="true"
	aria-labelledby="ozon-lead-title"
	aria-hidden="true"
>
	<div class="ozon-lead-backdrop" data-ozon-lead-close></div>
	<div class="ozon-lead-card" role="document">
		<button
			class="ozon-lead-close"
			type="button"
			aria-label="Закрыть форму"
			data-ozon-lead-close
		>×</button>

		<div class="ozon-lead-stage" data-stage="form">
			<header class="ozon-lead-head">
				<span class="ozon-lead-eyebrow">Заявка через kurerok.ru</span>
				<h2 id="ozon-lead-title">Откликнуться на вакансию Ozon</h2>
				<p class="ozon-lead-lead">
					Оставьте контакты — мы перезвоним и поможем зарегистрироваться
					в&nbsp;Ozon Job. После первой смены вы получите бонус +1&nbsp;000&nbsp;₽
					за&nbsp;регистрацию по&nbsp;нашему реферальному коду.
				</p>
			</header>

			<form id="ozon-lead-form" class="ozon-lead-form" novalidate>
				<label class="ozon-lead-field">
					<span>Имя <em>*</em></span>
					<input
						type="text"
						name="name"
						required
						autocomplete="given-name"
						enterkeyhint="next"
						minlength="2"
					/>
				</label>
				<label class="ozon-lead-field">
					<span>Телефон <em>*</em></span>
					<input
						type="tel"
						name="phone"
						required
						autocomplete="tel"
						inputmode="tel"
						enterkeyhint="send"
						placeholder="+7 (___) ___-__-__"
						pattern="[+\d\s\(\)\-]{10,}"
					/>
				</label>
				<p class="ozon-lead-privacy">
					<span aria-hidden="true">🔒</span>
					Передаём номер только в Ozon. Спама не будет.
				</p>
				<fieldset class="ozon-lead-fieldset">
					<legend>Транспорт</legend>
					<label class="ozon-lead-radio">
						<input type="radio" name="transport" value="auto" checked />
						<span>Авто</span>
					</label>
					<label class="ozon-lead-radio">
						<input type="radio" name="transport" value="foot" />
						<span>Пешком</span>
					</label>
					<label class="ozon-lead-radio">
						<input type="radio" name="transport" value="bicycle" />
						<span>Велосипед / самокат</span>
					</label>
				</fieldset>

				<button type="submit" class="ozon-lead-submit" id="ozon-lead-submit">
					<span class="ozon-lead-submit-label">Отправить заявку</span>
					<span class="ozon-lead-spinner" aria-hidden="true"></span>
				</button>

				<p class="ozon-lead-error hidden" id="ozon-lead-error" role="alert"></p>

				<p class="ozon-lead-fineprint">
					Нажимая «Отправить», вы соглашаетесь, что мы&nbsp;свяжемся с&nbsp;вами по&nbsp;указанному телефону.
				</p>
			</form>
		</div>

		<div class="ozon-lead-stage hidden" data-stage="success">
			<div class="ozon-lead-success-icon" aria-hidden="true">✓</div>
			<h2>Заявка отправлена в&nbsp;Ozon</h2>
			<p>Сейчас Ozon пришлёт SMS на&nbsp;ваш номер с&nbsp;инструкцией. Мы&nbsp;уже передали ваши контакты и&nbsp;закрепили вас за&nbsp;нашим аккаунтом.</p>

			<ol class="ozon-lead-steps">
				<li>
					<strong>Дождитесь SMS от&nbsp;Ozon</strong>
					<span>В&nbsp;течение нескольких минут на&nbsp;ваш телефон придёт сообщение с&nbsp;ссылкой и&nbsp;дальнейшими шагами.</span>
				</li>
				<li>
					<strong>Установите Ozon Job</strong>
					<span>
						<a href="https://apps.apple.com/ru/app/ozon-job/id6498711171" target="_blank" rel="noopener noreferrer">App Store</a>
						·
						<a href="https://play.google.com/store/apps/details?id=ru.ozon.hire" target="_blank" rel="noopener noreferrer">Google Play</a>
					</span>
				</li>
				<li>
					<strong>Зарегистрируйтесь и&nbsp;выходите на&nbsp;смену</strong>
					<span>Регистрация через Госуслуги — занимает 5&nbsp;минут. Дальше выберите смену в&nbsp;приложении.</span>
				</li>
			</ol>

			<button type="button" class="ozon-lead-finish" data-ozon-lead-close>Готово</button>
		</div>
	</div>
</div>

<script
	is:inline
	define:vars={{ ozonLeadApi }}
>
	(function () {
		const modal = document.getElementById('ozon-lead-modal');
		if (!modal) return;
		const form = document.getElementById('ozon-lead-form');
		const submitBtn = document.getElementById('ozon-lead-submit');
		const errorEl = document.getElementById('ozon-lead-error');
		const stageForm = modal.querySelector('[data-stage="form"]');
		const stageSuccess = modal.querySelector('[data-stage="success"]');
		const showError = (msg) => {
			if (!errorEl) return;
			errorEl.textContent = msg;
			errorEl.classList.remove('hidden');
		};
		const clearError = () => errorEl?.classList.add('hidden');

		const setBusy = (busy) => {
			if (!submitBtn) return;
			submitBtn.disabled = busy;
			submitBtn.classList.toggle('busy', busy);
		};

		const open = (context) => {
			modal.classList.remove('hidden');
			modal.setAttribute('aria-hidden', 'false');
			document.body.classList.add('ozon-lead-modal-open');
			modal.dataset.context = JSON.stringify(context || {});
			stageForm?.classList.remove('hidden');
			stageSuccess?.classList.add('hidden');
			clearError();
			// QW12 — на мобильном (touch-input) фокус мгновенно открывает
			// клавиатуру → перекрывает половину модалки, scroll прыгает.
			// Автофокус оставляем только на desktop (`pointer: fine`).
			if (!window.matchMedia('(pointer: coarse)').matches) {
				setTimeout(() => form?.querySelector('input[name="name"]')?.focus(), 50);
			}
			if (typeof window.gtag === 'function') {
				window.gtag('event', 'ozon_lead_open', {
					context_company: context?.company || '',
					context_city: context?.city || '',
					context_position: context?.position || ''
				});
			}
		};
		const close = () => {
			modal.classList.add('hidden');
			modal.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('ozon-lead-modal-open');
			form?.reset();
			setBusy(false);
			clearError();
		};

		// Public-on-window so anything on the page can call it.
		window.openOzonLeadModal = open;

		modal.querySelectorAll('[data-ozon-lead-close]').forEach((el) => {
			el.addEventListener('click', close);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !modal.classList.contains('hidden')) close();
		});

		// Click delegation: any element with `data-lead-form-type="ozon"`
		// opens the modal. Apply CTAs in JobCard / vacancy page set this
		// alongside the data-ozon-* attributes that pin the request to a
		// specific (vacancy, city, hire-object) triple — see
		// src/data/vacancies.ts for where those are wired up per offer.
		document.addEventListener('click', (e) => {
			const trigger = e.target instanceof Element
				? e.target.closest('[data-lead-form-type="ozon"]')
				: null;
			if (!trigger) return;
			e.preventDefault();
			open({
				company: trigger.dataset.applyCompany || 'Ozon',
				city: trigger.dataset.applyCity || '',
				transport: trigger.dataset.applyTransport || '',
				position: trigger.dataset.applyPosition || '',
				ozonVacancy: trigger.dataset.ozonVacancy || '',
				ozonCustomer: trigger.dataset.ozonCustomer || '',
				ozonCityId: trigger.dataset.ozonCityId || '',
				ozonHireObjectUuid: trigger.dataset.ozonHireObjectUuid || ''
			});
		});

		const submitToWorker = async (data, ctx) => {
			if (!ozonLeadApi) {
				// Preview / dev environment: PUBLIC_OZON_LEAD_API not set.
				// Make the silent skip visible in browser devtools so devs
				// don't ship a build that swallows real users' submissions.
				// eslint-disable-next-line no-console
				console.warn('[ozon-lead] submission skipped — PUBLIC_OZON_LEAD_API is not set in this build');
				return { skipped: true };
			}
			const res = await fetch(ozonLeadApi, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: data.name,
					phone: data.phone,
					transport: data.transport,
					// Per-request triple. The Worker validates against
					// its embedded whitelist and rejects unknowns. If
					// the trigger didn't carry them (legacy bundle or
					// non-Ozon CTA), the Worker falls back to legacy
					// Москва / rocket:courier defaults.
					vacancy: (ctx && ctx.ozonVacancy) || '',
					// Ozon Fresh discriminator — `'express'` for
					// fresh-referral-office vacancies, '' for sklad.
					// Worker branches its upstream payload shape on this.
					customer: (ctx && ctx.ozonCustomer) || '',
					cityID: (ctx && ctx.ozonCityId) || '',
					hireObjectUUID: (ctx && ctx.ozonHireObjectUuid) || ''
				})
			});
			let payload = null;
			try { payload = await res.json(); } catch (_) { payload = null; }
			if (!res.ok || (payload && payload.ok === false)) {
				const errCode = (payload && payload.error) || ('http_' + res.status);
				throw new Error(errCode);
			}
			return { sent: true };
		};

		const transportLabels = { auto: 'Авто', foot: 'Пешком', bicycle: 'Велосипед / самокат' };

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			clearError();
			const fd = new FormData(form);
			const name = String(fd.get('name') ?? '').trim();
			const phoneRaw = String(fd.get('phone') ?? '').trim();
			const transportKey = String(fd.get('transport') ?? 'auto');
			const transport = transportLabels[transportKey] || transportKey;

			if (name.length < 2) {
				showError('Укажите имя — минимум 2 символа.');
				return;
			}
			const phoneDigits = phoneRaw.replace(/\D+/g, '');
			if (phoneDigits.length < 10) {
				showError('Похоже, в номере не хватает цифр. Проверьте телефон.');
				return;
			}

			let ctx = {};
			try { ctx = JSON.parse(modal.dataset.context || '{}'); } catch (_) { ctx = {}; }

			setBusy(true);
			try {
				await submitToWorker({ name, phone: phoneRaw, transport }, ctx);
				if (typeof window.gtag === 'function') {
					window.gtag('event', 'ozon_lead_submit', {
						transport: transportKey,
						context_position: ctx.position || ''
					});
				}
				stageForm?.classList.add('hidden');
				stageSuccess?.classList.remove('hidden');
			} catch (err) {
				console.warn('[ozon-lead] submit failed', err);
				const code = String(err?.message || '');
				let msg = 'Не удалось отправить заявку. Попробуйте ещё раз через минуту.';
				if (code === 'invalid_phone') msg = 'Похоже, в номере не хватает цифр. Проверьте телефон.';
				else if (code === 'name_too_short') msg = 'Укажите имя — минимум 2 символа.';
				else if (code === 'ozon_submit_failed') msg = 'Ozon временно не отвечает. Попробуйте через минуту.';
				showError(msg);
			} finally {
				setBusy(false);
			}
		});
	})();
</script>

<style>
	.ozon-lead-modal {
		position: fixed;
		inset: 0;
		z-index: 9000;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	.ozon-lead-modal.hidden {
		display: none;
	}
	.ozon-lead-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 23, 42, 0.55);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}
	.ozon-lead-card {
		position: relative;
		width: 100%;
		max-width: 480px;
		/* 100dvh tracks dynamic viewport so the modal doesn't overflow
		   the visible area on iOS Chrome where the toolbar collapses on scroll */
		max-height: calc(100vh - 2rem);
		max-height: calc(100dvh - 2rem);
		overflow-y: auto;
		background: var(--ink-0);
		border-radius: 18px;
		box-shadow: 0 32px 60px rgba(0, 0, 0, 0.28);
		padding: 1.6rem 1.5rem 1.4rem;
		font-family: var(--font-main, 'Manrope', sans-serif);
		color: var(--ink-900);
	}
	.ozon-lead-close {
		position: absolute;
		top: 0.55rem;
		right: 0.55rem;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: none;
		background: var(--scrim-shadow-soft);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
		color: var(--ink-600);
		transition: background 0.18s ease, color 0.18s ease;
	}
	.ozon-lead-close:hover,
	.ozon-lead-close:focus-visible {
		background: rgba(15, 23, 42, 0.12);
		color: var(--ink-900);
		outline: none;
	}
	/* Force vertical column so the eyebrow pill never sits next to
	   the H2 / description on medium widths. inline-block + block
	   normally stack, but we lock the order explicitly via flex
	   to defend against future parent-context surprises. */
	.ozon-lead-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		margin-bottom: 0.4rem;
	}
	.ozon-lead-eyebrow {
		display: inline-block;
		max-width: 100%;
		padding: 0.3rem 0.7rem;
		background: rgba(0, 91, 255, 0.1);
		color: var(--brand-ozon);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		border-radius: 999px;
		white-space: nowrap;
	}
	.ozon-lead-head h2 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: 1.3rem;
		line-height: 1.25;
		color: var(--ink-900);
		letter-spacing: -0.01em;
	}
	.ozon-lead-lead {
		margin: 0 0 0.6rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--ink-600);
	}
	.ozon-lead-form {
		display: grid;
		gap: 0.7rem;
	}
	.ozon-lead-field {
		display: grid;
		gap: 0.3rem;
	}
	.ozon-lead-field span {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--ink-700);
	}
	.ozon-lead-field em {
		color: var(--color-danger);
		font-style: normal;
		font-weight: 800;
	}
	.ozon-lead-field input {
		width: 100%;
		min-height: 44px;
		padding: 0.55rem 0.85rem;
		border-radius: 10px;
		border: 1px solid var(--ink-200);
		background: var(--ink-0);
		font: inherit;
		color: var(--ink-900);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.ozon-lead-field input:focus-visible {
		outline: none;
		border-color: var(--brand-ozon);
		box-shadow: 0 0 0 3px rgba(0, 91, 255, 0.18);
	}
	.ozon-lead-fieldset {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		border: none;
		padding: 0;
		margin: 0;
	}
	.ozon-lead-fieldset legend {
		display: block;
		width: 100%;
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--ink-700);
		margin-bottom: 0.3rem;
	}
	.ozon-lead-radio {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--ink-200);
		border-radius: 999px;
		font-size: 0.88rem;
		cursor: pointer;
		transition: border-color 0.15s ease, background 0.15s ease;
	}
	.ozon-lead-radio:hover {
		border-color: var(--brand-ozon);
	}
	.ozon-lead-radio input {
		accent-color: var(--brand-ozon);
	}
	.ozon-lead-radio:has(input:checked) {
		border-color: var(--brand-ozon);
		background: rgba(0, 91, 255, 0.08);
		color: var(--brand-ozon);
		font-weight: 700;
	}
	.ozon-lead-submit {
		position: relative;
		min-height: 50px;
		padding: 0 1.1rem;
		margin-top: 0.4rem;
		border-radius: 12px;
		border: none;
		background: var(--brand-ozon);
		color: var(--ink-0);
		font-family: inherit;
		font-weight: 800;
		font-size: 1rem;
		cursor: pointer;
		transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
		box-shadow: 0 8px 18px rgba(0, 91, 255, 0.25);
	}
	.ozon-lead-submit:hover:not(:disabled),
	.ozon-lead-submit:focus-visible {
		background: #1e6bff;
		transform: translateY(-1px);
		box-shadow: 0 12px 22px rgba(0, 91, 255, 0.32);
		outline: none;
	}
	.ozon-lead-submit:disabled {
		opacity: 0.65;
		cursor: progress;
	}
	.ozon-lead-spinner {
		display: none;
		width: 14px;
		height: 14px;
		margin-left: 0.4rem;
		border: 2px solid rgba(255, 255, 255, 0.4);
		border-top-color: var(--ink-0);
		border-radius: 50%;
		animation: ozon-lead-spin 0.7s linear infinite;
		vertical-align: middle;
	}
	.ozon-lead-submit.busy .ozon-lead-spinner {
		display: inline-block;
	}
	.ozon-lead-submit.busy .ozon-lead-submit-label {
		opacity: 0.6;
	}
	@keyframes ozon-lead-spin {
		to { transform: rotate(360deg); }
	}
	.ozon-lead-error {
		margin: 0.2rem 0 0;
		padding: 0.55rem 0.7rem;
		background: rgba(239, 68, 68, 0.1);
		border: 1px solid rgba(239, 68, 68, 0.35);
		border-radius: 10px;
		color: #b91c1c;
		font-size: 0.85rem;
		line-height: 1.4;
	}
	.ozon-lead-error.hidden {
		display: none;
	}
	.ozon-lead-fineprint {
		margin: 0.2rem 0 0;
		font-size: 0.75rem;
		color: var(--ink-400);
		line-height: 1.4;
	}
	.ozon-lead-privacy {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: 0.1rem 0 0;
		padding: 0.45rem 0.6rem;
		background: var(--ink-50);
		border-radius: 8px;
		font-size: 0.78rem;
		color: var(--ink-600);
		line-height: 1.35;
	}
	.ozon-lead-privacy span[aria-hidden] {
		font-size: 0.85rem;
	}
	:global(:where(html, body).dark-mode) .ozon-lead-privacy {
		background: rgba(15, 23, 36, 0.65);
		color: rgba(231, 234, 240, 0.75);
	}

	/* Success stage */
	.ozon-lead-stage.hidden {
		display: none;
	}
	.ozon-lead-success-icon {
		width: 56px;
		height: 56px;
		margin: 0.2rem auto 0.6rem;
		border-radius: 50%;
		background: var(--brand-50);
		color: var(--brand-600);
		display: grid;
		place-items: center;
		font-size: 1.6rem;
		font-weight: 800;
	}
	.ozon-lead-stage[data-stage="success"] {
		text-align: center;
	}
	.ozon-lead-stage[data-stage="success"] h2 {
		margin: 0 0 0.4rem;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: 1.4rem;
		color: var(--ink-900);
	}
	.ozon-lead-stage[data-stage="success"] > p {
		margin: 0 0 1rem;
		color: var(--ink-600);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.ozon-lead-steps {
		text-align: left;
		list-style: none;
		counter-reset: ozon-step;
		margin: 0 0 1rem;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
	.ozon-lead-steps li {
		position: relative;
		padding: 0.7rem 0.85rem 0.7rem 2.6rem;
		background: var(--ink-50);
		border: 1px solid var(--ink-800);
		border-radius: 12px;
		counter-increment: ozon-step;
