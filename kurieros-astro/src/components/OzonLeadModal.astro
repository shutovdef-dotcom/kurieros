---
/**
 * Ozon lead-capture modal.
 *
 * Mounted once in BaseLayout. Hidden by default — opened by a global
 * click delegate inside this component's inline script when JobCard
 * or the vacancy page renders an apply CTA tagged
 * `data-lead-form-type="ozon"` (used for vacancies whose data has
 * `applyLink: 'lead-form:ozon'`, the magic prefix from
 * `src/data/vacancies.ts`).
 *
 * Flow:
 *  1. User submits the form (name and phone).
 *  2. Browser POSTs `{ name, phone }` to the Cloudflare
 *     Worker (PUBLIC_OZON_LEAD_API).
 *  3. Worker fills the Ozon recruitment form on the user's behalf
 *     using the site owner's referrer credentials (Worker secrets)
 *     and sends Telegram a PII-free operational status. The user never
 *     sees the referrer phone or the bot token — both stay server-side.
 *  4. On success Ozon may send an SMS directly to the candidate's phone.
 *
 * Env var (build-time, prefixed PUBLIC_ so Astro inlines it):
 *  - PUBLIC_OZON_LEAD_API — Worker URL like
 *    https://kurerok-ozon-lead.<account>.workers.dev/lead
 *
 * If the env var is blank (dev / not deployed yet), submit shows a soft
 * error instead of the success state so previews do not silently drop leads.
 */
import ozonLeadModalUrl from '../scripts/ozonLeadModal.js?url';

const ozonLeadApi = String(import.meta.env.PUBLIC_OZON_LEAD_API ?? '').trim();
---

<div
	id="ozon-lead-modal"
	class="ozon-lead-modal hidden"
	data-ozon-lead-api={ozonLeadApi}
	role="dialog"
	aria-modal="true"
	aria-labelledby="ozon-lead-title"
>
	<div class="ozon-lead-backdrop" data-ozon-lead-close></div>
	<div class="ozon-lead-card" role="document">
		<button
			class="ozon-lead-close"
			type="button"
			aria-label="Закрыть форму"
			data-ozon-lead-close
		>×</button>

		<div class="ozon-lead-stage" data-stage="form">
			<div class="ozon-lead-head">
				<span class="ozon-lead-eyebrow">Заявка через kurerok.ru</span>
				<h2 id="ozon-lead-title">Откликнуться на вакансию Ozon</h2>
				<p class="ozon-lead-lead">
					Имя и телефон КурьерОк передаст через Cloudflare Worker в Ozon
					для передачи заявки на выбранную вакансию. Ozon может отправить
					SMS с дальнейшими шагами регистрации.
				</p>
			</div>

			<form id="ozon-lead-form" class="ozon-lead-form" novalidate>
				<label class="ozon-lead-field">
					<span>Имя <em>*</em></span>
					<input
						type="text"
						name="name"
						required
						autocomplete="given-name"
						enterkeyhint="next"
						minlength="2"
						maxlength="200"
					/>
				</label>
				<label class="ozon-lead-field">
					<span>Телефон <em>*</em></span>
					<input
						type="tel"
						name="phone"
						required
						autocomplete="tel"
						inputmode="tel"
						enterkeyhint="send"
						placeholder="+7 (___) ___-__-__"
						minlength="10"
						maxlength="32"
					/>
				</label>
				<p class="ozon-lead-privacy">
					<span aria-hidden="true">🔒</span>
					КурьерОк использует имя и телефон только для этой передачи и не сохраняет их в своей базе.
				</p>

				<button type="submit" class="ozon-lead-submit" id="ozon-lead-submit">
					<span class="ozon-lead-submit-label">Отправить заявку</span>
					<span class="ozon-lead-spinner" aria-hidden="true"></span>
				</button>

				<p class="ozon-lead-error hidden" id="ozon-lead-error" role="alert"></p>

				<p class="ozon-lead-fineprint">
					Нажимая «Отправить», вы соглашаетесь на обработку имени и телефона КурьерОк
					только в течение запроса для передачи заявки в Ozon. После передачи Ozon
					обрабатывает данные по своим правилам. <a href="/privacy/">Подробнее в политике конфиденциальности</a>.
				</p>
			</form>
		</div>

		<div class="ozon-lead-stage hidden" data-stage="success">
			<div class="ozon-lead-success-icon" aria-hidden="true">✓</div>
			<h2>Заявка отправлена в&nbsp;Ozon</h2>
			<p>Контакты переданы в Ozon. Если заявка принята, Ozon может прислать SMS с дальнейшими шагами.</p>

			<ol class="ozon-lead-steps">
				<li>
					<strong>Проверьте SMS от&nbsp;Ozon</strong>
					<span>Срок и способ ответа определяет Ozon; сообщение может прийти не сразу.</span>
				</li>
				<li>
					<strong>Установите Ozon Job</strong>
					<span>
						<a href="https://apps.apple.com/ru/app/ozon-job/id6498711171" target="_blank" rel="noopener noreferrer">App Store</a>
						·
						<a href="https://play.google.com/store/apps/details?id=ru.ozon.hire" target="_blank" rel="noopener noreferrer">Google Play</a>
					</span>
				</li>
				<li>
					<strong>Зарегистрируйтесь и&nbsp;выходите на&nbsp;смену</strong>
					<span>Регистрация через Госуслуги — занимает 5&nbsp;минут. Дальше выберите смену в&nbsp;приложении.</span>
				</li>
			</ol>

			<button type="button" class="ozon-lead-finish" data-ozon-lead-close>Готово</button>
		</div>
	</div>
</div>

<script is:inline type="module" src={ozonLeadModalUrl}></script>

<style>
	.ozon-lead-modal {
		position: fixed;
		inset: 0;
		z-index: 9000;
		display: grid;
		place-items: center;
		padding: 1rem;
	}
	.ozon-lead-modal.hidden {
		display: none;
	}
	.ozon-lead-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 23, 42, 0.55);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}
	.ozon-lead-card {
		position: relative;
		width: 100%;
		max-width: 480px;
		/* 100dvh tracks dynamic viewport so the modal doesn't overflow
		   the visible area on iOS Chrome where the toolbar collapses on scroll */
		max-height: calc(100vh - 2rem);
		max-height: calc(100dvh - 2rem);
		overflow-y: auto;
		background: var(--ink-0);
		border-radius: 18px;
		box-shadow: 0 32px 60px rgba(0, 0, 0, 0.28);
		padding: 1.6rem 1.5rem 1.4rem;
		font-family: var(--font-main, 'Manrope', sans-serif);
		color: var(--ink-900);
	}
	.ozon-lead-close {
		position: absolute;
		top: 0.55rem;
		right: 0.55rem;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: none;
		background: var(--scrim-shadow-soft);
		font-size: 1.4rem;
		line-height: 1;
		cursor: pointer;
		color: var(--ink-600);
		transition: background 0.18s ease, color 0.18s ease;
	}
	.ozon-lead-close:hover,
	.ozon-lead-close:focus-visible {
		background: rgba(15, 23, 42, 0.12);
		color: var(--ink-900);
		outline: none;
	}
	/* Force vertical column so the eyebrow pill never sits next to
	   the H2 / description on medium widths. inline-block + block
	   normally stack, but we lock the order explicitly via flex
	   to defend against future parent-context surprises. */
	.ozon-lead-head {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.55rem;
		margin-bottom: 0.4rem;
	}
	.ozon-lead-eyebrow {
		display: inline-block;
		max-width: 100%;
		padding: 0.3rem 0.7rem;
		background: rgba(0, 91, 255, 0.1);
		color: var(--brand-ozon);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		border-radius: 999px;
		white-space: nowrap;
	}
	.ozon-lead-head h2 {
		margin: 0;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: 1.3rem;
		line-height: 1.25;
		color: var(--ink-900);
		letter-spacing: -0.01em;
	}
	.ozon-lead-lead {
		margin: 0 0 0.6rem;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--ink-600);
	}
	.ozon-lead-form {
		display: grid;
		gap: 0.7rem;
	}
	.ozon-lead-field {
		display: grid;
		gap: 0.3rem;
	}
	.ozon-lead-field span {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--ink-700);
	}
	.ozon-lead-field em {
		color: var(--color-danger);
		font-style: normal;
		font-weight: 800;
	}
	.ozon-lead-field input {
		width: 100%;
		min-height: 44px;
		padding: 0.55rem 0.85rem;
		border-radius: 10px;
		border: 1px solid var(--ink-200);
		background: var(--ink-0);
		font: inherit;
		color: var(--ink-900);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.ozon-lead-field input:focus-visible {
		outline: none;
		border-color: var(--brand-ozon);
		box-shadow: 0 0 0 3px rgba(0, 91, 255, 0.18);
	}
	.ozon-lead-submit {
		position: relative;
		min-height: 50px;
		padding: 0 1.1rem;
		margin-top: 0.4rem;
		border-radius: 12px;
		border: none;
		background: var(--brand-ozon);
		color: var(--ink-0);
		font-family: inherit;
		font-weight: 800;
		font-size: 1rem;
		cursor: pointer;
		transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
		box-shadow: 0 8px 18px rgba(0, 91, 255, 0.25);
	}
	.ozon-lead-submit:hover:not(:disabled),
	.ozon-lead-submit:focus-visible {
		background: #1e6bff;
		transform: translateY(-1px);
		box-shadow: 0 12px 22px rgba(0, 91, 255, 0.32);
		outline: none;
	}
	.ozon-lead-submit:disabled {
		opacity: 0.65;
		cursor: progress;
	}
	.ozon-lead-spinner {
		display: none;
		width: 14px;
		height: 14px;
		margin-left: 0.4rem;
		border: 2px solid rgba(255, 255, 255, 0.4);
		border-top-color: var(--ink-0);
		border-radius: 50%;
		animation: ozon-lead-spin 0.7s linear infinite;
		vertical-align: middle;
	}
	.ozon-lead-submit.busy .ozon-lead-spinner {
		display: inline-block;
	}
	.ozon-lead-submit.busy .ozon-lead-submit-label {
		opacity: 0.6;
	}
	@keyframes ozon-lead-spin {
		to { transform: rotate(360deg); }
	}
	.ozon-lead-error {
		margin: 0.2rem 0 0;
		padding: 0.55rem 0.7rem;
		background: rgba(239, 68, 68, 0.1);
		border: 1px solid rgba(239, 68, 68, 0.35);
		border-radius: 10px;
		color: #b91c1c;
		font-size: 0.85rem;
		line-height: 1.4;
	}
	.ozon-lead-error.hidden {
		display: none;
	}
	.ozon-lead-fineprint {
		margin: 0.2rem 0 0;
		font-size: 0.75rem;
		color: var(--ink-400);
		line-height: 1.4;
	}
	.ozon-lead-fineprint a {
		color: inherit;
		font-weight: 700;
	}
	.ozon-lead-privacy {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: 0.1rem 0 0;
		padding: 0.45rem 0.6rem;
		background: var(--ink-50);
		border-radius: 8px;
		font-size: 0.78rem;
		color: var(--ink-600);
		line-height: 1.35;
	}
	.ozon-lead-privacy span[aria-hidden] {
		font-size: 0.85rem;
	}
	:global(:where(html, body).dark-mode) .ozon-lead-privacy {
		background: rgba(15, 23, 36, 0.65);
		color: rgba(231, 234, 240, 0.75);
	}

	/* Success stage */
	.ozon-lead-stage.hidden {
		display: none;
	}
	.ozon-lead-success-icon {
		width: 56px;
		height: 56px;
		margin: 0.2rem auto 0.6rem;
		border-radius: 50%;
		background: var(--brand-50);
		color: var(--brand-600);
		display: grid;
		place-items: center;
		font-size: 1.6rem;
		font-weight: 800;
	}
	.ozon-lead-stage[data-stage="success"] {
		text-align: center;
	}
	.ozon-lead-stage[data-stage="success"] h2 {
		margin: 0 0 0.4rem;
		font-family: var(--font-heading, 'Manrope', sans-serif);
		font-size: 1.4rem;
		color: var(--ink-900);
	}
	.ozon-lead-stage[data-stage="success"] > p {
		margin: 0 0 1rem;
		color: var(--ink-600);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.ozon-lead-steps {
		text-align: left;
		list-style: none;
		counter-reset: ozon-step;
		margin: 0 0 1rem;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
	.ozon-lead-steps li {
		position: relative;
		padding: 0.7rem 0.85rem 0.7rem 2.6rem;
		background: var(--ink-50);
		border: 1px solid var(--ink-800);
		border-radius: 12px;
		counter-increment: ozon-step;
	}
	.ozon-lead-steps li::before {
		content: counter(ozon-step);
		position: absolute;
		top: 0.75rem;
		left: 0.85rem;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 50%;
		background: var(--brand-ozon);
		color: var(--ink-0);
		font-size: 0.78rem;
		font-weight: 800;
		display: grid;
		place-items: center;
	}
	.ozon-lead-steps li strong {
		display: block;
		font-size: 0.95rem;
		color: var(--ink-900);
		font-weight: 700;
		margin-bottom: 0.2rem;
	}
	.ozon-lead-steps li span {
		font-size: 0.85rem;
		color: var(--ink-600);
		line-height: 1.4;
	}
	.ozon-lead-steps li a {
		color: var(--brand-ozon);
		text-decoration: none;
		font-weight: 700;
	}
	.ozon-lead-finish {
		min-height: 44px;
		padding: 0 1.2rem;
		border-radius: 10px;
		border: 1px solid var(--ink-200);
		background: var(--ink-0);
		font-family: inherit;
		font-weight: 700;
		color: var(--ink-900);
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.ozon-lead-finish:hover {
		background: var(--ink-50);
		border-color: var(--ink-400);
	}

	/* Body lock when modal is open */
	:global(body.ozon-lead-modal-open) {
		overflow: hidden;
	}

	/* Dark mode */
	:global(:where(html, body).dark-mode) .ozon-lead-card {
		background: #14202b;
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-close {
		background: rgba(231, 234, 240, 0.08);
		color: var(--ink-300);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-close:hover {
		background: rgba(231, 234, 240, 0.15);
		color: var(--ink-50);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-head h2,
	:global(:where(html, body).dark-mode) .ozon-lead-stage[data-stage="success"] h2 {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-lead,
	:global(:where(html, body).dark-mode) .ozon-lead-stage[data-stage="success"] > p,
	:global(:where(html, body).dark-mode) .ozon-lead-steps li span,
	:global(:where(html, body).dark-mode) .ozon-lead-fineprint {
		color: rgba(231, 234, 240, 0.7);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-field span {
		color: var(--ink-300);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-field input {
		background: rgba(15, 23, 36, 0.7);
		border-color: rgba(195, 204, 216, 0.2);
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-steps li {
		background: rgba(15, 23, 36, 0.7);
		border-color: rgba(195, 204, 216, 0.18);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-steps li strong {
		color: var(--ink-800);
	}
	:global(:where(html, body).dark-mode) .ozon-lead-finish {
		background: rgba(15, 23, 36, 0.7);
		border-color: rgba(195, 204, 216, 0.2);
		color: var(--ink-800);
	}

	@media (max-width: 480px) {
		.ozon-lead-card {
			padding: 1.3rem 1.1rem;
		}
	}
</style>
