<style>
    footer {
        background: var(--ink-100);
        border-top: 1px solid var(--ink-200);
        padding: var(--space-8) var(--space-6);
        color: var(--ink-700);
    }

    .footer-content {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: var(--space-6);
        max-width: 1200px;
        margin: 0 auto;
    }
    @media (max-width: 768px) {
        .footer-content {
            grid-template-columns: 1fr;
            gap: var(--space-5);
        }
    }

    .footer-col h4 {
        font-family: var(--font-heading);
        font-size: var(--fs-13);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-500);
        margin: 0 0 12px 0;
        font-weight: 700;
    }

    .footer-description {
        color: var(--ink-600);
        font-size: var(--fs-14);
        line-height: var(--lh-14);
        margin: 0 0 var(--space-4) 0;
        max-width: 36em;
    }

    .footer-city-link-wrap {
        margin: 0 0 var(--space-4) 0;
    }
    .footer-city-link {
        color: var(--brand-600);
        font-size: var(--fs-14);
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }
    .footer-city-link:hover,
    .footer-city-link:focus-visible {
        color: var(--brand-700);
        outline: none;
        text-decoration: underline;
    }

    .footer-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: var(--space-2);
    }
    .footer-cloud span {
        font-size: var(--fs-12);
        color: var(--ink-500);
        background: var(--ink-50);
        border: 1px solid var(--ink-200);
        padding: 3px 8px;
        border-radius: var(--radius-pill);
    }

    .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .footer-col ul a {
        color: var(--ink-700);
        font-size: var(--fs-14);
        text-decoration: none;
        transition: color var(--transition);
    }
    .footer-col ul a:hover,
    .footer-col ul a:focus-visible {
        color: var(--brand-600);
        outline: none;
    }

    .footer-bottom {
        max-width: 1200px;
        margin: var(--space-8) auto 0;
        padding-top: var(--space-5);
        border-top: 1px solid var(--ink-200);
        color: var(--ink-500);
        font-size: var(--fs-13);
        text-align: center;
    }
</style>
