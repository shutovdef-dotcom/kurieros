---
import type { CompanyVacancyCardViewModel } from '../../utils/jobCardViewModel';
import { getVacancyDetailPath } from '../../utils/vacancyUrl';

interface Props {
  job: CompanyVacancyCardViewModel;
}

const { job } = Astro.props as Props;
const labels = job.labels;
const detailHref = getVacancyDetailPath(job);
---

<article class="job-card company-vacancy-card">
  <div class="job-card-top">
    <span class="job-salary">{job.salary}</span>
    <span class="job-city">{job.location}</span>
  </div>
  <h3><a href={detailHref}>{job.title}</a></h3>
  <p>{job.shortDescription || job.title}</p>
  <div class="chip-row">
    {labels.slice(0, 3).map((label: string) => (
      <span class="chip">{label}</span>
    ))}
  </div>
  <a class="job-link" href={detailHref}>Открыть карточку вакансии</a>
</article>

<style>
  .company-vacancy-card { display: grid; grid-template-columns: minmax(0,1fr) 250px; grid-template-areas: "title pay" "city pay" "description action" "labels action"; gap: 8px 24px; padding: 24px 0; background: var(--ink-0); border: 0; border-bottom: 1px solid var(--ink-200); border-radius: 0; box-shadow: none; }
  .job-card-top { display: contents; }
  h3 { grid-area: title; margin: 0; font-size: 21px; line-height: 1.35; font-weight: 600; }
  h3 a { text-decoration: none; color: var(--ink-700); }
  h3 a:hover { color: var(--brand-500); }
  .job-salary { grid-area: pay; justify-self: end; font-size: 24px; line-height: 1.3; color: var(--ink-700); font-weight: 600; letter-spacing: -.03em; text-align: right; background: transparent; border: 0; border-radius: 0; padding: 0; }
  .job-city { grid-area: city; color: var(--ink-500); font-size: 13px; line-height: 1.5; background: none; border: 0; padding: 0; min-height: 0; }
  p { grid-area: description; margin: 4px 0 0; color: var(--ink-500); font-size: 13px; line-height: 1.6; }
  .chip-row { grid-area: labels; display: flex; flex-wrap: wrap; gap: 4px 8px; }
  .chip { color: var(--ink-500); font-size: 12px; font-weight: 400; line-height: 1.5; background: none; border: 0; border-radius: 0; padding: 0; min-height: 0; }
  .chip + .chip::before { content: '·'; margin-right: 8px; color: var(--ink-400); }
  .job-link { grid-area: action; justify-self: end; align-self: end; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 14px; color: var(--action-on-blue); background: var(--action-blue); border-radius: 3px; font-size: 13px; line-height: 1.4; font-weight: 500; text-align: center; text-decoration: none; }
  .job-link:hover { background: var(--action-blue-hover); color: var(--action-on-blue); }
  @media(max-width:768px) { .company-vacancy-card { grid-template-columns: minmax(0,1fr); grid-template-areas: "title" "city" "pay" "description" "labels" "action"; gap: 10px; } .job-salary { justify-self: start; text-align: left; font-size: 23px; } .job-link { justify-self: start; margin-top: 8px; } }
</style>
