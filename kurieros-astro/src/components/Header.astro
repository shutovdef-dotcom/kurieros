---
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import { hasPublishedBlog } from '../utils/blogManifest';
---
<header class="site-header" aria-label="Шапка сайта">
    <div class="header-left">
        <Logo size="md" />
    </div>
    
    <nav class="main-nav" aria-label="Основная навигация">
        <ul>
            <li><a href="/#vacancies" data-t="nav.vacancies">Вакансии</a></li>
            <li><a href="/companies/" data-t="nav.companies">Компании</a></li>
            {hasPublishedBlog && <li><a href="/blog/">Блог</a></li>}
            <li><a href="/contacts/" data-t="nav.contacts">Контакты</a></li>
            <li><a href="/cities/" data-t="nav.cities">Города</a></li>
            <li><a href="/calculator/" data-t="nav.calculator">Калькулятор</a></li>
            <li><a href="/compare/" class="compare-nav-link"><span data-t="nav.compare">Сравнение</span> <span class="compare-badge hidden" id="compare-badge">0</span></a></li>
        </ul>
    </nav>

    <div class="header-controls">
        <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Переключить на тёмную тему"
            aria-pressed="false"
            title="Переключить на тёмную тему"
        >
            <svg class="theme-toggle-icon icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg class="theme-toggle-icon icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        </button>
        <div class="header-lang">
            <LanguageSwitcher />
        </div>
    </div>
</header>

<nav class="bottom-nav" aria-label="Мобильная навигация">
    <a href="/#vacancies" class="bn-item" id="bn-nav-vacancies">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
        <span data-t="nav.vacancies">Вакансии</span>
    </a>
    <a href="/companies/" class="bn-item">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><path d="M9 22v-4h6v4"></path><path d="M8 6h.01"></path><path d="M16 6h.01"></path><path d="M8 10h.01"></path><path d="M16 10h.01"></path><path d="M8 14h.01"></path><path d="M16 14h.01"></path></svg>
        <span data-t="nav.companies">Компании</span>
    </a>
    <a href="/compare/" class="bn-item">
        <div class="bn-icon-wrap">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path></svg>
            <span class="bn-badge hidden" id="compare-badge-bottom">0</span>
        </div>
        <span data-t="nav.compare">Сравнение</span>
    </a>
    <a href="/cities/" class="bn-item">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        <span data-t="nav.cities">Города</span>
    </a>
    <a href="/calculator/" class="bn-item">
        <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="8" y1="18" x2="16" y2="18"></line><line x1="8" y1="14" x2="16" y2="14"></line><line x1="8" y1="10" x2="16" y2="10"></line><line x1="8" y1="6" x2="16" y2="6"></line></svg>
        <span data-t="vacancy.income">Доход</span>
    </a>
</nav>

<script>
    const COLOR_MODE_KEY = 'site-color-mode';

    function readStoredColorMode() {
        try {
            const stored = localStorage.getItem(COLOR_MODE_KEY);
            return stored === 'dark' || stored === 'light' ? stored : null;
        } catch {
            return null;
        }
    }

    function getSystemColorMode() {
        return window.matchMedia?.('(prefers-color-scheme: dark)')?.matches ? 'dark' : 'light';
    }

    function getCurrentColorMode() {
        return document.body?.dataset.colorMode === 'dark' ? 'dark' : 'light';
    }

    function updateThemeToggleButton(mode: string) {
        const button = document.getElementById('theme-toggle');
        if (!button) return;

        const isDark = mode === 'dark';
        const nextModeLabel = isDark ? 'светлую' : 'тёмную';
        button.setAttribute('aria-pressed', String(isDark));
        button.setAttribute('aria-label', `Переключить на ${nextModeLabel} тему`);
        button.setAttribute('title', `Переключить на ${nextModeLabel} тему`);
    }

    function applyColorMode(mode: string, persist = true) {
        const resolvedMode = mode === 'dark' ? 'dark' : 'light';
        if (document.body) {
            document.body.classList.toggle('dark-mode', resolvedMode === 'dark');
            document.body.dataset.colorMode = resolvedMode;
        }
        // Keep the `dark-mode` class on <html> in sync with <body>. The
        // anti-FOUC <head> script in BaseLayout.astro sets it on <html> at
        // first paint, and the dark-mode stylesheet rules are converged on
        // `:where(html, body).dark-mode .X` (Wave 21e M7), which matches via
        // EITHER ancestor. Toggling only <body> would still work for those
        // rules, but the <head> script set the class on <html>, so a live
        // toggle must update <html> too — otherwise the theme stays
        // half-applied (stale <html> class) until the next reload.
        document.documentElement.classList.toggle('dark-mode', resolvedMode === 'dark');
        document.documentElement.style.colorScheme = resolvedMode;
        updateThemeToggleButton(resolvedMode);

        if (persist) {
            try {
                localStorage.setItem(COLOR_MODE_KEY, resolvedMode);
            } catch {}
        }

        window.dispatchEvent(new CustomEvent('kurieros:color-mode-change', {
            detail: { mode: resolvedMode },
        }));
    }

    function initThemeToggle() {
        const button = document.getElementById('theme-toggle');
        if (!button) return;

        const bodyMode = document.body?.dataset.colorMode;
        const initialMode = bodyMode === 'dark' || bodyMode === 'light'
            ? bodyMode
            : (readStoredColorMode() || getSystemColorMode());

        applyColorMode(initialMode, false);

        button.addEventListener('click', () => {
            const nextMode = getCurrentColorMode() === 'dark' ? 'light' : 'dark';
            applyColorMode(nextMode, true);
        });

        const mediaQuery = window.matchMedia?.('(prefers-color-scheme: dark)');
        if (mediaQuery && typeof mediaQuery.addEventListener === 'function') {
            mediaQuery.addEventListener('change', (event) => {
                if (readStoredColorMode()) return;
                applyColorMode(event.matches ? 'dark' : 'light', false);
            });
        }
    }

    // Source of truth: `MAX_COMPARE_IDS` in src/scripts/compare/compareList.ts.
    // This `is:inline` Header script cannot `import`, so the cap is duplicated
    // as a local literal — kept in sync with compareList.ts by
    // tests/compareListParity.test.ts.
    const MAX_COMPARE_IDS = 4;

    function readCompareList() {
        try {
            const rawList = JSON.parse(localStorage.getItem('compareList') || '[]');
            if (!Array.isArray(rawList)) return [];

            // `.slice(0, MAX_COMPARE_IDS)` is a DEFENSIVE cap on stored data;
            // the Header only reads the list for the badge count and never
            // adds, so no add-overflow eviction happens here.
            const normalizedList = rawList
                .map((id) => Number.parseInt(String(id), 10))
                .filter((id, index, list) => Number.isFinite(id) && list.indexOf(id) === index)
                .slice(0, MAX_COMPARE_IDS);

            if (JSON.stringify(rawList) !== JSON.stringify(normalizedList)) {
                localStorage.setItem('compareList', JSON.stringify(normalizedList));
            }

            return normalizedList;
        } catch {
            return [];
        }
    }

    function updateHeaderCompareBadge() {
        const compareList = readCompareList();
        const badges = [
            document.getElementById('compare-badge'),
            document.getElementById('compare-badge-bottom')
        ];
        
        badges.forEach(badge => {
            if (badge) {
                badge.textContent = String(compareList.length);
                if (compareList.length > 0) {
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
        });
    }
    
    /**
     * C2 — contextual «Вакансии» bottom-nav handler.
     *
     * Spec (per user):
     *   • on /rabota-kurerom-{city}/  → reveal next batch of hidden cards
     *   • on / with city selected     → reveal next batch (grid was hot-
     *                                   swapped to the city's HTML)
     *   • on / with no city selected  → smooth-scroll to #vacancies
     *   • elsewhere                   → fall through to default href
     *
     * Reveal logic itself lives in JobGrid.astro and listens for the
     * `kurieros:reveal-more-jobs` event. Here we just decide whether to
     * dispatch + scroll, or let the static `href="/#vacancies"` win.
     */
    function initBottomNavVacancies() {
        const link = document.getElementById('bn-nav-vacancies');
        if (!link) return;

        link.addEventListener('click', (event) => {
            const grid = document.getElementById('jobs-grid');
            const overflowCount = grid
                ? Number.parseInt(grid.getAttribute('data-overflow-count') || '0', 10)
                : 0;
            const isHome =
                window.location.pathname === '/' ||
                window.location.pathname === '/index.html';

            // Case A: a listing grid is on the page AND has hidden cards.
            // Reveal the next batch instead of navigating.
            if (grid && overflowCount > 0) {
                event.preventDefault();
                window.dispatchEvent(new CustomEvent('kurieros:reveal-more-jobs'));
                return;
            }

            // Case B: home page, no overflow → scroll to filters/grid
            // section. Default href would do the same via hash, but
            // smooth-scroll is nicer and avoids a page jump.
            if (isHome && grid) {
                event.preventDefault();
                grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }

            // Case C: any other page → let the default href (`/#vacancies`)
            // navigate home + jump to the grid. No JS intervention.
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();
        updateHeaderCompareBadge();
        initBottomNavVacancies();
    });

    window.addEventListener('storage', (event) => {
        if (!event.key || event.key === 'compareList') {
            updateHeaderCompareBadge();
        }

        if (event.key === COLOR_MODE_KEY) {
            const stored = readStoredColorMode();
            if (stored) {
                applyColorMode(stored, false);
            }
        }
    });

    window.addEventListener('compareUpdate', updateHeaderCompareBadge);
</script>

<style>
    .site-header {
        background: var(--ink-100);
        border-bottom: 1px solid var(--ink-150);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        padding: var(--space-4) var(--space-6);
    }

    .main-nav ul {
        display: flex;
        gap: var(--space-2);
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .main-nav a {
        color: var(--ink-600);
        font-size: var(--fs-14);
        font-weight: 500;
        padding: 8px 12px;
        border-radius: var(--radius-md);
        text-decoration: none;
        transition: background var(--transition), color var(--transition);
    }
    .main-nav a:hover,
    .main-nav a:focus-visible {
        background: var(--ink-100);
        color: var(--ink-800);
        outline: none;
    }
    .main-nav a:focus-visible {
        box-shadow: var(--shadow-focus);
    }

    .compare-nav-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .compare-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: var(--radius-pill);
        background: var(--accent-500);
        color: var(--ink-0);
        font-size: var(--fs-12);
        font-weight: 700;
        line-height: 1;
    }
    .compare-badge.hidden {
        display: none;
    }

    .header-controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .theme-toggle {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-md);
        border: none;
        background: var(--ink-50);
        color: var(--ink-700);
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: background var(--transition), color var(--transition);
    }
    .theme-toggle:hover {
        background: var(--ink-150);
        color: var(--ink-900);
    }
    .theme-toggle:focus-visible {
        outline: none;
        box-shadow: var(--shadow-focus);
    }
    .theme-toggle-icon {
        width: 20px;
        height: 20px;
        stroke-width: 2;
        transition: opacity var(--transition), transform var(--transition);
    }
    /* Show moon in light mode, sun in dark mode */
    .theme-toggle .icon-sun {
        display: none;
    }
    .theme-toggle .icon-moon {
        display: block;
    }
    :global(:where(html, body).dark-mode) .theme-toggle .icon-sun {
        display: block;
    }
    :global(:where(html, body).dark-mode) .theme-toggle .icon-moon {
        display: none;
    }

    /* Bottom nav (mobile) */
    .bottom-nav {
        background: var(--ink-100);
        border-top: 1px solid var(--ink-200);
    }
    .bn-item {
        color: var(--ink-500);
        text-decoration: none;
    }
    .bn-item:hover,
    .bn-item:focus-visible,
    .bn-item.active {
        color: var(--brand-600);
    }
    .bn-badge {
        background: var(--accent-500);
        color: var(--ink-0);
    }
</style>
