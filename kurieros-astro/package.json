{
  "name": "kurieros-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "astro sync",
    "pregenerate": "npm run generate:data",
    "generate:data": "npm run i18n:extract && npm run i18n:assemble && npm run i18n:test && npm run i18n:validate-keys && concurrently -n trans,reviews,llms 'npm:generate:vacancy-translations' 'npm:generate:reviews' 'npm:generate:llms' && npm run emit:empty-listings",
    "i18n:extract": "tsx scripts/i18n/extract-clauses.ts",
    "i18n:analyze": "tsx scripts/i18n/analyze-tokens.ts",
    "i18n:assemble": "tsx scripts/i18n/assemble-translations.ts",
    "i18n:test": "tsx scripts/i18n/test-translations.ts",
    "i18n:validate-keys": "tsx scripts/validate-translation-keys.ts",
    "generate:vacancy-translations": "tsx scripts/generate-vacancy-translations.ts",
    "generate:reviews": "tsx scripts/generate-reviews.ts",
    "generate:llms": "node scripts/generate-llms.mjs",
    "emit:empty-listings": "tsx scripts/emit-empty-listings.ts",
    "bench:city-neighbours": "node --expose-gc --import tsx scripts/perf/bench-city-neighbours.ts",
    "predev": "npm run generate:data",
    "dev": "astro dev",
    "prebuild": "npm run generate:data",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint \"src/**/*.{ts,astro,js,mjs}\" \"scripts/**/*.{ts,js,mjs}\"",
    "test": "vitest run",
    "test:worker": "vitest run tests/ozonLeadWorker.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint:worker": "eslint \"workers/**/*.{js,mjs}\"",
    "check:worker": "npm run lint:worker && npm run test:worker",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run check:worker",
    "check:perf": "npm run bench:city-neighbours",
    "check:release": "npm run build && npm run check && npm run check:perf && git diff --check",
    "local:build": "./scripts/build-local.sh",
    "local:preview": "./scripts/preview-local.sh",
    "local:dev": "./scripts/dev-local.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "astro-eslint-parser": "^1.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-astro": "^1.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "shell-quote": "1.8.4",
    "yaml-language-server": {
      "yaml": "2.8.3"
    }
  }
}
