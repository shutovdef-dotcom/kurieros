{"defaults":{"shortDescription":"Հավաքեք ինտերնետ-պատվերներ METRO, Lenta Online և այլ գործընկերների խանութներում.","description":"Kuper-ի պատվերներ հավաքողը պատասխանատու է հաճախորդների պատվերների ճշգրիտ և կոկիկ հավաքման համար նախատեսված առաքման համար.","req_0":"Հավաքել ապրանքները հաճախորդի ցանկի համաձայն հավելվածում.","req_1":"Ստուգել ապրանքների պիտանիության ժամկետները և արտաքին տեսքը.","req_2":"Հավաքված պատվերները փոխանցել առաքիչին թայմ-սլոտի շրջանակում.","ben_0":"Շաբաթական վճարումներ քարտին.","ben_1":"Ճկուն գրաֆիկ՝ կարելի է ընտրել հարմար սլոտներ և շրջան.","ben_2":"Զեղչեր և բոնուսներ Kuper-ի և գործընկերների ծառայություններից.","ben_3":"Բրենդավորված համազգեստ ըստ կետի պայմանների.","ben_4":"Բոնուս հրավիրված ընկերների համար (ըստ ռեֆերալային ծրագրի).","doc_0":"РФ-ի քաղաքացիների համար՝ անձնագիր բնակության հասցեով և բժշկական գիրք; ձևակերպում ինքնազբաղվածությամբ."},"entries":{"500011":{},"500021":{},"500031":{},"500041":{},"500051":{},"500061":{},"500071":{},"500081":{},"500091":{},"500101":{},"500111":{},"500121":{},"500131":{},"500141":{},"500151":{},"501231":{},"501701":{},"502401":{},"502601":{},"503741":{},"504281":{},"504431":{},"504481":{},"504781":{},"504861":{},"505041":{},"505331":{},"505491":{},"505501":{},"505811":{},"506101":{},"506461":{},"506651":{},"506671":{},"506761":{},"506801":{},"506871":{},"507171":{},"507241":{},"507531":{},"507551":{},"507711":{},"508161":{},"508231":{},"509141":{},"509171":{},"509251":{},"509301":{},"509401":{},"509531":{},"509751":{},"509901":{},"511271":{},"511341":{},"511371":{},"511701":{},"512461":{},"512671":{},"512971":{},"513101":{},"513221":{},"513261":{},"513351":{},"513651":{},"513661":{},"513701":{},"513811":{},"514031":{},"514291":{},"514461":{},"514511":{},"515581":{},"516051":{},"516301":{},"516421":{},"516431":{},"516501":{},"516561":{},"516671":{},"516711":{},"516851":{},"517121":{},"517191":{},"517381":{},"517671":{},"517771":{},"518311":{},"518411":{},"518681":{},"518751":{},"519291":{},"519301":{},"519381":{},"