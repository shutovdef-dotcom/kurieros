{"defaults":{"shortDescription":"Giao hàng theo kế hoạch và nhanh bằng ô tô với thanh toán hàng tuần.","description":"Vị trí tài xế giao hàng bằng ô tô tại Kuper: giao đơn hàng bằng ô tô, chọn khu vực thuận tiện và nhận thanh toán hàng tuần.","req_0":"Giao đơn hàng đã thu gom cho khách theo lộ trình từ ứng dụng.","req_1":"Tuân thủ khung giờ giao hàng theo kế hoạch và quy tắc bàn giao đơn hàng.","req_2":"Duy trì liên lạc với bộ phận hỗ trợ và khách hàng qua ứng dụng khi cần.","ben_0":"Thanh toán hàng tuần vào thẻ.","ben_1":"Lịch trình linh hoạt: có thể chọn khung giờ và khu vực thuận tiện.","ben_2":"Giảm giá và ưu đãi từ các dịch vụ Kuper và đối tác.","ben_3":"Đồng phục có logo theo điều kiện điểm.","ben_4":"Thưởng cho bạn bè được mời (theo chương trình giới thiệu).","ben_5":"Đối với Moskva có thể thuê xe của công ty.","doc_0":"Đối với công dân РФ: hộ chiếu kèm propiska và sổ y tế; đăng ký theo hình thức tự kinh doanh."},"entries":{"400013":{},"400023":{},"400033":{},"400043":{},"400053":{},"400063":{},"400073":{},"400083":{},"400093":{},"400103":{},"400113":{},"400123":{},"400133":{},"400143":{},"400153":{},"401233":{},"401703":{},"402403":{},"402603":{},"403743":{},"404283":{},"404433":{},"404483":{},"404783":{},"404863":{},"405043":{},"405333":{},"405493":{},"405503":{},"405813":{},"406103":{},"406463":{},"406653":{},"406673":{},"406763":{},"406803":{},"406873":{},"407173":{},"407243":{},"407533":{},"407553":{},"407713":{},"408163":{},"408233":{},"409143":{},"409173":{},"409253":{},"409303":{},"409403":{},"409533":{},"409753":{},"409903":{},"411273":{},"411343":{},"411373":{},"411703":{},"412463":{},"412673":{},"412973":{},"413103":{},"413223":{},"413263":{},"413353":{},"413653":{},"413663":{},"413703":{},"413813":{},"414033":{},"414293":{},"414463":{},"414513":{},"415583":{},"416053":{},"416303":{},"416423":{},"416433":{},"416503":{},"416563":{},"416673":{},"416713":{},"416853":{},"417123":{},"417193":{},"417383":{},"417673":{},"417773":{},"418313":{},"418413":{}