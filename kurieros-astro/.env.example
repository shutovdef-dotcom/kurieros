# Public-prefixed env vars are inlined into the client bundle by Astro
# at build time. NEVER put real secrets here — anything a browser sees
# is public. For private secrets use a server-side proxy or unprefixed
# vars consumed only in build scripts.

# === Analytics =======================================================
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Ozon lead form =================================================
# Referrer phone shown in the success state with a «Скопировать» button.
# Format: +7XXXXXXXXXX (digits with leading +7).
PUBLIC_OZON_REF_CODE=

# Telegram bot that receives lead notifications when a candidate
# submits the Ozon form on /v/ozon-courier-moskva-auto/ (or the home
# job-card CTA). The token is exposed to browsers; keep usage low and
# rotate via @BotFather → /revoke if abused.
#
# Setup:
#   1. Open Telegram → @BotFather → /newbot → follow prompts.
#   2. Copy the token printed after «Use this token to access the HTTP API».
#   3. Send any message to your new bot (e.g. /start) so the chat exists.
#   4. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser.
#   5. Find the `chat.id` (positive integer for direct chats, negative
#      for groups) and put it into PUBLIC_TELEGRAM_CHAT_ID below.
PUBLIC_TELEGRAM_BOT_TOKEN=
PUBLIC_TELEGRAM_CHAT_ID=
